// std/str: an owned byte string and operations on byte views. Imported
// with `import "std/str"`; every declaration is exported (spec/types.md §1).
module str

// String is an owned, growable byte string. The library treats it as
// bytes; text is UTF-8 by convention.
struct String nocopy { bytes: Vec[u8] }

impl String {
    func new() -> String { return String { bytes: Vec[u8].new() } }
    // from copies the bytes of s into a new String.
    func from(s: view[]u8) -> String {
        r := String { bytes: Vec[u8].new() }
        r.bytes.extend(s)
        return r
    }
    func len(view self) -> usize { return self.bytes.len() }
    func as_view(view self) -> view[]u8 { return self.bytes.as_view() }
    func push(edit self, b: u8) { self.bytes.push(b) }
    func push_str(edit self, s: view[]u8) { self.bytes.extend(s) }
    // capacity and the try_ forms are those of the byte vector
    // (specs/fallible-alloc/SPEC.md §2): Err(OutOfMemory) where from, push
    // and push_str trap oom, with the string unchanged.
    func capacity(view self) -> usize { return self.bytes.capacity() }
    func try_from(s: view[]u8) -> Result[String, AllocErr] {
        r := String { bytes: Vec[u8].new() }
        r.bytes.try_extend(s)?
        return Ok(r)
    }
    func try_reserve(edit self, n: usize) -> Result[(), AllocErr] { return self.bytes.try_reserve(n) }
    func try_push(edit self, b: u8) -> Result[(), AllocErr] { return self.bytes.try_push(b) }
    func try_push_str(edit self, s: view[]u8) -> Result[(), AllocErr] { return self.bytes.try_extend(s) }
    // push_u64 appends v in decimal.
    func push_u64(edit self, v: u64) {
        if v == 0u64 { self.bytes.push(48u8); return }
        var digits: [20]u8 = zero()
        n := 0usize
        x := v
        while x > 0u64 {
            digits[n] = truncate[u8](x % 10u64) + 48u8
            x = x / 10u64
            n = n + 1usize
        }
        while n > 0usize {
            n = n - 1usize
            self.bytes.push(digits[n])
        }
    }
    // push_i64 appends v in decimal, with a leading - when negative; the
    // magnitude is taken in u64, so the minimum i64 needs no wider type.
    func push_i64(edit self, v: i64) {
        if v < 0i64 {
            self.bytes.push(45u8)
            self.push_u64(u64(0i64 - (v + 1i64)) + 1u64)
            return
        }
        self.push_u64(u64(v))
    }
    // push_hex appends v in lowercase hexadecimal, no prefix, no leading
    // zeros; 0 for zero.
    func push_hex(edit self, v: u64) {
        if v == 0u64 { self.bytes.push(48u8); return }
        var digits: [16]u8 = zero()
        n := 0usize
        x := v
        while x > 0u64 {
            d := truncate[u8](x & 15u64)
            if d < 10u8 { digits[n] = d + 48u8 } else { digits[n] = d + 87u8 }
            x = x >> 4u32
            n = n + 1usize
        }
        while n > 0usize {
            n = n - 1usize
            self.bytes.push(digits[n])
        }
    }
    // push_padded appends v in decimal right-aligned in width bytes, filled
    // on the left with fill; a wider number is appended whole.
    func push_padded(edit self, v: u64, width: usize, fill: u8) {
        digits := 1usize
        x := v / 10u64
        while x > 0u64 {
            digits = digits + 1usize
            x = x / 10u64
        }
        while digits < width {
            self.bytes.push(fill)
            digits = digits + 1usize
        }
        self.push_u64(v)
    }
    // push_rune appends the UTF-8 encoding of a scalar value and returns
    // true; a surrogate (U+D800 to U+DFFF) or a value above U+10FFFF
    // appends nothing and returns false.
    func push_rune(edit self, code: u32) -> bool {
        if code >= 55296u32 && code <= 57343u32 { return false }
        if code > 1114111u32 { return false }
        if code < 128u32 {
            self.bytes.push(truncate[u8](code))
        } else if code < 2048u32 {
            self.bytes.push(192u8 | truncate[u8](code >> 6u32))
            self.bytes.push(128u8 | truncate[u8](code & 63u32))
        } else if code < 65536u32 {
            self.bytes.push(224u8 | truncate[u8](code >> 12u32))
            self.bytes.push(128u8 | truncate[u8]((code >> 6u32) & 63u32))
            self.bytes.push(128u8 | truncate[u8](code & 63u32))
        } else {
            self.bytes.push(240u8 | truncate[u8](code >> 18u32))
            self.bytes.push(128u8 | truncate[u8]((code >> 12u32) & 63u32))
            self.bytes.push(128u8 | truncate[u8]((code >> 6u32) & 63u32))
            self.bytes.push(128u8 | truncate[u8](code & 63u32))
        }
        return true
    }
    // push_f64 appends v as text that reads back as exactly v
    // (specs/float-text): NaN, Infinity, -Infinity; 0 or -0; otherwise
    // the round-trip digits laid out by ECMAScript's Number::toString
    // rule (plain up to 21 integer digits, 0.000ddd down to 1e-6, else
    // d.ddde+X).
    func push_f64(edit self, v: f64) {
        if v != v {
            self.push_str("NaN")
            return
        }
        d := v - v
        if d != d {
            if v > 0.0f64 { self.push_str("Infinity") } else { self.push_str("-Infinity") }
            return
        }
        var buf: [40]u8 = zero()
        n := str_f64_digits(v, buf)
        // buf is [-]d[.ddd]e+XX
        i := 0usize
        if buf[0usize] == 45u8 {
            self.push(45u8)
            i = 1usize
        }
        var digs: [17]u8 = zero()
        k := 0usize
        while i < n && buf[i] != 101u8 {
            if buf[i] != 46u8 {
                digs[k] = buf[i]
                k = k + 1usize
            }
            i = i + 1usize
        }
        i = i + 1usize
        eneg := buf[i] == 45u8
        i = i + 1usize
        e := 0i64
        while i < n {
            e = e * 10i64 + i64(buf[i] - 48u8)
            i = i + 1usize
        }
        if eneg { e = 0i64 - e }
        if k == 1usize && digs[0usize] == 48u8 {
            self.push(48u8)
            return
        }
        pt := e + 1i64
        kk := i64(k)
        if kk <= pt && pt <= 21i64 {
            for j in 0usize..k { self.push(digs[j]) }
            z := pt - kk
            while z > 0i64 {
                self.push(48u8)
                z = z - 1i64
            }
        } else if pt > 0i64 && pt <= 21i64 {
            p := usize(pt)
            for j in 0usize..p { self.push(digs[j]) }
            self.push(46u8)
            for j in p..k { self.push(digs[j]) }
        } else if pt > -6i64 && pt <= 0i64 {
            self.push(48u8)
            self.push(46u8)
            z := 0i64 - pt
            while z > 0i64 {
                self.push(48u8)
                z = z - 1i64
            }
            for j in 0usize..k { self.push(digs[j]) }
        } else {
            self.push(digs[0usize])
            if k > 1usize {
                self.push(46u8)
                for j in 1usize..k { self.push(digs[j]) }
            }
            self.push(101u8)
            x := pt - 1i64
            if x >= 0i64 {
                self.push(43u8)
                self.push_u64(u64(x))
            } else {
                self.push(45u8)
                self.push_u64(u64(0i64 - x))
            }
        }
    }
    func clear(edit self) { self.bytes.clear() }
    func clone(view self) -> String { return String { bytes: self.bytes.clone() } }
    func byte(view self, i: usize) -> u8 { b := self.bytes.get(i); return b }
    // equals compares the bytes with s.
    func equals(view self, s: view[]u8) -> bool { return equal(self.bytes.as_view(), s) }
}

// Runtime intrinsics for floating-point text (specs/float-text; the
// freestanding runtime's are specs/freestanding-float):
// str_f64_digits writes a finite v's round-trip digits in exponent form,
// [-]d[.ddd]e+XX, and returns the length; str_parse_f64 is the correctly
// rounded value of text already checked to be one JSON number, +-Inf when
// it overflows (the hosted runtime traps oom only if text over 1,023
// bytes cannot be copied for the C call; the freestanding one never
// traps).
func str_f64_digits(v: f64, buf: edit[]u8) -> usize
func str_parse_f64(s: view[]u8) -> f64

// parse_f64 is the correctly rounded value of s when s is exactly one JSON
// number (RFC 8259) whose value is finite, else None (specs/float-text).
func parse_f64(s: view[]u8) -> Option[f64] {
    if !json_number(s) { return None }
    v := str_parse_f64(s)
    d := v - v
    if d != d { return None }
    return Some(v)
}

// json_number reports whether s is exactly one JSON number: an optional
// -, 0 or a digit 1-9 and digits, an optional fraction, an optional
// exponent.
func json_number(s: view[]u8) -> bool {
    n := len(s)
    i := 0usize
    if i < n && s[i] == 45u8 { i = i + 1usize }
    if i >= n { return false }
    if s[i] == 48u8 {
        i = i + 1usize
    } else if s[i] >= 49u8 && s[i] <= 57u8 {
        while i < n && s[i] >= 48u8 && s[i] <= 57u8 { i = i + 1usize }
    } else {
        return false
    }
    if i < n && s[i] == 46u8 {
        i = i + 1usize
        start := i
        while i < n && s[i] >= 48u8 && s[i] <= 57u8 { i = i + 1usize }
        if i == start { return false }
    }
    if i < n && (s[i] == 101u8 || s[i] == 69u8) {
        i = i + 1usize
        if i < n && (s[i] == 43u8 || s[i] == 45u8) { i = i + 1usize }
        start := i
        while i < n && s[i] >= 48u8 && s[i] <= 57u8 { i = i + 1usize }
        if i == start { return false }
    }
    return i == n
}

// equal reports whether a and b hold the same bytes. The first byte is
// compared before anything else, which settles most unequal pairs at the
// cost of a byte loop's first step. The rest is compared eight bytes at a
// time through load_le: whole words from the front, then the last eight
// bytes, which overlap what was compared when the length is not a multiple
// of eight. A view of four to seven bytes is compared the same way by its
// first and last four, a shorter one by its bytes. No read here is
// bounds-checked: the loop's `i + 8usize <= n` and each `t + K <= n`,
// which follow from the lines before them, are the guards that prove the
// reads in range (docs/bounds-checks.md), and `i < t` is what lets a
// native build drop the overflow check of `i + 8`.
func equal(a: view[]u8, b: view[]u8) -> bool {
    n := len(a)
    if n != len(b) { return false }
    if n < 1usize { return true }
    if a[0usize] != b[0usize] { return false }
    if n >= 8usize {
        t := n - 8usize
        i := 0usize
        while i < t && i + 8usize <= n {
            if load_le[u64](a, i) != load_le[u64](b, i) { return false }
            i = i + 8usize
        }
        return t + 8usize <= n && load_le[u64](a, t) == load_le[u64](b, t)
    }
    if n >= 4usize {
        if load_le[u32](a, 0usize) != load_le[u32](b, 0usize) { return false }
        if n == 4usize { return true }
        t := n - 4usize
        return t + 4usize <= n && load_le[u32](a, t) == load_le[u32](b, t)
    }
    if n >= 2usize {
        if a[1usize] != b[1usize] { return false }
        return n < 3usize || a[2usize] == b[2usize]
    }
    return true
}

// hash is the 64-bit FNV-1a hash of s.
func hash(s: view[]u8) -> u64 {
    h := 14695981039346656037u64
    i := 0usize
    while i < len(s) {
        h = wrapping_mul(h ^ u64(s[i]), 1099511628211u64)
        i = i + 1usize
    }
    return h
}

// starts_with reports whether s begins with prefix.
func starts_with(s: view[]u8, prefix: view[]u8) -> bool {
    n := len(prefix)
    return n <= len(s) && equal(s[0usize:n], prefix)
}

// ends_with reports whether s ends with suffix (`from <= len(s)` always
// holds: it is the guard that proves the slice).
func ends_with(s: view[]u8, suffix: view[]u8) -> bool {
    if len(suffix) > len(s) { return false }
    from := len(s) - len(suffix)
    return from <= len(s) && equal(s[from:len(s)], suffix)
}

// find_byte returns the index of the first byte of s equal to b. It reads
// eight bytes at a time: a word xored with b in every byte has a zero byte
// where s holds b, and `(w - 0x01..01) & ~w & 0x80..80` has the high bit
// set in the lowest zero byte of w and in no byte below it (a borrow can
// set it only in a byte above a zero one), so the lowest set bit names the
// first match whatever the other bytes hold. The last eight bytes are read
// as one word that overlaps bytes already found not to match, and a view
// under eight bytes is read a byte at a time. The guards are those of
// equal.
func find_byte(s: view[]u8, b: u8) -> Option[usize] {
    n := len(s)
    if n >= 8usize {
        ones := 72340172838076673u64
        highs := 9259542123273814144u64
        pat := wrapping_mul(u64(b), ones)
        t := n - 8usize
        i := 0usize
        while i < t && i + 8usize <= n {
            w := load_le[u64](s, i) ^ pat
            z := wrapping_sub(w, ones) & (w ^ 18446744073709551615u64) & highs
            if z != 0u64 { return Some(i + usize(count_trailing_zeros(z) >> 3u32)) }
            i = i + 8usize
        }
        if t + 8usize <= n {
            w := load_le[u64](s, t) ^ pat
            z := wrapping_sub(w, ones) & (w ^ 18446744073709551615u64) & highs
            if z != 0u64 { return Some(t + usize(count_trailing_zeros(z) >> 3u32)) }
        }
        return None
    }
    i := 0usize
    while i < n && s[i] != b { i = i + 1usize }
    if i < n { return Some(i) }
    return None
}

// find returns the index of the first occurrence of needle in s: 0 for an
// empty needle, None for one longer than s. It looks for the needle's
// first byte with find_byte and compares with equal at each place found.
func find(s: view[]u8, needle: view[]u8) -> Option[usize] {
    m := len(needle)
    if m > len(s) { return None }
    if m < 1usize { return Some(0usize) }
    first := needle[0usize]
    if m == 1usize { return find_byte(s, first) }
    i := 0usize
    while i < len(s) {
        if s[i] != first {
            match find_byte(s[i + 1usize:len(s)], first) {
                Some(k) => i = i + 1usize + k
                None => return None
            }
        }
        // the first byte is at i: an occurrence there ends at e, and when
        // that is past the end so is every later one (`i > e` never holds:
        // with the other test it is the guard that proves the slice)
        e := i + m
        if e > len(s) || i > e { return None }
        if equal(s[i:e], needle) { return Some(i) }
        i = i + 1usize
    }
    return None
}

// parse_u64 reads a decimal number; None when s is empty, has a byte that
// is not a digit, or does not fit in a u64.
func parse_u64(s: view[]u8) -> Option[u64] {
    if len(s) == 0usize { return None }
    v := 0u64
    i := 0usize
    while i < len(s) {
        b := s[i]
        if b < 48u8 || b > 57u8 { return None }
        match checked_mul(v, 10u64) {
            Some(m) => {
                match checked_add(m, u64(b - 48u8)) {
                    Some(a) => v = a
                    None => return None
                }
            }
            None => return None
        }
        i = i + 1usize
    }
    return Some(v)
}

// Bounds is a byte range lo..hi of a view.
struct Bounds { lo: usize; hi: usize }

// trim returns the bounds of s without leading and trailing spaces, tabs,
// carriage returns and newlines: s[b.lo : b.hi].
func trim(s: view[]u8) -> Bounds {
    lo := 0usize
    hi := len(s)
    while lo < hi && is_space(s[lo]) { lo = lo + 1usize }
    while hi > lo && is_space(s[hi - 1usize]) { hi = hi - 1usize }
    return Bounds { lo: lo, hi: hi }
}

func is_space(b: u8) -> bool { return b == 32u8 || b == 9u8 || b == 10u8 || b == 13u8 }

// Rune is one decoded scalar value and the length of its encoding.
struct Rune { code: u32; len: usize }

// utf8_decode decodes the scalar value encoded at byte at of s: None when
// at is not below len(s) or the bytes from at do not begin a well-formed
// sequence (Unicode Table 3-7, which rules out overlong forms, surrogates
// and values above U+10FFFF through the second byte's range).
func utf8_decode(s: view[]u8, at: usize) -> Option[Rune] {
    if at >= len(s) { return None }
    b0 := s[at]
    if b0 < 128u8 { return Some(Rune { code: u32(b0), len: 1usize }) }
    var n: usize = 0usize
    var lo: u8 = 128u8
    var hi: u8 = 191u8
    var code: u32 = 0u32
    if b0 >= 194u8 && b0 <= 223u8 {
        n = 2usize
        code = u32(b0 & 31u8)
    } else if b0 >= 224u8 && b0 <= 239u8 {
        n = 3usize
        code = u32(b0 & 15u8)
        if b0 == 224u8 { lo = 160u8 }
        if b0 == 237u8 { hi = 159u8 }
    } else if b0 >= 240u8 && b0 <= 244u8 {
        n = 4usize
        code = u32(b0 & 7u8)
        if b0 == 240u8 { lo = 144u8 }
        if b0 == 244u8 { hi = 143u8 }
    } else {
        return None
    }
    if len(s) - at < n { return None }
    i := 1usize
    while i < n {
        b := s[at + i]
        if b < lo || b > hi { return None }
        lo = 128u8
        hi = 191u8
        code = (code << 6u32) | u32(b & 63u8)
        i = i + 1usize
    }
    return Some(Rune { code: code, len: n })
}

// utf8_count is the number of scalar values in s, or None when s is not
// well-formed UTF-8.
func utf8_count(s: view[]u8) -> Option[usize] {
    i := 0usize
    n := 0usize
    while i < len(s) {
        match utf8_decode(s, i) {
            Some(r) => {
                i = i + r.len
                n = n + 1usize
            }
            None => return None
        }
    }
    return Some(n)
}

// utf8_valid reports whether s is well-formed UTF-8 (the empty view is).
func utf8_valid(s: view[]u8) -> bool {
    match utf8_count(s) {
        Some(n) => return true
        None => return false
    }
}
