// std/io: files, the standard streams and the program's arguments, for
// hosted programs (a freestanding image has no runtime behind these).
// Imported with `import "std/io"`. The runtime calls below work at the
// descriptor level and report errors as negative errno values; the
// functions after them are the library's interface.
module io

// IoErr is why an operation failed.
union IoErr { NotFound; Permission; Exists; Other(code: i32) }

// Runtime intrinsics (hosted).
func io_open(path: view[]u8, write: bool) -> i32
func io_read(fd: i32, buf: edit[]u8) -> i64
func io_write(fd: i32, data: view[]u8) -> i64
func io_close(fd: i32) -> i32
func io_remove(path: view[]u8) -> i32
func io_mkdir(path: view[]u8) -> i32
func io_rmdir(path: view[]u8) -> i32
func io_kind(path: view[]u8) -> i32
func io_list(path: view[]u8, buf: edit[]u8) -> i64
func io_temp(prefix: view[]u8, dir: bool, buf: edit[]u8) -> i64
func io_argc() -> usize
func io_arg(i: usize, buf: edit[]u8) -> usize

func err_of(code: i32) -> IoErr {
    if code == 2i32 { return NotFound }
    if code == 13i32 { return Permission }
    if code == 17i32 { return Exists }
    return Other(code)
}

// read_from reads a descriptor to its end.
func read_from(fd: i32) -> Result[Vec[u8], IoErr] {
    data := Vec[u8].new()
    var buf: [4096]u8 = zero()
    while true {
        n := io_read(fd, buf)
        if n < 0i64 { return Err(err_of(truncate[i32](0i64 - n))) }
        if n == 0i64 { break }
        data.extend(buf[0usize : usize(n)])
    }
    return Ok(data)
}

// read_file reads the whole file at path.
func read_file(path: view[]u8) -> Result[Vec[u8], IoErr] {
    fd := io_open(path, false)
    if fd < 0i32 { return Err(err_of(0i32 - fd)) }
    r := read_from(fd)
    c := io_close(fd)
    return r
}

// read_stdin reads standard input to its end.
func read_stdin() -> Result[Vec[u8], IoErr] { return read_from(0i32) }

// write_all writes data to a descriptor, retrying short writes.
func write_all(fd: i32, data: view[]u8) -> Result[(), IoErr] {
    off := 0usize
    while off < len(data) {
        n := io_write(fd, data[off : len(data)])
        if n <= 0i64 { return Err(err_of(truncate[i32](0i64 - n))) }
        off = off + usize(n)
    }
    return Ok(())
}

// write_file creates or truncates the file at path and writes data to it.
func write_file(path: view[]u8, data: view[]u8) -> Result[(), IoErr] {
    fd := io_open(path, true)
    if fd < 0i32 { return Err(err_of(0i32 - fd)) }
    r := write_all(fd, data)
    c := io_close(fd)
    if c < 0i32 {
        // a delayed write error surfaces at close; an earlier write error
        // takes precedence
        match r {
            Ok(u) => return Err(err_of(0i32 - c))
            Err(e) => { }
        }
    }
    return r
}

// write_stdout and write_stderr write bytes to the standard streams
// (stdout in order with print_str).
func write_stdout(data: view[]u8) -> Result[(), IoErr] { return write_all(1i32, data) }
func write_stderr(data: view[]u8) -> Result[(), IoErr] { return write_all(2i32, data) }

// remove_file deletes the file at path.
func remove_file(path: view[]u8) -> Result[(), IoErr] {
    r := io_remove(path)
    if r < 0i32 { return Err(err_of(0i32 - r)) }
    return Ok(())
}

// FileKind is what a path names, symbolic links followed.
union FileKind { RegularFile; Directory; OtherFile }

// kind_of reports what path names.
func kind_of(path: view[]u8) -> Result[FileKind, IoErr] {
    k := io_kind(path)
    if k < 0i32 { return Err(err_of(0i32 - k)) }
    if k == 1i32 { return Ok(RegularFile) }
    if k == 2i32 { return Ok(Directory) }
    return Ok(OtherFile)
}

// make_dir creates a directory; Exists when path names anything already.
func make_dir(path: view[]u8) -> Result[(), IoErr] {
    r := io_mkdir(path)
    if r < 0i32 { return Err(err_of(0i32 - r)) }
    return Ok(())
}

// remove_dir deletes an empty directory.
func remove_dir(path: view[]u8) -> Result[(), IoErr] {
    r := io_rmdir(path)
    if r < 0i32 { return Err(err_of(0i32 - r)) }
    return Ok(())
}

// list_dir returns the names of a directory's entries, `.` and `..` left
// out, in bytewise order.
func list_dir(path: view[]u8) -> Result[Vec[Vec[u8]], IoErr] {
    buf := Vec[u8].new()
    buf.resize(4096usize, 0u8)
    while true {
        var n: i64 = 0i64
        with e := buf.as_edit() { n = io_list(path, e) }
        if n < 0i64 { return Err(err_of(truncate[i32](0i64 - n))) }
        if usize(n) <= buf.len() {
            names := Vec[Vec[u8]].new()
            var start: usize = 0usize
            var i: usize = 0usize
            with b := buf.as_view() {
                while i < usize(n) {
                    if b[i] == 0u8 {
                        name := Vec[u8].new()
                        name.extend(b[start:i])
                        names.push(name)
                        start = i + 1usize
                    }
                    i = i + 1usize
                }
            }
            return Ok(names)
        }
        // the names need more room (the directory may grow meanwhile)
        buf.resize(usize(n), 0u8)
    }
    return Err(Other(0i32))
}

// temp_path creates a fresh directory or empty file in the system's
// temporary directory ($TMPDIR, /tmp when unset), named prefix and random
// characters, and returns its path; the prefix may not hold a '/'.
func temp_path(prefix: view[]u8, dir: bool) -> Result[Vec[u8], IoErr] {
    var buf: [4096]u8 = zero()
    n := io_temp(prefix, dir, buf)
    if n < 0i64 { return Err(err_of(truncate[i32](0i64 - n))) }
    path := Vec[u8].new()
    path.extend(buf[0usize : usize(n)])
    return Ok(path)
}

// make_temp_dir and make_temp_file create a fresh directory or empty file
// for the program's own use; removing it is the program's job.
func make_temp_dir(prefix: view[]u8) -> Result[Vec[u8], IoErr] { return temp_path(prefix, true) }
func make_temp_file(prefix: view[]u8) -> Result[Vec[u8], IoErr] { return temp_path(prefix, false) }

// args returns the program's arguments, the program name first; an
// argument longer than 4096 bytes is cut there.
func args() -> Vec[Vec[u8]] {
    list := Vec[Vec[u8]].new()
    n := io_argc()
    i := 0usize
    while i < n {
        var buf: [4096]u8 = zero()
        k := io_arg(i, buf)
        if k > 4096usize { k = 4096usize }
        a := Vec[u8].new()
        a.extend(buf[0usize : k])
        list.push(a)
        i = i + 1usize
    }
    return list
}
