// std/net: TCP and UDP sockets over IPv4 and IPv6 and Unix-domain
// sockets, for hosted programs (a freestanding image has no network
// behind these).
// Imported with `import "std/net"` (specs/runtime area H).
//
// A socket call blocks the calling thread until it completes, or, for the
// `_timeout` forms, until its duration has passed: there is no
// non-blocking mode. A call that a signal interrupts carries on. Sockets
// are not inherited by child processes. Writing to a connection the peer
// closed is an error of kind BrokenPipe or ConnectionReset and never ends
// the program. Every type here may move to another thread.
module net
import "std/signal"
import "std/io"
import "std/time"

// Runtime intrinsics (hosted). An address crosses as a record of 23
// bytes: the family (4 or 6), 16 bytes of address (IPv4 in the first
// four), the port high byte first, an IPv6 address's scope high byte
// first. A call with ns and timed waits at most
// ns nanoseconds when timed is set and returns io.timed_out() when that
// time passed; each returns its value or -errno.
func net_tcp_listen(addr: view[]u8, backlog: i32) -> i32
func net_udp_bind(addr: view[]u8) -> i32
func net_accept(fd: i32, ns: u64, timed: bool) -> i64
func net_connect(addr: view[]u8, ns: u64, timed: bool) -> i64
func net_unix_listen(path: view[]u8, backlog: i32) -> i32
func net_unix_connect(path: view[]u8, ns: u64, timed: bool) -> i64
func net_unix_pair(fds: edit[]i32) -> i32
// net_unix_dgram makes a datagram socket, bound to path unless it is
// empty; net_unix_recv_from writes the sender's path into from (at least
// 105 bytes): its length in the first byte, then its bytes.
func net_unix_dgram(path: view[]u8) -> i32
func net_unix_send_to(fd: i32, data: view[]u8, path: view[]u8) -> i64
func net_unix_recv_from(fd: i32, buf: edit[]u8, from: edit[]u8, ns: u64, timed: bool) -> i64
func net_recv(fd: i32, buf: edit[]u8, ns: u64, timed: bool) -> i64
func net_send(fd: i32, data: view[]u8) -> i64
// net_send_timeout is net_send that waits at most ns nanoseconds for the
// socket to take any of the bytes: the count, -errno, or the timed-out
// value when it took none.
func net_send_timeout(fd: i32, data: view[]u8, ns: u64) -> i64
func net_shutdown(fd: i32, how: i32) -> i32
func net_set_nodelay(fd: i32, on: bool) -> i32
// net_set_opt and net_get_opt set and read a socket option by number: 1
// keep-alive, 2 the receive buffer's size, 3 the send buffer's, 4
// broadcast, 5 the hop limit, 6 linger in seconds (-1: off), 7 no-delay.
// net_get_opt returns the value, or -errno - 1.
func net_set_opt(fd: i32, opt: i32, value: i64) -> i32
func net_get_opt(fd: i32, opt: i32) -> i64
// net_if_index is the index of the network interface with a name, 0 for
// none; net_if_name writes the name of the interface with an index into
// buf and returns its length, 0 for none.
func net_if_index(name: view[]u8) -> u32
func net_if_name(index: u32, buf: edit[]u8) -> i64
// net_poller_new makes a readiness queue; net_poller_set watches fd for
// reading (interest 1), writing (2) or both (3) under a token, or stops
// watching it (0); net_poller_wait writes (token, flags) pairs into raw
// and returns how many: flags 1 readable, 2 writable, 4 the peer closed,
// 8 an error is pending.
func net_poller_new() -> i32
func net_poller_set(p: i32, fd: i32, token: u64, interest: i32) -> i32
func net_poller_wait(p: i32, raw: edit[]u64, ns: u64, timed: bool) -> i64
// net_send_fd sends bytes over a Unix-domain stream with the descriptor
// pass attached; net_recv_fd receives bytes and puts a descriptor that
// came with them in got[0] (-1: none). net_fd_kind says what a
// descriptor is (1 not a socket, 2 a TCP stream, 3 a TCP listener, 4 a
// UDP socket, 5 a Unix-domain stream, 6 a Unix-domain listener, 7 a
// Unix-domain datagram socket, 0 another socket) and net_fd_adopt makes
// a received one ready for use as the kind named.
func net_send_fd(fd: i32, data: view[]u8, pass: i32) -> i64
func net_recv_fd(fd: i32, buf: edit[]u8, got: edit[]i32, ns: u64, timed: bool) -> i64
func net_fd_kind(fd: i32) -> i32
func net_fd_adopt(fd: i32, kind: i32) -> i32
// net_peer_cred writes the user, the group and the process of a
// Unix-domain stream's peer into raw.
func net_peer_cred(fd: i32, raw: edit[]u32) -> i32
func net_addr(fd: i32, peer: bool, rec: edit[]u8) -> i32
func net_send_to(fd: i32, data: view[]u8, addr: view[]u8) -> i64
func net_recv_from(fd: i32, buf: edit[]u8, from: edit[]u8, ns: u64, timed: bool) -> i64
func net_close(fd: i32) -> i32
func net_resolve(host: view[]u8, port: u16, recs: edit[]u8) -> i64

// ---- addresses (RH1) ----

// IpAddr is an IPv4 or an IPv6 address, its bytes in network order.
union IpAddr { V4(a: [4]u8); V6(a: [16]u8) }

// SocketAddr is an address and a port. Addresses are small values that
// copy: every function here takes one by value, so the result of one call
// can be the argument of another.
//
// scope is for an IPv6 address that means something only on one link (a
// link-local address, fe80::/10): the index of the network interface the
// link is on, which the system needs to reach it. It is 0 for every
// other address, and an IPv4 address has none.
struct SocketAddr { ip: IpAddr; port: u16; scope: u32 }

// v4 is the IPv4 address a.b.c.d.
func v4(a: u8, b: u8, c: u8, d: u8) -> IpAddr {
    var bytes: [4]u8 = zero()
    bytes[0usize] = a
    bytes[1usize] = b
    bytes[2usize] = c
    bytes[3usize] = d
    return V4(bytes)
}

// addr joins an address and a port.
func addr(ip: IpAddr, port: u16) -> SocketAddr { return SocketAddr { ip: ip, port: port, scope: 0u32 } }

// addr_scoped is addr with the scope of an IPv6 link-local address: the
// index of its interface, which interface_index finds by name. An IPv4
// address has no scope, and the one given is dropped.
func addr_scoped(ip: IpAddr, port: u16, scope: u32) -> SocketAddr {
    match ip {
        V4(b) => { return SocketAddr { ip: ip, port: port, scope: 0u32 } }
        V6(b) => { return SocketAddr { ip: ip, port: port, scope: scope } }
    }
}

// interface_index is the index of the network interface with a name
// (`en0`, `eth0`, `lo`), or None when the machine has none of that name.
func interface_index(name: view[]u8) -> Option[u32] {
    i := net_if_index(name)
    if i == 0u32 { return None }
    return Some(i)
}

// interface_name is the name of the network interface with an index, or
// None when the machine has none.
func interface_name(index: u32) -> Option[Vec[u8]] {
    var buf: [64]u8 = zero()
    n := net_if_name(index, buf)
    if n <= 0i64 { return None }
    name := Vec[u8].new()
    for k in 0usize..usize(n) { name.push(buf[k]) }
    return Some(name)
}

// loopback_v4 and loopback_v6 are 127.0.0.1 and ::1 with a port; any_v4
// and any_v6 are the addresses that stand for every interface. Port 0
// asks the system for a free port, which local_addr then reports.
func loopback_v4(port: u16) -> SocketAddr { return addr(v4(127u8, 0u8, 0u8, 1u8), port) }
func loopback_v6(port: u16) -> SocketAddr {
    var bytes: [16]u8 = zero()
    bytes[15usize] = 1u8
    return addr(V6(bytes), port)
}
func any_v4(port: u16) -> SocketAddr { return addr(v4(0u8, 0u8, 0u8, 0u8), port) }
func any_v6(port: u16) -> SocketAddr {
    var bytes: [16]u8 = zero()
    return addr(V6(bytes), port)
}

// to_wire and from_wire convert between a SocketAddr and the runtime's
// record of 23 bytes.
func to_wire(a: view[SocketAddr], rec: edit[]u8) {
    for i in 0usize..23usize { rec[i] = 0u8 }
    match a.ip {
        V4(b) => {
            rec[0usize] = 4u8
            for i in 0usize..4usize { rec[1usize + i] = b[i] }
        }
        V6(b) => {
            rec[0usize] = 6u8
            for i in 0usize..16usize { rec[1usize + i] = b[i] }
            rec[19usize] = truncate[u8](a.scope >> 24u32)
            rec[20usize] = truncate[u8]((a.scope >> 16u32) & 255u32)
            rec[21usize] = truncate[u8]((a.scope >> 8u32) & 255u32)
            rec[22usize] = truncate[u8](a.scope & 255u32)
        }
    }
    rec[17usize] = truncate[u8](a.port >> 8u32)
    rec[18usize] = truncate[u8](a.port & 255u16)
}
func from_wire(rec: view[]u8) -> SocketAddr {
    port := u16(rec[17usize]) * 256u16 + u16(rec[18usize])
    if rec[0usize] == 6u8 {
        var b: [16]u8 = zero()
        for i in 0usize..16usize { b[i] = rec[1usize + i] }
        scope := ((u32(rec[19usize]) * 256u32 + u32(rec[20usize])) * 256u32 + u32(rec[21usize])) * 256u32 + u32(rec[22usize])
        return addr_scoped(V6(b), port, scope)
    }
    var b: [4]u8 = zero()
    for i in 0usize..4usize { b[i] = rec[1usize + i] }
    return addr(V4(b), port)
}

// number reads a decimal number of 1 to max digits with no sign: its
// value, or None for anything else. With strict set a leading zero is
// refused unless the number is 0 itself.
func number(s: view[]u8, max: usize, strict: bool) -> Option[u32] {
    if len(s) == 0usize || len(s) > max { return None }
    if strict && len(s) > 1usize && s[0usize] == 48u8 { return None }
    var v: u32 = 0u32
    for c in s {
        if c < 48u8 || c > 57u8 { return None }
        v = v * 10u32 + u32(c - 48u8)
    }
    return Some(v)
}

// parse_v4 reads a.b.c.d into dst, four decimal numbers of at most 255
// with no leading zeros: whether the text was one.
func parse_v4(s: view[]u8, dst: edit[]u8) -> bool {
    var part: usize = 0usize
    var start: usize = 0usize
    var i: usize = 0usize
    while i <= len(s) {
        if i == len(s) || s[i] == 46u8 {
            if part == 4usize { return false }
            match number(s[start : i], 3usize, true) {
                Some(v) => {
                    if v > 255u32 { return false }
                    dst[part] = truncate[u8](v)
                }
                None => { return false }
            }
            part = part + 1usize
            start = i + 1usize
        }
        i = i + 1usize
    }
    return part == 4usize
}

// hex is the value of a hexadecimal digit, or 16 for any other byte.
func hex(c: u8) -> u16 {
    if c >= 48u8 && c <= 57u8 { return u16(c - 48u8) }
    if c >= 97u8 && c <= 102u8 { return u16(c - 87u8) }
    if c >= 65u8 && c <= 70u8 { return u16(c - 55u8) }
    return 16u16
}

// parse_v6 reads an IPv6 address in its text form into dst: eight groups
// of one to four hexadecimal digits separated by colons, where one run of
// zero groups may be written `::` and the last two groups may be written
// as an IPv4 address. Whether the text was one.
func parse_v6(s: view[]u8, dst: edit[]u8) -> bool {
    var groups: [8]u16 = zero()
    var count: usize = 0usize
    var gap: usize = 0usize
    var gapped: bool = false
    n := len(s)
    var i: usize = 0usize
    if n >= 2usize && s[0usize] == 58u8 && s[1usize] == 58u8 {
        gapped = true
        i = 2usize
    } else if n >= 1usize && s[0usize] == 58u8 {
        return false
    }
    while i < n {
        // the token runs to the next colon or the end
        var j: usize = i
        var dotted: bool = false
        while j < n && s[j] != 58u8 {
            if s[j] == 46u8 { dotted = true }
            j = j + 1usize
        }
        if dotted {
            // an IPv4 address: the last token, standing for two groups
            var four: [4]u8 = zero()
            if j != n || count > 6usize || !parse_v4(s[i : n], four) { return false }
            groups[count] = u16(four[0usize]) * 256u16 + u16(four[1usize])
            groups[count + 1usize] = u16(four[2usize]) * 256u16 + u16(four[3usize])
            count = count + 2usize
            i = n
        } else {
            if j == i || j - i > 4usize || count == 8usize { return false }
            var v: u16 = 0u16
            for c in s[i : j] {
                d := hex(c)
                if d == 16u16 { return false }
                v = v * 16u16 + d
            }
            groups[count] = v
            count = count + 1usize
            i = j
            if i < n {
                if i + 1usize < n && s[i + 1usize] == 58u8 {
                    if gapped { return false }
                    gapped = true
                    gap = count
                    i = i + 2usize
                } else {
                    i = i + 1usize
                    if i == n { return false }
                }
            }
        }
    }
    var full: [8]u16 = zero()
    if gapped {
        // `::` stands for at least one group
        if count > 7usize { return false }
        for k in 0usize..gap { full[k] = groups[k] }
        for k in gap..count { full[8usize - count + k] = groups[k] }
    } else {
        if count != 8usize { return false }
        full = groups
    }
    for k in 0usize..8usize {
        dst[k * 2usize] = truncate[u8](full[k] >> 8u32)
        dst[k * 2usize + 1usize] = truncate[u8](full[k] & 255u16)
    }
    return true
}

// parse_ip reads an IPv4 address (a.b.c.d) or an IPv6 address (in any of
// its text forms, without brackets).
func parse_ip(text: view[]u8) -> Option[IpAddr] {
    var four: [4]u8 = zero()
    if parse_v4(text, four) { return Some(V4(four)) }
    var sixteen: [16]u8 = zero()
    if parse_v6(text, sixteen) { return Some(V6(sixteen)) }
    return None
}

// parse_scope reads what follows the `%` of a scoped address: an
// interface's index in decimal (1 to 4294967295, no leading zero), or
// the name of one of this machine's interfaces. A zone that is all
// digits is always an index and never looked up as a name. None for
// anything else.
func parse_scope(zone: view[]u8) -> Option[u32] {
    if len(zone) == 0usize { return None }
    var digits: bool = true
    for c in zone {
        if c < 48u8 || c > 57u8 { digits = false }
    }
    if !digits { return interface_index(zone) }
    if len(zone) > 10usize || (len(zone) > 1usize && zone[0usize] == 48u8) { return None }
    var v: u64 = 0u64
    for c in zone { v = v * 10u64 + u64(c - 48u8) }
    if v == 0u64 || v > 4294967295u64 { return None }
    return Some(truncate[u32](v))
}

// parse_addr reads `a.b.c.d:port` or `[v6]:port`; the port is 0 to 65535
// in one to five decimal digits. An IPv6 address may carry a scope,
// `[fe80::1%en0]:port` or `[fe80::1%4]:port`: the name of one of this
// machine's interfaces, or its index.
func parse_addr(text: view[]u8) -> Option[SocketAddr] {
    n := len(text)
    if n == 0usize { return None }
    var host_end: usize = 0usize
    var port_at: usize = 0usize
    var six: bool = false
    if text[0usize] == 91u8 {
        var close: usize = 1usize
        while close < n && text[close] != 93u8 { close = close + 1usize }
        if close + 1usize >= n || text[close + 1usize] != 58u8 { return None }
        six = true
        host_end = close
        port_at = close + 2usize
    } else {
        var colon: usize = 0usize
        while colon < n && text[colon] != 58u8 { colon = colon + 1usize }
        if colon == n { return None }
        host_end = colon
        port_at = colon + 1usize
    }
    var port: u16 = 0u16
    match number(text[port_at : n], 5usize, false) {
        Some(p) => {
            if p > 65535u32 { return None }
            port = truncate[u16](p)
        }
        None => { return None }
    }
    if six {
        var sixteen: [16]u8 = zero()
        var ip_end: usize = 1usize
        while ip_end < host_end && text[ip_end] != 37u8 { ip_end = ip_end + 1usize }
        if !parse_v6(text[1usize : ip_end], sixteen) { return None }
        if ip_end == host_end { return Some(addr(V6(sixteen), port)) }
        match parse_scope(text[ip_end + 1usize : host_end]) {
            Some(scope) => { return Some(addr_scoped(V6(sixteen), port, scope)) }
            None => { return None }
        }
    }
    var four: [4]u8 = zero()
    if !parse_v4(text[0usize : host_end], four) { return None }
    return Some(addr(V4(four), port))
}

// push_number appends v in decimal.
func push_number(dst: edit[Vec[u8]], v: u32) {
    var digits: [10]u8 = zero()
    var n: usize = 0usize
    var x: u32 = v
    while true {
        digits[n] = 48u8 + truncate[u8](x % 10u32)
        n = n + 1usize
        x = x / 10u32
        if x == 0u32 { break }
    }
    while n > 0usize {
        n = n - 1usize
        dst.push(digits[n])
    }
}

// push_v4 appends a.b.c.d.
func push_v4(dst: edit[Vec[u8]], b: view[]u8) {
    for i in 0usize..4usize {
        if i > 0usize { dst.push(46u8) }
        push_number(dst, u32(b[i]))
    }
}

// push_v6 appends an IPv6 address in its canonical text: lowercase, no
// leading zeros, the longest run of two or more zero groups (the first of
// equals) written `::`, and an IPv4-mapped address (::ffff:a.b.c.d) with
// its last two groups as the IPv4 address.
func push_v6(dst: edit[Vec[u8]], b: view[]u8) {
    var groups: [8]u16 = zero()
    for k in 0usize..8usize { groups[k] = u16(b[k * 2usize]) * 256u16 + u16(b[k * 2usize + 1usize]) }
    var mapped: bool = groups[5usize] == 65535u16
    for k in 0usize..5usize {
        if groups[k] != 0u16 { mapped = false }
    }
    var shown: usize = 8usize
    if mapped { shown = 6usize }
    // the longest run of zero groups among those shown
    var best: usize = 0usize
    var best_len: usize = 0usize
    var k: usize = 0usize
    while k < shown {
        if groups[k] == 0u16 {
            var e: usize = k
            while e < shown && groups[e] == 0u16 { e = e + 1usize }
            if e - k > best_len {
                best = k
                best_len = e - k
            }
            k = e
        } else {
            k = k + 1usize
        }
    }
    if best_len < 2usize { best_len = 0usize }
    var g: usize = 0usize
    while g < shown {
        if best_len > 0usize && g == best {
            dst.push(58u8)
            dst.push(58u8)
            g = g + best_len
        } else {
            if g > 0usize && !(best_len > 0usize && g == best + best_len) { dst.push(58u8) }
            // the group in hexadecimal without leading zeros
            var started: bool = false
            for shift in 0u32..4u32 {
                d := truncate[u8]((groups[g] >> (12u32 - shift * 4u32)) & 15u16)
                if d != 0u8 || started || shift == 3u32 {
                    started = true
                    if d < 10u8 { dst.push(48u8 + d) } else { dst.push(87u8 + d) }
                }
            }
            g = g + 1usize
        }
    }
    if mapped {
        if !(best_len > 0usize && best + best_len == 6usize) { dst.push(58u8) }
        push_v4(dst, b[12usize : 16usize])
    }
}

// format_ip is an address as text: a.b.c.d, or an IPv6 address in its
// canonical form.
func format_ip(ip: IpAddr) -> Vec[u8] {
    text := Vec[u8].new()
    match ip {
        V4(b) => { push_v4(text, b) }
        V6(b) => { push_v6(text, b) }
    }
    return text
}

// format_addr is `a.b.c.d:port` or `[v6]:port`, which parse_addr reads
// back; an address with a scope is `[v6%index]:port`.
func format_addr(a: SocketAddr) -> Vec[u8] {
    text := Vec[u8].new()
    match a.ip {
        V4(b) => { push_v4(text, b) }
        V6(b) => {
            text.push(91u8)
            push_v6(text, b)
            if a.scope != 0u32 {
                text.push(37u8)
                push_number(text, a.scope)
            }
            text.push(93u8)
        }
    }
    text.push(58u8)
    push_number(text, u32(a.port))
    return text
}

// resolve asks the system resolver for the addresses of a host name (or
// of an address written as text), each joined with port, in the
// resolver's order and without repeats. A name the resolver does not know
// is an error of kind NotFound.
func resolve(host: view[]u8, port: u16) -> Result[Vec[SocketAddr], io.IoErr] {
    buf := Vec[u8].new()
    buf.resize(368usize, 0u8)
    while true {
        var n: i64 = 0i64
        with e := buf.as_edit() { n = net_resolve(host, port, e) }
        if n < 0i64 { return Err(io.neg(n)) }
        if usize(n) <= buf.len() {
            list := Vec[SocketAddr].new()
            with b := buf.as_view() {
                var at: usize = 0usize
                while at + 23usize <= usize(n) {
                    // a record the list already has is the same address again
                    var seen: bool = false
                    var prev: usize = 0usize
                    while prev < at && !seen {
                        var same: bool = true
                        for k in 0usize..23usize {
                            if b[prev + k] != b[at + k] { same = false }
                        }
                        seen = same
                        prev = prev + 23usize
                    }
                    if !seen { list.push(from_wire(b[at : at + 23usize])) }
                    at = at + 23usize
                }
            }
            return Ok(list)
        }
        buf.resize(usize(n), 0u8)
    }
    return Err(io.error_of(io.ErrKind.Other))
}

// sock_addr reads a socket's own address, or its peer's.
func sock_addr(fd: i32, peer: bool) -> Result[SocketAddr, io.IoErr] {
    var rec: [23]u8 = zero()
    r := net_addr(fd, peer, rec)
    if r < 0i32 { return Err(io.err_of(0i32 - r)) }
    return Ok(from_wire(rec))
}

// ---- socket options (RM4) ----

// The options a socket carries are set and read through methods of the
// socket types; these are what they share. A size or a limit the system
// cannot give is its error (kind InvalidInput), and the system may give a
// buffer larger than asked: the reading methods return what it gave.

func opt_set(fd: i32, opt: i32, value: i64) -> Result[(), io.IoErr] { return io.status(net_set_opt(fd, opt, value)) }
func opt_get(fd: i32, opt: i32) -> Result[i64, io.IoErr] {
    r := net_get_opt(fd, opt)
    if r < 0i64 - 1i64 { return Err(io.neg(r + 1i64)) }
    return Ok(r)
}
func opt_flag(fd: i32, opt: i32) -> Result[bool, io.IoErr] {
    v := opt_get(fd, opt)?
    return Ok(v != 0i64)
}
func opt_set_flag(fd: i32, opt: i32, on: bool) -> Result[(), io.IoErr] {
    var v: i64 = 0i64
    if on { v = 1i64 }
    return opt_set(fd, opt, v)
}
// opt_set_hops sets the hop limit, 1 to 255 on every system.
func opt_set_hops(fd: i32, hops: u32) -> Result[(), io.IoErr] {
    if hops == 0u32 || hops > 255u32 { return Err(io.error_of(io.ErrKind.InvalidInput)) }
    return opt_set(fd, 5i32, i64(hops))
}
func opt_count(fd: i32, opt: i32) -> Result[u32, io.IoErr] {
    v := opt_get(fd, opt)?
    if v < 0i64 || v > 4294967295i64 { return Err(io.error_of(io.ErrKind.Other)) }
    return Ok(truncate[u32](u64(v)))
}

// ---- readiness (RN1) ----

// Source is a socket a Poller can watch and a UnixStream can send: every
// socket type of this module. descriptor is the system's number for it,
// which the socket still owns.
interface Source {
    func descriptor(view self) -> i32
}

// Ready is one watched socket that can be read or written without
// waiting. token is what the program gave when it asked for the socket to
// be watched. readable: a read returns at once, with bytes, a connection
// (for a listener) or the end of the stream. writable: a write takes at
// least one byte at once. closed: the peer has closed its end, or its
// sending side; what it sent before can still be read. failed: the
// socket has an error, which the next read or write returns.
struct Ready { token: u64; readable: bool; writable: bool; closed: bool; failed: bool }

// Poller waits for any of many sockets, so that one thread can serve
// them all: watch each socket under a token, wait, and read or write
// those the wait names. Readiness is a state, not an event: a socket
// that is readable is reported by every wait until the program has read
// what is there. The calls of this module go on blocking, so after a
// wait a program reads once per report, or uses the `_timeout` forms
// with a duration of zero, which never wait.
//
// A socket that is closed stops being watched. A Poller may move to
// another thread but waits on one thread at a time; to wake a waiting
// thread from another, watch one end of UnixStream.pair() and write a
// byte to the other.
struct Poller nocopy { fd: i32 }

impl Poller {
    func new() -> Result[Poller, io.IoErr] {
        fd := net_poller_new()
        if fd < 0i32 { return Err(io.err_of(0i32 - fd)) }
        return Ok(Poller { fd: fd })
    }

    // watch asks for s to be reported when it is readable, writable or
    // either, under token; for a socket already watched it replaces what
    // was asked and the token. Neither readable nor writable is an error
    // of kind InvalidInput.
    func watch[S: Source](edit self, s: view[S], token: u64, readable: bool, writable: bool) -> Result[(), io.IoErr] {
        var interest: i32 = 0i32
        if readable { interest = interest + 1i32 }
        if writable { interest = interest + 2i32 }
        if interest == 0i32 { return Err(io.error_of(io.ErrKind.InvalidInput)) }
        return io.status(net_poller_set(self.fd, s.descriptor(), token, interest))
    }

    // unwatch stops the reports of s: kind NotFound when it was not
    // watched.
    func unwatch[S: Source](edit self, s: view[S]) -> Result[(), io.IoErr] {
        return io.status(net_poller_set(self.fd, s.descriptor(), 0u64, 0i32))
    }

    // wait blocks until at least one watched socket is ready, replaces
    // the contents of into with the reports (at most 64 a call; the rest
    // come with the next) and returns how many there are.
    func wait(edit self, into: edit[Vec[Ready]]) -> Result[usize, io.IoErr] { return self.collect(into, 0u64, false) }

    // wait_timeout is wait for at most d: 0 reports when none was ready
    // in that time. A duration of zero looks once.
    func wait_timeout(edit self, into: edit[Vec[Ready]], d: time.Duration) -> Result[usize, io.IoErr] { return self.collect(into, d.ns, true) }

    func collect(edit self, into: edit[Vec[Ready]], ns: u64, timed: bool) -> Result[usize, io.IoErr] {
        into.clear()
        var raw: [128]u64 = zero()
        n := net_poller_wait(self.fd, raw, ns, timed)
        if n < 0i64 { return Err(io.neg(n)) }
        for k in 0usize..usize(n) {
            f := raw[k * 2usize + 1usize]
            into.push(Ready { token: raw[k * 2usize], readable: f & 1u64 != 0u64, writable: f & 2u64 != 0u64, closed: f & 4u64 != 0u64, failed: f & 8u64 != 0u64 })
        }
        return Ok(usize(n))
    }

    destructor(edit self) {
        if self.fd >= 0i32 { r := net_close(self.fd) }
    }
}

impl Source for TcpListener { func descriptor(view self) -> i32 { return self.fd } }
impl Source for TcpStream { func descriptor(view self) -> i32 { return self.fd } }
impl Source for UdpSocket { func descriptor(view self) -> i32 { return self.fd } }
impl Source for UnixListener { func descriptor(view self) -> i32 { return self.fd } }
impl Source for UnixStream { func descriptor(view self) -> i32 { return self.fd } }
impl Source for UnixDatagram { func descriptor(view self) -> i32 { return self.fd } }
// A signal.Signals is a Source too, so that one wait serves sockets and
// signals: watched for reading, it is reported when a signal it has
// caught has arrived. The program then calls try_next until it is None;
// a report may come once more after the last signal was taken. Watching
// it for writing is InvalidInput. Its descriptor is the process's and
// outlives the Signals: unwatch it before destroying the Signals, or the
// watch reports the next Signals' arrivals under its old token.
impl Source for signal.Signals { func descriptor(view self) -> i32 { return signal.signal_fd() } }

// ---- TCP (RH2) ----

// TcpListener is a socket that accepts connections on an address. It is
// closed when it is destroyed.
struct TcpListener nocopy { fd: i32 }

impl TcpListener {
    // bind makes a listener on addr, with address reuse on (a server may
    // be restarted on its port at once) and a queue of 128 connections
    // waiting to be accepted.
    func bind(addr: SocketAddr) -> Result[TcpListener, io.IoErr] { return TcpListener.bind_with_backlog(addr, 128u32) }

    // bind_with_backlog is bind with a queue of the given length; what
    // the system does with a connection beyond it is the system's choice.
    func bind_with_backlog(addr: SocketAddr, backlog: u32) -> Result[TcpListener, io.IoErr] {
        var rec: [23]u8 = zero()
        to_wire(addr, rec)
        var queue: u32 = backlog
        if queue > 65535u32 { queue = 65535u32 }
        fd := net_tcp_listen(rec, truncate[i32](queue))
        if fd < 0i32 { return Err(io.err_of(0i32 - fd)) }
        return Ok(TcpListener { fd: fd })
    }

    // accept waits for the next connection.
    func accept(edit self) -> Result[TcpStream, io.IoErr] {
        r := net_accept(self.fd, 0u64, false)
        if r < 0i64 { return Err(io.neg(r)) }
        return Ok(TcpStream { fd: truncate[i32](r) })
    }

    // accept_timeout is accept waiting at most d: None when no connection
    // arrived in that time. A duration of zero looks once.
    func accept_timeout(edit self, d: time.Duration) -> Result[Option[TcpStream], io.IoErr] {
        r := net_accept(self.fd, d.ns, true)
        if r == io.timed_out() { return Ok(None) }
        if r < 0i64 { return Err(io.neg(r)) }
        return Ok(Some(TcpStream { fd: truncate[i32](r) }))
    }

    // local_addr is the address the listener is bound to: the way to
    // learn the port the system chose for port 0.
    func local_addr(view self) -> Result[SocketAddr, io.IoErr] { return sock_addr(self.fd, false) }

    destructor(edit self) {
        if self.fd >= 0i32 { r := net_close(self.fd) }
    }
}

// Shutdown names the direction TcpStream.shutdown ends.
union Shutdown { Read; Write; Both }

// TcpStream is one end of a connection: an io.Reader and an io.Writer.
// It is closed when it is destroyed.
struct TcpStream nocopy { fd: i32 }

impl io.Reader for TcpStream {
    // read receives at most len(buf) bytes and returns how many: 0 when
    // the peer has closed its end, or for an empty buf.
    func read(edit self, buf: edit[]u8) -> Result[usize, io.IoErr] {
        r := net_recv(self.fd, buf, 0u64, false)
        if r < 0i64 { return Err(io.neg(r)) }
        return Ok(usize(r))
    }
}

impl io.Writer for TcpStream {
    // write sends at most len(data) bytes and returns how many the system
    // took, waiting while its buffer is full.
    func write(edit self, data: view[]u8) -> Result[usize, io.IoErr] {
        r := net_send(self.fd, data)
        if r < 0i64 { return Err(io.neg(r)) }
        return Ok(usize(r))
    }
    // flush does nothing: a stream has no buffer on this side of the
    // system's.
    func flush(edit self) -> Result[(), io.IoErr] { return Ok(()) }
}

impl TcpStream {
    // connect makes a connection to addr.
    func connect(addr: SocketAddr) -> Result[TcpStream, io.IoErr] {
        var rec: [23]u8 = zero()
        to_wire(addr, rec)
        r := net_connect(rec, 0u64, false)
        if r < 0i64 { return Err(io.neg(r)) }
        return Ok(TcpStream { fd: truncate[i32](r) })
    }

    // connect_timeout is connect waiting at most d: None when the
    // connection was not made in that time, and the attempt is then
    // given up. A duration of zero starts the attempt and returns None
    // unless it succeeded at once.
    func connect_timeout(addr: SocketAddr, d: time.Duration) -> Result[Option[TcpStream], io.IoErr] {
        var rec: [23]u8 = zero()
        to_wire(addr, rec)
        r := net_connect(rec, d.ns, true)
        if r == io.timed_out() { return Ok(None) }
        if r < 0i64 { return Err(io.neg(r)) }
        return Ok(Some(TcpStream { fd: truncate[i32](r) }))
    }

    // read_timeout is read waiting at most d for bytes: Some(n) for n
    // bytes (0 when the peer has closed its end, or for an empty buf),
    // None when none arrived in that time. A duration of zero looks once.
    func read_timeout(edit self, buf: edit[]u8, d: time.Duration) -> Result[Option[usize], io.IoErr] {
        r := net_recv(self.fd, buf, d.ns, true)
        if r == io.timed_out() { return Ok(None) }
        if r < 0i64 { return Err(io.neg(r)) }
        return Ok(Some(usize(r)))
    }

    // write_all sends all of data.
    func write_all(edit self, data: view[]u8) -> Result[(), io.IoErr] {
        var off: usize = 0usize
        while off < len(data) {
            r := net_send(self.fd, data[off : len(data)])
            if r < 0i64 { return Err(io.neg(r)) }
            off = off + usize(r)
        }
        return Ok(())
    }

    // write_timeout sends what the socket will take of data, waiting at
    // most d for it to take any: Some(n) for the first n bytes (the rest
    // is not sent), None when it took none in that time. A duration of
    // zero offers the bytes once and never waits, which is how a thread
    // that serves many connections writes: what is left is kept, and the
    // socket watched for writing in a Poller.
    func write_timeout(edit self, data: view[]u8, d: time.Duration) -> Result[Option[usize], io.IoErr] {
        r := net_send_timeout(self.fd, data, d.ns)
        if r == io.timed_out() { return Ok(None) }
        if r < 0i64 { return Err(io.neg(r)) }
        return Ok(Some(usize(r)))
    }

    // shutdown ends one direction, or both, without closing the socket:
    // after Write the peer reads the end of the stream, and this side can
    // still read what the peer sends.
    func shutdown(edit self, how: Shutdown) -> Result[(), io.IoErr] {
        var n: i32 = 2i32
        match how {
            Read => { n = 0i32 }
            Write => { n = 1i32 }
            Both => { n = 2i32 }
        }
        return io.status(net_shutdown(self.fd, n))
    }

    // set_nodelay turns the delay of small writes (Nagle's algorithm) off
    // or back on; nodelay is whether it is off.
    func set_nodelay(edit self, on: bool) -> Result[(), io.IoErr] { return io.status(net_set_nodelay(self.fd, on)) }
    func nodelay(view self) -> Result[bool, io.IoErr] { return opt_flag(self.fd, 7i32) }

    // set_keepalive has the system probe a connection that has been idle
    // (after a time that is the system's setting), so that a peer that
    // vanished is found out: a read then fails instead of waiting forever.
    func set_keepalive(edit self, on: bool) -> Result[(), io.IoErr] { return opt_set_flag(self.fd, 1i32, on) }
    func keepalive(view self) -> Result[bool, io.IoErr] { return opt_flag(self.fd, 1i32) }

    // set_recv_buffer and set_send_buffer ask for the system's buffers of
    // received and unsent bytes to be of a size; recv_buffer and
    // send_buffer are the sizes it gave.
    func set_recv_buffer(edit self, bytes: u32) -> Result[(), io.IoErr] { return opt_set(self.fd, 2i32, i64(bytes)) }
    func recv_buffer(view self) -> Result[u32, io.IoErr] { return opt_count(self.fd, 2i32) }
    func set_send_buffer(edit self, bytes: u32) -> Result[(), io.IoErr] { return opt_set(self.fd, 3i32, i64(bytes)) }
    func send_buffer(view self) -> Result[u32, io.IoErr] { return opt_count(self.fd, 3i32) }

    // set_hop_limit sets how many routers what this socket sends may
    // pass (IPv4's time to live, IPv6's hop limit), 1 to 255: kind
    // InvalidInput for any other number.
    func set_hop_limit(edit self, hops: u32) -> Result[(), io.IoErr] { return opt_set_hops(self.fd, hops) }
    func hop_limit(view self) -> Result[u32, io.IoErr] { return opt_count(self.fd, 5i32) }

    // set_linger decides what closing the stream does with bytes not yet
    // sent: with Some(seconds) the close waits at most that long for
    // them to be sent and then drops the connection (Some(0) drops it at
    // once, and the peer sees a reset); with None, the default, the close
    // returns at once and the system goes on sending.
    func set_linger(edit self, seconds: Option[u32]) -> Result[(), io.IoErr] {
        match seconds {
            Some(n) => { return opt_set(self.fd, 6i32, i64(n)) }
            None => { return opt_set(self.fd, 6i32, 0i64 - 1i64) }
        }
    }
    func linger(view self) -> Result[Option[u32], io.IoErr] {
        v := opt_get(self.fd, 6i32)?
        if v < 0i64 { return Ok(None) }
        return Ok(Some(truncate[u32](u64(v))))
    }

    // peer_addr and local_addr are the addresses of the two ends.
    func peer_addr(view self) -> Result[SocketAddr, io.IoErr] { return sock_addr(self.fd, true) }
    func local_addr(view self) -> Result[SocketAddr, io.IoErr] { return sock_addr(self.fd, false) }

    destructor(edit self) {
        if self.fd >= 0i32 { r := net_close(self.fd) }
    }
}

// ---- Unix-domain sockets (RL1) ----

// A Unix-domain socket is named by a path in the file system and joins
// programs on one machine. The path is at most 103 bytes. bind creates
// it and fails with kind AddrInUse when it exists; nothing removes it
// but the program (io.remove_file), before the next bind.
//
// On Linux a socket may instead have a name in the abstract namespace,
// which is in no file system, needs no removal and is gone when the
// socket is closed: wherever this module takes a path, a path whose
// first byte is zero ("\x00name") is such a name, made of the bytes
// after it (at least one, none of them zero). macOS has no such
// namespace: the same call there is an error of kind Unsupported.

// UnixListener accepts connections made to a path.
struct UnixListener nocopy { fd: i32 }

impl UnixListener {
    func bind(path: view[]u8) -> Result[UnixListener, io.IoErr] { return UnixListener.bind_with_backlog(path, 128u32) }

    func bind_with_backlog(path: view[]u8, backlog: u32) -> Result[UnixListener, io.IoErr] {
        var queue: u32 = backlog
        if queue > 65535u32 { queue = 65535u32 }
        fd := net_unix_listen(path, truncate[i32](queue))
        if fd < 0i32 { return Err(io.err_of(0i32 - fd)) }
        return Ok(UnixListener { fd: fd })
    }

    // accept waits for the next connection; accept_timeout waits at most
    // d and returns None when none arrived.
    func accept(edit self) -> Result[UnixStream, io.IoErr] {
        r := net_accept(self.fd, 0u64, false)
        if r < 0i64 { return Err(io.neg(r)) }
        return Ok(UnixStream { fd: truncate[i32](r) })
    }
    func accept_timeout(edit self, d: time.Duration) -> Result[Option[UnixStream], io.IoErr] {
        r := net_accept(self.fd, d.ns, true)
        if r == io.timed_out() { return Ok(None) }
        if r < 0i64 { return Err(io.neg(r)) }
        return Ok(Some(UnixStream { fd: truncate[i32](r) }))
    }

    destructor(edit self) {
        if self.fd >= 0i32 { r := net_close(self.fd) }
    }
}

// UnixStream is one end of a Unix-domain connection: an io.Reader and an
// io.Writer, with TcpStream's reading, writing and shutdown.
struct UnixStream nocopy { fd: i32 }

// UnixPair is two streams connected to each other. It is a union of one
// variant so that a match takes both ends out of it:
// `match net.UnixStream.pair()? { Ends(a, b) => { ... } }`.
union UnixPair { Ends(UnixStream, UnixStream) }

// Credentials are the user, the group and the process at the other end
// of a Unix-domain stream; process is 0 where the system does not say.
struct Credentials { user: u32; group: u32; process: u32 }

// Descriptor is an open file or socket that another program sent
// (UnixStream.recv_with), before this program has said what it is. kind
// asks the system; an `into_` method makes it the type named, and fails
// with kind InvalidInput when it is not that (the descriptor is then
// closed, as it is when a Descriptor is destroyed unused).
struct Descriptor nocopy { fd: i32 }

// DescriptorKind is what the system says a descriptor is. Other is a
// socket of a sort this module has no type for.
union DescriptorKind { File; TcpStream; TcpListener; UdpSocket; UnixStream; UnixListener; UnixDatagram; Other }

// Received is what recv_with read: the number of bytes (0 when the peer
// has closed its end), alone or with the descriptor that came with them.
// It is a union so that a match takes the descriptor out of it:
// `match s.recv_with(buf)? { Bytes(n) => { ... } WithDescriptor(n, d) => { ... } }`.
union Received { Bytes(usize); WithDescriptor(usize, Descriptor) }

func received(n: usize, fd: i32) -> Received {
    if fd < 0i32 { return Bytes(n) }
    return WithDescriptor(n, Descriptor { fd: fd })
}

impl Descriptor {
    func kind(view self) -> Result[DescriptorKind, io.IoErr] {
        k := net_fd_kind(self.fd)
        if k < 0i32 { return Err(io.err_of(0i32 - k)) }
        if k == 1i32 { return Ok(DescriptorKind.File) }
        if k == 2i32 { return Ok(DescriptorKind.TcpStream) }
        if k == 3i32 { return Ok(DescriptorKind.TcpListener) }
        if k == 4i32 { return Ok(DescriptorKind.UdpSocket) }
        if k == 5i32 { return Ok(DescriptorKind.UnixStream) }
        if k == 6i32 { return Ok(DescriptorKind.UnixListener) }
        if k == 7i32 { return Ok(DescriptorKind.UnixDatagram) }
        return Ok(DescriptorKind.Other)
    }

    // adopt readies the descriptor as the kind numbered and gives it up:
    // the caller wraps what it returns.
    func adopt(own self, kind: i32) -> Result[i32, io.IoErr] {
        r := net_fd_adopt(self.fd, kind)
        if r < 0i32 { return Err(io.err_of(0i32 - r)) }
        self.fd = 0i32 - 1i32
        return Ok(r)
    }

    // into_file is the descriptor as an io.File, which has the offset and
    // the access the sender's open file has: the two share one open file.
    func into_file(own self) -> Result[io.File, io.IoErr] {
        fd := self.adopt(1i32)?
        return Ok(io.file_of(fd))
    }
    func into_tcp_stream(own self) -> Result[TcpStream, io.IoErr] {
        fd := self.adopt(2i32)?
        return Ok(TcpStream { fd: fd })
    }
    func into_tcp_listener(own self) -> Result[TcpListener, io.IoErr] {
        fd := self.adopt(3i32)?
        return Ok(TcpListener { fd: fd })
    }
    func into_udp_socket(own self) -> Result[UdpSocket, io.IoErr] {
        fd := self.adopt(4i32)?
        return Ok(UdpSocket { fd: fd })
    }
    func into_unix_stream(own self) -> Result[UnixStream, io.IoErr] {
        fd := self.adopt(5i32)?
        return Ok(UnixStream { fd: fd })
    }
    func into_unix_listener(own self) -> Result[UnixListener, io.IoErr] {
        fd := self.adopt(6i32)?
        return Ok(UnixListener { fd: fd })
    }
    func into_unix_datagram(own self) -> Result[UnixDatagram, io.IoErr] {
        fd := self.adopt(7i32)?
        return Ok(UnixDatagram { fd: fd })
    }

    destructor(edit self) {
        if self.fd >= 0i32 { r := net_close(self.fd) }
    }
}

// unix_recv reads from a Unix-domain stream and closes a descriptor that
// came with the bytes. A read that gave it no room would leave it to the
// system, and not every system closes it: some open it in this process
// first, where nothing would name it again.
func unix_recv(fd: i32, buf: edit[]u8, ns: u64, timed: bool) -> i64 {
    if len(buf) == 0usize { return net_recv(fd, buf, ns, timed) }
    var got: [1]i32 = zero()
    got[0usize] = 0i32 - 1i32 // none, should the receive fail before it says so
    r := net_recv_fd(fd, buf, got, ns, timed)
    if r >= 0i64 && got[0usize] >= 0i32 { c := net_close(got[0usize]) }
    return r
}

impl io.Reader for UnixStream {
    func read(edit self, buf: edit[]u8) -> Result[usize, io.IoErr] {
        r := unix_recv(self.fd, buf, 0u64, false)
        if r < 0i64 { return Err(io.neg(r)) }
        return Ok(usize(r))
    }
}

impl io.Writer for UnixStream {
    func write(edit self, data: view[]u8) -> Result[usize, io.IoErr] {
        r := net_send(self.fd, data)
        if r < 0i64 { return Err(io.neg(r)) }
        return Ok(usize(r))
    }
    func flush(edit self) -> Result[(), io.IoErr] { return Ok(()) }
}

impl UnixStream {
    // connect makes a connection to the listener at path;
    // connect_timeout waits at most d for a listener whose queue is full.
    func connect(path: view[]u8) -> Result[UnixStream, io.IoErr] {
        r := net_unix_connect(path, 0u64, false)
        if r < 0i64 { return Err(io.neg(r)) }
        return Ok(UnixStream { fd: truncate[i32](r) })
    }
    func connect_timeout(path: view[]u8, d: time.Duration) -> Result[Option[UnixStream], io.IoErr] {
        r := net_unix_connect(path, d.ns, true)
        if r == io.timed_out() { return Ok(None) }
        if r < 0i64 { return Err(io.neg(r)) }
        return Ok(Some(UnixStream { fd: truncate[i32](r) }))
    }

    // pair makes two streams connected to each other, with no path: what
    // one writes the other reads.
    func pair() -> Result[UnixPair, io.IoErr] {
        var fds: [2]i32 = zero()
        r := net_unix_pair(fds)
        if r < 0i32 { return Err(io.err_of(0i32 - r)) }
        return Ok(Ends(UnixStream { fd: fds[0usize] }, UnixStream { fd: fds[1usize] }))
    }

    func read_timeout(edit self, buf: edit[]u8, d: time.Duration) -> Result[Option[usize], io.IoErr] {
        r := unix_recv(self.fd, buf, d.ns, true)
        if r == io.timed_out() { return Ok(None) }
        if r < 0i64 { return Err(io.neg(r)) }
        return Ok(Some(usize(r)))
    }

    func write_all(edit self, data: view[]u8) -> Result[(), io.IoErr] {
        var off: usize = 0usize
        while off < len(data) {
            r := net_send(self.fd, data[off : len(data)])
            if r < 0i64 { return Err(io.neg(r)) }
            off = off + usize(r)
        }
        return Ok(())
    }

    // write_timeout sends what the socket will take of data, waiting at
    // most d for it to take any: Some(n) for the first n bytes (the rest
    // is not sent), None when it took none in that time. A duration of
    // zero offers the bytes once and never waits, which is how a thread
    // that serves many connections writes: what is left is kept, and the
    // socket watched for writing in a Poller.
    func write_timeout(edit self, data: view[]u8, d: time.Duration) -> Result[Option[usize], io.IoErr] {
        r := net_send_timeout(self.fd, data, d.ns)
        if r == io.timed_out() { return Ok(None) }
        if r < 0i64 { return Err(io.neg(r)) }
        return Ok(Some(usize(r)))
    }

    func shutdown(edit self, how: Shutdown) -> Result[(), io.IoErr] {
        var n: i32 = 2i32
        match how {
            Read => { n = 0i32 }
            Write => { n = 1i32 }
            Both => { n = 2i32 }
        }
        return io.status(net_shutdown(self.fd, n))
    }

    // peer_credentials is who the other end was when the connection was
    // made (or the pair): the system's own record, which the peer cannot
    // forge.
    func peer_credentials(view self) -> Result[Credentials, io.IoErr] {
        var raw: [3]u32 = zero()
        r := net_peer_cred(self.fd, raw)
        if r < 0i32 { return Err(io.err_of(0i32 - r)) }
        return Ok(Credentials { user: raw[0usize], group: raw[1usize], process: raw[2usize] })
    }

    // send_with sends at most len(data) bytes, at least one, with an open
    // socket of this program attached, and returns how many bytes the
    // system took; send_file attaches an open file. The descriptor
    // travels with the first byte: the receiver gets a descriptor of its
    // own for the same open socket or file, and this program keeps its.
    // Keep it until the receiver has taken the descriptor (an answer on
    // this stream says so): on macOS a socket closed here while it is
    // still in flight can arrive already at its end, with what its peer
    // wrote lost.
    // Empty data is an error of kind InvalidInput.
    func send_with[S: Source](edit self, data: view[]u8, pass: view[S]) -> Result[usize, io.IoErr] {
        r := net_send_fd(self.fd, data, pass.descriptor())
        if r < 0i64 { return Err(io.neg(r)) }
        return Ok(usize(r))
    }
    func send_file(edit self, data: view[]u8, pass: view[io.File]) -> Result[usize, io.IoErr] {
        r := net_send_fd(self.fd, data, pass.raw_fd())
        if r < 0i64 { return Err(io.neg(r)) }
        return Ok(usize(r))
    }

    // recv_with is read that also takes a descriptor sent with the
    // bytes it reads; recv_with_timeout waits at most d and returns None
    // when nothing arrived. A read by any other method drops a descriptor
    // that came with its bytes (it is closed, not leaked), and so is
    // every descriptor after the first that one call receives. An empty
    // buf is an error of kind InvalidInput.
    func recv_with(edit self, buf: edit[]u8) -> Result[Received, io.IoErr] {
        var got: [1]i32 = zero()
        r := net_recv_fd(self.fd, buf, got, 0u64, false)
        if r < 0i64 { return Err(io.neg(r)) }
        return Ok(received(usize(r), got[0usize]))
    }
    func recv_with_timeout(edit self, buf: edit[]u8, d: time.Duration) -> Result[Option[Received], io.IoErr] {
        var got: [1]i32 = zero()
        r := net_recv_fd(self.fd, buf, got, d.ns, true)
        if r == io.timed_out() { return Ok(None) }
        if r < 0i64 { return Err(io.neg(r)) }
        return Ok(Some(received(usize(r), got[0usize])))
    }

    // The buffers, as TcpStream's.
    func set_recv_buffer(edit self, bytes: u32) -> Result[(), io.IoErr] { return opt_set(self.fd, 2i32, i64(bytes)) }
    func recv_buffer(view self) -> Result[u32, io.IoErr] { return opt_count(self.fd, 2i32) }
    func set_send_buffer(edit self, bytes: u32) -> Result[(), io.IoErr] { return opt_set(self.fd, 3i32, i64(bytes)) }
    func send_buffer(view self) -> Result[u32, io.IoErr] { return opt_count(self.fd, 3i32) }

    destructor(edit self) {
        if self.fd >= 0i32 { r := net_close(self.fd) }
    }
}

// ---- UDP (RH3) ----

// Datagram is what recv_from received: the number of bytes it put in the
// buffer and the address they came from.
struct Datagram { len: usize; from: SocketAddr }

// UdpSocket sends and receives datagrams. It is closed when it is
// destroyed.
struct UdpSocket nocopy { fd: i32 }

impl UdpSocket {
    // bind makes a socket on addr.
    func bind(addr: SocketAddr) -> Result[UdpSocket, io.IoErr] {
        var rec: [23]u8 = zero()
        to_wire(addr, rec)
        fd := net_udp_bind(rec)
        if fd < 0i32 { return Err(io.err_of(0i32 - fd)) }
        return Ok(UdpSocket { fd: fd })
    }

    // send_to sends data as one datagram to an address and returns its
    // length.
    func send_to(edit self, data: view[]u8, to: SocketAddr) -> Result[usize, io.IoErr] {
        var rec: [23]u8 = zero()
        to_wire(to, rec)
        r := net_send_to(self.fd, data, rec)
        if r < 0i64 { return Err(io.neg(r)) }
        return Ok(usize(r))
    }

    // recv_from waits for one datagram and puts it in buf; a datagram
    // longer than buf is cut to it and the rest is lost.
    func recv_from(edit self, buf: edit[]u8) -> Result[Datagram, io.IoErr] {
        var rec: [23]u8 = zero()
        r := net_recv_from(self.fd, buf, rec, 0u64, false)
        if r < 0i64 { return Err(io.neg(r)) }
        return Ok(Datagram { len: usize(r), from: from_wire(rec) })
    }

    // recv_from_timeout is recv_from waiting at most d: None when no
    // datagram arrived in that time. A duration of zero looks once.
    func recv_from_timeout(edit self, buf: edit[]u8, d: time.Duration) -> Result[Option[Datagram], io.IoErr] {
        var rec: [23]u8 = zero()
        r := net_recv_from(self.fd, buf, rec, d.ns, true)
        if r == io.timed_out() { return Ok(None) }
        if r < 0i64 { return Err(io.neg(r)) }
        return Ok(Some(Datagram { len: usize(r), from: from_wire(rec) }))
    }

    // local_addr is the address the socket is bound to.
    func local_addr(view self) -> Result[SocketAddr, io.IoErr] { return sock_addr(self.fd, false) }

    // set_broadcast permits sending to a broadcast address
    // (255.255.255.255, or a network's), which is otherwise an error of
    // kind Permission.
    func set_broadcast(edit self, on: bool) -> Result[(), io.IoErr] { return opt_set_flag(self.fd, 4i32, on) }
    func broadcast(view self) -> Result[bool, io.IoErr] { return opt_flag(self.fd, 4i32) }

    // The buffers and the hop limit, as TcpStream's. A datagram that
    // arrives when the receive buffer is full is lost.
    func set_recv_buffer(edit self, bytes: u32) -> Result[(), io.IoErr] { return opt_set(self.fd, 2i32, i64(bytes)) }
    func recv_buffer(view self) -> Result[u32, io.IoErr] { return opt_count(self.fd, 2i32) }
    func set_send_buffer(edit self, bytes: u32) -> Result[(), io.IoErr] { return opt_set(self.fd, 3i32, i64(bytes)) }
    func send_buffer(view self) -> Result[u32, io.IoErr] { return opt_count(self.fd, 3i32) }
    func set_hop_limit(edit self, hops: u32) -> Result[(), io.IoErr] { return opt_set_hops(self.fd, hops) }
    func hop_limit(view self) -> Result[u32, io.IoErr] { return opt_count(self.fd, 5i32) }

    destructor(edit self) {
        if self.fd >= 0i32 { r := net_close(self.fd) }
    }
}

// ---- Unix-domain datagrams (RM3) ----

// UnixMessage is what UnixDatagram.recv_from received: the number of
// bytes it put in the buffer and the path of the socket that sent them,
// empty when that socket is not bound to one. A sender that another
// program bound to a path longer than this library allows (104 bytes or
// more) is reported by the first 104 bytes of its path.
struct UnixMessage { len: usize; from: Vec[u8] }

// UnixDatagram sends and receives datagrams between programs on one
// machine, each addressed to the path of a bound socket. Unlike UDP's, a
// datagram here is not lost on the way: send_to waits while the
// receiver's queue is full. It is closed when it is destroyed; the path
// of a bound socket is the program's to remove.
struct UnixDatagram nocopy { fd: i32 }

impl UnixDatagram {
    // bind makes a socket that receives what is sent to path, creating
    // the path: kind AddrInUse when it exists.
    func bind(path: view[]u8) -> Result[UnixDatagram, io.IoErr] {
        if len(path) == 0usize { return Err(io.error_of(io.ErrKind.InvalidInput)) }
        fd := net_unix_dgram(path)
        if fd < 0i32 { return Err(io.err_of(0i32 - fd)) }
        return Ok(UnixDatagram { fd: fd })
    }

    // unbound makes a socket with no path: it can send, and a receiver
    // sees an empty sender's path, so nothing can be sent back to it.
    func unbound() -> Result[UnixDatagram, io.IoErr] {
        fd := net_unix_dgram("")
        if fd < 0i32 { return Err(io.err_of(0i32 - fd)) }
        return Ok(UnixDatagram { fd: fd })
    }

    // send_to sends data as one datagram to the socket bound to path and
    // returns its length: kind NotFound when nothing is at the path,
    // ConnectionRefused when no socket is bound to it any more.
    func send_to(edit self, data: view[]u8, path: view[]u8) -> Result[usize, io.IoErr] {
        r := net_unix_send_to(self.fd, data, path)
        if r < 0i64 { return Err(io.neg(r)) }
        return Ok(usize(r))
    }

    // recv_from waits for one datagram and puts it in buf; a datagram
    // longer than buf is cut to it and the rest is lost.
    func recv_from(edit self, buf: edit[]u8) -> Result[UnixMessage, io.IoErr] {
        var from: [108]u8 = zero()
        r := net_unix_recv_from(self.fd, buf, from, 0u64, false)
        if r < 0i64 { return Err(io.neg(r)) }
        return Ok(UnixMessage { len: usize(r), from: sender(from) })
    }

    // recv_from_timeout is recv_from waiting at most d: None when no
    // datagram arrived in that time. A duration of zero looks once.
    func recv_from_timeout(edit self, buf: edit[]u8, d: time.Duration) -> Result[Option[UnixMessage], io.IoErr] {
        var from: [108]u8 = zero()
        r := net_unix_recv_from(self.fd, buf, from, d.ns, true)
        if r == io.timed_out() { return Ok(None) }
        if r < 0i64 { return Err(io.neg(r)) }
        return Ok(Some(UnixMessage { len: usize(r), from: sender(from) }))
    }

    func set_recv_buffer(edit self, bytes: u32) -> Result[(), io.IoErr] { return opt_set(self.fd, 2i32, i64(bytes)) }
    func recv_buffer(view self) -> Result[u32, io.IoErr] { return opt_count(self.fd, 2i32) }
    func set_send_buffer(edit self, bytes: u32) -> Result[(), io.IoErr] { return opt_set(self.fd, 3i32, i64(bytes)) }
    func send_buffer(view self) -> Result[u32, io.IoErr] { return opt_count(self.fd, 3i32) }

    destructor(edit self) {
        if self.fd >= 0i32 { r := net_close(self.fd) }
    }
}

// sender is the path the runtime wrote: its length, then its bytes.
func sender(from: view[]u8) -> Vec[u8] {
    path := Vec[u8].new()
    var n: usize = usize(from[0usize])
    if n + 1usize > len(from) { n = len(from) - 1usize }
    for k in 0usize..n { path.push(from[1usize + k]) }
    return path
}
