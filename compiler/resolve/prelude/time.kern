// std/time: a monotonic clock, durations, deadlines, sleep and the wall
// clock, for hosted programs (a freestanding image has no runtime behind
// these). Imported with `import "std/time"` (specs/std-time).
module time

// Runtime intrinsics (hosted). Both trap explicit on a failure of the
// underlying call, which cannot happen for the arguments the runtime
// passes; sleep resumes after a signal interrupts it.
func time_sleep_ns(ns: u64)
func time_wall_ns() -> u64

// Duration is a span of time in nanoseconds.
struct Duration { ns: u64 }
// Instant is a reading of the monotonic clock (the prelude's now_ns).
struct Instant { ns: u64 }
// Deadline is a monotonic instant to compare the clock against.
struct Deadline { at: u64 }

// The constructors trap overflow past u64 nanoseconds (about 584 years).
func nanos(n: u64) -> Duration { return Duration { ns: n } }
func micros(n: u64) -> Duration { return Duration { ns: n * 1000u64 } }
func millis(n: u64) -> Duration { return Duration { ns: n * 1000000u64 } }
func seconds(n: u64) -> Duration { return Duration { ns: n * 1000000000u64 } }

impl Duration {
    func as_nanos(view self) -> u64 { return self.ns }
    // as_millis truncates.
    func as_millis(view self) -> u64 { return self.ns / 1000000u64 }
    // plus traps overflow; minus is 0 when d is longer.
    func plus(view self, d: Duration) -> Duration { return Duration { ns: self.ns + d.ns } }
    func minus(view self, d: Duration) -> Duration {
        if d.ns >= self.ns { return Duration { ns: 0u64 } }
        return Duration { ns: self.ns - d.ns }
    }
    func less(view self, d: Duration) -> bool { return self.ns < d.ns }
}

func now() -> Instant { return Instant { ns: now_ns() } }

impl Instant {
    // elapsed is the time since self.
    func elapsed(view self) -> Duration {
        t := now_ns()
        if t <= self.ns { return Duration { ns: 0u64 } }
        return Duration { ns: t - self.ns }
    }
    // since is the time from earlier to self, 0 when earlier is later.
    func since(view self, earlier: Instant) -> Duration {
        if earlier.ns >= self.ns { return Duration { ns: 0u64 } }
        return Duration { ns: self.ns - earlier.ns }
    }
    func plus(view self, d: Duration) -> Instant { return Instant { ns: self.ns + d.ns } }
}

// after is a deadline d from now.
func after(d: Duration) -> Deadline { return Deadline { at: now_ns() + d.ns } }

impl Deadline {
    // expired is now() >= the deadline.
    func expired(view self) -> bool { return now_ns() >= self.at }
    // remaining is the time left, 0 once expired.
    func remaining(view self) -> Duration {
        t := now_ns()
        if t >= self.at { return Duration { ns: 0u64 } }
        return Duration { ns: self.at - t }
    }
}

// sleep returns after at least d has passed on the monotonic clock.
func sleep(d: Duration) {
    if d.ns > 0u64 { time_sleep_ns(d.ns) }
}

// wall_nanos is the wall clock: nanoseconds since the Unix epoch, which
// may jump when the system time is set.
func wall_nanos() -> u64 { return time_wall_ns() }
