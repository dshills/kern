module par
func sum(xs: view[[]u64]) -> u64 { t := 0u64; for x in xs { t = t + x }; return t }
func parallel_total(v: view[Vec[u64]]) -> Result[u64, SpawnErr] {
    // TODO
    return Ok(0u64)
}
func main() -> i32 {
    v := Vec[u64].new()
    i := 0u64
    while i < 1000u64 { v.push(i); i = i + 1u64 }
    match parallel_total(v) {
        Ok(t) => { print_u64(t); println() }
        Err(e) => { print_str("spawn failed"); println() }
    }
    return 0i32
}
