module l
struct Node { value: u64; next: Option[PoolId[Node]] }
struct List { nodes: Pool[Node]; head: Option[PoolId[Node]]; count: u64 }
impl List {
    func new() -> List { return List { nodes: Pool[Node].new(), head: None, count: 0u64 } }
    func push_front(edit self, v: u64) -> bool {
        match self.nodes.alloc(Node { value: v, next: self.head }) {
            Ok(id) => { self.head = Some(id); self.count = self.count + 1u64; return true }
            Err(e) => { return false }
        }
    }
    func sum(view self) -> u64 {
        t := 0u64
        cur := self.head
        while cur != None {
            match cur {
                Some(id) => {
                    with n := self.nodes.get(id) { t = t + n.value; cur = n.next }
                }
                None => { }
            }
        }
        return t
    }
}
func main() -> i32 {
    l := List.new()
    ok1 := l.push_front(10u64)
    ok2 := l.push_front(20u64)
    ok3 := l.push_front(30u64)
    print_u64(l.count)
    println()
    print_u64(l.sum())
    println()
    return 0i32
}
