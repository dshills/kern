module ring
struct Ring { slots: [4]u64; head: usize; len: usize }
impl Ring {
    func new() -> Ring { return Ring { slots: zero(), head: 0usize, len: 0usize } }
    func push(edit self, v: u64) -> bool {
        if self.len == 4usize { return false }
        self.slots[(self.head + self.len) % 4usize] = v
        self.len = self.len + 1usize
        return true
    }
    func pop(edit self) -> Option[u64] {
        if self.len == 0usize { return None }
        v := self.slots[self.head]
        self.head = (self.head + 1usize) % 4usize
        self.len = self.len - 1usize
        return Some(v)
    }
}
func show(o: Option[u64]) {
    match o {
        Some(v) => { print_u64(v); println() }
        None => { print_str("empty"); println() }
    }
}
func main() -> i32 {
    r := Ring.new()
    print_bool(r.push(1u64)); println()
    print_bool(r.push(2u64)); println()
    print_bool(r.push(3u64)); println()
    print_bool(r.push(4u64)); println()
    print_bool(r.push(9u64)); println()
    show(r.pop())
    show(r.pop())
    print_bool(r.push(5u64)); println()
    show(r.pop())
    show(r.pop())
    show(r.pop())
    show(r.pop())
    return 0i32
}
