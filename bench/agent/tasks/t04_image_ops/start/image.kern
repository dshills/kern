module image
// Image operations over a flat grid of w*h u32 pixels stored row by row:
// pixel (x, y) is at index y * w + x, and every grid passed in has
// exactly w * h entries.

// blur writes the 3x3 box blur of src into dst, which has the shape of
// src: each pixel becomes the mean, rounded down, of itself and its eight
// neighbours, where the neighbours wrap around the edges (the row above
// the first row is the last row, the column left of the first column is
// the last column).
func blur(src: view[]u32, dst: edit[]u32, w: usize, h: usize) {
    for y in 0usize..h {
        up := ((y + h - 1usize) % h) * w
        mid := y * w
        down := ((y + 1usize) % h) * w
        for x in 0usize..w {
            left := (x + w - 1usize) % w
            right := (x + 1usize) % w
            var s: u64 = u64(src[up + left]) + u64(src[up + x]) + u64(src[up + right])
            s = s + u64(src[mid + left]) + u64(src[mid + x]) + u64(src[mid + right])
            s = s + u64(src[down + left]) + u64(src[down + x]) + u64(src[down + right])
            dst[mid + x] = truncate[u32](s / 9u64)
        }
    }
}

// flip mirrors the grid left to right in place.
func flip(g: edit[]u32, w: usize, h: usize) {
    for y in 0usize..h {
        row := y * w
        for x in 0usize..w / 2usize {
            t := g[row + x]
            g[row + x] = g[row + w - 1usize - x]
            g[row + w - 1usize - x] = t
        }
    }
}

// row_sums writes the sum of row y into sums[y], for the rows that have
// an entry in sums (sums may be shorter or longer than h); it returns the
// number of sums written.
func row_sums(g: view[]u32, w: usize, h: usize, sums: edit[]u64) -> usize {
    var m: usize = h
    if len(sums) < m { m = len(sums) }
    for y in 0usize..m {
        var s: u64 = 0u64
        for x in 0usize..w { s = s + u64(g[y * w + x]) }
        sums[y] = s
    }
    return m
}

// scroll writes src moved back by k pixels in row-major order into dst,
// which has the length of src: dst[i] is the pixel k places after i,
// wrapping past the end to the start. An empty grid writes nothing.
func scroll(src: view[]u32, dst: edit[]u32, k: usize) {
    if len(src) == 0usize { return }
    for i in 0usize..len(dst) { dst[i] = src[(i + k) % len(src)] }
}

func show(g: view[]u32) {
    for p in g {
        print_u64(u64(p))
        print_str(" ")
    }
    println()
}

func report(g: edit[]u32, d: edit[]u32, w: usize, h: usize, sums: edit[]u64) {
    blur(g, d, w, h)
    show(d)
    print_u64(u64(row_sums(d, w, h, sums)))
    print_str(": ")
    for s in sums {
        print_u64(s)
        print_str(" ")
    }
    println()
    scroll(g, d, w + 1usize)
    show(d)
    flip(g, w, h)
    show(g)
}

func main() -> i32 {
    var a: [20]u32 = [9u32, 18u32, 27u32, 36u32, 45u32, 54u32, 63u32, 72u32, 81u32, 90u32, 99u32, 108u32, 117u32, 126u32, 135u32, 144u32, 153u32, 162u32, 171u32, 180u32]
    var b: [12]u32 = [7u32, 0u32, 3u32, 250u32, 1u32, 8u32, 40u32, 2u32, 6u32, 5u32, 11u32, 4u32]
    var d: [20]u32 = zero()
    var sums: [4]u64 = zero()
    with gs := a[0usize:20usize] {
        with ds := d[0usize:20usize] {
            with ss := sums[0usize:4usize] { report(gs, ds, 5usize, 4usize, ss) }
        }
    }
    with gs := b[0usize:12usize] {
        with ds := d[0usize:12usize] {
            with ss := sums[0usize:1usize] { report(gs, ds, 6usize, 2usize, ss) }
        }
    }
    return 0i32
}
