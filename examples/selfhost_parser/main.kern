//! phase: 6
//! expect: output selfhost_parser
// A kern parser written in kern (specs/selfhost-parser): given a path (and
// optionally `bodyless`, the mode for std/ and the prelude, and `spans`,
// specs/selfhost-spans) it prints the file's parse tree in ast.Dump's
// format, or ast.DumpSpans's with `spans`; with `diags` (specs/selfhost-diags)
// it prints the Go parser's diagnostics as `start:end message` lines
// instead, nothing for a file that parses. Otherwise `error` (exit 1) on a lexical
// or syntax error, or `cannot read` and the path (exit 2). With no
// arguments it parses the embedded sample, so the example runs as a
// fixture; tests/selfhost_parser_test.go compares it with the Go parser
// over the whole corpus.
module main
import "std/io"
import "std/str"
import "syntax"

func run_on(src: own Vec[u8], bodyless: bool, spans: bool, diags: bool) -> i32 {
    o := str.String.new()
    r := syntax.Parse(src, bodyless, spans, diags, o)
    if r == 0u32 {
        print_str(o.as_view())
        return 0i32
    }
    if !diags {
        print_str("error")
        println()
        return 1i32
    }
    if r == 2u32 {
        print_str("unsupported")
        println()
        return 1i32
    }
    print_str(o.as_view())
    return 1i32
}

// read_and_run reads path (an owned Result holding a Vec is unwrapped with
// ?, not matched) and parses it.
func read_and_run(path: view[]u8, bodyless: bool, spans: bool, diags: bool) -> Result[i32, io.IoErr] {
    data := io.read_file(path)?
    return Ok(run_on(data, bodyless, spans, diags))
}

func main() -> i32 {
    args := io.args()
    if args.len() < 2usize {
        sample := Vec[u8].new()
        sample.extend("module sample\nimport \"std/str\"\nstruct P[T: Copy] nocopy { x: u64; y: [4]T }\nunion U { A; B(u64) }\nimpl P[u64] {\n    func get(view self) -> u64 { return self.x }\n}\nfunc start() -> i32 {\n    p := P[u64] { x: 1_000u64, y: [1, 2, 3, 4] }\n    match u {\n        B(n) => { return -1 }\n        _ => { }\n    }\n    for i in 0usize..4usize { s := \"a\\tb\" }\n    return i32(p.get() % 7u64)\n}\n")
        return run_on(sample, false, false, false)
    }
    // the words after the path: bodyless, spans, diags
    bodyless := false
    spans := false
    diags := false
    var i: usize = 2usize
    while i < args.len() {
        with a := args.get(i) {
            with b := a.as_view() {
                if str.equal(b, "bodyless") { bodyless = true }
                if str.equal(b, "spans") { spans = true }
                if str.equal(b, "diags") { diags = true }
            }
        }
        i = i + 1usize
    }
    var path: Vec[u8] = Vec[u8].new()
    with a := args.get(1usize) { path.extend(a.as_view()) }
    match read_and_run(path.as_view(), bodyless, spans, diags) {
        Ok(code) => return code
        Err(e) => {
            print_str("cannot read ")
            print_str(path.as_view())
            println()
            return 2i32
        }
    }
}
