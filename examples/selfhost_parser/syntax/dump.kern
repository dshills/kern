// The tree dumper (specs/selfhost-parser): the format of ast.Dump
// (compiler/ast/dump.go), byte for byte, or with spans that of
// ast.DumpSpans (specs/selfhost-spans).
module syntax
import "std/str"

impl P {
    func word(view self, s: usize, e: usize, o: edit[str.String]) {
        o.push(32u8)
        if e <= s {
            o.push(95u8)
            return
        }
        with src := self.src.as_view() { o.push_str(src[s:e]) }
    }
    func flag_word(view self, v: bool, o: edit[str.String]) {
        o.push(32u8)
        if v { o.push(116u8) } else { o.push(102u8) }
    }
    func num(view self, v: u64, o: edit[str.String]) {
        o.push(32u8)
        o.push_u64(v)
    }
    // str writes a string token's unescaped value as x and its hex.
    func str_value(view self, s: usize, e: usize, o: edit[str.String]) {
        o.push(120u8)
        i := s + 1usize
        end := e - 1usize
        while i < end {
            var c: u8 = 0u8
            with b := self.src.get(i) { c = b }
            if c == 92u8 {
                var d: u8 = 0u8
                with b := self.src.get(i + 1usize) { d = b }
                if d == 110u8 { c = 10u8 } else if d == 116u8 { c = 9u8 } else if d == 48u8 { c = 0u8 } else { c = d }
                i = i + 1usize
            }
            hex_byte(c, o)
            i = i + 1usize
        }
    }
    func strv(view self, n: usize, o: edit[str.String]) {
        o.push(32u8)
        self.str_value(self.ns(n), self.ne(n), o)
    }
    func open(view self, n: usize, name: view[]u8, o: edit[str.String]) {
        o.push(40u8)
        o.push_str(name)
        self.put_at(self.pstart(n), self.pend(n), o)
    }
    // put_at writes a position as @s:e when the dump has spans.
    func put_at(view self, s: usize, e: usize, o: edit[str.String]) {
        if !self.spans { return }
        o.push(64u8)
        o.push_u64(u64(s))
        o.push(58u8)
        o.push_u64(u64(e))
    }
    func child(view self, n: usize, o: edit[str.String]) {
        o.push(32u8)
        self.node(n, o)
    }
    // items writes a list node's elements as [a b].
    func items(view self, l: usize, o: edit[str.String]) {
        o.push(32u8)
        o.push(91u8)
        n := self.nlen(l)
        i := 0usize
        while i < n {
            if i > 0usize { o.push(32u8) }
            self.node(self.kid(l, i), o)
            i = i + 1usize
        }
        o.push(93u8)
    }
    // names writes a list of N_NAME nodes as [a b].
    func names(view self, l: usize, o: edit[str.String]) {
        o.push(32u8)
        o.push(91u8)
        n := self.nlen(l)
        i := 0usize
        while i < n {
            if i > 0usize { o.push(32u8) }
            c := self.kid(l, i)
            s := self.ns(c)
            e := self.ne(c)
            with src := self.src.as_view() { o.push_str(src[s:e]) }
            self.put_at(s, e, o)
            i = i + 1usize
        }
        o.push(93u8)
    }
    // strs writes a list of N_STRV nodes as [x.. x..].
    func strs(view self, l: usize, o: edit[str.String]) {
        o.push(32u8)
        o.push(91u8)
        n := self.nlen(l)
        i := 0usize
        while i < n {
            if i > 0usize { o.push(32u8) }
            c := self.kid(l, i)
            self.str_value(self.ns(c), self.ne(c), o)
            i = i + 1usize
        }
        o.push(93u8)
    }
    func name(view self, n: usize, o: edit[str.String]) { self.word(self.ns(n), self.ne(n), o) }
    func name2(view self, n: usize, o: edit[str.String]) {
        var s: usize = 0usize
        var e: usize = 0usize
        with x := self.nodes.get(n) {
            s = x.s2
            e = x.e2
        }
        self.word(s, e, o)
    }
    func nv(view self, n: usize) -> u64 {
        var r: u64 = 0u64
        with x := self.nodes.get(n) { r = x.v }
        return r
    }
    func has(view self, n: usize, f: u32) -> bool { return self.nf(n) & f != 0u32 }
    // conv writes a parameter convention.
    func conv(view self, v: u64, o: edit[str.String]) {
        if v == 0u64 { o.push_str(" value") } else if v == 1u64 { o.push_str(" view") } else if v == 2u64 { o.push_str(" edit") } else if v == 3u64 { o.push_str(" own") } else { o.push_str(" out") }
    }
    // suffix writes a number literal's suffix, or _.
    func suffix(view self, n: usize, o: edit[str.String]) {
        s := self.ns(n)
        e := self.ne(n)
        var k: usize = 0usize
        with src := self.src.as_view() { k = suffix_len(src, s, e) }
        self.word(e - k, e, o)
    }

    func node(view self, n: usize, o: edit[str.String]) {
        k := self.nk(n)
        if n == 0usize || k == N_NIL {
            o.push(95u8)
            return
        }
        if k == N_FILE {
            self.open(n, "file", o)
            self.name(n, o)
            self.items(self.kid(n, 0usize), o)
            self.items(self.kid(n, 1usize), o)
        } else if k == N_IMPORT {
            self.open(n, "import", o)
            self.strv(n, o)
        } else if k == N_TP {
            self.open(n, "tp", o)
            self.name(n, o)
            self.items(self.kid(n, 0usize), o)
        } else if k == N_FIELD {
            self.open(n, "field", o)
            self.name(n, o)
            self.child(self.kid(n, 0usize), o)
        } else if k == N_STRUCT {
            self.open(n, "struct", o)
            self.name(n, o)
            self.items(self.kid(n, 0usize), o)
            self.items(self.kid(n, 1usize), o)
            self.flag_word(self.has(n, F_VIEW), o)
            self.flag_word(self.has(n, F_NOCOPY), o)
            self.flag_word(self.has(n, F_PACKED), o)
        } else if k == N_VARIANT {
            self.open(n, "variant", o)
            self.name(n, o)
            self.items(self.kid(n, 0usize), o)
        } else if k == N_UNION {
            self.open(n, "union", o)
            self.name(n, o)
            self.items(self.kid(n, 0usize), o)
            self.items(self.kid(n, 1usize), o)
        } else if k == N_INTERFACE {
            self.open(n, "interface", o)
            self.name(n, o)
            self.items(self.kid(n, 0usize), o)
            self.items(self.kid(n, 1usize), o)
        } else if k == N_IMPL {
            self.open(n, "impl", o)
            self.items(self.kid(n, 0usize), o)
            self.child(self.kid(n, 1usize), o)
            self.child(self.kid(n, 2usize), o)
            self.items(self.kid(n, 3usize), o)
            self.child(self.kid(n, 4usize), o)
        } else if k == N_DESTRUCTOR {
            self.open(n, "destructor", o)
            self.child(self.kid(n, 0usize), o)
        } else if k == N_PARAM {
            self.open(n, "param", o)
            self.name(n, o)
            self.conv(self.nv(n), o)
            self.child(self.kid(n, 0usize), o)
            self.flag_word(self.has(n, F_VIEW), o)
        } else if k == N_CONTRACT {
            self.open(n, "contract", o)
            self.strs(self.kid(n, 0usize), o)
            self.strs(self.kid(n, 1usize), o)
            self.strs(self.kid(n, 2usize), o)
        } else if k == N_BUDGET {
            self.open(n, "budget", o)
            self.items(self.kid(n, 0usize), o)
        } else if k == N_BITEM {
            self.open(n, "item", o)
            self.name(n, o)
            self.put_at(self.ns(n), self.ne(n), o)
            self.name2(n, o)
        } else if k == N_FUNC {
            self.open(n, "func", o)
            self.name(n, o)
            self.child(self.kid(n, 0usize), o)
            // a budget is dumped only when present, as ast.Dump does
            bud := self.kid(n, 7usize)
            if bud != 0usize { self.child(bud, o) }
            self.items(self.kid(n, 1usize), o)
            self.items(self.kid(n, 2usize), o)
            self.items(self.kid(n, 3usize), o)
            self.items(self.kid(n, 4usize), o)
            self.name2(n, o)
            self.child(self.kid(n, 5usize), o)
            ext := self.kid(n, 6usize)
            if ext == 0usize { o.push_str(" _") } else { self.strv(ext, o) }
        } else if k == N_CONST || k == N_GLOBAL {
            if k == N_CONST { self.open(n, "const", o) } else { self.open(n, "global", o) }
            self.name(n, o)
            self.child(self.kid(n, 0usize), o)
            self.child(self.kid(n, 1usize), o)
        } else if k == N_ASSERT {
            self.open(n, "assert", o)
            self.name(n, o)
            self.child(self.kid(n, 0usize), o)
        } else if k == N_PRIM {
            self.open(n, "prim", o)
            self.name(n, o)
        } else if k == N_TNAME {
            self.open(n, "tname", o)
            self.name2(n, o)
            self.name(n, o)
            self.items(self.kid(n, 0usize), o)
        } else if k == N_ARRAY {
            self.open(n, "array", o)
            self.num(self.nv(n), o)
            self.child(self.kid(n, 0usize), o)
        } else if k == N_SLICE {
            self.open(n, "slice", o)
            self.child(self.kid(n, 0usize), o)
        } else if k == N_ACCESS {
            self.open(n, "access", o)
            self.flag_word(self.has(n, F_EDIT), o)
            self.flag_word(self.has(n, F_SEQ), o)
            self.child(self.kid(n, 0usize), o)
        } else if k == N_RAWPTR {
            self.open(n, "rawptr", o)
            self.child(self.kid(n, 0usize), o)
        } else if k == N_FUNCTYPE {
            self.open(n, "functype", o)
            self.items(self.kid(n, 0usize), o)
            self.items(self.kid(n, 1usize), o)
            self.flag_word(self.has(n, F_VIEW), o)
        } else if k == N_UNIT {
            self.open(n, "unit", o)
        } else if k == N_BLOCK {
            self.open(n, "block", o)
            self.items(self.kid(n, 0usize), o)
        } else if k == N_VAR {
            self.open(n, "var", o)
            self.name(n, o)
            self.child(self.kid(n, 0usize), o)
            self.child(self.kid(n, 1usize), o)
        } else if k == N_SHORT {
            self.open(n, "short", o)
            self.name(n, o)
            self.child(self.kid(n, 0usize), o)
        } else if k == N_ASSIGN {
            self.open(n, "assign", o)
            self.child(self.kid(n, 0usize), o)
            self.child(self.kid(n, 1usize), o)
        } else if k == N_WITH {
            self.open(n, "with", o)
            self.names(self.kid(n, 0usize), o)
            self.child(self.kid(n, 1usize), o)
            self.child(self.kid(n, 2usize), o)
        } else if k == N_ARM {
            self.open(n, "arm", o)
            self.flag_word(self.has(n, F_VIEW), o)
            self.child(self.kid(n, 0usize), o)
            self.name(n, o)
            self.names(self.kid(n, 1usize), o)
            self.child(self.kid(n, 2usize), o)
        } else if k == N_MATCH {
            self.open(n, "match", o)
            self.child(self.kid(n, 0usize), o)
            self.flag_word(self.has(n, F_VIEW), o)
            self.items(self.kid(n, 1usize), o)
        } else if k == N_FOR {
            self.open(n, "for", o)
            self.name(n, o)
            self.put_at(self.ns(n), self.ne(n), o)
            self.name2(n, o)
            var s2: usize = 0usize
            var e2: usize = 0usize
            with x := self.nodes.get(n) {
                s2 = x.s2
                e2 = x.e2
            }
            if e2 > s2 { self.put_at(s2, e2, o) }
            self.child(self.kid(n, 0usize), o)
            self.child(self.kid(n, 1usize), o)
        } else if k == N_WHILE {
            self.open(n, "while", o)
            self.child(self.kid(n, 0usize), o)
            self.child(self.kid(n, 1usize), o)
        } else if k == N_IF {
            self.open(n, "if", o)
            self.child(self.kid(n, 0usize), o)
            self.child(self.kid(n, 1usize), o)
            self.child(self.kid(n, 2usize), o)
        } else if k == N_RETURN {
            self.open(n, "return", o)
            self.child(self.kid(n, 0usize), o)
        } else if k == N_BREAK {
            self.open(n, "break", o)
        } else if k == N_CONTINUE {
            self.open(n, "continue", o)
        } else if k == N_UNSAFE {
            self.open(n, "unsafe", o)
            self.child(self.kid(n, 0usize), o)
        } else if k == N_EXPR {
            self.open(n, "expr", o)
            self.child(self.kid(n, 0usize), o)
        } else if k == N_INT {
            self.open(n, "int", o)
            self.name(n, o)
            self.num(self.nv(n), o)
            self.suffix(n, o)
            self.flag_word(self.has(n, F_VIEW), o)
        } else if k == N_FLOAT {
            self.open(n, "float", o)
            self.name(n, o)
            self.suffix(n, o)
        } else if k == N_STRING {
            self.open(n, "string", o)
            self.strv(n, o)
        } else if k == N_BOOL {
            self.open(n, "bool", o)
            self.flag_word(self.has(n, F_VIEW), o)
        } else if k == N_IDENT {
            self.open(n, "ident", o)
            self.name(n, o)
        } else if k == N_FIELDX {
            self.open(n, "fieldx", o)
            self.child(self.kid(n, 0usize), o)
            self.name(n, o)
        } else if k == N_INDEX {
            self.open(n, "index", o)
            self.child(self.kid(n, 0usize), o)
            self.items(self.kid(n, 1usize), o)
        } else if k == N_TYPEARG {
            self.open(n, "typearg", o)
            self.child(self.kid(n, 0usize), o)
        } else if k == N_SLICEX {
            self.open(n, "slicex", o)
            self.child(self.kid(n, 0usize), o)
            self.child(self.kid(n, 1usize), o)
            self.child(self.kid(n, 2usize), o)
        } else if k == N_ARG {
            self.open(n, "arg", o)
            self.flag_word(self.has(n, F_VIEW), o)
            self.child(self.kid(n, 0usize), o)
        } else if k == N_CALL {
            self.open(n, "call", o)
            self.child(self.kid(n, 0usize), o)
            self.items(self.kid(n, 1usize), o)
        } else if k == N_BINARY {
            self.open(n, "binary", o)
            self.name(n, o)
            self.child(self.kid(n, 0usize), o)
            self.child(self.kid(n, 1usize), o)
        } else if k == N_UNARY {
            self.open(n, "unary", o)
            self.name(n, o)
            self.child(self.kid(n, 0usize), o)
        } else if k == N_TRY {
            self.open(n, "try", o)
            self.child(self.kid(n, 0usize), o)
        } else if k == N_MOVE {
            self.open(n, "move", o)
            self.name(n, o)
        } else if k == N_CLOSURE {
            self.open(n, "closure", o)
            self.items(self.kid(n, 0usize), o)
            self.child(self.kid(n, 1usize), o)
            self.child(self.kid(n, 2usize), o)
        } else if k == N_COPY {
            self.open(n, "copy", o)
            self.child(self.kid(n, 0usize), o)
        } else if k == N_TAKE {
            self.open(n, "take", o)
            self.child(self.kid(n, 0usize), o)
        } else if k == N_REPLACE {
            self.open(n, "replace", o)
            self.child(self.kid(n, 0usize), o)
            self.child(self.kid(n, 1usize), o)
        } else if k == N_DROP {
            self.open(n, "drop", o)
            self.name(n, o)
        } else if k == N_TRAP {
            self.open(n, "trap", o)
        } else if k == N_CONV {
            self.open(n, "conv", o)
            self.name(n, o)
            self.child(self.kid(n, 0usize), o)
            self.flag_word(self.has(n, F_VIEW), o)
        } else if k == N_FINIT {
            self.open(n, "finit", o)
            self.name(n, o)
            self.child(self.kid(n, 0usize), o)
        } else if k == N_STRUCTLIT {
            self.open(n, "structlit", o)
            self.child(self.kid(n, 0usize), o)
            self.items(self.kid(n, 1usize), o)
        } else if k == N_ARRAYLIT {
            self.open(n, "arraylit", o)
            self.items(self.kid(n, 0usize), o)
        } else if k == N_RANGE {
            self.open(n, "range", o)
            self.child(self.kid(n, 0usize), o)
            self.child(self.kid(n, 1usize), o)
        } else if k == N_UNITLIT {
            self.open(n, "unitlit", o)
        } else if k == N_PAREN {
            self.open(n, "paren", o)
            self.child(self.kid(n, 0usize), o)
        } else {
            self.open(n, "unknown", o)
        }
        o.push(41u8)
    }
}

func hex_byte(c: u8, o: edit[str.String]) {
    hi := c >> 4u32
    lo := c & 15u8
    if hi < 10u8 { o.push(48u8 + hi) } else { o.push(87u8 + hi) }
    if lo < 10u8 { o.push(48u8 + lo) } else { o.push(87u8 + lo) }
}

// Parse lexes and parses src (bodyless for the standard library and the
// prelude). Without diags it writes the dump into o, with spans when spans
// is set; with diags it writes the diagnostics instead, one `start:end
// message` line each, as the Go parser reports them (specs/selfhost-diags),
// and nothing for a file that parses. It returns 0 when src parsed, 1 on
// a lexical or syntax error, 2 when src has a byte at or above 0x80
// outside a string or a comment (not supported).
func Parse(src: own Vec[u8], bodyless: bool, spans: bool, diags: bool, o: edit[str.String]) -> u32 {
    toks := Vec[Tok].new()
    errs := Vec[LexErr].new()
    var ok: bool = false
    with s := src.as_view() { ok = lex(s, toks, errs) }
    if !ok { return 2u32 }
    if errs.len() > 0usize {
        if diags {
            with s := src.as_view() {
                for e in errs.as_view() {
                    m := Vec[u8].new()
                    if e.k == LE_ESCAPE {
                        m.extend("unknown escape")
                    } else if e.k == LE_UNTERMINATED {
                        m.extend("unterminated string")
                    } else {
                        m.extend("unexpected character ")
                        go_quote(s[e.s], m)
                    }
                    diag_line(e.s, e.e, m.as_view(), o)
                }
            }
        }
        return 1u32
    }
    p := new_parser(src, toks, bodyless)
    p.spans = spans
    f := p.parse_file()
    if p.failed {
        if diags {
            with m := p.emsg.as_view() { diag_line(p.es, p.ee, m, o) }
        }
        return 1u32
    }
    if !diags {
        p.node(f, o)
        o.push(10u8)
    }
    return 0u32
}

// diag_line writes one diagnostic as `start:end message` and a newline.
func diag_line(s: usize, e: usize, m: view[]u8, o: edit[str.String]) {
    o.push_u64(u64(s))
    o.push(58u8)
    o.push_u64(u64(e))
    o.push(32u8)
    o.push_str(m)
    o.push(10u8)
}
