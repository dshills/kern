// The kern parser, ported from compiler/parser function by function
// (specs/selfhost-parser): the same nesting counter, newline skipping,
// no-struct-literal flag, lookahead, conversions and checks. Go's bailout
// panic is the failed flag: once set, ck() reports EOF, every loop over a
// list ends (more() is false) and every parse function returns.
module syntax

struct P nocopy { src: Vec[u8]; toks: Vec[Tok]; pos: usize; nest: u32; nolit: bool; bodyless: bool; failed: bool; nodes: Vec[Node]; spans: bool }

func new_parser(src: own Vec[u8], toks: own Vec[Tok], bodyless: bool) -> P {
    p := P { src: src, toks: toks, pos: 0usize, nest: 0u32, nolit: false, bodyless: bodyless, failed: false, nodes: Vec[Node].new(), spans: false }
    n := p.mk(N_NIL, 0usize, 0usize)
    return p
}

impl P {
    // ---- tokens ----

    func tok(view self, i: usize) -> Tok {
        var t: Tok = Tok { k: EOF, s: 0usize, e: 0usize }
        with x := self.toks.get(i) { t = Tok { k: x.k, s: x.s, e: x.e } }
        return t
    }
    func kind_at(view self, i: usize) -> u32 {
        t := self.tok(i)
        return t.k
    }
    func cur(edit self) -> Tok {
        while self.nest > 0u32 && self.kind_at(self.pos) == NL { self.pos = self.pos + 1usize }
        return self.tok(self.pos)
    }
    // ck is the current kind, EOF once parsing has failed.
    func ck(edit self) -> u32 {
        if self.failed { return EOF }
        t := self.cur()
        return t.k
    }
    func peek(view self, n: usize) -> u32 {
        i := self.pos
        seen := 0usize
        while i < self.toks.len() {
            k := self.kind_at(i)
            if !(self.nest > 0u32 && k == NL) {
                if seen == n { return k }
                seen = seen + 1usize
            }
            i = i + 1usize
        }
        return EOF
    }
    func next(edit self) -> Tok {
        t := self.cur()
        if t.k != EOF { self.pos = self.pos + 1usize }
        return t
    }
    func at(edit self, k: u32) -> bool { return self.ck() == k }
    // more is "not at k" for the loops over a list: false once failed.
    func more(edit self, k: u32) -> bool { return !self.failed && self.ck() != k }
    func accept(edit self, k: u32) -> bool {
        if self.at(k) {
            t := self.next()
            return true
        }
        return false
    }
    func fail(edit self) { self.failed = true }
    func expect(edit self, k: u32) -> Tok {
        if self.failed { return self.tok(self.pos) }
        t := self.cur()
        if t.k != k {
            self.failed = true
            return t
        }
        return self.next()
    }
    func skip_nl(edit self) {
        while self.kind_at(self.pos) == NL || self.kind_at(self.pos) == SEMI { self.pos = self.pos + 1usize }
    }
    func stmt_end(edit self) {
        if self.failed { return }
        t := self.cur()
        if t.k == NL || t.k == SEMI {
            u := self.next()
        } else if t.k != RBRACE && t.k != EOF {
            self.failed = true
        }
    }
    // tis reports whether a token spells w.
    func tis(view self, t: Tok, w: view[]u8) -> bool {
        with s := self.src.as_view() { return same(s, t.s, t.e, w) }
    }

    // ---- nodes ----

    func mk(edit self, k: u32, s: usize, e: usize) -> usize {
        self.nodes.push(Node { k: k, s: s, e: e, s2: 0usize, e2: 0usize, v: 0u64, f: 0u32, kids: Vec[usize].new(), ps: 0usize, pe: 0usize })
        return self.nodes.len() - 1usize
    }
    func list(edit self) -> usize { return self.mk(N_LIST, 0usize, 0usize) }
    // spans (specs/selfhost-spans): setp sets a node's span, setps and
    // setpe one end; pstart and pend read them; prev_end is the end of the
    // token before the current position, Go's p.toks[p.pos-1].End
    func setp(edit self, n: usize, s: usize, e: usize) {
        if n == 0usize { return }
        with x := self.nodes.at(n) { x.ps = s; x.pe = e }
    }
    func setps(edit self, n: usize, s: usize) {
        if n == 0usize { return }
        with x := self.nodes.at(n) { x.ps = s }
    }
    func setpe(edit self, n: usize, e: usize) {
        if n == 0usize { return }
        with x := self.nodes.at(n) { x.pe = e }
    }
    func pstart(view self, n: usize) -> usize {
        var r: usize = 0usize
        with x := self.nodes.get(n) { r = x.ps }
        return r
    }
    func pend(view self, n: usize) -> usize {
        var r: usize = 0usize
        with x := self.nodes.get(n) { r = x.pe }
        return r
    }
    func prev_end(view self) -> usize {
        if self.pos == 0usize { return 0usize }
        t := self.tok(self.pos - 1usize)
        return t.e
    }
    // span_nn spans n from a's start to b's end; span_tn from s to b's
    // end; span_nt from a's start to e; setpe_n ends n where b ends,
    // setpe_kid where kid i of a ends, setpe_prev at prev_end. Each reads
    // the nodes itself, since an argument may not read self while the call
    // edits it.
    func span_nn(edit self, n: usize, a: usize, b: usize) {
        s := self.pstart(a)
        e := self.pend(b)
        self.setp(n, s, e)
    }
    func span_tn(edit self, n: usize, s: usize, b: usize) {
        e := self.pend(b)
        self.setp(n, s, e)
    }
    func span_nt(edit self, n: usize, a: usize, e: usize) {
        s := self.pstart(a)
        self.setp(n, s, e)
    }
    func setpe_n(edit self, n: usize, b: usize) {
        e := self.pend(b)
        self.setpe(n, e)
    }
    func setpe_kid(edit self, n: usize, a: usize, i: usize) {
        k := self.kid(a, i)
        e := self.pend(k)
        self.setpe(n, e)
    }
    func setpe_prev(edit self, n: usize) {
        e := self.prev_end()
        self.setpe(n, e)
    }
    func add(edit self, n: usize, c: usize) {
        if n == 0usize { return }
        with x := self.nodes.at(n) { x.kids.push(c) }
    }
    func set2(edit self, n: usize, s: usize, e: usize) {
        if n == 0usize { return }
        with x := self.nodes.at(n) { x.s2 = s; x.e2 = e }
    }
    func set1(edit self, n: usize, s: usize, e: usize) {
        if n == 0usize { return }
        with x := self.nodes.at(n) { x.s = s; x.e = e }
    }
    func setv(edit self, n: usize, v: u64) {
        if n == 0usize { return }
        with x := self.nodes.at(n) { x.v = v }
    }
    func flag(edit self, n: usize, f: u32) {
        if n == 0usize { return }
        with x := self.nodes.at(n) { x.f = x.f | f }
    }
    func nk(view self, n: usize) -> u32 {
        var k: u32 = N_NIL
        with x := self.nodes.get(n) { k = x.k }
        return k
    }
    func ns(view self, n: usize) -> usize {
        var r: usize = 0usize
        with x := self.nodes.get(n) { r = x.s }
        return r
    }
    func ne(view self, n: usize) -> usize {
        var r: usize = 0usize
        with x := self.nodes.get(n) { r = x.e }
        return r
    }
    func nf(view self, n: usize) -> u32 {
        var r: u32 = 0u32
        with x := self.nodes.get(n) { r = x.f }
        return r
    }
    func nlen(view self, n: usize) -> usize {
        var r: usize = 0usize
        with x := self.nodes.get(n) { r = x.kids.len() }
        return r
    }
    // kid is child i of n, or the nil node.
    func kid(view self, n: usize, i: usize) -> usize {
        var r: usize = 0usize
        with x := self.nodes.get(n) {
            if i < x.kids.len() {
                with c := x.kids.get(i) { r = c }
            }
        }
        return r
    }
    // upper reports whether a node's name starts with an upper-case letter.
    func upper(view self, n: usize) -> bool {
        s := self.ns(n)
        if self.ne(n) <= s { return false }
        var c: u8 = 0u8
        with b := self.src.get(s) { c = b }
        return c >= 65u8 && c <= 90u8
    }
    func is_prim(view self, s: usize, e: usize) -> bool {
        with src := self.src.as_view() {
            return same(src, s, e, "i8") || same(src, s, e, "i16") || same(src, s, e, "i32") || same(src, s, e, "i64") || same(src, s, e, "isize") || same(src, s, e, "u8") || same(src, s, e, "u16") || same(src, s, e, "u32") || same(src, s, e, "u64") || same(src, s, e, "usize") || same(src, s, e, "f32") || same(src, s, e, "f64") || same(src, s, e, "bool")
        }
    }

    // ---- file and declarations ----

    func parse_file(edit self) -> usize {
        self.skip_nl()
        start := self.cur()
        t := self.expect(KW_MODULE)
        m := self.expect(IDENT)
        f := self.mk(N_FILE, m.s, m.e)
        imps := self.list()
        decls := self.list()
        self.add(f, imps)
        self.add(f, decls)
        self.stmt_end()
        self.skip_nl()
        while self.at(KW_IMPORT) {
            u := self.next()
            s := self.expect(STR)
            im := self.mk(N_IMPORT, s.s, s.e)
            self.setp(im, u.s, s.e)
            self.add(imps, im)
            self.stmt_end()
            self.skip_nl()
        }
        while self.more(EOF) {
            d := self.parse_decl()
            self.add(decls, d)
            self.skip_nl()
        }
        last := self.cur()
        self.setp(f, start.s, last.e)
        return f
    }

    func parse_decl(edit self) -> usize {
        k := self.ck()
        if k == KW_VIEW {
            if self.peek(1usize) == KW_STRUCT {
                u := self.next()
                d := self.parse_struct()
                self.flag(d, F_VIEW)
                self.setps(d, u.s)
                return d
            }
        } else if k == KW_STRUCT {
            return self.parse_struct()
        } else if k == KW_UNION {
            return self.parse_union()
        } else if k == KW_INTERFACE {
            return self.parse_interface()
        } else if k == KW_IMPL {
            return self.parse_impl()
        } else if k == KW_FUNC || k == KW_CONTRACT {
            f := self.parse_func(true)
            if self.kid(f, 5usize) == 0usize { self.stmt_end() }
            return f
        } else if k == KW_EXTERN {
            return self.parse_extern()
        } else if k == KW_CONST {
            return self.parse_const(N_CONST, KW_CONST)
        } else if k == KW_THREAD_LOCAL {
            return self.parse_const(N_GLOBAL, KW_THREAD_LOCAL)
        } else if k == KW_UNSAFE {
            if self.peek(1usize) == KW_ASSERT { return self.parse_assert() }
        } else if k == IDENT && self.at_budget() {
            f := self.parse_func(true)
            if self.kid(f, 5usize) == 0usize { self.stmt_end() }
            return f
        }
        self.fail()
        return 0usize
    }

    // parse_constraints parses `C1 + C2 ...` into the list l and ends
    // tp's span at the last one.
    func parse_constraints(edit self, l: usize, tp: usize) {
        while true {
            c := self.parse_tname()
            self.add(l, c)
            self.setpe_n(tp, c)
            if !self.accept(PLUS) { break }
        }
    }

    func parse_tps(edit self) -> usize {
        l := self.list()
        if !self.at(LBRACK) { return l }
        u := self.next()
        self.nest = self.nest + 1u32
        while true {
            n := self.expect(IDENT)
            tp := self.mk(N_TP, n.s, n.e)
            self.setp(tp, n.s, n.e)
            cs := self.list()
            self.add(tp, cs)
            if self.accept(COLON) { self.parse_constraints(cs, tp) }
            self.add(l, tp)
            if !self.accept(COMMA) { break }
        }
        self.nest = self.nest - 1u32
        v := self.expect(RBRACK)
        return l
    }

    func parse_struct(edit self) -> usize {
        t := self.expect(KW_STRUCT)
        n := self.expect(IDENT)
        d := self.mk(N_STRUCT, n.s, n.e)
        self.setp(d, t.s, t.e)
        tps := self.parse_tps()
        self.add(d, tps)
        fl := self.list()
        self.add(d, fl)
        if self.accept(KW_NOCOPY) { self.flag(d, F_NOCOPY) }
        if !self.failed && self.kind_at(self.pos) == IDENT && self.tis(self.tok(self.pos), "packed") {
            u := self.next()
            self.flag(d, F_PACKED)
        }
        b := self.expect(LBRACE)
        self.skip_nl()
        while self.more(RBRACE) {
            fname := self.expect(IDENT)
            c := self.expect(COLON)
            ty := self.parse_type()
            f := self.mk(N_FIELD, fname.s, fname.e)
            self.span_tn(f, fname.s, ty)
            self.add(f, ty)
            self.add(fl, f)
            self.stmt_end()
            self.skip_nl()
        }
        e := self.expect(RBRACE)
        self.setpe(d, e.e)
        return d
    }

    func parse_union(edit self) -> usize {
        t := self.expect(KW_UNION)
        n := self.expect(IDENT)
        d := self.mk(N_UNION, n.s, n.e)
        self.setp(d, t.s, t.e)
        tps := self.parse_tps()
        self.add(d, tps)
        vs := self.list()
        self.add(d, vs)
        b := self.expect(LBRACE)
        self.skip_nl()
        while self.more(RBRACE) {
            vn := self.expect(IDENT)
            v := self.mk(N_VARIANT, vn.s, vn.e)
            self.setp(v, vn.s, vn.e)
            fl := self.list()
            self.add(v, fl)
            if self.at(LPAREN) {
                u := self.next()
                self.nest = self.nest + 1u32
                while self.more(RPAREN) {
                    var fld: usize = 0usize
                    if self.at(IDENT) && self.peek(1usize) == COLON {
                        fname := self.next()
                        c := self.next()
                        ty := self.parse_type()
                        fld = self.mk(N_FIELD, fname.s, fname.e)
                        self.span_tn(fld, fname.s, ty)
                        self.add(fld, ty)
                    } else {
                        ty := self.parse_type()
                        fld = self.mk(N_FIELD, 0usize, 0usize)
                        self.span_nn(fld, ty, ty)
                        self.add(fld, ty)
                    }
                    self.add(fl, fld)
                    if !self.accept(COMMA) { break }
                }
                self.nest = self.nest - 1u32
                r := self.expect(RPAREN)
                self.setpe(v, r.e)
            }
            self.add(vs, v)
            self.stmt_end()
            self.skip_nl()
        }
        e := self.expect(RBRACE)
        self.setpe(d, e.e)
        return d
    }

    func parse_interface(edit self) -> usize {
        t := self.expect(KW_INTERFACE)
        n := self.expect(IDENT)
        d := self.mk(N_INTERFACE, n.s, n.e)
        self.setp(d, t.s, t.e)
        tps := self.parse_tps()
        self.add(d, tps)
        ms := self.list()
        self.add(d, ms)
        b := self.expect(LBRACE)
        self.skip_nl()
        while self.more(RBRACE) {
            m := self.parse_func(false)
            self.add(ms, m)
            self.stmt_end()
            self.skip_nl()
        }
        e := self.expect(RBRACE)
        self.setpe(d, e.e)
        return d
    }

    // impl kids: type params, interface (or nil), target, funcs, destructor (or nil)
    func parse_impl(edit self) -> usize {
        t := self.expect(KW_IMPL)
        d := self.mk(N_IMPL, 0usize, 0usize)
        self.setp(d, t.s, t.e)
        tps := self.parse_tps()
        first := self.parse_type()
        var iface: usize = 0usize
        var target: usize = first
        if self.accept(KW_FOR) {
            if self.nk(first) != N_TNAME { self.fail() }
            iface = first
            target = self.parse_type()
        }
        fs := self.list()
        var dtor: usize = 0usize
        b := self.expect(LBRACE)
        self.skip_nl()
        while self.more(RBRACE) {
            if self.at(KW_DESTRUCTOR) {
                u := self.next()
                a := self.expect(LPAREN)
                c := self.expect(KW_EDIT)
                s := self.expect(KW_SELF)
                r := self.expect(RPAREN)
                body := self.parse_block()
                dtor = self.mk(N_DESTRUCTOR, 0usize, 0usize)
                self.span_tn(dtor, u.s, body)
                self.add(dtor, body)
            } else {
                f := self.parse_func(true)
                self.add(fs, f)
                if self.kid(f, 5usize) == 0usize { self.stmt_end() }
            }
            self.skip_nl()
        }
        e := self.expect(RBRACE)
        self.setpe(d, e.e)
        self.add(d, tps)
        self.add(d, iface)
        self.add(d, target)
        self.add(d, fs)
        self.add(d, dtor)
        return d
    }

    // contract kids: invariant, requires, ensures string lists
    func parse_contract(edit self) -> usize {
        t := self.expect(KW_CONTRACT)
        c := self.mk(N_CONTRACT, 0usize, 0usize)
        self.setp(c, t.s, t.e)
        inv := self.list()
        req := self.list()
        ens := self.list()
        self.add(c, inv)
        self.add(c, req)
        self.add(c, ens)
        b := self.expect(LBRACE)
        self.skip_nl()
        while self.more(RBRACE) {
            k := self.next()
            s := self.expect(STR)
            sv := self.mk(N_STRV, s.s, s.e)
            if k.k == KW_INVARIANT {
                self.add(inv, sv)
            } else if k.k == KW_REQUIRES {
                self.add(req, sv)
            } else if k.k == KW_ENSURES {
                self.add(ens, sv)
            } else {
                self.fail()
            }
            self.stmt_end()
            self.skip_nl()
        }
        e := self.expect(RBRACE)
        self.setpe(c, e.e)
        self.skip_nl()
        return c
    }

    // at_budget reports whether a budget block starts here: the identifier
    // budget followed by `{` (contextual, not a keyword).
    func at_budget(edit self) -> bool {
        if !self.at(IDENT) { return false }
        t := self.cur()
        return self.tis(t, "budget") && self.peek(1usize) == LBRACE
    }

    // budget kids: the item list; an item holds its name in s..e and its
    // value's text, suffix included, in s2..e2
    func parse_budget(edit self) -> usize {
        t := self.expect(IDENT)
        b := self.mk(N_BUDGET, 0usize, 0usize)
        self.setp(b, t.s, t.e)
        items := self.list()
        self.add(b, items)
        l := self.expect(LBRACE)
        self.skip_nl()
        while self.more(RBRACE) {
            n := self.expect(IDENT)
            v := self.expect(INT)
            it := self.mk(N_BITEM, n.s, n.e)
            self.set2(it, v.s, v.e)
            self.setp(it, n.s, v.e)
            self.add(items, it)
            self.stmt_end()
            self.skip_nl()
        }
        e := self.expect(RBRACE)
        self.setpe(b, e.e)
        self.skip_nl()
        if !self.at(KW_FUNC) { self.fail() }
        return b
    }

    // func kids: contract (or nil), type params, params, ret, where, body
    // (or nil), extern ABI (or nil), budget (or nil); release in s2..e2
    func parse_func(edit self, with_body: bool) -> usize {
        var con: usize = 0usize
        if self.at(KW_CONTRACT) { con = self.parse_contract() }
        var bud: usize = 0usize
        if with_body && self.at_budget() { bud = self.parse_budget() }
        t := self.expect(KW_FUNC)
        n := self.expect(IDENT)
        d := self.mk(N_FUNC, n.s, n.e)
        if con != 0usize {
            self.span_nn(d, con, con)
        } else if bud != 0usize {
            self.span_nn(d, bud, bud)
        } else {
            self.setp(d, t.s, t.e)
        }
        tps := self.parse_tps()
        ps := self.parse_params()
        ret := self.parse_ret()
        wh := self.list()
        if self.at(IDENT) && self.tis(self.tok(self.pos), "where") {
            u := self.next()
            while true {
                wn := self.expect(IDENT)
                tp := self.mk(N_TP, wn.s, wn.e)
                self.setp(tp, wn.s, wn.e)
                cs := self.list()
                self.add(tp, cs)
                c := self.expect(COLON)
                self.parse_constraints(cs, tp)
                self.add(wh, tp)
                if !self.accept(COMMA) { break }
            }
        }
        if self.at(IDENT) && self.tis(self.tok(self.pos), "release") {
            u := self.next()
            r := self.expect(IDENT)
            self.set2(d, r.s, r.e)
        }
        var body: usize = 0usize
        if with_body && (!self.bodyless || self.at(LBRACE)) {
            body = self.parse_block()
            self.setpe_n(d, body)
        } else {
            self.setpe_prev(d)
        }
        self.add(d, con)
        self.add(d, tps)
        self.add(d, ps)
        self.add(d, ret)
        self.add(d, wh)
        self.add(d, body)
        self.add(d, 0usize)
        self.add(d, bud)
        return d
    }

    func parse_params(edit self) -> usize {
        l := self.list()
        t := self.expect(LPAREN)
        self.nest = self.nest + 1u32
        while self.more(RPAREN) {
            p := self.parse_param()
            self.add(l, p)
            if !self.accept(COMMA) { break }
        }
        self.nest = self.nest - 1u32
        r := self.expect(RPAREN)
        return l
    }

    // param: name in s..e (empty for none), convention in v, type kid (or
    // nil), F_VIEW set for a receiver
    func parse_param(edit self) -> usize {
        t := self.cur()
        if (t.k == KW_VIEW || t.k == KW_EDIT || t.k == KW_OWN) && self.peek(1usize) == KW_SELF {
            u := self.next()
            s := self.next()
            p := self.mk(N_PARAM, s.s, s.e)
            self.setp(p, u.s, s.e)
            if t.k == KW_VIEW { self.setv(p, 1u64) } else if t.k == KW_EDIT { self.setv(p, 2u64) } else { self.setv(p, 3u64) }
            self.add(p, 0usize)
            self.flag(p, F_VIEW)
            return p
        }
        n := self.expect(IDENT)
        c := self.expect(COLON)
        p := self.mk(N_PARAM, n.s, n.e)
        self.parse_param_type(p)
        self.setps(p, n.s)
        self.setpe_kid(p, p, 0usize)
        return p
    }

    // parse_param_type parses a parameter's convention and type into p.
    func parse_param_type(edit self, p: usize) {
        k := self.ck()
        if k == KW_OWN {
            u := self.next()
            ty := self.parse_type()
            self.setv(p, 3u64)
            self.add(p, ty)
            return
        }
        if k == KW_OUT {
            u := self.next()
            ty := self.parse_type()
            self.setv(p, 4u64)
            self.add(p, ty)
            return
        }
        ty := self.parse_type()
        if self.nk(ty) == N_ACCESS {
            if self.nf(ty) & F_EDIT != 0u32 { self.setv(p, 2u64) } else { self.setv(p, 1u64) }
        }
        self.add(p, ty)
    }

    func parse_ret(edit self) -> usize {
        l := self.list()
        if !self.accept(ARROW) { return l }
        if self.at(LPAREN) && self.peek(1usize) != RPAREN {
            u := self.next()
            self.nest = self.nest + 1u32
            while true {
                ty := self.parse_type()
                self.add(l, ty)
                if !self.accept(COMMA) { break }
            }
            self.nest = self.nest - 1u32
            r := self.expect(RPAREN)
            return l
        }
        ty := self.parse_type()
        self.add(l, ty)
        return l
    }

    func parse_extern(edit self) -> usize {
        t := self.expect(KW_EXTERN)
        abi := self.expect(STR)
        f := self.expect(KW_FUNC)
        n := self.expect(IDENT)
        d := self.mk(N_FUNC, n.s, n.e)
        self.setp(d, t.s, t.e)
        ps := self.parse_params()
        ret := self.parse_ret()
        self.setpe_prev(d)
        var body: usize = 0usize
        if self.at(LBRACE) {
            body = self.parse_block()
            self.setpe_prev(d)
        } else {
            self.stmt_end()
        }
        sv := self.mk(N_STRV, abi.s, abi.e)
        tps := self.list()
        wh := self.list()
        self.add(d, 0usize)
        self.add(d, tps)
        self.add(d, ps)
        self.add(d, ret)
        self.add(d, wh)
        self.add(d, body)
        self.add(d, sv)
        return d
    }

    // const and thread_local: name, kids type and value
    func parse_const(edit self, kind: u32, kw: u32) -> usize {
        t := self.expect(kw)
        n := self.expect(IDENT)
        d := self.mk(kind, n.s, n.e)
        c := self.expect(COLON)
        ty := self.parse_type()
        a := self.expect(ASSIGN)
        v := self.parse_expr()
        self.span_tn(d, t.s, v)
        self.add(d, ty)
        self.add(d, v)
        self.stmt_end()
        return d
    }

    func parse_assert(edit self) -> usize {
        t := self.expect(KW_UNSAFE)
        a := self.expect(KW_ASSERT)
        m := self.expect(IDENT)
        f := self.expect(KW_FOR)
        tn := self.parse_tname()
        self.stmt_end()
        d := self.mk(N_ASSERT, m.s, m.e)
        self.span_tn(d, t.s, tn)
        self.add(d, tn)
        return d
    }
}
