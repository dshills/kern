-- a program and its instructions
    | fn sum_to(n) {
    |     let total = 0
    |     let i = 1
    |     while i <= n && total >= 0 {
    |         total = total + i
    |         i = i + 1
    |     }
    |     return total
    | }
    | let scale = 2.5
    | print("sum:", sum_to(10) * scale)
