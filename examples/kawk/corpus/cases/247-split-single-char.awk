BEGIN { n = split("a:b:c", p, ":"); print n, p[1], p[2], p[3]; n = split(":a::b:", p, ":"); print n; for (i = 1; i <= n; i++) printf "[%s]", p[i]; print ""; n = split("a b", p, " "); print n; n = split("a|b|c", p, "|"); print n, p[2]; n = split("a.b.c", p, "."); print n; n = split("a\nb:c", p, ":"); print n, p[1], p[2]; n = split("abc", p, "b"); print n, p[1] p[2]; n = split("a b c", p, "\t"); print n }
