function tobase(n, b,  d, r) { d = "0123456789abcdef"; if (n == 0) return "0"; while (n > 0) { r = substr(d, n % b + 1, 1) r; n = int(n / b) }; return r } function frombase(s, b,  i, n) { for (i = 1; i <= length(s); i++) n = n * b + index("0123456789abcdef", substr(s, i, 1)) - 1; return n } BEGIN { print tobase(255, 2), tobase(255, 16), tobase(1000, 8), frombase("ff", 16), frombase("1010", 2), tobase(2 ^ 40, 16) }
