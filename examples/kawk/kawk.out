== functions: recursion, locals, arrays by reference ==
    | function fact(n) { return n <= 1 ? 1 : n * fact(n - 1) }
    | function fib(n) { return n < 2 ? n : fib(n - 1) + fib(n - 2) }
    | function gcd(a, b) { return b == 0 ? a : gcd(b, a % b) }
    | function hanoi(n, from, to, via) {
    |     if (n == 0) return 0
    |     return hanoi(n - 1, from, via, to) + 1 + hanoi(n - 1, via, to, from)
    | }
    | function fill(arr, n,   i) { for (i = 1; i <= n; i++) arr[i] = i * i }
    | function sum(arr,   k, s) { for (k in arr) s += arr[k]; return s }
    | function reverse(s,   i, r) { for (i = length(s); i > 0; i--) r = r substr(s, i, 1); return r }
    | function twice(x) { x = x x; return x }
    | BEGIN {
    |     print fact(10), fact(20), fib(12), gcd(1071, 462), hanoi(6, "a", "c", "b")
    |     fill(squares, 10); print sum(squares), length(squares)
    |     i = "kept"; s = "abc"; print reverse("kern awk"), twice(s), s, i
    | }
3628800 2432902008176640000 144 21 63
385 10
kwa nrek abcabc abc kept

== regular expressions: match, sub, gsub, split ==
    | BEGIN {
    |     s = "The year 1999 and the year 2024"
    |     print match(s, /[0-9]+/), RSTART, RLENGTH, substr(s, RSTART, RLENGTH)
    |     print match(s, /x+/), RSTART, RLENGTH
    |     print match("xabcabcabcy", /(abc)+/), RLENGTH, match("foobar", /foo|foobar/), RLENGTH
    |     t = s; n = gsub(/[0-9]+/, "<&>", t); print n, t
    |     t = s; sub(/year/, "month", t); print t
    |     t = s; gsub(/the|The/, "", t); gsub(/  +/, " ", t); sub(/^ /, "", t); print t
    |     t = "a.b.c"; gsub(/\./, "\\&", t); print t
    |     t = "banana"; print gsub(/a/, "&&", t), t, gsub(/x*/, "-", t), t
    |     n = split("2024-11-12T08:30:00", p, /[-T:]/); print n, p[1], p[3], p[6]
    |     n = split("a1b22c333d", q, /[0-9]+/); print n, q[1] q[2] q[3] q[4]
    |     pat = "^[A-Z][a-z]+$"; print ("Kern" ~ pat), ("kern" ~ pat), ("KERN" !~ pat)
    |     print ("aaa" ~ /^a{2,3}$/), ("aaaa" ~ /^a{2,3}$/), ("x9" ~ /^[[:alpha:]][[:digit:]]$/)
    | }
    | /[aeiou][aeiou]/ { print "two vowels together: " $0 }
    | $0 ~ "^.[^ ]* [a-z]" && !/q/ { gsub(/[^a-z]/, ""); print "letters: " $0 }
10 10 4 1999
0 0 -1
2 9 1 6
