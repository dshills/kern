== printf: every conversion, flags, width and precision ==
    | BEGIN {
    |     printf "%d|%5d|%-5d|%05d|%+d|% d|%.3d|%i\n", 42, 42, 42, 42, 42, 42, 7, -7.9
    |     printf "%o|%x|%X|%#o|%#x|%u|%c|%c|%c\n", 64, 255, 255, 8, 255, 3000000000, 65, "kern", 256 + 66
    |     printf "%f|%.2f|%8.3f|%-8.1f|%+.0f|%e|%.2E\n", 3.14159, 2.675, 3.14159, 2.5, 0.5, 12345.678, 0.000123
    |     printf "%g|%g|%g|%g|%G|%.3g|%#.3g|%.10g\n", 100000, 1000000, 0.0001, 0.00001, 1e-10, 1234567, 1.5, 0.1
    |     printf "%s|%10s|%-10s|%.2s|%5.1s|%%|%5s|\n", "kern", "right", "left", "truncate", "x", 3.0
    |     printf "%*d|%-*d|%.*f|%*.*f\n", 6, 42, 6, 42, 2, 3.14159, 9, 4, 3.14159
    |     printf "%s %s %s %d %d\n", 1e6, 0.1 + 0.2, 1e300 * 10, "12abc", 2 ^ 31
    |     OFMT = "%.2f"; CONVFMT = "%.3g"; x = 3.14159; print x, x "", 17, 1e3
    | }
