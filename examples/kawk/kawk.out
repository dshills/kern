== fields, NF and assigning to a field ==
    | { print NR ": " NF " fields, first [" $1 "] last [" $NF "]" }
    | NR == 2 { $2 = "CHANGED"; print; print NF }
    | NR == 3 { $6 = "sixth"; print; NF = 2; print; print NF }
    | NR == 4 { print "empty record: NF is " NF " and $1 is [" $1 "]" }
    | END { OFS = "-"; $0 = "a b c"; $1 = $1; print; print $(NF - 1) $NF; print NR " records" }
1: 3 fields, first [alpha] last [gamma]
2: 3 fields, first [leading] last [trailing]
leading CHANGED trailing
3
3: 3 fields, first [one] last [three]
one two three   sixth
one two
2
4: 0 fields, first [] last []
empty record: NF is 0 and $1 is []
5: 1 fields, first [last-one] last [last-one]
