== separators: one character, a tab, a regular expression, none, and paragraphs ==
    | BEGIN {
    |     FS = ":"; $0 = "root:x:0:0::/root:/bin/sh"; print NF, $1, $6, "[" $5 "]"
    |     FS = "\t"; $0 = "a b\tc d\t\te"; print NF, $2, "[" $3 "]"
    |     FS = ", *|;"; $0 = "p, q,r;s"; print NF, $1 $2 $3 $4
    |     FS = "|"; $0 = "x|y|z"; print NF, $2
    |     FS = ""; $0 = "kern"; print NF, $4 $3 $2 $1
    |     FS = " "; RS = ""
    | }
    | { print "paragraph " NR ": " NF " words, from " $1 " to " $NF }
    | END { RS = ";"; print NR " paragraphs" }
7 root /root []
4 c d []
4 pqrs
3 y
4 nrek
paragraph 1: 6 words, from the to lines
paragraph 2: 2 words, from the to second
paragraph 3: 6 words, from the to long
3 paragraphs

== patterns: regular expressions, comparisons, ranges, next ==
    | /^#/ { comments++; next }
    | /start/, /stop/ { print "in range:  " $0; next }
    | $2 >= 10 && $1 ~ /^[a-c]/ { print "big a-c:   " $1, $2 }
    | $2 < 10
    | NR == 2, NR == 4 { early++ }
    | END { print comments " comments, " early " early, " NR " lines" }
big a-c:   alpha 12
beta 7
in range:  start here
in range:  gamma 99
in range:  stop here
big a-c:   carol 31
zeta 3
2 comments, 5 early, 10 lines

== arrays: counting, in, delete, several subscripts, for in ==
    | function sorted(arr, keys,   n, i, j, t, k) {
    |     for (k in arr) keys[++n] = k
    |     for (i = 2; i <= n; i++) {
    |         t = keys[i]
    |         for (j = i - 1; j >= 1 && keys[j] > t; j--) keys[j + 1] = keys[j]
    |         keys[j + 1] = t
    |     }
    |     return n
    | }
    | { for (i = 1; i <= NF; i++) count[tolower($i)]++ }
    | END {
    |     n = sorted(count, words)
    |     for (i = 1; i <= n; i++) if (count[words[i]] > 1) printf "%-6s %d\n", words[i], count[words[i]]
    |     print n " different words;", ("fox" in count) ? "a fox," : "no fox,", ("cat" in count) ? "a cat" : "no cat"
    |     delete count["the"]; print length(count) " after delete"
    |     for (r = 1; r <= 3; r++) for (c = 1; c <= 3; c++) grid[r, c] = r * c
    |     print grid[2, 3], ((3, 3) in grid), ((4, 1) in grid), length(grid)
    |     for (k in grid) { split(k, rc, SUBSEP); total += rc[1] * 10 + rc[2] }
    |     print total
    |     delete grid; print length(grid)
    | }
dog    2
fox    3
quick  2
the    4
13 different words; a fox, no cat
12 after delete
6 1 0 9
198
