// Regular expressions: POSIX extended syntax as AWK writes it, compiled to
// a small machine and run with every alternative at once, so the time is
// at most the text's length times the pattern's size whatever the
// pattern. A search returns the leftmost match and, of those, the longest.
module lang
import "std/str"

// Set256 is a set of bytes.
struct Set256 { w: [4]u64 }

func set_has(s: view[Set256], b: u8) -> bool { return (s.w[usize(b >> 6u32)] >> u32(b & 63u8)) & 1u64 == 1u64 }
func set_add(s: edit[Set256], b: u8) {
    i := usize(b >> 6u32)
    s.w[i] = s.w[i] | wrapping_shl(1u64, u32(b & 63u8))
}
func set_range(s: edit[Set256], lo: u8, hi: u8) {
    var c: u32 = u32(lo)
    while c <= u32(hi) {
        set_add(s, truncate[u8](c))
        c = c + 1u32
    }
}
func set_invert(s: edit[Set256]) {
    for i in 0usize..4usize { s.w[i] = s.w[i] ^ 18446744073709551615u64 }
}
func set_union(s: edit[Set256], o: view[Set256]) {
    for i in 0usize..4usize { s.w[i] = s.w[i] | o.w[i] }
}

// RNode is a node of a pattern's tree; hi of a Rep is no_limit for {n,}.
union RNode {
    Empty
    Byte(b: u8)
    Any
    Set(k: u32)
    Cat(a: u32, b: u32)
    Alt(a: u32, b: u32)
    Star(a: u32)
    Plus(a: u32)
    Quest(a: u32)
    Rep(a: u32, lo: u32, hi: u32)
    Bol
    Eol
}
const no_limit: u32 = 4294967295u32
const max_program: usize = 200000usize

// Inst is an instruction of the machine: the first three take a byte,
// the others are followed without taking one.
union Inst { Byte(b: u8); Any; Set(k: u32); Split(x: u32, y: u32); Jmp(x: u32); Bol; Eol; Match }

// Regex is a compiled pattern. lit holds the text of a pattern that is
// nothing but literal bytes, which is then searched for as a string;
// first is the set of bytes a match can begin with, of use when the
// pattern cannot match the empty string (nullable).
struct Regex {
    prog: Vec[Inst]
    sets: Vec[Set256]
    lit: Vec[u8]
    is_lit: bool
    anchored: bool
    nullable: bool
    first: Set256
    bad: bool
}

struct RParser { src: Vec[u8]; pos: usize; nodes: Vec[RNode]; sets: Vec[Set256]; bad: bool; depth: u32 }

func is_octal(c: u8) -> bool { return c >= 48u8 && c <= 55u8 }
func hex_value(c: u8) -> u32 {
    if c >= 48u8 && c <= 57u8 { return u32(c - 48u8) }
    if c >= 97u8 && c <= 102u8 { return u32(c - 87u8) }
    if c >= 65u8 && c <= 70u8 { return u32(c - 55u8) }
    return 16u32
}

// class_set adds a named class of a bracket expression; false for a name
// that is none.
func class_set(s: edit[Set256], name: view[]u8) -> bool {
    if str.equal(name, "alpha") { set_range(s, 65u8, 90u8); set_range(s, 97u8, 122u8); return true }
    if str.equal(name, "digit") { set_range(s, 48u8, 57u8); return true }
    if str.equal(name, "alnum") { set_range(s, 48u8, 57u8); set_range(s, 65u8, 90u8); set_range(s, 97u8, 122u8); return true }
    if str.equal(name, "upper") { set_range(s, 65u8, 90u8); return true }
    if str.equal(name, "lower") { set_range(s, 97u8, 122u8); return true }
    if str.equal(name, "space") { set_range(s, 9u8, 13u8); set_add(s, 32u8); return true }
    if str.equal(name, "blank") { set_add(s, 9u8); set_add(s, 32u8); return true }
    if str.equal(name, "punct") { set_range(s, 33u8, 47u8); set_range(s, 58u8, 64u8); set_range(s, 91u8, 96u8); set_range(s, 123u8, 126u8); return true }
    if str.equal(name, "print") { set_range(s, 32u8, 126u8); return true }
    if str.equal(name, "graph") { set_range(s, 33u8, 126u8); return true }
    if str.equal(name, "cntrl") { set_range(s, 0u8, 31u8); set_add(s, 127u8); return true }
    if str.equal(name, "xdigit") { set_range(s, 48u8, 57u8); set_range(s, 65u8, 70u8); set_range(s, 97u8, 102u8); return true }
    return false
}

impl RParser {
    func add(edit self, n: RNode) -> u32 {
        id := truncate[u32](self.nodes.len())
        self.nodes.push(n)
        return id
    }
    func more(view self) -> bool { return self.pos < self.src.len() }
    func cur(view self) -> u8 {
        c := self.src.get(self.pos)
        return c
    }
    func byte_at(view self, i: usize) -> u8 {
        if i >= self.src.len() { return 0u8 }
        c := self.src.get(i)
        return c
    }

    // escape reads what follows a backslash and returns the byte it means.
    func escape(edit self) -> u8 {
        if !self.more() { return 92u8 }
        c := self.cur()
        self.pos = self.pos + 1usize
        if c == 110u8 { return 10u8 }
        if c == 116u8 { return 9u8 }
        if c == 114u8 { return 13u8 }
        if c == 102u8 { return 12u8 }
        if c == 98u8 { return 8u8 }
        if c == 118u8 { return 11u8 }
        if c == 97u8 { return 7u8 }
        if is_octal(c) {
            var v: u32 = u32(c - 48u8)
            var k: u32 = 1u32
            while k < 3u32 && self.more() && is_octal(self.cur()) {
                v = v * 8u32 + u32(self.cur() - 48u8)
                self.pos = self.pos + 1usize
                k = k + 1u32
            }
            return truncate[u8](v)
        }
        if c == 120u8 && hex_value(self.byte_at(self.pos)) < 16u32 {
            var v: u32 = 0u32
            var k: u32 = 0u32
            while k < 2u32 && hex_value(self.byte_at(self.pos)) < 16u32 {
                v = v * 16u32 + hex_value(self.byte_at(self.pos))
                self.pos = self.pos + 1usize
                k = k + 1u32
            }
            return truncate[u8](v)
        }
        // \x with no hexadecimal digit after it is the zero byte, as the
        // system awk reads it: no text holds one, so it matches nothing
        if c == 120u8 { return 0u8 }
        return c
    }

    func alt(edit self) -> u32 {
        var left: u32 = self.cat()
        while self.more() && self.cur() == 124u8 {
            self.pos = self.pos + 1usize
            right := self.cat()
            left = self.add(RNode.Alt(left, right))
        }
        return left
    }

    func cat(edit self) -> u32 {
        var left: u32 = no_limit
        while self.more() && !self.bad {
            c := self.cur()
            if c == 124u8 { break }
            if c == 41u8 && self.depth > 0u32 { break }
            right := self.rep()
            if left == no_limit { left = right } else { left = self.add(RNode.Cat(left, right)) }
        }
        if left == no_limit { return self.add(RNode.Empty) }
        return left
    }

    // interval reads {n}, {n,} or {n,m} at pos and returns true, with the
    // bounds in lo and hi; a brace that begins none is left where it is.
    func interval(edit self, lo: edit[u32], hi: edit[u32]) -> bool {
        var i: usize = self.pos + 1usize
        var a: u32 = 0u32
        var digits: u32 = 0u32
        while is_digit(self.byte_at(i)) && digits < 6u32 {
            a = a * 10u32 + u32(self.byte_at(i) - 48u8)
            i = i + 1usize
            digits = digits + 1u32
        }
        if digits == 0u32 { return false }
        var b: u32 = a
        if self.byte_at(i) == 44u8 {
            i = i + 1usize
            if self.byte_at(i) == 125u8 {
                b = no_limit
            } else {
                b = 0u32
                digits = 0u32
                while is_digit(self.byte_at(i)) && digits < 6u32 {
                    b = b * 10u32 + u32(self.byte_at(i) - 48u8)
                    i = i + 1usize
                    digits = digits + 1u32
                }
                if digits == 0u32 { return false }
            }
        }
        if self.byte_at(i) != 125u8 || i >= self.src.len() { return false }
        if b < a { return false }
        self.pos = i + 1usize
        lo = a
        hi = b
        return true
    }

    func rep(edit self) -> u32 {
        var e: u32 = self.atom()
        while self.more() && !self.bad {
            c := self.cur()
            if c == 42u8 {
                self.pos = self.pos + 1usize
                e = self.add(RNode.Star(e))
            } else if c == 43u8 {
                self.pos = self.pos + 1usize
                e = self.add(RNode.Plus(e))
            } else if c == 63u8 {
                self.pos = self.pos + 1usize
                e = self.add(RNode.Quest(e))
            } else if c == 123u8 {
                var lo: u32 = 0u32
                var hi: u32 = 0u32
                if !self.interval(lo, hi) { break }
                e = self.add(RNode.Rep(e, lo, hi))
            } else {
                break
            }
        }
        return e
    }

    func bracket(edit self) -> u32 {
        s := Set256 { w: zero() }
        var negate: bool = false
        if self.more() && self.cur() == 94u8 {
            negate = true
            self.pos = self.pos + 1usize
        }
        var first: bool = true
        var closed: bool = false
        // cut: an escape gave the zero byte, which ends the class's members
        // for the system awk (its class is a C string): the rest is read
        // and left out
        var cut: bool = false
        while self.more() {
            var c: u8 = self.cur()
            if c == 93u8 && !first {
                self.pos = self.pos + 1usize
                closed = true
                break
            }
            first = false
            if c == 91u8 && self.byte_at(self.pos + 1usize) == 58u8 {
                // [:name:]
                var j: usize = self.pos + 2usize
                while j < self.src.len() && self.byte_at(j) != 58u8 { j = j + 1usize }
                if self.byte_at(j) == 58u8 && self.byte_at(j + 1usize) == 93u8 {
                    var known: bool = false
                    with text := self.src.as_view() { known = class_set(s, text[self.pos + 2usize : j]) }
                    if known {
                        self.pos = j + 2usize
                        continue
                    }
                }
            }
            self.pos = self.pos + 1usize
            if c == 92u8 {
                c = self.escape()
                if c == 0u8 { cut = true }
            }
            // a range, unless the - is the last thing in the brackets
            if self.byte_at(self.pos) == 45u8 && self.pos + 1usize < self.src.len() && self.byte_at(self.pos + 1usize) != 93u8 {
                self.pos = self.pos + 1usize
                var d: u8 = self.cur()
                self.pos = self.pos + 1usize
                if d == 92u8 { d = self.escape() }
                if c <= d && !cut { set_range(s, c, d) }
            } else if !cut {
                set_add(s, c)
            }
        }
        if !closed { self.bad = true }
        // a class with no member (a range written backwards and nothing
        // else) matches the empty string, as the system awk has it: it is
        // written as a class that matches no byte, optionally, so that it
        // is not taken for the empty expression (which split treats apart)
        if !negate && s.w[0usize] == 0u64 && s.w[1usize] == 0u64 && s.w[2usize] == 0u64 && s.w[3usize] == 0u64 {
            k := truncate[u32](self.sets.len())
            self.sets.push(s)
            none := self.add(RNode.Set(k))
            return self.add(RNode.Quest(none))
        }
        if negate { set_invert(s) }
        k := truncate[u32](self.sets.len())
        self.sets.push(s)
        return self.add(RNode.Set(k))
    }

    func atom(edit self) -> u32 {
        c := self.cur()
        self.pos = self.pos + 1usize
        if c == 40u8 {
            if self.depth > 200u32 {
                self.bad = true
                return self.add(RNode.Empty)
            }
            self.depth = self.depth + 1u32
            e := self.alt()
            self.depth = self.depth - 1u32
            if self.more() && self.cur() == 41u8 { self.pos = self.pos + 1usize } else { self.bad = true }
            return e
        }
        if c == 91u8 { return self.bracket() }
        if c == 46u8 { return self.add(RNode.Any) }
        if c == 94u8 { return self.add(RNode.Bol) }
        if c == 36u8 { return self.add(RNode.Eol) }
        if c == 92u8 {
            b := self.escape()
            return self.add(RNode.Byte(b))
        }
        return self.add(RNode.Byte(c))
    }
}

// RCompiler turns a tree into instructions.
struct RCompiler { nodes: Vec[RNode]; prog: Vec[Inst]; bad: bool }

impl RCompiler {
    func here(view self) -> u32 { return truncate[u32](self.prog.len()) }
    func patch(edit self, at: u32, ins: Inst) {
        with slot := self.prog.at(usize(at)) { slot = ins }
    }
    func emit(edit self, n: u32) {
        if self.prog.len() > max_program {
            self.bad = true
            return
        }
        nd := self.nodes.get(usize(n))
        match nd {
            Empty => { }
            Byte(b) => { self.prog.push(Inst.Byte(b)) }
            Any => { self.prog.push(Inst.Any) }
            Set(k) => { self.prog.push(Inst.Set(k)) }
            Bol => { self.prog.push(Inst.Bol) }
            Eol => { self.prog.push(Inst.Eol) }
            Cat(a, b) => {
                self.emit(a)
                self.emit(b)
            }
            Alt(a, b) => {
                split := self.here()
                self.prog.push(Inst.Jmp(0u32))
                self.emit(a)
                jump := self.here()
                self.prog.push(Inst.Jmp(0u32))
                self.patch(split, Inst.Split(split + 1u32, self.here()))
                self.emit(b)
                self.patch(jump, Inst.Jmp(self.here()))
            }
            Star(a) => { self.star(a) }
            Plus(a) => {
                start := self.here()
                self.emit(a)
                self.prog.push(Inst.Split(start, self.here() + 1u32))
            }
            Quest(a) => { self.quest(a) }
            Rep(a, lo, hi) => {
                var i: u32 = 0u32
                while i < lo && !self.bad {
                    self.emit(a)
                    i = i + 1u32
                }
                if hi == no_limit {
                    self.star(a)
                } else {
                    while i < hi && !self.bad {
                        self.quest(a)
                        i = i + 1u32
                    }
                }
            }
        }
    }
    func star(edit self, a: u32) {
        split := self.here()
        self.prog.push(Inst.Jmp(0u32))
        self.emit(a)
        self.prog.push(Inst.Jmp(split))
        self.patch(split, Inst.Split(split + 1u32, self.here()))
    }
    func quest(edit self, a: u32) {
        split := self.here()
        self.prog.push(Inst.Jmp(0u32))
        self.emit(a)
        self.patch(split, Inst.Split(split + 1u32, self.here()))
    }

    func nullable(view self, n: u32) -> bool {
        nd := self.nodes.get(usize(n))
        match nd {
            Byte(b) => { return false }
            Any => { return false }
            Set(k) => { return false }
            Cat(a, b) => { return self.nullable(a) && self.nullable(b) }
            Alt(a, b) => { return self.nullable(a) || self.nullable(b) }
            Plus(a) => { return self.nullable(a) }
            Rep(a, lo, hi) => { return lo == 0u32 || self.nullable(a) }
            _ => { return true }
        }
    }
    // first adds to s every byte a match of n can begin with.
    func first(view self, n: u32, sets: view[]Set256, s: edit[Set256]) {
        nd := self.nodes.get(usize(n))
        match nd {
            Byte(b) => { set_add(s, b) }
            Any => { set_range(s, 0u8, 255u8) }
            Set(k) => { set_union(s, sets[usize(k)]) }
            Cat(a, b) => {
                self.first(a, sets, s)
                if self.nullable(a) { self.first(b, sets, s) }
            }
            Alt(a, b) => {
                self.first(a, sets, s)
                self.first(b, sets, s)
            }
            Star(a) => { self.first(a, sets, s) }
            Plus(a) => { self.first(a, sets, s) }
            Quest(a) => { self.first(a, sets, s) }
            Rep(a, lo, hi) => { self.first(a, sets, s) }
            _ => { }
        }
    }
    // begins_anchored: every match of n begins with ^.
    func begins_anchored(view self, n: u32) -> bool {
        nd := self.nodes.get(usize(n))
        match nd {
            Bol => { return true }
            Cat(a, b) => { return self.begins_anchored(a) }
            Alt(a, b) => { return self.begins_anchored(a) && self.begins_anchored(b) }
            _ => { return false }
        }
    }
    // literal appends the bytes of n when n is literal bytes and nothing
    // else, and says whether it is.
    func literal(view self, n: u32, dst: edit[Vec[u8]]) -> bool {
        nd := self.nodes.get(usize(n))
        match nd {
            Byte(b) => {
                dst.push(b)
                return true
            }
            Cat(a, b) => { return self.literal(a, dst) && self.literal(b, dst) }
            _ => { return false }
        }
    }
}

// regex_compile compiles a pattern; the result's bad is set when the
// pattern is not well formed.
func regex_compile(src: view[]u8) -> Regex {
    rp := RParser { src: Vec[u8].new(), pos: 0usize, nodes: Vec[RNode].new(), sets: Vec[Set256].new(), bad: false, depth: 0u32 }
    rp.src.extend(src)
    root := rp.alt()
    if rp.more() { rp.bad = true }
    rc := RCompiler { nodes: replace(rp.nodes, Vec[RNode].new()), prog: Vec[Inst].new(), bad: rp.bad }
    re := Regex {
        prog: Vec[Inst].new(), sets: replace(rp.sets, Vec[Set256].new()), lit: Vec[u8].new(), is_lit: false, anchored: false,
        nullable: true, first: Set256 { w: zero() }, bad: false
    }
    if !rc.bad { rc.emit(root) }
    rc.prog.push(Inst.Match)
    if rc.bad {
        re.bad = true
        return re
    }
    re.nullable = rc.nullable(root)
    rc.first(root, re.sets.as_view(), re.first)
    re.anchored = rc.begins_anchored(root)
    lit := Vec[u8].new()
    if rc.literal(root, lit) && lit.len() > 0usize {
        re.is_lit = true
        re.lit = lit
    } else {
        drop(lit)
    }
    re.prog = replace(rc.prog, Vec[Inst].new())
    return re
}

// Hit is the result of a search: the match is text[start:end].
struct Hit { found: bool; start: usize; end: usize }

// Scratch is the memory a search works in, kept between searches.
struct Scratch {
    clist: Vec[u32]
    cstart: Vec[usize]
    nlist: Vec[u32]
    nstart: Vec[usize]
    mark: Vec[u32]
    gen: u32
    stack: Vec[u32]
}

func new_scratch() -> Scratch {
    return Scratch {
        clist: Vec[u32].new(), cstart: Vec[usize].new(), nlist: Vec[u32].new(), nstart: Vec[usize].new(), mark: Vec[u32].new(),
        gen: 0u32, stack: Vec[u32].new()
    }
}

// re_add puts on a list the instruction at pc0 and everything reachable
// from it without taking a byte, for a thread that began at st and is now
// at pos. An instruction already on the list belongs to a thread that
// began no later, which is the one to keep. Reaching Match records a
// match when it is better than the best so far.
func re_add(re: view[Regex], sc: edit[Scratch], next: bool, pc0: u32, st: usize, pos: usize, n: usize, mode: u8, best: edit[Hit]) {
    sc.stack.push(pc0)
    while true {
        var pc: u32 = 0u32
        match sc.stack.pop() {
            Some(x) => { pc = x }
            None => { break }
        }
        seen := sc.mark.get(usize(pc))
        if seen == sc.gen { continue }
        with m := sc.mark.at(usize(pc)) { m = sc.gen }
        ins := re.prog.get(usize(pc))
        match ins {
            Jmp(x) => { sc.stack.push(x) }
            Split(x, y) => {
                sc.stack.push(y)
                sc.stack.push(x)
            }
            Bol => {
                if pos == 0usize && mode & re_notbol == 0u8 { sc.stack.push(pc + 1u32) }
            }
            Eol => {
                if pos == n { sc.stack.push(pc + 1u32) }
            }
            Match => {
                if mode & re_nonempty != 0u8 && pos == st {
                    // an empty match is not wanted
                } else if !best.found || st < best.start || (st == best.start && pos > best.end) {
                    best.found = true
                    best.start = st
                    best.end = pos
                }
            }
            _ => {
                if next {
                    sc.nlist.push(pc)
                    sc.nstart.push(st)
                } else {
                    sc.clist.push(pc)
                    sc.cstart.push(st)
                }
            }
        }
    }
}

// The ways of a search, added together: re_notbol says that ^ matches
// nowhere (the text is the rest of a string already searched); re_any
// returns the first match found, which answers whether there is one at
// less cost; re_nonempty passes over a match of no bytes.
const re_notbol: u8 = 1u8
const re_any: u8 = 2u8
const re_nonempty: u8 = 4u8

// re_search finds the leftmost longest match of re in text at or after
// from.
func re_search(re: view[Regex], sc: edit[Scratch], text: view[]u8, from: usize, mode: u8) -> Hit {
    notbol := mode & re_notbol != 0u8
    any := mode & re_any != 0u8
    n := len(text)
    best := Hit { found: false, start: 0usize, end: 0usize }
    if from > n { return best }
    if re.is_lit {
        match str.find(text[from:n], re.lit.as_view()) {
            Some(k) => { return Hit { found: true, start: from + k, end: from + k + re.lit.len() } }
            None => { return best }
        }
    }
    if re.anchored && (from > 0usize || notbol) { return best }
    np := re.prog.len()
    if sc.mark.len() < np { sc.mark.resize(np, 0u32) }
    if sc.gen >= 4294967000u32 {
        // the stamps would wrap: clear them
        size := sc.mark.len()
        sc.mark.clear()
        sc.mark.resize(size, 0u32)
        sc.gen = 0u32
    }
    sc.clist.clear()
    sc.cstart.clear()
    sc.gen = sc.gen + 1u32
    var pos: usize = from
    while true {
        // a thread that begins here, unless a match has been found (a
        // later beginning cannot be better) or no match can begin here
        if !best.found && (!re.anchored || pos == 0usize) {
            if re.nullable || (pos < n && set_has(re.first, text[pos])) { re_add(re, sc, false, 0u32, pos, pos, n, mode, best) }
        }
        if best.found && any { return best }
        if pos >= n { break }
        if sc.clist.len() == 0usize {
            if best.found || re.anchored { break }
            // nothing is under way: go on to the next byte that can begin a match
            pos = pos + 1usize
            if !re.nullable {
                while pos < n && !set_has(re.first, text[pos]) { pos = pos + 1usize }
                if pos >= n { break }
            }
            sc.gen = sc.gen + 1u32
            continue
        }
        c := text[pos]
        sc.gen = sc.gen + 1u32
        count := sc.clist.len()
        for i in 0usize..count {
            st := sc.cstart.get(i)
            if best.found && st > best.start { break }
            pc := sc.clist.get(i)
            ins := re.prog.get(usize(pc))
            var ok: bool = false
            match ins {
                Byte(b) => { ok = b == c }
                Any => { ok = true }
                Set(k) => { ok = set_has(re.sets.get(usize(k)), c) }
                _ => { }
            }
            if ok { re_add(re, sc, true, pc + 1u32, st, pos + 1usize, n, mode, best) }
        }
        // the next list becomes the current one
        old := replace(sc.clist, Vec[u32].new())
        new := replace(sc.nlist, old)
        sc.clist = new
        sc.nlist.clear()
        olds := replace(sc.cstart, Vec[usize].new())
        news := replace(sc.nstart, olds)
        sc.cstart = news
        sc.nstart.clear()
        pos = pos + 1usize
    }
    return best
}
