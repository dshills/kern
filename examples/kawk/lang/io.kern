// Input and output: records and how they are split, the files and
// commands a program reads from and writes to, print and getline.
module lang
import "std/io"
import "std/process"
import "std/str"

// Source is where an input's bytes come from.
union Source { Closed; Stdin; File(f: io.File); Pipe(p: process.Pipe) }

// Input is a file or a command's output being read: buf[pos:end] are the
// bytes read and not yet taken.
struct Input { name: str.String; is_cmd: bool; src: Source; child: Option[process.Child]; buf: Vec[u8]; pos: usize; end: usize; eof: bool }

func new_input(name: view[]u8, is_cmd: bool) -> Input {
    return Input { name: str.String.from(name), is_cmd: is_cmd, src: Source.Closed, child: None, buf: Vec[u8].new(), pos: 0usize, end: 0usize, eof: false }
}

// Output is a file or a command being written to. std is 1 for the
// standard output under its name /dev/stdout and 2 for the standard error.
struct Output { name: str.String; is_cmd: bool; std: u8; file: Source; child: Option[process.Child]; buf: Vec[u8] }

impl Input {
    // fill reads more bytes after the ones held and reports whether it
    // got any; the bytes already taken are dropped first.
    func fill(edit self) -> bool {
        if self.eof { return false }
        if self.pos > 0usize {
            if self.pos == self.end {
                self.pos = 0usize
                self.end = 0usize
            } else if self.pos >= 32768usize {
                left := self.end - self.pos
                with b := self.buf.as_edit() {
                    for i in 0usize..left { b[i] = b[self.pos + i] }
                }
                self.pos = 0usize
                self.end = left
            }
        }
        if self.buf.len() - self.end < 16384usize {
            var size: usize = self.buf.len() * 2usize
            if size < 65536usize { size = 65536usize }
            self.buf.resize(size, 0u8)
        }
        var n: usize = 0usize
        cap := self.buf.len()
        with b := self.buf.as_edit() {
            match self.src {
                Stdin => {
                    inp := io.stdin()
                    match inp.read(b[self.end : cap]) {
                        Ok(k) => { n = k }
                        Err(e) => { }
                    }
                }
                File(f) => {
                    match f.read(b[self.end : cap]) {
                        Ok(k) => { n = k }
                        Err(e) => { }
                    }
                }
                Pipe(q) => {
                    match q.read(b[self.end : cap]) {
                        Ok(k) => { n = k }
                        Err(e) => { }
                    }
                }
                Closed => { }
            }
        }
        if n == 0usize {
            self.eof = true
            return false
        }
        self.end = self.end + n
        return true
    }

    // peek is the next byte, or -1 at the end.
    func peek(edit self) -> i32 {
        if self.pos >= self.end {
            if !self.fill() { return -1i32 }
        }
        b := self.buf.get(self.pos)
        return i32(b)
    }

    // read_to appends to rec the bytes up to the next `sep`, which it
    // takes too. It returns 1 when it found the separator, 0 when the
    // input ended first with some bytes, -1 when it ended with none.
    func read_to(edit self, sep: u8, rec: edit[str.String]) -> i32 {
        var any: bool = false
        while true {
            if self.pos >= self.end {
                if !self.fill() {
                    if any { return 0i32 }
                    return -1i32
                }
            }
            var found: bool = false
            var upto: usize = self.end
            with b := self.buf.as_view() {
                match str.find_byte(b[self.pos : self.end], sep) {
                    Some(k) => {
                        upto = self.pos + k
                        found = true
                    }
                    None => { }
                }
                rec.push_str(b[self.pos : upto])
            }
            if upto > self.pos { any = true }
            if found {
                self.pos = upto + 1usize
                return 1i32
            }
            self.pos = upto
        }
        return -1i32
    }

    // record appends the next record to rec and reports whether there
    // was one. mode 0 ends a record at the byte ch; mode 1 is paragraph
    // mode, where blank lines separate records; mode 2 ends it at a match
    // of re, for which the rest of the input is read first.
    func record(edit self, mode: u8, ch: u8, re: view[Regex], sc: edit[Scratch], rec: edit[str.String]) -> bool {
        if mode == 0u8 { return self.read_to(ch, rec) >= 0i32 }
        if mode == 1u8 {
            while self.peek() == 10i32 { self.pos = self.pos + 1usize }
            var any: bool = false
            while true {
                r := self.read_to(10u8, rec)
                if r < 0i32 { return any }
                any = true
                if r == 0i32 { return true }
                c := self.peek()
                if c < 0i32 { return true }
                if c == 10i32 {
                    self.pos = self.pos + 1usize
                    return true
                }
                rec.push(10u8)
            }
            return any
        }
        while self.fill() { }
        if self.pos >= self.end { return false }
        var hit: Hit = Hit { found: false, start: 0usize, end: 0usize }
        with b := self.buf.as_view() {
            hit = re_search(re, sc, b[self.pos : self.end], 0usize, re_nonempty)
            if hit.found { rec.push_str(b[self.pos : self.pos + hit.start]) } else { rec.push_str(b[self.pos : self.end]) }
        }
        if hit.found { self.pos = self.pos + hit.end } else { self.pos = self.end }
        return true
    }

    // shut closes the source and waits for the command, if it is one.
    func shut(edit self) {
        self.src = Source.Closed
        match replace(self.child, None) {
            Some(c) => {
                match c.wait() {
                    Ok(st) => { }
                    Err(e) => { }
                }
            }
            None => { }
        }
    }
}

impl Output {
    func flush(edit self) {
        if self.buf.len() == 0usize { return }
        if self.std == 2u8 {
            match io.write_stderr(self.buf.as_view()) {
                Ok(u) => { }
                Err(e) => { }
            }
        } else {
            match self.file {
                File(f) => {
                    match f.write_all(self.buf.as_view()) {
                        Ok(u) => { }
                        Err(e) => { }
                    }
                }
                Pipe(q) => {
                    match q.write_all(self.buf.as_view()) {
                        Ok(u) => { }
                        Err(e) => { }
                    }
                }
                _ => { }
            }
        }
        self.buf.clear()
    }
    func shut(edit self) {
        self.flush()
        self.file = Source.Closed
        match replace(self.child, None) {
            Some(c) => {
                match c.wait() {
                    Ok(st) => { }
                    Err(e) => { }
                }
            }
            None => { }
        }
    }
}

// split_text splits text into fields as mode says and appends their
// bounds to spans. In paragraph mode a newline separates fields too.
func split_text(text: view[]u8, mode: FsMode, re: view[Regex], sc: edit[Scratch], para: bool, spans: edit[Vec[Span]]) {
    n := len(text)
    if mode.kind == 0u8 {
        var i: usize = 0usize
        while true {
            while i < n && (text[i] == 32u8 || text[i] == 9u8 || text[i] == 10u8) { i = i + 1usize }
            if i >= n { break }
            lo := i
            while i < n && text[i] != 32u8 && text[i] != 9u8 && text[i] != 10u8 { i = i + 1usize }
            spans.push(Span { lo: lo, hi: i, ty: 0u8, n: 0.0 })
        }
        return
    }
    if n == 0usize { return }
    if mode.kind == 1u8 {
        var lo: usize = 0usize
        if !para {
            // one byte to look for: the library's search finds each
            var i: usize = 0usize
            while true {
                match str.find_byte(text[i:n], mode.ch) {
                    Some(k) => {
                        spans.push(Span { lo: i, hi: i + k, ty: 0u8, n: 0.0 })
                        i = i + k + 1usize
                    }
                    None => {
                        spans.push(Span { lo: i, hi: n, ty: 0u8, n: 0.0 })
                        break
                    }
                }
            }
            return
        }
        for i in 0usize..n {
            if text[i] == mode.ch || text[i] == 10u8 {
                spans.push(Span { lo: lo, hi: i, ty: 0u8, n: 0.0 })
                lo = i + 1usize
            }
        }
        spans.push(Span { lo: lo, hi: n, ty: 0u8, n: 0.0 })
        return
    }
    if mode.kind == 3u8 {
        for i in 0usize..n { spans.push(Span { lo: i, hi: i + 1usize, ty: 0u8, n: 0.0 }) }
        return
    }
    // a regular expression: each match that is not empty separates; after
    // the first, ^ no longer matches
    var lo: usize = 0usize
    var m: u8 = re_nonempty
    while true {
        h := re_search(re, sc, text, lo, m)
        if !h.found {
            spans.push(Span { lo: lo, hi: n, ty: 0u8, n: 0.0 })
            break
        }
        spans.push(Span { lo: lo, hi: h.start, ty: 0u8, n: 0.0 })
        lo = h.end
        m = re_nonempty | re_notbol
    }
}

func open_output(name: view[]u8, append: bool) -> Result[io.File, io.IoErr] {
    if append { return io.open_append(name) }
    return io.create(name)
}

// is_assignment reports whether an operand has the form name=value, and
// where its = is.
func is_assignment(s: view[]u8) -> usize {
    if len(s) == 0usize || !is_alpha(s[0usize]) { return 0usize }
    var i: usize = 1usize
    while i < len(s) && (is_alpha(s[i]) || is_digit(s[i])) { i = i + 1usize }
    if i < len(s) && s[i] == 61u8 { return i }
    return 0usize
}

// unescape_all is s with the escapes of a string taken.
func unescape_all(s: view[]u8) -> str.String {
    r := str.String.new()
    var i: usize = 0usize
    while i < len(s) {
        if s[i] == 92u8 {
            i = i + 1usize + unescape(s[i + 1usize : len(s)], r)
        } else {
            r.push(s[i])
            i = i + 1usize
        }
    }
    return r
}

impl Interp {
    // ---- the standard output ----

    func flush_stdout(edit self) {
        if self.obuf.len() > 0usize {
            print_str(self.obuf.as_view())
            self.obuf.clear()
        }
    }
    func write_stdout(edit self, data: view[]u8) {
        self.obuf.push_str(data)
        if self.obuf.len() >= 32768usize || self.tty { self.flush_stdout() }
    }
    // sync_stdout hands everything printed to the system, to files and
    // commands too, before a child runs that may share the standard
    // output or read what was written.
    func sync_stdout(edit self) {
        self.flush_stdout()
        for i in 0usize..self.outs.len() {
            with o := self.outs.at(i) { o.flush() }
        }
        match io.flush_stdout() {
            Ok(u) => { }
            Err(e) => { }
        }
    }

    // ---- assignments from the command line ----

    // assign_operand performs name=value: the value's escapes are taken,
    // and it is a number if it looks like one. A name the program never
    // mentions is assigned nowhere.
    func assign_operand(edit self, p: view[Prog], s: view[]u8, eq: usize) {
        match p.find_global(s[0usize:eq]) {
            Some(slot) => {
                if slot == VFS && self.reading && self.any_file {
                    // after the first file, the record being read is
                    // still split by the old FS, as in the one-true-awk:
                    // this one is set after it
                    self.late_fs = unescape_all(s[eq + 1usize : len(s)])
                    self.has_late_fs = true
                } else {
                    self.var_set(slot, input_own(unescape_all(s[eq + 1usize : len(s)])))
                }
            }
            None => { }
        }
    }

    // settle_fs performs an FS assignment that an operand made while a
    // record was being read, once that record has been split.
    func settle_fs(edit self) {
        if !self.has_late_fs { return }
        self.has_late_fs = false
        self.ensure_split()
        late := replace(self.late_fs, str.String.new())
        self.var_set(VFS, input_own(late))
    }

    // ---- the main input ----

    // open_next opens the next file the arguments name, performing the
    // assignments among them on the way; with no file named at all, the
    // standard input is the one file. It reports whether there is input.
    func open_next(edit self, p: view[Prog]) -> bool {
        argv := self.array_at(usize(VARGV))
        while true {
            argc := to_num(self.cells.get(usize(VARGC)).v)
            if self.argi >= argc {
                if self.any_file { return false }
                self.any_file = true
                self.open_stdin()
                return true
            }
            index := str.String.new()
            push_num(index, self.argi, "%.6g")
            key := Key { s: index }
            self.argi = self.argi + 1.0
            if !self.elem_exists(argv, key) { continue }
            arg := into_text(self.elem_get(argv, key), self.convfmt.as_view())
            if arg.len() == 0usize { continue }
            eq := is_assignment(arg.as_view())
            if eq > 0usize {
                self.assign_operand(p, arg.as_view(), eq)
                continue
            }
            self.any_file = true
            self.set_cell(usize(VFILENAME), text(arg.as_view()))
            self.fnr = 0.0
            if arg.equals("-") {
                self.open_stdin()
                return true
            }
            match io.open_read(arg.as_view()) {
                Ok(f) => {
                    self.main = new_input(arg.as_view(), false)
                    self.main.src = Source.File(f)
                    self.main_open = true
                    return true
                }
                Err(e) => {
                    self.fatal2("can't open file ", arg.as_view())
                    return false
                }
            }
        }
        return false
    }

    func open_stdin(edit self) {
        self.main = new_input("", false)
        if self.stdin_given {
            // the demonstration's input is held in memory
            self.main.buf = replace(self.stdin_text, Vec[u8].new())
            self.main.end = self.main.buf.len()
            self.main.eof = true
        } else {
            self.main.src = Source.Stdin
        }
        self.main_open = true
    }

    // main_record appends the next record of the main input to rec,
    // going on to the next file when one ends.
    func main_record(edit self, p: view[Prog], rec: edit[str.String]) -> bool {
        while self.halt != 2u8 {
            if !self.main_open {
                if !self.open_next(p) { return false }
            }
            if self.main.record(self.rs_mode, self.rs_ch, self.rs_re, self.scratch, rec) {
                self.nr = self.nr + 1.0
                self.fnr = self.fnr + 1.0
                return true
            }
            self.main.shut()
            self.main_open = false
        }
        return false
    }

    // next_record reads the next record of the main input into $0.
    func next_record(edit self, p: view[Prog]) -> bool {
        rec := str.String.new()
        self.reading = true
        got := self.main_record(p, rec)
        self.reading = false
        if got { self.set_record(rec) } else { drop(rec) }
        self.settle_fs()
        return got
    }

    // ---- getline ----

    // input_for finds the open input of a file or a command, opening it
    // the first time; the result is its place in ins, or -1.
    func input_for(edit self, name: view[]u8, is_cmd: bool) -> i64 {
        if len(name) == 0usize {
            self.fatal("null file name in print or getline")
            return -1i64
        }
        for i in 0usize..self.ins.len() {
            if self.ins.get(i).is_cmd == is_cmd && self.ins.get(i).name.equals(name) { return i64(i) }
        }
        inp := new_input(name, is_cmd)
        if is_cmd {
            self.sync_stdout()
            cmd := process.Command.new("/bin/sh")
            cmd.arg("-c")
            cmd.arg(name)
            cmd.stdout(process.Stdio.Piped)
            match cmd.spawn() {
                Ok(child) => {
                    match child.take_stdout() {
                        Ok(q) => { inp.src = Source.Pipe(q) }
                        Err(e) => { }
                    }
                    inp.child = Some(child)
                }
                Err(e) => { return -1i64 }
            }
        } else if str.equal(name, "-") || str.equal(name, "/dev/stdin") {
            inp.src = Source.Stdin
        } else {
            match io.open_read(name) {
                Ok(f) => { inp.src = Source.File(f) }
                Err(e) => { return -1i64 }
            }
        }
        self.ins.push(inp)
        return i64(self.ins.len()) - 1i64
    }

    // getline is every form of getline: 1 for a record read, 0 at the
    // end, -1 when the file cannot be read.
    func getline(edit self, p: view[Prog], kind: u8, lhs: u32, src: u32) -> f64 {
        rec := str.String.new()
        if kind == RNone {
            self.reading = lhs == NoNode
            got := self.main_record(p, rec)
            self.reading = false
            if !got {
                self.settle_fs()
                return 0.0
            }
            if lhs == NoNode {
                self.set_record(rec)
                self.settle_fs()
                return 1.0
            }
        } else {
            name := str.String.new()
            self.eval_text(p, src, name)
            at := self.input_for(name.as_view(), kind == RPipe)
            if at < 0i64 { return -1.0 }
            var got: bool = false
            with inp := self.ins.at(usize(at)) { got = inp.record(self.rs_mode, self.rs_ch, self.rs_re, self.scratch, rec) }
            if !got { return 0.0 }
        }
        if lhs == NoNode {
            self.set_record(rec)
        } else {
            self.store(p, lhs, input_own(rec))
        }
        return 1.0
    }

    // store assigns a value to what an lvalue node names.
    func store(edit self, p: view[Prog], lhs: u32, v: own Value) {
        lnd := p.nodes.get(usize(lhs))
        match lnd {
            Var(vr) => { self.var_set(vr, v) }
            Field(x) => {
                i := self.eval_num(p, x)
                self.field_set(i, v)
            }
            Index(vr, first, count) => {
                key := self.subscript(p, first, count)
                id := self.array_of(vr)
                self.elem_set(id, key, v)
            }
            _ => { drop(v) }
        }
    }

    // ---- print ----

    // output_for finds the open output of a file or a command, opening
    // it the first time; the result is its place in outs, or -1 after an
    // error was reported.
    func output_for(edit self, name: view[]u8, redir: u8) -> i64 {
        is_cmd := redir == RPipe
        if len(name) == 0usize {
            self.fatal("null file name in print or getline")
            return -1i64
        }
        for i in 0usize..self.outs.len() {
            if self.outs.get(i).is_cmd == is_cmd && self.outs.get(i).name.equals(name) { return i64(i) }
        }
        o := Output { name: str.String.from(name), is_cmd: is_cmd, std: 0u8, file: Source.Closed, child: None, buf: Vec[u8].new() }
        if is_cmd {
            self.sync_stdout()
            cmd := process.Command.new("/bin/sh")
            cmd.arg("-c")
            cmd.arg(name)
            cmd.stdin(process.Stdio.Piped)
            match cmd.spawn() {
                Ok(child) => {
                    match child.take_stdin() {
                        Ok(q) => { o.file = Source.Pipe(q) }
                        Err(e) => { }
                    }
                    o.child = Some(child)
                }
                Err(e) => {
                    self.fatal2("can't open pipe ", name)
                    return -1i64
                }
            }
        } else if str.equal(name, "/dev/stdout") {
            o.std = 1u8
        } else if str.equal(name, "/dev/stderr") {
            o.std = 2u8
        } else {
            match open_output(name, redir == RAppend) {
                Ok(f) => { o.file = Source.File(f) }
                Err(e) => {
                    self.fatal2("can't redirect to ", name)
                    return -1i64
                }
            }
        }
        self.outs.push(o)
        return i64(self.outs.len()) - 1i64
    }

    // emit writes data where a print's redirection says.
    func emit(edit self, p: view[Prog], redir: u8, dest: u32, data: view[]u8) {
        if redir == RNone {
            self.write_stdout(data)
            return
        }
        name := str.String.new()
        self.eval_text(p, dest, name)
        if self.halt != 0u8 { return }
        at := self.output_for(name.as_view(), redir)
        if at < 0i64 { return }
        var std: u8 = 0u8
        with o := self.outs.at(usize(at)) {
            std = o.std
            if std != 1u8 {
                o.buf.extend(data)
                if o.buf.len() >= 16384usize || std == 2u8 { o.flush() }
            }
        }
        if std == 1u8 { self.write_stdout(data) }
    }

    func print(edit self, p: view[Prog], first: u32, count: u32, redir: u8, dest: u32) {
        line := str.String.new()
        if count == 0u32 {
            line.push_str(self.rec.as_view())
        } else {
            for i in 0u32..count {
                if i > 0u32 { line.push_str(self.ofs.as_view()) }
                good := line.len()
                self.eval_print(p, p.kids.get(usize(first + i)), line)
                if self.halt != 0u8 {
                    // the items before the one that failed are written,
                    // as the one-true-awk writes each as it goes
                    with done := line.as_view() { self.emit(p, redir, dest, done[0usize:good]) }
                    return
                }
            }
        }
        line.push_str(self.ors.as_view())
        if self.halt != 0u8 { return }
        self.emit(p, redir, dest, line.as_view())
    }

    // sprintf formats the arguments after the first by the first. The
    // arguments are evaluated in order, and a variable that a conversion
    // reads as a number has been read as one (as_number) before the next
    // argument is evaluated, as in the one-true-awk, which evaluates each
    // argument when the format reaches it.
    func sprintf(edit self, p: view[Prog], first: u32, count: u32) -> str.String {
        res := str.String.new()
        fmt := str.String.new()
        self.eval_text(p, p.kids.get(usize(first)), fmt)
        kinds := Vec[bool].new()
        format_kinds(fmt.as_view(), kinds)
        args := Vec[Value].new()
        for i in 1u32..count {
            kid := p.kids.get(usize(first + i))
            args.push(self.eval(p, kid))
            at := usize(i) - 1usize
            if at < kinds.len() && kinds.get(at) {
                nd := p.nodes.get(usize(kid))
                match nd {
                    Var(vr) => { read := self.var_num(vr) }
                    _ => { }
                }
            }
        }
        if self.halt != 0u8 { return res }
        if !format(res, fmt.as_view(), args.as_view(), self.convfmt.as_view()) {
            self.fatal2("not enough arguments for the format ", fmt.as_view())
        }
        return res
    }

    func printf(edit self, p: view[Prog], first: u32, count: u32, redir: u8, dest: u32) {
        line := self.sprintf(p, first, count)
        if self.halt != 0u8 { return }
        self.emit(p, redir, dest, line.as_view())
    }

    // ---- closing ----

    // close_name closes the outputs and inputs open under a name and
    // returns 0, or -1 when there is none.
    func close_name(edit self, name: view[]u8) -> f64 {
        var found: bool = false
        var i: usize = 0usize
        while i < self.outs.len() {
            if self.outs.get(i).name.equals(name) {
                found = true
                with o := self.outs.at(i) { o.shut() }
                match self.outs.pop() {
                    Some(last) => {
                        if i < self.outs.len() {
                            with slot := self.outs.at(i) { slot = last }
                        } else {
                            drop(last)
                        }
                    }
                    None => { }
                }
            } else {
                i = i + 1usize
            }
        }
        i = 0usize
        while i < self.ins.len() {
            if self.ins.get(i).name.equals(name) {
                found = true
                with inp := self.ins.at(i) { inp.shut() }
                match self.ins.pop() {
                    Some(last) => {
                        if i < self.ins.len() {
                            with slot := self.ins.at(i) { slot = last }
                        } else {
                            drop(last)
                        }
                    }
                    None => { }
                }
            } else {
                i = i + 1usize
            }
        }
        if found { return 0.0 }
        return -1.0
    }

    // flush_all writes out what is buffered for every output.
    func flush_all(edit self) {
        self.flush_stdout()
        for i in 0usize..self.outs.len() {
            with o := self.outs.at(i) { o.flush() }
        }
    }

    // close_all ends the program's input and output: the standard output
    // first, then each file and command in the order it was opened.
    func close_all(edit self) {
        self.sync_stdout()
        for i in 0usize..self.outs.len() {
            with o := self.outs.at(i) { o.shut() }
        }
        for i in 0usize..self.ins.len() {
            with inp := self.ins.at(i) { inp.shut() }
        }
        self.main.shut()
    }

    // system runs a command with the shell and returns how it ended: its
    // exit status, or 256 more than the signal that ended it.
    func system(edit self, command: view[]u8) -> f64 {
        self.sync_stdout()
        cmd := process.Command.new("/bin/sh")
        cmd.arg("-c")
        cmd.arg(command)
        match cmd.spawn() {
            Ok(child) => {
                match child.wait() {
                    Ok(st) => {
                        match st {
                            Exited(code) => { return f64(code) }
                            Signaled(sig) => { return f64(sig) + 256.0 }
                        }
                    }
                    Err(e) => { }
                }
            }
            Err(e) => { }
        }
        return -1.0
    }
}
