//! phase: 6
//! expect: output httpd
// httpd: serves the files of a directory over HTTP.
//
//     httpd ADDRESS ROOT        for example: httpd 127.0.0.1:8080 ./site
//
// It answers GET and HEAD. A path names a file under ROOT; a directory
// is answered with its index.html, or with a list of its entries when it
// has none. Each request is written to standard output as
// `METHOD TARGET STATUS BYTES`. Interrupt or Terminate stops it, after
// the requests it has accepted are answered.
//
// What it will not serve: a path with `..` in it (400); a name that
// begins with a dot; and anything that is outside ROOT once symbolic
// links are followed, wherever the link is (both 404, as a file that is
// not there is, so that an answer does not tell which it was).
//
// How it is built:
//   - One thread accepts connections and puts them in a bounded channel;
//     a fixed number of threads take them out and answer. A connection
//     is a value that is moved: into the channel, out to a worker, and it
//     is closed where that worker's function ends, whichever return that
//     is.
//   - A request's head must arrive within a limit and fit 8,192 bytes,
//     so a client that says nothing holds a worker only that long (408),
//     and one that never stops is cut off (431).
//   - A file is sent in pieces of 64 KiB as it is read, and never held
//     whole in memory. Every response closes the connection, which keeps
//     the protocol to one request, one answer.
//
// It is HTTP/1.1 without TLS, ranges, compression or dates: enough for a
// directory of files on a network one trusts.
//
// With no arguments the program serves a small site from a temporary
// directory on a port of the system's choosing and requests its pages
// itself, which is how it runs as a test.
module httpd
import "std/io"
import "std/net"
import "std/signal"
import "std/str"
import "std/sync"
import "std/time"

struct Config { root: Vec[u8]; workers: usize; read_limit_ms: u64 }

// Log is the list of requests: written as they are answered when live,
// else kept.
struct Log { live: bool; lines: Vec[Vec[u8]] }

// Served is what a request was answered with.
struct Served { status: u32; bytes: u64 }

func log_line(log: view[Mutex[Log]], text: view[]u8) {
    with l := log.lock() {
        if l.live {
            print_str(text)
            println()
            flushed := io.flush_stdout()
        } else {
            line := Vec[u8].new()
            line.extend(text)
            l.lines.push(line)
        }
    }
}

// ---- writing a response ----

func push_reason(status: u32, dst: edit[str.String]) {
    if status == 200u32 {
        dst.push_str("OK")
    } else if status == 301u32 {
        dst.push_str("Moved Permanently")
    } else if status == 400u32 {
        dst.push_str("Bad Request")
    } else if status == 404u32 {
        dst.push_str("Not Found")
    } else if status == 405u32 {
        dst.push_str("Method Not Allowed")
    } else if status == 408u32 {
        dst.push_str("Request Timeout")
    } else {
        dst.push_str("Request Header Fields Too Large")
    }
}

// send_head sends the status line and the headers; extra is whole header
// lines, each with its line end.
func send_head(c: edit[net.TcpStream], status: u32, kind: view[]u8, length: u64, extra: view[]u8) -> Result[(), io.IoErr] {
    h := str.String.new()
    h.push_str("HTTP/1.1 ")
    h.push_u64(u64(status))
    h.push(32u8)
    push_reason(status, h)
    h.push_str("\r\nServer: kern-httpd\r\nContent-Type: ")
    h.push_str(kind)
    h.push_str("\r\nContent-Length: ")
    h.push_u64(length)
    h.push_str("\r\n")
    h.push_str(extra)
    h.push_str("Connection: close\r\n\r\n")
    return c.write_all(h.as_view())
}

// send_body sends a response whose body is in memory.
func send_body(c: edit[net.TcpStream], status: u32, kind: view[]u8, body: view[]u8, extra: view[]u8, head_only: bool) -> Served {
    match send_head(c, status, kind, u64(len(body)), extra) {
        Ok(u) => {
            if head_only { return Served { status: status, bytes: 0u64 } }
            match c.write_all(body) {
                Ok(w) => { return Served { status: status, bytes: u64(len(body)) } }
                Err(e) => { return Served { status: status, bytes: 0u64 } }
            }
        }
        Err(e) => { return Served { status: status, bytes: 0u64 } }
    }
}

// send_note sends a response that says only what its status is.
func send_note(c: edit[net.TcpStream], status: u32, extra: view[]u8, head_only: bool) -> Served {
    body := str.String.new()
    body.push_u64(u64(status))
    body.push(32u8)
    push_reason(status, body)
    body.push(10u8)
    return send_body(c, status, "text/plain; charset=utf-8", body.as_view(), extra, head_only)
}

func ends_with(s: view[]u8, suffix: view[]u8) -> bool {
    if len(suffix) > len(s) { return false }
    return str.equal(s[len(s) - len(suffix) : len(s)], suffix)
}

// push_kind writes the media type that a file's name stands for.
func push_kind(path: view[]u8, dst: edit[str.String]) {
    if ends_with(path, ".html") || ends_with(path, ".htm") {
        dst.push_str("text/html; charset=utf-8")
    } else if ends_with(path, ".css") {
        dst.push_str("text/css; charset=utf-8")
    } else if ends_with(path, ".js") {
        dst.push_str("text/javascript; charset=utf-8")
    } else if ends_with(path, ".txt") || ends_with(path, ".md") || ends_with(path, ".kern") {
        dst.push_str("text/plain; charset=utf-8")
    } else if ends_with(path, ".json") {
        dst.push_str("application/json")
    } else if ends_with(path, ".svg") {
        dst.push_str("image/svg+xml")
    } else if ends_with(path, ".png") {
        dst.push_str("image/png")
    } else if ends_with(path, ".jpg") || ends_with(path, ".jpeg") {
        dst.push_str("image/jpeg")
    } else if ends_with(path, ".gif") {
        dst.push_str("image/gif")
    } else if ends_with(path, ".pdf") {
        dst.push_str("application/pdf")
    } else if ends_with(path, ".wasm") {
        dst.push_str("application/wasm")
    } else {
        dst.push_str("application/octet-stream")
    }
}

// send_file sends a file, a piece at a time.
func send_file(c: edit[net.TcpStream], path: view[]u8, head_only: bool) -> Served {
    match io.open_read(path) {
        Ok(f) => {
            match f.metadata() {
                Ok(m) => {
                    kind := str.String.new()
                    push_kind(path, kind)
                    var sent: u64 = 0u64
                    match send_head(c, 200u32, kind.as_view(), m.size, "") {
                        Ok(u) => { }
                        Err(e) => { return Served { status: 200u32, bytes: 0u64 } }
                    }
                    if head_only { return Served { status: 200u32, bytes: 0u64 } }
                    piece := Vec[u8].new()
                    piece.resize(65536usize, 0u8)
                    while sent < m.size {
                        match f.read(piece.as_edit()) {
                            Ok(n) => {
                                // a file that grew since its size was read is
                                // sent as long as was promised
                                var k: usize = n
                                if u64(k) > m.size - sent { k = usize(m.size - sent) }
                                if k == 0usize { break }
                                with b := piece.as_view() {
                                    match c.write_all(b[0usize : k]) {
                                        Ok(w) => { sent = sent + u64(k) }
                                        Err(e) => { return Served { status: 200u32, bytes: sent } }
                                    }
                                }
                            }
                            Err(e) => { break }
                        }
                    }
                    return Served { status: 200u32, bytes: sent }
                }
                Err(e) => { return send_note(c, 404u32, "", head_only) }
            }
        }
        Err(e) => { return send_note(c, 404u32, "", head_only) }
    }
}

// ---- names ----

func hex_digit(n: u32) -> u8 {
    if n < 10u32 { return 48u8 + truncate[u8](n) }
    return 55u8 + truncate[u8](n)
}

// hex_value is 16 for a byte that is not a hexadecimal digit.
func hex_value(b: u8) -> u32 {
    if b >= 48u8 && b <= 57u8 { return u32(b - 48u8) }
    if b >= 97u8 && b <= 102u8 { return u32(b - 87u8) }
    if b >= 65u8 && b <= 70u8 { return u32(b - 55u8) }
    return 16u32
}

// push_encoded writes a path for a URL: every byte that is not a letter,
// a digit or one of - . _ ~ / as a percent and two digits.
func push_encoded(dst: edit[str.String], path: view[]u8) {
    for b in path {
        if (b >= 97u8 && b <= 122u8) || (b >= 65u8 && b <= 90u8) || (b >= 48u8 && b <= 57u8) || b == 45u8 || b == 46u8 || b == 95u8 || b == 126u8 || b == 47u8 {
            dst.push(b)
        } else {
            dst.push(37u8)
            dst.push(hex_digit(u32(b) / 16u32))
            dst.push(hex_digit(u32(b) % 16u32))
        }
    }
}

// push_escaped writes text for an HTML page.
func push_escaped(dst: edit[str.String], text: view[]u8) {
    for b in text {
        if b == 38u8 {
            dst.push_str("&amp;")
        } else if b == 60u8 {
            dst.push_str("&lt;")
        } else if b == 62u8 {
            dst.push_str("&gt;")
        } else if b == 34u8 {
            dst.push_str("&quot;")
        } else {
            dst.push(b)
        }
    }
}

// Target is a request's path, read: the names it goes through, each
// after a slash; whether it ended in a slash; and a verdict, 0 when it
// may be looked for, 1 when it is malformed or climbs with `..`, 2 when
// one of its names begins with a dot.
struct Target { path: Vec[u8]; slash: bool; verdict: u8 }

func read_target(raw: view[]u8) -> Target {
    var t: Target = Target { path: Vec[u8].new(), slash: false, verdict: 0u8 }
    if len(raw) == 0usize || raw[0usize] != 47u8 {
        t.verdict = 1u8
        return t
    }
    // what follows ? or # is not part of the path
    decoded := Vec[u8].new()
    var i: usize = 0usize
    while i < len(raw) && raw[i] != 63u8 && raw[i] != 35u8 {
        if raw[i] == 37u8 {
            var hi: u32 = 16u32
            var lo: u32 = 16u32
            if i + 2usize < len(raw) {
                hi = hex_value(raw[i + 1usize])
                lo = hex_value(raw[i + 2usize])
            }
            // two digits must follow; a zero byte would end the path for
            // the system, so it is refused too
            if hi > 15u32 || lo > 15u32 || hi + lo == 0u32 {
                t.verdict = 1u8
                return t
            }
            decoded.push(truncate[u8](hi * 16u32 + lo))
            i = i + 3usize
        } else {
            decoded.push(raw[i])
            i = i + 1usize
        }
    }
    with d := decoded.as_view() {
        t.slash = d[len(d) - 1usize] == 47u8
        var start: usize = 1usize
        var j: usize = 1usize
        while j <= len(d) {
            if j == len(d) || d[j] == 47u8 {
                n := j - start
                if n == 2usize && d[start] == 46u8 && d[start + 1usize] == 46u8 {
                    t.verdict = 1u8
                } else if n > 1usize || (n == 1usize && d[start] != 46u8) {
                    if d[start] == 46u8 && t.verdict == 0u8 { t.verdict = 2u8 }
                    t.path.push(47u8)
                    t.path.extend(d[start : j])
                }
                start = j + 1usize
            }
            j = j + 1usize
        }
    }
    return t
}

// inside reports whether path, with every symbolic link followed, is
// root or something under it. root is in that form already.
func inside(root: view[]u8, path: view[]u8) -> bool {
    match io.canonicalize(path) {
        Ok(real) => {
            with r := real.as_view() {
                if !str.starts_with(r, root) { return false }
                return len(r) == len(root) || r[len(root)] == 47u8
            }
        }
        Err(e) => { return false }
    }
}

func is_file(path: view[]u8) -> bool {
    match io.metadata(path) {
        Ok(m) => {
            kind := m.kind
            match kind {
                RegularFile => { return true }
                _ => { return false }
            }
        }
        Err(e) => { return false }
    }
}

func is_directory(kind: io.FileKind) -> bool {
    match kind {
        Directory => { return true }
        _ => { return false }
    }
}

// ---- answering ----

// send_listing sends a page that lists a directory's entries; shown is
// the directory's path as the client knows it.
func send_listing(c: edit[net.TcpStream], dir: view[]u8, shown: view[]u8, head_only: bool) -> Served {
    match io.read_dir(dir) {
        Ok(entries) => {
            page := str.String.new()
            page.push_str("<!doctype html>\n<title>Index of ")
            push_escaped(page, shown)
            page.push_str("/</title>\n<h1>Index of ")
            push_escaped(page, shown)
            page.push_str("/</h1>\n<ul>\n")
            for e in entries.as_view() {
                if e.name.len() > 0usize && e.name.get(0usize) != 46u8 {
                    below := is_directory(e.kind)
                    page.push_str("<li><a href=\"")
                    push_encoded(page, e.name.as_view())
                    if below { page.push(47u8) }
                    page.push_str("\">")
                    push_escaped(page, e.name.as_view())
                    if below { page.push(47u8) }
                    page.push_str("</a></li>\n")
                }
            }
            page.push_str("</ul>\n")
            return send_body(c, 200u32, "text/html; charset=utf-8", page.as_view(), "", head_only)
        }
        Err(e) => { return send_note(c, 404u32, "", head_only) }
    }
}

// respond answers a GET or a HEAD for the target as the client wrote it.
func respond(c: edit[net.TcpStream], cfg: view[Config], raw: view[]u8, head_only: bool) -> Served {
    t := read_target(raw)
    if t.verdict == 1u8 { return send_note(c, 400u32, "", head_only) }
    if t.verdict == 2u8 { return send_note(c, 404u32, "", head_only) }
    full := Vec[u8].new()
    full.extend(cfg.root.as_view())
    full.extend(t.path.as_view())
    if !inside(cfg.root.as_view(), full.as_view()) { return send_note(c, 404u32, "", head_only) }
    match io.metadata(full.as_view()) {
        Ok(m) => {
            if is_directory(m.kind) {
                if !t.slash {
                    // a directory's own address ends in a slash, or the
                    // links of its page would lead elsewhere
                    to := str.String.new()
                    to.push_str("Location: ")
                    push_encoded(to, t.path.as_view())
                    to.push_str("/\r\n")
                    return send_note(c, 301u32, to.as_view(), head_only)
                }
                index := io.join(full.as_view(), "index.html")
                if is_file(index.as_view()) { return send_file(c, index.as_view(), head_only) }
                return send_listing(c, full.as_view(), t.path.as_view(), head_only)
            }
            if is_file(full.as_view()) { return send_file(c, full.as_view(), head_only) }
            return send_note(c, 404u32, "", head_only)
        }
        Err(e) => { return send_note(c, 404u32, "", head_only) }
    }
}

func word_at(line: view[]u8, from: usize) -> str.Bounds {
    var lo: usize = from
    while lo < len(line) && line[lo] == 32u8 { lo = lo + 1usize }
    var hi: usize = lo
    while hi < len(line) && line[hi] != 32u8 { hi = hi + 1usize }
    return str.Bounds { lo: lo, hi: hi }
}

// head_is_whole reports whether an empty line has arrived.
func head_is_whole(b: view[]u8) -> bool {
    var i: usize = 0usize
    while i + 1usize < len(b) {
        if b[i] == 10u8 && (b[i + 1usize] == 10u8 || (b[i + 1usize] == 13u8 && i + 2usize < len(b) && b[i + 2usize] == 10u8)) { return true }
        i = i + 1usize
    }
    return false
}

// push_printable writes text with a ? for every byte that is not a
// printable ASCII character, so a request cannot write what it likes in
// the log.
func push_printable(dst: edit[str.String], text: view[]u8) {
    for b in text {
        if b >= 32u8 && b < 127u8 { dst.push(b) } else { dst.push(63u8) }
    }
}

// handle reads one request from a connection, answers it and writes it
// to the log. The connection is closed when handle returns, which is
// after the log has the line.
func handle(c: own net.TcpStream, cfg: view[Config], log: view[Mutex[Log]]) {
    var req: [8192]u8 = zero()
    var n: usize = 0usize
    // 0 while reading, then: 1 the head is here, 2 too slow, 3 too long,
    // 4 the client has gone
    var state: u8 = 0u8
    limit := time.after(time.millis(cfg.read_limit_ms))
    while state == 0u8 {
        if n == 8192usize {
            state = 3u8
        } else {
            match c.read_timeout(req[n : 8192usize], limit.remaining()) {
                Ok(got) => {
                    match got {
                        Some(k) => {
                            n = n + k
                            if k == 0usize {
                                state = 4u8
                            } else if head_is_whole(req[0usize : n]) {
                                state = 1u8
                            }
                        }
                        None => { state = 2u8 }
                    }
                }
                Err(e) => { state = 4u8 }
            }
        }
    }
    if state == 4u8 { return }
    entry := str.String.new()
    var served: Served = Served { status: 0u32, bytes: 0u64 }
    if state == 2u8 {
        entry.push_str("-")
        served = send_note(c, 408u32, "", false)
    } else if state == 3u8 {
        entry.push_str("-")
        served = send_note(c, 431u32, "", false)
    } else {
        var end: usize = 0usize
        while end < n && req[end] != 13u8 && req[end] != 10u8 { end = end + 1usize }
        with line := req[0usize : end] {
            m := word_at(line, 0usize)
            t := word_at(line, m.hi)
            v := word_at(line, t.hi)
            if t.lo == t.hi || !str.starts_with(line[v.lo : v.hi], "HTTP/1.") {
                entry.push_str("?")
                served = send_note(c, 400u32, "", false)
            } else {
                push_printable(entry, line[m.lo : t.hi])
                head_only := str.equal(line[m.lo : m.hi], "HEAD")
                if head_only || str.equal(line[m.lo : m.hi], "GET") {
                    served = respond(c, cfg, line[t.lo : t.hi], head_only)
                } else {
                    served = send_note(c, 405u32, "Allow: GET, HEAD\r\n", false)
                }
            }
        }
    }
    entry.push(32u8)
    entry.push_u64(u64(served.status))
    entry.push(32u8)
    entry.push_u64(served.bytes)
    log_line(log, entry.as_view())
}

// ---- the server ----

// worker answers the connections that come down the channel until it is
// closed and empty, and returns how many there were.
func worker(queue: view[sync.Channel[net.TcpStream]], cfg: view[Config], log: view[Mutex[Log]]) -> u64 {
    var count: u64 = 0u64
    while true {
        match queue.recv() {
            Some(c) => {
                handle(c, cfg, log)
                count = count + 1u64
            }
            None => { return count }
        }
    }
    return count
}

// serve accepts connections until stop says so, and returns how many
// were answered. A handle is asked for its thread's result, which waits
// for the thread, so the handles are kept until the channel is closed.
func serve(l: own net.TcpListener, cfg: view[Config], log: view[Mutex[Log]], stop: closure() -> bool) -> u64 {
    queue := sync.Channel[net.TcpStream].new(64usize)
    handles := Vec[Join[u64]].new()
    var answered: u64 = 0u64
    with s := thread.scope() {
        for i in 0usize..cfg.workers {
            match s.spawn(worker, queue, cfg, log) {
                Ok(j) => handles.push(j)
                Err(e) => { }
            }
        }
        while !stop() {
            match l.accept_timeout(time.millis(100u64)) {
                Ok(got) => {
                    match move got {
                        Some(c) => {
                            if handles.len() > 0usize {
                                match queue.send(c) {
                                    Ok(u) => { }
                                    Err(back) => { }
                                }
                            } else {
                                // no worker could be started: this thread answers
                                handle(c, cfg, log)
                                answered = answered + 1u64
                            }
                        }
                        None => { }
                    }
                }
                // out of descriptors, most likely: wait for some to be closed
                Err(e) => time.sleep(time.millis(50u64))
            }
        }
        queue.close()
        while true {
            match handles.pop() {
                Some(j) => { answered = answered + j.get() }
                None => { break }
            }
        }
    }
    return answered
}

// ---- the demonstration ----

func say(s: view[]u8) { print_str(s); println() }

func write_under(dir: view[]u8, name: view[]u8, content: view[]u8) -> Result[(), io.IoErr] {
    path := io.join(dir, name)
    return io.write_file(path.as_view(), content)
}

const big_size: usize = 300000usize

func big_byte(i: usize) -> u8 { return truncate[u8]((i * 7usize + i / 251usize) % 256usize) }

// build_site makes a directory with a site in it and, beside the site, a
// file that must not be served.
func build_site(dir: view[]u8) -> Result[Vec[u8], io.IoErr] {
    site := io.join(dir, "site")
    docs := io.join(site.as_view(), "docs")
    io.create_dir_all(docs.as_view())?
    write_under(dir, "secret.txt", "not for the network\n")?
    write_under(site.as_view(), "index.html", "<h1>A site served by kern</h1>\n")?
    write_under(site.as_view(), "style.css", "h1 { font-family: serif }\n")?
    write_under(site.as_view(), "a b.txt", "a name with a space in it\n")?
    write_under(site.as_view(), ".env", "PASSWORD=hunter2\n")?
    write_under(docs.as_view(), "guide.txt", "Read the reference first.\n")?
    write_under(docs.as_view(), "Q&A <draft>.md", "# Questions\n")?
    notes := io.join(docs.as_view(), "notes")
    io.make_dir(notes.as_view())?
    big := Vec[u8].new()
    for i in 0usize..big_size { big.push(big_byte(i)) }
    write_under(site.as_view(), "big.bin", big.as_view())?
    leak := io.join(site.as_view(), "leak.txt")
    outside := io.join(dir, "secret.txt")
    io.symlink(outside.as_view(), leak.as_view())?
    return Ok(site)
}

func fetch(at: net.SocketAddr, request: view[]u8) -> Result[Vec[u8], io.IoErr] {
    c := net.TcpStream.connect(at)?
    c.write_all(request)?
    data := Vec[u8].new()
    n := io.read_to_end(c, data)?
    return Ok(data)
}

// body_start is the index after the empty line that ends the head.
func body_start(b: view[]u8) -> usize {
    var i: usize = 0usize
    while i + 3usize < len(b) {
        if b[i] == 13u8 && b[i + 1usize] == 10u8 && b[i + 2usize] == 13u8 && b[i + 3usize] == 10u8 { return i + 4usize }
        i = i + 1usize
    }
    return len(b)
}

// show sends a request and writes the status line, the headers that say
// what the body is or where to go, and the body.
func show(at: net.SocketAddr, shown: view[]u8, request: view[]u8) -> Result[(), io.IoErr] {
    print_str("> ")
    say(shown)
    data := fetch(at, request)?
    with b := data.as_view() {
        body := body_start(b)
        var start: usize = 0usize
        var i: usize = 0usize
        while i < body {
            if b[i] == 10u8 {
                var end: usize = i
                if end > start && b[end - 1usize] == 13u8 { end = end - 1usize }
                if start == 0usize || str.starts_with(b[start : end], "Content-") || str.starts_with(b[start : end], "Location:") || str.starts_with(b[start : end], "Allow:") {
                    print_str("< ")
                    say(b[start : end])
                }
                start = i + 1usize
            }
            i = i + 1usize
        }
        start = body
        i = body
        while i < len(b) {
            if b[i] == 10u8 {
                print_str("| ")
                say(b[start : i])
                start = i + 1usize
            }
            i = i + 1usize
        }
    }
    return Ok(())
}

// show_big fetches the large file and checks every byte of it.
func show_big(at: net.SocketAddr) -> Result[(), io.IoErr] {
    say("> GET /big.bin")
    data := fetch(at, "GET /big.bin HTTP/1.1\r\nHost: test\r\n\r\n")?
    with b := data.as_view() {
        body := body_start(b)
        var same: bool = len(b) - body == big_size
        var i: usize = 0usize
        while same && i < big_size {
            if b[body + i] != big_byte(i) { same = false }
            i = i + 1usize
        }
        print_str("< ")
        print_u64(u64(len(b) - body))
        print_str(" bytes of body, every one as it is in the file: ")
        print_bool(same)
        println()
    }
    return Ok(())
}

func converse(at: net.SocketAddr) -> Result[(), io.IoErr] {
    say("-- files")
    show(at, "GET /", "GET / HTTP/1.1\r\nHost: test\r\n\r\n")?
    show(at, "HEAD /style.css", "HEAD /style.css HTTP/1.1\r\nHost: test\r\n\r\n")?
    show(at, "GET /docs/guide.txt", "GET /docs/guide.txt HTTP/1.0\r\n\r\n")?
    show(at, "GET /a%20b.txt?version=2", "GET /a%20b.txt?version=2 HTTP/1.1\r\nHost: test\r\n\r\n")?
    show_big(at)?
    say("-- directories")
    show(at, "GET /docs", "GET /docs HTTP/1.1\r\nHost: test\r\n\r\n")?
    show(at, "GET /docs/", "GET /docs/ HTTP/1.1\r\nHost: test\r\n\r\n")?
    say("-- what is not served")
    show(at, "GET /missing.html", "GET /missing.html HTTP/1.1\r\nHost: test\r\n\r\n")?
    show(at, "GET /../secret.txt", "GET /../secret.txt HTTP/1.1\r\nHost: test\r\n\r\n")?
    show(at, "GET /docs/%2e%2e/%2e%2e/secret.txt", "GET /docs/%2e%2e/%2e%2e/secret.txt HTTP/1.1\r\nHost: test\r\n\r\n")?
    show(at, "GET /leak.txt (a symbolic link to a file outside the site)", "GET /leak.txt HTTP/1.1\r\nHost: test\r\n\r\n")?
    show(at, "GET /.env", "GET /.env HTTP/1.1\r\nHost: test\r\n\r\n")?
    show(at, "GET /a%2xb.txt", "GET /a%2xb.txt HTTP/1.1\r\nHost: test\r\n\r\n")?
    show(at, "POST /", "POST / HTTP/1.1\r\nHost: test\r\nContent-Length: 0\r\n\r\n")?
    show(at, "hello?", "hello?\r\n\r\n")?
    show(at, "(a client that connects and says nothing)", "")?
    return Ok(())
}

func demo_server(l: own net.TcpListener, root: own Vec[u8], flag: own Shared[Atomic[u32]], log: own Shared[Mutex[Log]]) -> u64 {
    cfg := Config { root: root, workers: 3usize, read_limit_ms: 1000u64 }
    return serve(l, cfg, log.get(), || flag.get().load(Ordering.seq_cst) != 0u32)
}

// demo makes a directory for the demonstration and removes it
// afterwards, whether the demonstration succeeded or not.
func demo() -> Result[(), io.IoErr] {
    dir := io.make_temp_dir("httpd")?
    done := demo_in(dir.as_view())
    removed := io.remove_dir_all(dir.as_view())
    done?
    return removed
}

func demo_in(dir: view[]u8) -> Result[(), io.IoErr] {
    site := build_site(dir)?
    root := io.canonicalize(site.as_view())?
    l := net.TcpListener.bind(net.loopback_v4(0u16))?
    at := l.local_addr()?
    flag := Shared[Atomic[u32]].new(Atomic[u32].new(0u32))
    log := Shared[Mutex[Log]].new(Mutex[Log].new(Log { live: false, lines: Vec[Vec[u8]].new() }))
    match thread.spawn(demo_server, l, root, flag.clone(), log.clone()) {
        Ok(t) => {
            talked := converse(at)
            flag.get().store(1u32, Ordering.seq_cst)
            answered := t.join()
            talked?
            say("-- the server's log")
            with entries := log.get().lock() {
                for line in entries.lines.as_view() { say(line.as_view()) }
            }
            print_u64(answered)
            say(" connections were answered")
        }
        Err(e) => say("no thread for the server")
    }
    return Ok(())
}

// ---- the program ----

func caught(s: Option[signal.Signal]) -> bool {
    match s {
        Some(which) => { return true }
        None => { return false }
    }
}

func run(address: view[]u8, root: view[]u8) -> Result[u64, io.IoErr] {
    match net.parse_addr(address) {
        Some(a) => {
            real := io.canonicalize(root)?
            if !is_directory(io.metadata(real.as_view())?.kind) { return Err(io.error_of(io.ErrKind.NotADirectory)) }
            l := net.TcpListener.bind(a)?
            print_str("httpd: serving ")
            print_str(real.as_view())
            print_str(" on ")
            say(net.format_addr(l.local_addr()?).as_view())
            flushed := io.flush_stdout()
            var workers: usize = thread.available_parallelism()
            if workers < 2usize { workers = 2usize }
            cfg := Config { root: real, workers: workers, read_limit_ms: 10000u64 }
            log := Mutex[Log].new(Log { live: true, lines: Vec[Vec[u8]].new() })
            sigs := signal.catch(signal.Signal.Interrupt)
            sigs.add(signal.Signal.Terminate)
            return Ok(serve(l, cfg, log, || caught(sigs.try_next())))
        }
        None => { return Err(io.error_of(io.ErrKind.InvalidInput)) }
    }
}

func main() -> i32 {
    args := io.args()
    if args.len() < 2usize {
        match demo() {
            Ok(u) => { return 0i32 }
            Err(e) => {
                say("the demonstration failed")
                return 1i32
            }
        }
    }
    if args.len() != 3usize {
        eprint_str("usage: httpd ADDRESS ROOT\n")
        return 2i32
    }
    match run(args.get(1usize).as_view(), args.get(2usize).as_view()) {
        Ok(answered) => {
            print_str("httpd: stopped after ")
            print_u64(answered)
            say(" connections")
            return 0i32
        }
        Err(e) => {
            eprint_str("httpd: cannot serve (a bad address, one in use, or a root that is not a directory)\n")
            return 1i32
        }
    }
}
