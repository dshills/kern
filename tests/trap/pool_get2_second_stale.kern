//! phase: 3
//! expect: trap generation
// get2 validates its second handle after its first (Rule 5.6.2): a
// second handle whose slot was reused traps generation.
module t
struct C { v: u64 }
func run() -> Result[u64, AllocErr] {
    p := Pool[C].new()
    a := p.alloc(C { v: 1u64 })?
    b := p.alloc(C { v: 2u64 })?
    p.free(b)
    c := p.alloc(C { v: 3u64 })?
    with x, y := p.get2(a, b) { x.v = y.v }
    return Ok(0u64)
}
func main() -> i32 {
    match run() {
        Ok(v) => { }
        Err(e) => { }
    }
    return 0i32
}
