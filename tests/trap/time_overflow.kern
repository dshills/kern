//! phase: 6
//! expect: trap overflow
//! twin: time_overflow_ok
// A duration past u64 nanoseconds traps overflow (specs/std-time §2); the
// twin builds one that fits.
module t
import "std/time"
func main() -> i32 {
    d := time.seconds(18446744073709551615u64)
    print_u64(d.as_millis())
    println()
    return 0i32
}
