//! phase: 6
//! expect: trap explicit
//! twin: sysalloc_checked_ok
//! config: opt=debug
// SystemAllocator.realloc with an old size that is not the allocation's.
// A debug build and the interpreter trap explicit at the call
// (specs/runtime RF1); a release build does not check, the obligation is
// the caller's there.
module t
contract { requires "the block is used as the comments say: this fixture breaks the obligation on purpose" }
func run() {
    a := SystemAllocator.new()
    unsafe {
        match a.alloc(16usize, 8usize) {
            Ok(p) => {
                match a.realloc(p, 32usize, 64usize, 8usize) {   // trap explicit: the block has 16 bytes
                    Ok(q) => { a.free(q, 64usize, 8usize) }
                    Err(e) => { a.free(p, 16usize, 8usize) }
                }
            }
            Err(e) => { }
        }
    }
}
func main() -> i32 {
    run()
    print_str("after the trap")
    println()
    return 0i32
}
