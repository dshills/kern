//! phase: 1
//! expect: output disjoint_ok
//! twin: disjoint

module t
struct C { v: u64 }
func main() -> i32 {
    p := Pool[C].new()
    match p.alloc(C { v: 1u64 }) {
        Ok(a) => {
            match p.alloc(C { v: 2u64 }) {
                Ok(b) => { with x, y := p.get2(a, b) { x.v = y.v }; return 0i32 }
                Err(e) => return 1i32
            }
        }
        Err(e) => return 1i32
    }
}
