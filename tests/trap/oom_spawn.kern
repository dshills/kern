//! phase: 3
//! expect: trap oom
//! test-hooks: true
// The runtime's allocation for a spawned thread fails (the armed hook):
// oom at thread.spawn, in both engines (specs/runtime-trap-file/SPEC.md R4).
module t
func one(n: u64) -> u64 { return n + 1u64 }
func run() -> Result[u64, SpawnErr] {
    testing.fail_next_alloc()
    t := thread.spawn(one, 1u64)?
    return Ok(t.join())
}
func main() -> i32 {
    match run() {
        Ok(v) => print_u64(v)
        Err(e) => print_str("spawn failed")
    }
    print_str("after the trap")
    return 0i32
}
