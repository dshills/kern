//! phase: 3
//! expect: trap bounds
//! trap-file: lib/lib.kern
// A trap inside an imported module's function reports that module's file,
// not the program's first file, in both backends (regression: the record
// named the program's file, or none, for every trap). The sentinel lines
// must not appear: execution and destruction stop at the trap.
module app
import "lib"
func main() -> i32 {
    g := lib.Make(7u64)
    xs := [1u64, 2u64, 3u64]
    print_u64(lib.Pick(xs[0usize:3usize], 1usize))
    println()
    print_u64(lib.Pick(xs[0usize:3usize], 5usize))
    print_str("after the trap")
    println()
    print_u64(g.Id)
    return 0i32
}
