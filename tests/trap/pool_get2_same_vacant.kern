//! phase: 3
//! expect: trap vacant
// get2 compares its handles only after validating both (Rule 5.6.2):
// twice the same freed handle traps vacant, not disjoint.
module t
struct C { v: u64 }
func run() -> Result[u64, AllocErr] {
    p := Pool[C].new()
    a := p.alloc(C { v: 1u64 })?
    p.free(a)
    with x, y := p.get2(a, a) { x.v = y.v }
    return Ok(0u64)
}
func main() -> i32 {
    match run() {
        Ok(v) => { }
        Err(e) => { }
    }
    return 0i32
}
