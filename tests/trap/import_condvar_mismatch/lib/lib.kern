module lib
struct Flags { waiting: bool; woken: bool }
struct Both { a: Mutex[Flags]; b: Mutex[u64]; cv: Condvar }
func worker(x: own Shared[Both]) -> u64 {
    with p := x.get() {
        with g := p.a.lock() {
            g.waiting = true
            while !g.woken { p.cv.wait(g) }
        }
    }
    return 1u64
}
func run(x: view[Shared[Both]]) -> Result[u64, SpawnErr] {
    t := thread.spawn(worker, x.clone())?
    with p := x.get() {
        pending := true
        while pending {
            with g := p.a.lock() {
                if g.waiting { g.woken = true; pending = false }
            }
            yield_now()
        }
        p.cv.notify_all()
    }
    r := t.join()
    with p := x.get() {
        with h := p.b.lock() { p.cv.wait(h) }   // trap explicit: a second Mutex on the Condvar
    }
    return Ok(r)
}
func Main() {
    x := Shared[Both].new(Both { a: Mutex[Flags].new(Flags { waiting: false, woken: false }), b: Mutex[u64].new(0u64), cv: Condvar.new() })
    match run(x) {
        Ok(n) => { print_u64(n); println() }
        Err(e) => { print_str("spawn failed"); println() }
    }
}
