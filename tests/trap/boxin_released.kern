//! phase: 3
//! expect: trap explicit
//! twin: boxin_released_ok
// get on a BoxIn emptied by release traps explicit, as Box does
// (specs/alloc-containers/SPEC.md §2); the twin reads it before release.
module t
func run() -> Result[(), AllocErr] {
    b := BoxIn[u64, SystemAllocator].try_new_in(7u64, SystemAllocator.new())?
    b.release()
    with g := b.get() { print_u64(g); println() }
    return Ok(())
}
func main() -> i32 {
    match run() {
        Ok(u) => { }
        Err(e) => { print_str("out of memory"); println() }
    }
    return 0i32
}
