//! phase: 3
//! expect: trap disjoint
// PoolIn.get2 with one handle twice traps disjoint, as Pool.get2 does
// (specs/in-forms R3).
module t
struct C { v: u64 }
func run() -> Result[u64, AllocErr] {
    p := PoolIn[C, SystemAllocator].new_in(SystemAllocator.new())
    a := p.try_alloc(C { v: 1u64 })?
    with x, y := p.get2(a, a) { x.v = y.v }
    print_str("after the trap")
    return Ok(0u64)
}
func main() -> i32 {
    match run() {
        Ok(v) => { }
        Err(e) => { print_str("out of memory") }
    }
    return 0i32
}
