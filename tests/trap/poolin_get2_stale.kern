//! phase: 3
//! expect: trap generation
// PoolIn.get2 checks each handle as get does: a handle whose slot was
// freed and then reused traps generation (specs/in-forms R3).
module t
struct C { v: u64 }
func run() -> Result[u64, AllocErr] {
    p := PoolIn[C, SystemAllocator].new_in(SystemAllocator.new())
    a := p.try_alloc(C { v: 1u64 })?
    b := p.try_alloc(C { v: 2u64 })?
    p.free(b)
    c := p.try_alloc(C { v: 3u64 })?
    with x, y := p.get2(c, a) { print_u64(x.v + y.v) }
    println()
    with x, y := p.get2(a, b) { x.v = y.v }
    print_str("after the trap")
    return Ok(0u64)
}
func main() -> i32 {
    match run() {
        Ok(v) => { }
        Err(e) => { print_str("out of memory") }
    }
    return 0i32
}
