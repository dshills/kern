//! phase: 1
//! expect: accept
// Marker derivation distinguishes instantiations of one generic declaration
// (prism regression): Box[Box[u64]] is Send even though Box appears twice.
module m
func send_it(b: own Box[Box[u64]]) -> u64 { return 0u64 }
func f(b: own Box[Box[u64]]) -> Result[u64, SpawnErr] {
    h := thread.spawn(send_it, b)?
    return Ok(h.join())
}
