module lib
thread_local Counter: u64 = 100u64
func Bump(n: u64) -> u64 {
    Counter = Counter + n
    return Counter
}
func Worker(n: u64) -> u64 { return Bump(n) }
func Twice(x: u64) -> u64 { return x * 2u64 }
func Apply(f: func(u64) -> u64, x: u64) -> u64 { return f(x) }
func Each(n: u64, f: closure(u64)) {
    var i: u64 = 0u64
    while i < n { f(i); i = i + 1u64 }
}
func Fill(o: out u64, v: u64) { o = v * 2u64 }
