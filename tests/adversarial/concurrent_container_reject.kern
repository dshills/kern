//! expect: reject SHARE_NOT_SHARE rule=5.5.3
//! twin: concurrent_container
module adversarial
struct Unsync { p: RawPtr[u64] }
func peek(u: view[Unsync]) -> u64 { return 0u64 }
func run(u: own Unsync) -> Result[u64, SpawnErr] {
    with s := thread.scope() {
        j := s.spawn(peek, u)?   // SHARE_NOT_SHARE
        return Ok(j.get())
    }
}
