//! phase: 1
//! expect: accept
//! twin: partial_init_reject
// Partially initialized objects exist only as out storage inside the callee
// and are cleaned up field by field on error (spec §5.2).
module adversarial
struct Big { a: u64; b: u64; c: u64 }
func init_big(x: out Big, fail: bool) -> Result[(), u8] {
    x.a = 1u64
    x.b = 2u64
    if fail { return Err(1u8) }
    x.c = 3u64
    return Ok(())
}
func use() -> Result[u64, u8] {
    var x: Big
    init_big(out x, false)?
    return Ok(x.a + x.b + x.c)
}
