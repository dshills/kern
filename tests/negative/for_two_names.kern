//! expect: reject TYPE_MISMATCH rule=T.5
//! twin: for_two_names_ok
// Two names iterate a type with the cursor protocol only; an array has
// none (spec/types.md §7).
module m
func main() -> i32 {
    xs := [1u64, 2u64, 3u64]
    var s: u64 = 0u64
    for i, x in xs { s = s + x }
    return 0i32
}
