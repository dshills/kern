//! expect: reject SHARE_NOT_SHARE rule=5.5.3
//! twin: assert_where_share_ok
// A conditional marker assertion (rule 5.5.1): Cell is Share only for a
// Send payload, and Raw, which holds a raw pointer, is not Send.
module m
struct Cell[T] nocopy { state: Atomic[u32]; data: RawPtr[T] }
unsafe assert Interior for Cell
unsafe assert Share for Cell where T: Send
struct Raw { p: RawPtr[u8] }
func look(c: view[Cell[Raw]]) -> u64 { return 0u64 }
func f(c: view[Cell[Raw]]) {
    with s := thread.scope() {
        j := s.spawn(look, c)   // SHARE_NOT_SHARE
    }
}
