//! expect: reject ACC_CONFLICT rule=5.4.4
//! twin: for_cursor_nested_ok
// A mutable map whose values are not Copy: the outer loop binds an edit of
// each value (cursor_entry_mut), so the inner loop over the same map may
// not read it (spec §5.4; specs/nested-cursor-loops R2). The conflict is
// reported once, though the desugared inner loop reads t in several
// statements.
module m
import "std/map"
import "std/str"
func main() -> i32 {
    t := map.Map[u64, str.String].new()
    var s: usize = 0usize
    for a, x in t {
        for b, y in t { s = s + x.len() }
    }
    return 0i32
}
