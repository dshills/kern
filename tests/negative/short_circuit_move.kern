//! expect: reject OWN_CONDITIONAL_MOVE rule=5.1.5
//! twin: short_circuit_move_ok
// The right operand of && is a conditional path (spec/types.md §5).
module m
func grab(b: own Box[u64]) -> bool { return true }
func f(c: bool) {
    b := Box.new(1u64)
    ok := c && grab(b)   // OWN_CONDITIONAL_MOVE: b is moved only when c holds
}
