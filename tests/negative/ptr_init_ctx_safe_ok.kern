//! phase: 1
//! expect: accept
//! twin: ptr_init_ctx_safe
module m
union E { Bad }
func init_n(n: out u64, v: view[u64]) -> Result[(), E] { n = v; return Ok(()) }
contract { requires "p addresses storage for one u64 that holds no live value" }
func f(p: RawPtr[u64], v: view[u64]) -> Result[(), E] {
    unsafe { return ptr_init_ctx(p, init_n, v) }
