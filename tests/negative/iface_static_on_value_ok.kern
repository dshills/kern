//! phase: 1
//! expect: accept
//! twin: iface_static_on_value
// A function an interface declares without a receiver, called on the type
// parameter.
module m
interface Zero {
    func unit() -> u64
}
struct Ev { at: u64 }
impl Zero for Ev {
    func unit() -> u64 { return 7u64 }
}
func u[Z: Zero](z: view[Z]) -> u64 { return Z.unit() }
func main() -> i32 {
    e := Ev { at: 1u64 }
    return i32(u(e) - 7u64)
}
