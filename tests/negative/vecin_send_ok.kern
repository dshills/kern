//! phase: 3
//! expect: accept
//! twin: vecin_send
module m
// H is an allocator handle holding a raw pointer to state elsewhere.
struct H nocopy { state: RawPtr[u8] }
unsafe assert Send for H
impl Allocator for H {
    func alloc(edit self, size: usize, align: usize) -> Result[RawPtr[u8], AllocErr] { return Err(OutOfMemory) }
    func free(edit self, ptr: RawPtr[u8], size: usize, align: usize) { }
}
func work(v: own VecIn[u64, H]) -> u64 { return u64(v.len()) }
func start(v: own VecIn[u64, H]) -> Result[u64, SpawnErr] {
    t := thread.spawn(work, v)?
    return Ok(t.join())
}
