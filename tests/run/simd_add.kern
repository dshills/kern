//! phase: 3
//! expect: output simd_add
// SIMD intrinsic simd_add over fixed-width vectors (PLAN.md 3.2); lanes wrap.
module run
func main() -> i32 {
    a := [1u64, 2u64, 3u64, 18446744073709551615u64]
    b := [10u64, 20u64, 30u64, 1u64]
    r := simd_add(a, b)
    print_u64(r[0]); println(); print_u64(r[3]); println()
    f := simd_add([1.5f64, 2.0f64], [0.25f64, 1.0f64])
    print_bool(f[0] == 1.75f64 && f[1] == 3.0f64); println()
    return 0i32
}
