-- is_match
/abc/ in "xabcx" => true
/abc/ in "ab" => false
// in "" => true
/a/ in "" => false
/^a/ in "ba" => false
/a$/ in "ba" => true
/^$/ newline in "a<10>" => true
/^$/ in "a<10>" => false
/abc/ ignore_case in "xxABC" => true
/[0-9]+/ in "abc" => false
/x*/ in "" => true
/a{3}/ in "aa" => false
/a{3}/ in "aaa" => true
/./ newline in "<10>" => false
/(a|b)*c/ in "abab" => false
/(a|b)*c/ in "ababc" => true
/b/ in "aaaaaaaab" => true
