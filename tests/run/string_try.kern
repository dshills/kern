//! phase: 3
//! expect: output string_try
// The fallible String forms leave a string as their mirrored operations do
// (specs/fallible-alloc/SPEC.md R6): each pair prints its result, the
// bytes, len and capacity, so the two lines of a pair are equal; capacity
// and try_reserve are those of the byte vector.
module t
import "std/str"
func show(s: view[str.String]) {
    print_str(s.as_view())
    print_str(" len "); print_u64(u64(s.len()))
    print_str(" cap "); print_u64(u64(s.capacity()))
    println()
}
func ok() { print_str("  ok ") }
func res(r: Result[(), AllocErr]) {
    match r {
        Ok(u) => print_str("  ok ")
        Err(e) => print_str("  err ")
    }
}
func quiet(r: Result[(), AllocErr]) {
    match r {
        Ok(u) => { }
        Err(e) => { print_str("  err"); println() }
    }
}
func from_try(b: view[]u8) -> Result[(), AllocErr] {
    s := str.String.try_from(b)?
    ok(); show(s)
    return Ok(())
}
func say(s: view[]u8) { print_str(s); println() }
func main() -> i32 {
    say("from")
    a := str.String.from("hello"); ok(); show(a)
    quiet(from_try("hello"))
    say("from empty")
    a0 := str.String.from(""); ok(); show(a0)
    quiet(from_try(""))
    say("push")
    a1 := str.String.from("abcd"); a1.push(101u8); ok(); show(a1)
    b1 := str.String.from("abcd"); res(b1.try_push(101u8)); show(b1)
    say("push_str")
    a2 := str.String.from("hello"); a2.push_str(", world"); ok(); show(a2)
    b2 := str.String.from("hello"); res(b2.try_push_str(", world")); show(b2)
    say("try_reserve")
    b3 := str.String.from("hi"); res(b3.try_reserve(32usize)); show(b3)
    b3.push_str("!"); ok(); show(b3)
    say("new")
    b4 := str.String.new(); ok(); show(b4)
    return 0i32
}
