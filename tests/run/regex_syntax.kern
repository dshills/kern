//! phase: 6
//! expect: output regex_syntax
// std/regex, the pattern language (specs/std-regex/SPEC.md, T1): every
// form accepted, with the number of its groups; each row of the error
// table with the kind and the index it reports, and the first error of
// several; the escapes, a backslash before each of the 256 bytes outside a
// bracket expression and inside one; a pattern's size, compiled with
// max_insts at that size and one below; groups nested 202 and 203 deep; a
// pattern whose bytes are overwritten and destroyed after the call; the
// three plain structs copied by assignment; the cases R5 and R8 settle
// for a hyphen where a member begins, a class form and an interval with
// no atom; and, by searching, the bytes each named class and each escape
// matches among all 256, and braces and a closing bracket matching
// themselves.
module t
import "std/regex"

func say(s: view[]u8) { print_str(s); println() }

// show prints a pattern between slashes, a byte outside 32 to 126 as its
// value in angle brackets.
func show(p: view[]u8) {
    print_str("/")
    var i: usize = 0usize
    while i < len(p) {
        if p[i] >= 32u8 && p[i] <= 126u8 {
            print_str(p[i:i + 1usize])
        } else {
            print_str("<")
            print_u64(u64(p[i]))
            print_str(">")
        }
        i = i + 1usize
    }
    print_str("/")
}

func kind(k: regex.ErrKind) {
    match k {
        UnclosedGroup => print_str("UnclosedGroup")
        UnmatchedClose => print_str("UnmatchedClose")
        UnclosedBracket => print_str("UnclosedBracket")
        BadRange => print_str("BadRange")
        BadClass => print_str("BadClass")
        BadEscape => print_str("BadEscape")
        BadInterval => print_str("BadInterval")
        NothingToRepeat => print_str("NothingToRepeat")
        Unsupported => print_str("Unsupported")
        TooDeep => print_str("TooDeep")
        TooLarge => print_str("TooLarge")
    }
}

// outcome prints what a compilation gave: ok and the number of groups, or
// the error's kind and index.
func outcome(r: view[Result[regex.Regex, regex.CompileErr]]) {
    match r {
        Ok(re) => {
            print_str("ok ")
            print_u64(u64(re.groups()))
        }
        Err(e) => {
            kind(e.kind)
            print_str(" at ")
            print_u64(u64(e.at))
        }
    }
}

func pat(p: view[]u8) {
    show(p)
    print_str(" => ")
    with r := regex.compile(p) { outcome(r) }
    println()
}

func pat_with(p: view[]u8, o: regex.Options) {
    show(p)
    if o.ignore_case { print_str(" ignore_case") }
    if o.newline { print_str(" newline") }
    print_str(" => ")
    with r := regex.compile_with(p, o) { outcome(r) }
    println()
}

// sized_tail compiles p with max_insts at size and at one below.
func sized_tail(p: view[]u8, size: usize, o: regex.Options) {
    print_str(" size ")
    print_u64(u64(size))
    print_str(": ")
    at := o
    at.max_insts = size
    with r := regex.compile_with(p, at) { outcome(r) }
    print_str(", one below: ")
    at.max_insts = size - 1usize
    with r := regex.compile_with(p, at) { outcome(r) }
    println()
}
func sized(p: view[]u8, size: usize) {
    show(p)
    sized_tail(p, size, regex.options())
}

// deep compiles lead, opens `(`, inner, closes `)` and tail in a row.
func deep(label: view[]u8, lead: view[]u8, opens: usize, inner: view[]u8, closes: usize, tail: view[]u8) {
    p := Vec[u8].new()
    p.extend(lead)
    var i: usize = 0usize
    while i < opens {
        p.push(40u8)
        i = i + 1usize
    }
    p.extend(inner)
    i = 0usize
    while i < closes {
        p.push(41u8)
        i = i + 1usize
    }
    p.extend(tail)
    print_str(label)
    print_str(" => ")
    with r := regex.compile(p.as_view()) { outcome(r) }
    println()
}

// sweep compiles a backslash before each of the 256 bytes, alone or
// between brackets, and prints the bytes accepted, those refused as
// Unsupported, how many are refused as BadEscape or otherwise, and
// whether every error is at the backslash.
func sweep(inside: bool) {
    accepted := Vec[u8].new()
    unsupported := Vec[u8].new()
    var bad: u64 = 0u64
    var other: u64 = 0u64
    var want: usize = 0usize
    if inside { want = 1usize }
    var there: bool = true
    var b: u32 = 0u32
    while b < 256u32 {
        p := Vec[u8].new()
        if inside { p.push(91u8) }
        p.push(92u8)
        p.push(truncate[u8](b))
        if inside { p.push(93u8) }
        with r := regex.compile(p.as_view()) {
            match r {
                Ok(re) => { accepted.push(truncate[u8](b)) }
                Err(e) => {
                    if e.at != want { there = false }
                    match e.kind {
                        Unsupported => { unsupported.push(truncate[u8](b)) }
                        BadEscape => { bad = bad + 1u64 }
                        _ => { other = other + 1u64 }
                    }
                }
            }
        }
        b = b + 1u32
    }
    print_str("accepted ")
    show(accepted.as_view())
    println()
    print_str("Unsupported ")
    show(unsupported.as_view())
    println()
    print_str("BadEscape ")
    print_u64(bad)
    print_str(", other errors ")
    print_u64(other)
    print_str(", every error at the backslash ")
    print_bool(there)
    println()
}

// kept compiles a pattern held in a vector, overwrites the vector and
// destroys it, and returns what the compilation gave.
func kept() -> Result[regex.Regex, regex.CompileErr] {
    v := Vec[u8].new()
    v.extend("(a)(b(c))")
    r := regex.compile(v.as_view())
    var i: usize = 0usize
    while i < v.len() {
        with b := v.at(i) { b = 41u8 }
        i = i + 1usize
    }
    drop(v)
    return r
}

// members prints the bytes b for which the pattern matches the text of
// the one byte b, as ranges.
func members(p: view[]u8, o: regex.Options) {
    show(p)
    if o.ignore_case { print_str(" ignore_case") }
    if o.newline { print_str(" newline") }
    print_str(" matches")
    with r := regex.compile_with(p, o) {
        match r {
            Err(e) => { print_str(" nothing, refused") }
            Ok(re) => {
                sc := regex.Scratch.new()
                var text: [1]u8 = zero()
                var lo: u32 = 0u32
                var open: bool = false
                var b: u32 = 0u32
                while b <= 256u32 {
                    var got: bool = false
                    if b < 256u32 {
                        text[0usize] = truncate[u8](b)
                        got = re.is_match(sc, text[0usize:1usize])
                    }
                    if got && !open {
                        lo = b
                        open = true
                    } else if !got && open {
                        print_str(" ")
                        print_u64(u64(lo))
                        if b - 1u32 > lo {
                            print_str("-")
                            print_u64(u64(b - 1u32))
                        }
                        open = false
                    }
                    b = b + 1u32
                }
            }
        }
    }
    println()
}

// seek prints the match find returns from offset 0.
func seek(p: view[]u8, text: view[]u8) {
    show(p)
    print_str(" in ")
    show(text)
    print_str(" => ")
    with r := regex.compile(p) {
        match r {
            Err(e) => { print_str("refused") }
            Ok(re) => {
                sc := regex.Scratch.new()
                match re.find(sc, text, 0usize) {
                    Some(m) => {
                        print_u64(u64(m.start))
                        print_str("-")
                        print_u64(u64(m.end))
                    }
                    None => print_str("none")
                }
            }
        }
    }
    println()
}

func main() -> i32 {
    say("-- accepted: ordinary bytes, alternation, groups")
    pat("")
    pat("a")
    pat("abc")
    pat("a|b")
    pat("a|")
    pat("|a")
