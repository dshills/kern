    pat("[a-\\q]")

    say("-- Unsupported")
    pat("\\1")
    pat("\\10")
    pat("(a)\\1")
    pat("a\\9")
    pat("[\\1]")
    pat("[[.a.]]")
    pat("[a[=b=]]")
    pat("[[.")
    pat("[[=")
    pat("[a-[.z.]]")
    pat("[^[.x.]]")

    say("-- BadInterval")
    pat("a{2,1}")
    pat("a{1001}")
    pat("a{0,1001}")
    pat("a{1001,}")
    pat("ab{3,2}c")
    pat("(a){9999}")
    pat("a{1000}{2,1}")
    pat("a{1,2}{1001}")

    say("-- NothingToRepeat")
    pat("*")
    pat("+a")
    pat("?")
    pat("a|*b")
    pat("(*a)")
    pat("(a|+)")
    pat("|*")
    pat("()|?")
    pat("{2}")
    pat("a|{1,2}")
    pat("({3,})")

    say("-- the first error is the one reported")
    pat("a)(")
    pat("(a{2,1}")
    pat("[b-a")
    pat("*)")
    pat("(\\1")
    pat("a{2,1}\\")
    pat("\\q(")
    pat("([[:foo:]")
    pat("a{1000}{1000})")
    pat("a{1000}{1000}(")
    pat("a{1000}{1000}\\")

    say("-- a backslash before each byte")
    sweep(false)
    say("-- a backslash before each byte, in a bracket expression")
    sweep(true)

    say("-- size")
    sized("", 1usize)
    sized("abc", 4usize)
    sized("^$.", 4usize)
    sized("()", 3usize)
    sized("(|a)", 6usize)
    sized("a||b", 7usize)
    sized("a?b+c*", 10usize)
    sized("(a|b)*c", 10usize)
    sized("a{0}", 1usize)
    sized("a{3}{4}", 13usize)
    sized("x{2,}", 5usize)
    sized("a{0,}", 4usize)
    sized("a{1,}", 4usize)
    sized("(a{1,}){1,}", 8usize)
    sized("a{2,5}", 12usize)
    sized("(ab){3,}x?", 18usize)
    sized("[a-c]+|\\.$|^x{3}", 14usize)
    sized("(a{1000}){0}b", 2usize)
    sized("(a{100}){100}", 10201usize)
    stars := Vec[u8].new()
    stars.push(97u8)
    var i: usize = 0usize
    while i < 2000usize {
        stars.push(42u8)
        i = i + 1usize
    }
    print_str("a and 2000 stars")
    sized_tail(stars.as_view(), 4002usize, regex.options())
    o = regex.options()
    o.ignore_case = true
    o.newline = true
    print_str("ignore_case newline ")
    show("a.[^b]")
    sized_tail("a.[^b]", 4usize, o)

    say("-- TooLarge")
    pat("a{1000}{99}x{999}")
    pat("a{1000}{100}")
    pat("(a{1000}){1000}")
    o = regex.options()
    o.max_insts = 0usize
    print_str("max_insts 0 ")
    pat_with("a", o)
    o.max_insts = 18446744073709551615usize
    print_str("max_insts 18446744073709551615 ")
    pat_with("((((((a{1000}){1000}){1000}){1000}){1000}){1000}){1000}", o)

    say("-- nesting")
    deep("202 nested groups", "", 202usize, "a", 202usize, "")
    deep("203 nested groups", "", 203usize, "a", 203usize, "")
    deep("x and 203 open parentheses", "x", 203usize, "", 0usize, "")
    deep("202 open parentheses", "", 202usize, "", 0usize, "")
    deep("202 nested groups and one beside them", "", 202usize, "a", 202usize, "(b)")
    deep("202 nested groups around [(]", "", 202usize, "[(]", 202usize, "")

    say("-- the pattern is not kept")
    with r := kept() { outcome(r) }
    println()

    say("-- copies")
    a := regex.options()
    b := a
    b.max_insts = 5usize
    b.ignore_case = true
    print_bool(a.ignore_case)
    print_str(" ")
    print_bool(a.newline)
    print_str(" ")
    print_u64(u64(a.max_insts))
    println()
    print_bool(b.ignore_case)
    print_str(" ")
    print_bool(b.newline)
    print_str(" ")
    print_u64(u64(b.max_insts))
    println()
    e := regex.CompileErr { kind: regex.ErrKind.BadClass, at: 3usize }
    f := e
    f.kind = regex.ErrKind.TooDeep
    f.at = 9usize
    kind(e.kind)
    print_str(" at ")
    print_u64(u64(e.at))
    println()
    kind(f.kind)
    print_str(" at ")
    print_u64(u64(f.at))
    println()
    s := regex.Span { start: 1usize, end: 4usize }
    t := s
    t.end = 7usize
    print_u64(u64(s.start))
    print_str(" ")
    print_u64(u64(s.end))
    println()
    print_u64(u64(t.start))
    print_str(" ")
    print_u64(u64(t.end))
    println()

    say("-- a hyphen where a member begins, a class form, an interval with no atom (R5, R8)")
    pat("{2,1}")
    pat("[[:alpha]")
    pat("[[:alpha")
    pat("[a-[:foo:]]")
    pat("[--a]")
    pat("[a-c--e]")
    pat("[a--]")
    // the name is read, and refused, before the hyphen after it is met
    pat("[[:foo:]-z]")

    say("-- the bytes each class matches")
    plain := regex.options()
    members("[[:alpha:]]", plain)
    members("[[:digit:]]", plain)
    members("[[:alnum:]]", plain)
    members("[[:upper:]]", plain)
    members("[[:lower:]]", plain)
    members("[[:space:]]", plain)
    members("[[:blank:]]", plain)
    members("[[:punct:]]", plain)
    members("[[:print:]]", plain)
    members("[[:graph:]]", plain)
    members("[[:cntrl:]]", plain)
    members("[[:xdigit:]]", plain)
    members("[[:space:][:xdigit:]_]", plain)
    members("[^[:print:]]", plain)
    members(".", plain)
    lines := regex.options()
    lines.newline = true
    members("[^[:print:]]", lines)
    members(".", lines)
    members("[\\n]", lines)
    fold := regex.options()
    fold.ignore_case = true
    members("[[:lower:]]", fold)
    members("[^[:lower:]]", fold)
    members("[x-z]", fold)
    members("q", fold)
    members("7", fold)

    say("-- the byte each escape matches")
    members("\\n", plain)
    members("\\t", plain)
    members("\\r", plain)
    members("\\f", plain)
    members("\\v", plain)
    members("\\a", plain)
    members("\\x41", plain)
    members("\\x7", plain)
    members("\\xfF", plain)
    members("\\.", plain)
    members("\\\\", plain)
    members("[\\n\\t\\x41-\\x43\\]]", plain)

    say("-- braces and a closing bracket match themselves")
    seek("{", "a{b")
    seek("}", "a}b")
    seek("]", "a]b")
    seek("a{", "xa{")
    seek("a{,2}", "a{,2}")
    seek("a{1,2,3}", "a{1,2,3}")
    seek("a{12345}", "a{12345}")
    seek("{a}", "x{a}")
    seek("{*", "{{{")
    seek("a{x}", "aa{x}")
    seek("a{1", "a{1")
    seek("[{}]+", "a{}}b")
    seek("a{2}", "a{2}")
    seek("a{2}", "baa")
    return 0i32
}
