    pat("a||b")
    pat("()")
    pat("(a)")
    pat("(a)(b)")
    pat("((a)(b))")
    pat("(a|b)|(c)")
    pat("(|)")
    pat("(()())")
    pat("a\0b")
    pat("\xc8\xff")

    say("-- accepted: repetition")
    pat("a*")
    pat("a+")
    pat("a?")
    pat("a*+?")
    pat("(a)*")
    pat("(a|b)+c?")
    pat("a{2}")
    pat("a{2,}")
    pat("a{2,5}")
    pat("a{0}")
    pat("a{0,0}")
    pat("a{0,}")
    pat("a{1000}")
    pat("a{0001}")
    pat("a{1,1000}")
    pat("a{2}{3}")
    pat("(a){0}")
    pat("(a){2,3}*")

    say("-- accepted: any byte and anchors")
    pat(".")
    pat("^")
    pat("$")
    pat("^a$")
    pat("a^b")
    pat("a$b")
    pat("^*")
    pat("$+")
    pat("(^a|b$)")

    say("-- accepted: bracket expressions")
    pat("[a]")
    pat("[abc]")
    pat("[a-z]")
    pat("[^a]")
    pat("[]]")
    pat("[^]]")
    pat("[]a]")
    pat("[a-]")
    pat("[-a]")
    pat("[a-c-e]")
    pat("[[]")
    pat("[a[]")
    pat("[.]")
    pat("[=]")
    pat("[:a:]")
    pat("[^^]")
    pat("[a^]")
    pat("[*+?(){}|^$.]")
    pat("[\0-\xff]")
    pat("[[:alpha:]]")
    pat("[[:alpha:][:digit:]_]")
    pat("[^[:space:]]")
    pat("[[:alpha:]-]")
    pat("[[:alpha:][:digit:][:alnum:][:upper:][:lower:][:space:][:blank:][:punct:][:print:][:graph:][:cntrl:][:xdigit:]]")
    pat("([)]a)")

    say("-- accepted: escapes")
    pat("\\.")
    pat("\\\\")
    pat("\\(\\)")
    pat("\\[a\\]")
    pat("\\{2\\}")
    pat("\\n\\t\\r\\f\\v\\a")
    pat("\\x41")
    pat("\\x4")
    pat("\\x414")
    pat("\\xAf")
    pat("\\x0")
    pat("\\x4g")
    pat("\\*\\+\\?\\|\\^\\$")
    pat("[\\]]")
    pat("[\\\\]")
    pat("[a\\]b]")
    pat("[\\n\\t\\x41-\\x5a]")
    pat("[\\x5d]")
    pat("[\\--\\/]")
    pat("[\\^a]")

    say("-- accepted: braces and brackets as ordinary bytes")
    pat("{")
    pat("}")
    pat("]")
    pat("a]")
    pat("a{")
    pat("a}")
    pat("a{}")
    pat("a{,2}")
    pat("a{,}")
    pat("a{1")
    pat("a{1,2")
    pat("a{x}")
    pat("a{ 1}")
    pat("a{-1}")
    pat("a{1,2,3}")
    pat("a{12345}")
    pat("a{1,23456}")
    pat("{a}")
    pat("{*")
    pat("{}")
    pat("(a{)")

    say("-- accepted: options")
    var o: regex.Options = regex.options()
    o.ignore_case = true
    pat_with("[a-z]B\\x41", o)
    o.newline = true
    pat_with("^(a.[^b])$", o)
    o.ignore_case = false
    pat_with("^.$|[^\\n]", o)

    say("-- UnclosedGroup")
    pat("(")
    pat("(a")
    pat("a(b")
    pat("((")
    pat("(a)(b")
    pat("(a|b")
    pat("((a)")
    pat("a(b(c)d")

    say("-- UnmatchedClose")
    pat(")")
    pat("a)")
    pat("(a))")
    pat("a|)")
    pat("()b)c(")

    say("-- UnclosedBracket")
    pat("[")
    pat("[a")
    pat("a[^")
    pat("[]")
    pat("[^]")
    pat("([")
    pat("[a-")
    pat("[[:alpha:]")
    pat("x[a-z")
    pat("[a\\]")

    say("-- BadRange")
    pat("[b-a]")
    pat("x[z-a]")
    pat("[a-c9-0]")
    pat("[^9-0]")
    pat("[\\x62-\\x61]")
    pat("[a-[:alpha:]]")
    pat("[[:alpha:]-z]")

    say("-- BadClass")
    pat("[[:foo:]]")
    pat("[a[:Alpha:]]")
    pat("[[:alpha:][:nope:]]")
    pat("[^[:word:]]")

    say("-- BadEscape")
    pat("\\")
    pat("a\\")
    pat("ab\\")
    pat("[\\")
    pat("(\\")
    pat("\\d")
    pat("\\w")
    pat("\\b")
