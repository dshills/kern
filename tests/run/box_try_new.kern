//! phase: 3
//! expect: output box_try_new
// The fallible Box forms (specs/fallible-alloc/SPEC.md R1): try_new,
// try_new_with and try_new_with_ctx succeed as new, new_with and
// new_with_ctx do, and an initializer's own failure is Init, after which
// the out failure rule has destroyed the field it had initialized and
// Page's destructor does not run.
module t
struct Tok nocopy { id: u64 }
impl Tok {
    destructor(edit self) { print_str("drop tok "); print_u64(self.id); println() }
}
struct Page nocopy { id: u64; tok: Tok; data: [4096]u8 }
impl Page {
    destructor(edit self) { print_str("drop page "); print_u64(self.id); println() }
}
struct Spec { id: u64; last: u8 }
union E { Bad }
func init_ok(p: out Page) -> Result[(), E] {
    p.id = 1u64
    p.tok = Tok { id: 10u64 }
    p.data = zero()
    p.data[4095usize] = 9u8
    return Ok(())
}
func init_partial(p: out Page) -> Result[(), E] {
    p.id = 2u64
    p.tok = Tok { id: 20u64 }
    return Err(Bad)
}
func init_from(p: out Page, s: view[Spec]) -> Result[(), E] {
    p.id = s.id
    p.tok = Tok { id: s.id * 10u64 }
    p.data = zero()
    p.data[4095usize] = s.last
    return Ok(())
}
func init_from_partial(p: out Page, s: view[Spec]) -> Result[(), E] {
    p.id = s.id
    p.tok = Tok { id: s.id * 10u64 }
    return Err(Bad)
}
func plain(v: u64) -> Result[u64, AllocErr] {
    b := Box[u64].try_new(v)?
    with g := b.get() { return Ok(g) }
}
func build(init: func(out Page) -> Result[(), E]) -> Result[u64, AllocOrInit[E]] {
    b := Box[Page].try_new_with(init)?
    with g := b.get() {
        return Ok(g.id * 1000u64 + u64(g.data[4095usize]))
    }
}
func build_ctx(init: func(out Page, view[Spec]) -> Result[(), E], s: view[Spec]) -> Result[u64, AllocOrInit[E]] {
    b := Box[Page].try_new_with_ctx(init, s)?
    with g := b.get() {
        return Ok(g.id * 1000u64 + u64(g.data[4095usize]))
    }
}
func show_plain(r: Result[u64, AllocErr]) {
    match r {
        Ok(v) => { print_str("ok "); print_u64(v); println() }
        Err(e) => { print_str("out of memory"); println() }
    }
}
func show(r: Result[u64, AllocOrInit[E]]) {
    match r {
        Ok(v) => { print_str("ok "); print_u64(v); println() }
        Err(e) => {
            match e {
                Alloc(a) => { print_str("out of memory"); println() }
                Init(i) => { print_str("init failed"); println() }
            }
        }
    }
}
func main() -> i32 {
    show_plain(plain(42u64))
    show(build(init_ok))
    show(build(init_partial))
    s := Spec { id: 4u64, last: 7u8 }
    show(build_ctx(init_from, s))
    t := Spec { id: 5u64, last: 0u8 }
    show(build_ctx(init_from_partial, t))
    return 0i32
}
