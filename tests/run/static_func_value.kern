//! phase: 6
//! expect: output static_func_value
// A type's static function is a value as a module's function is: Type.f,
// and Type[Args].f of a generic type. (It passed the check and was an
// internal error in lowering.)
module main
struct A { x: u64 }
impl A {
    func make(n: u64) -> A { return A { x: n } }
    func twice(view self) -> u64 { return self.x * 2u64 }
}
struct W[T: Copy] { v: T }
impl[T: Copy] W[T] {
    func wrap(v: T) -> W[T] { return W[T] { v: v } }
}
func apply(f: func(u64) -> A, n: u64) -> u64 { return f(n).twice() }
func main() -> i32 {
    g := A.make
    print_u64(g(2u64).x); println()
    print_u64(apply(A.make, 5u64)); println()
    h := W[u32].wrap
    print_u64(u64(h(7u32).v)); println()
    return 0i32
}
