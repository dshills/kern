//! phase: 3
//! expect: output
//! test-hooks: true
// The allocation of what a spawned thread needs fails (the armed hook):
// a scoped spawn returns Err(SpawnErr), as any spawn that cannot start does, and the
// program goes on (specs/runtime RC3). Until 2026-11-09 this trapped oom
// (specs/runtime-trap-file R4).
module t
func one(n: u64) -> u64 { return n + 1u64 }
func run() -> Result[u64, SpawnErr] {
    with s := thread.scope() {
        testing.fail_next_alloc()
        h := s.spawn(one, 1u64)?
        return Ok(h.get())
    }
}
func main() -> i32 {
    match run() {
        Ok(v) => print_u64(v)
        Err(e) => print_str("spawn failed")
    }
    println()
    print_str("after the failed spawn")
    println()
    return 0i32
}
