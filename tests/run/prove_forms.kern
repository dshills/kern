//! phase: 6
//! expect: output prove_forms
// The guard forms the proof pass proves (specs/prove-guards/SPEC.md F1–F9),
// one function each; `show-bounds-checks` labels every index and slice
// check below proven. The output is the same under the interpreter, which
// executes every check, and the native builds, which leave the proven ones
// out.
module run
struct Ring {
    buf: [8]u32
    head: usize
}
func sum(xs: view[]u64) -> u64 {
    var s: u64 = 0u64
    for x in xs { s = s + x }
    return s
}
func sum32(xs: view[]u32) -> u64 {
    var s: u64 = 0u64
    for x in xs { s = s + u64(x) }
    return s
}
// F1: a cached length in a loop head
func cached(xs: view[]u64) -> u64 {
    n := len(xs)
    var i: usize = 0usize
    var s: u64 = 0u64
    while i < n {
        s = s + xs[i]
        i = i + 1usize
    }
    return s
}
// F1: an if between the guard and the store
func join_store(tab: edit[]u8, v: u8) {
    var i: usize = 0usize
    while i < len(tab) {
        c := v
        if c > 9u8 { c = 9u8 }
        tab[i] = c
        i = i + 1usize
    }
}
// F1: a range loop over the length
func range_loop(xs: view[]u64) -> u64 {
    var s: u64 = 0u64
    for i in 0usize..len(xs) { s = s + xs[i] }
    return s
}
// F2: both operands of && guard the body
func lockstep_both(a: view[]u64, b: view[]u64) -> u64 {
    var s: u64 = 0u64
    var i: usize = 0usize
    while i < len(a) && i < len(b) {
        s = s + a[i] * b[i]
        i = i + 1usize
    }
    return s
}
// F2: the second operand of || runs under the first's negation
func first_zero(xs: view[]u8, i: usize) -> bool {
    if i >= len(xs) || xs[i] == 0u8 { return true }
    return false
}
// F3: a non-strict guard
func window(xs: view[]u64) -> u64 {
    var s: u64 = 0u64
    var i: usize = 0usize
    while i + 2usize <= len(xs) {
        s = s + xs[i] + xs[i + 1usize]
        i = i + 2usize
    }
    return s
}
// F4: equality with a literal
func exactly4(xs: view[]u8) -> u8 {
    if len(xs) == 4usize { return xs[3usize] }
    return 0u8
}
// F4: two equal lengths
func lockstep_eq(a: view[]u64, b: view[]u64) -> u64 {
    var s: u64 = 0u64
    if len(a) == len(b) {
        var i: usize = 0usize
        while i < len(a) {
            s = s + a[i] * b[i]
            i = i + 1usize
        }
    }
    return s
}
// F5: a literal equal to the array's length
func ring_get(r: view[Ring], idx: usize) -> u32 {
    if idx < 8usize { return r.buf[idx] }
    return 0u32
}
// F6: a recomputed index expression
func stride6(xs: view[]u8, i: usize) -> u8 {
    if i * 6usize + 5usize < len(xs) { return xs[i * 6usize + 5usize] }
    return 0u8
}
func ring_at(r: view[Ring], i: usize) -> u32 {
    if (r.head + i) % len(r.buf) < len(r.buf) { return r.buf[(r.head + i) % len(r.buf)] }
    return 0u32
}
func classify(tab: view[]u8, b: u8) -> u8 {
    if usize(b) < len(tab) { return tab[usize(b)] }
    return 0u8
}
// F7: an index minus a constant
func prev(xs: view[]u64, i: usize) -> u64 {
    if i < len(xs) {
        if i >= 1usize { return xs[i - 1usize] }
    }
    return 0u64
}
// F8: two stores under one guard; an access after a call
func put2(dst: edit[]u8, i: usize, a: u8, b: u8) -> bool {
    if i + 1usize < len(dst) {
        dst[i] = a
        dst[i + 1usize] = b
        return true
    }
    return false
}
func fill(xs: edit[]u8, v: u8) {
    var i: usize = 0usize
    while i < len(xs) {
        xs[i] = v
        i = i + 1usize
    }
}
func after_call(xs: edit[]u8, i: usize) -> u8 {
    if i < len(xs) {
        fill(xs, 1u8)
        return xs[i]
    }
    return 0u8
}
// F9: slices under a guard, to the length, and with literal bounds
func mid(xs: view[]u64, i: usize) -> u64 {
    if i + 2usize <= len(xs) { return sum(xs[i:i + 2usize]) }
    return 0u64
}
func tail_sum(xs: view[]u64, i: usize) -> u64 {
    if i < len(xs) { return sum(xs[i:len(xs)]) }
    return 0u64
}
func head2(r: view[Ring]) -> u64 {
    return sum32(r.buf[0usize:2usize])
}
// masked indexes (specs/prove-masks): a constant mask below the length
func mask_ring(r: view[[16]u64], head: usize, n: usize) -> u64 { return r[(head + n) & 15usize] }
func mask_local(r: view[[16]u64], x: usize) -> u64 {
    j := x & 15usize
    return r[j]
}
func mask_conv(r: view[[16]u64], x: u64) -> u64 { return r[usize(x & 15u64)] }
func mask_off(r: view[[16]u64], x: usize) -> u64 { return r[(x & 7usize) + 8usize] }
func mask_guard(p: view[]u64, x: usize) -> u64 {
    if len(p) >= 4usize { return p[x & 3usize] }
    return 0u64
}
// bounds (specs/prove-bounds): a remainder by a literal, a bound a local
// keeps around a loop and across a join, and a mask by a value below the
// length
func rem_at(r: view[[16]u64], x: usize) -> u64 { return r[x % 16usize] }
func ring_sum(r: view[[16]u64], n: usize) -> u64 {
    var s: u64 = 0u64
    var w: usize = 0usize
    for k in 0usize..n {
        s = s + r[w]
        w = (w + 5usize) & 15usize
    }
    return s
}
func join_pick(r: view[[16]u64], x: usize, c: bool) -> u64 {
    var p: usize = 0usize
    if c { p = x & 7usize } else { p = x % 16usize }
    return r[p]
}
func len_mask(p: view[]u64, x: usize) -> u64 {
    if len(p) == 0usize { return 0u64 }
    m := len(p) - 1usize
    return p[x & m]
}
func guard_mask(p: view[]u64, x: usize, m: usize) -> u64 {
    if m < len(p) { return p[x & m] }
    return 0u64
}
func main() -> i32 {
    xs := [1u64, 2u64, 3u64, 4u64, 5u64]
    ys := [10u64, 20u64, 30u64, 40u64, 50u64]
    var bytes: [6]u8 = [1u8, 0u8, 3u8, 4u8, 5u8, 6u8]
    var r: Ring = Ring{buf: [1u32, 2u32, 3u32, 4u32, 5u32, 6u32, 7u32, 8u32], head: 6usize}
    print_u64(cached(xs[0usize:5usize]) + range_loop(xs[0usize:5usize]))
    println()
    join_store(bytes[0usize:6usize], 12u8)
    print_u64(u64(bytes[0usize]) + u64(bytes[5usize]))
    println()
    print_u64(lockstep_both(xs[0usize:5usize], ys[0usize:3usize]))
    println()
    print_bool(first_zero(bytes[0usize:6usize], 1usize))
    print_bool(first_zero(bytes[0usize:6usize], 9usize))
    print_bool(first_zero(bytes[0usize:6usize], 2usize))
    println()
    print_u64(window(xs[0usize:5usize]))
    println()
    print_u64(u64(exactly4(bytes[0usize:4usize])) + u64(exactly4(bytes[0usize:5usize])))
    println()
    print_u64(lockstep_eq(xs[0usize:5usize], ys[0usize:5usize]) + lockstep_eq(xs[0usize:5usize], ys[0usize:4usize]))
    println()
    print_u64(u64(ring_get(r, 7usize)) + u64(ring_get(r, 8usize)))
    println()
    print_u64(u64(stride6(bytes[0usize:6usize], 0usize)) + u64(stride6(bytes[0usize:6usize], 1usize)))
    println()
    print_u64(u64(ring_at(r, 3usize)))
    println()
    print_u64(u64(classify(bytes[0usize:6usize], 2u8)) + u64(classify(bytes[0usize:6usize], 200u8)))
    println()
    print_u64(prev(xs[0usize:5usize], 4usize) + prev(xs[0usize:5usize], 0usize))
    println()
    var dst: [4]u8 = zero()
    print_bool(put2(dst[0usize:4usize], 2usize, 7u8, 8u8))
    print_bool(put2(dst[0usize:4usize], 3usize, 7u8, 8u8))
    print_u64(u64(dst[2usize]) + u64(dst[3usize]))
    println()
    print_u64(u64(after_call(dst[0usize:4usize], 1usize)))
    println()
    print_u64(mid(xs[0usize:5usize], 3usize) + mid(xs[0usize:5usize], 4usize) + tail_sum(xs[0usize:5usize], 2usize) + head2(r))
    println()
    var mr: [16]u64 = zero()
    var mi: usize = 0usize
    while mi < 16usize {
        mr[mi] = u64(mi) * 3u64
        mi = mi + 1usize
    }
    print_u64(mask_ring(mr, 14usize, 5usize) + mask_local(mr, 35usize) + mask_conv(mr, 4097u64) + mask_off(mr, 13usize))
    println()
    print_u64(mask_guard(xs[0usize:5usize], 7usize) + mask_guard(xs[0usize:2usize], 7usize))
    println()
    print_u64(rem_at(mr, 37usize) + ring_sum(mr, 5usize) + join_pick(mr, 13usize, true) + join_pick(mr, 29usize, false))
    println()
    print_u64(len_mask(xs[0usize:5usize], 6usize) + len_mask(xs[0usize:0usize], 3usize) + len_mask(xs[0usize:3usize], 7usize) + guard_mask(xs[0usize:5usize], 7usize, 3usize))
    println()
    return 0i32
}
