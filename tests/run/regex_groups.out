/a/ "" with "-" onto "\\1&" replace_all => 0 "\\1&"
-- split
/,/ "a,b,c" split => 3: (0,1) (2,3) (4,5)
/,/ ",a" split => 2: (0,0) (1,2)
/,/ "a," split => 2: (0,1) (2,2)
/,/ "a,,b" split => 3: (0,1) (2,2) (3,4)
/,/ "abc" split => 1: (0,3)
/,/ "," split => 2: (0,0) (1,1)
/,/ ",," split => 3: (0,0) (1,1) (2,2)
/b/ "abbbc" split => 4: (0,1) (2,2) (3,3) (4,5)
/,/ "" split => 0:
// "" split => 0:
/x*/ "" split => 0:
/,+/ "a,,b" split => 2: (0,1) (3,4)
/,+/ ",,a,," split => 3: (0,0) (2,3) (5,5)
/[ \\t]+/ "  a  b " split => 4: (0,0) (2,3) (5,6) (7,7)
/a|ab/ "xaby" split => 2: (0,1) (3,4)
/(,)|(;)/ "a,b;c" split => 3: (0,1) (2,3) (4,5)
/abc/ "abc" split => 2: (0,0) (3,3)
/.*/ "abc" split => 2: (0,0) (3,3)
/./ "abc" split => 4: (0,0) (1,1) (2,2) (3,3)
// "abc" split => 1: (0,3)
/x*/ "abc" split => 1: (0,3)
/^/ "abc" split => 1: (0,3)
/$/ "abc" split => 1: (0,3)
/()/ "a" split => 1: (0,1)
/,*/ "a,b,,c" split => 3: (0,1) (2,3) (5,6)
/\\n/ "a\nb\n" split => 3: (0,1) (2,3) (4,4)
/^./ newline "ab\ncd" split => 3: (0,0) (1,3) (4,5)
/^./ "ab\ncd" split => 2: (0,0) (1,5)
/\x00/ "a\x00b" split => 2: (0,1) (2,3)
/,/ "a,b" split onto 2 => 2: (800,800) (801,801) (0,1) (2,3)
/,/ "" split onto 2 => 0: (800,800) (801,801)
// "ab" split onto 1 => 1: (800,800) (0,2)
-- a Scratch that has served nothing
/(a)(b)/ "xab" from 0, slots 3 => true (1,3) (1,2) (2,3)
/a*/ "baaac" next => (0,0) (1,4) (5,5) then None None
/(a)|b/ "ba" next_captures, slots 2 => [(0,1) -] [(1,2) (1,2)] then false [(900,900) (901,901)] false [(900,900) (901,901)]
/(b)(c)?/ "abcd-b" with "[\\1]" replace_all => 2 "a[b]d-[b]"
/b/ "abc" with "&&" replace_first => true "abbc"
/,/ "a,b" split => 2: (0,1) (2,3)
-- what the specification leaves open
/(a*)*/ "b" from 0, slots 2 => true (0,0) (0,0)
/(a*)*/ "aa" from 0, slots 2 => true (0,2) (0,2)
/(a*)+/ "ab" from 0, slots 2 => true (0,1) (0,1)
/(a*){2}/ "a" from 0, slots 2 => true (0,1) (1,1)
