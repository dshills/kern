//! phase: 3
//! expect: output string_try_oom
//! test-hooks: true
// Every failure of a fallible String form leaves the string's bytes, len
// and capacity as they were (specs/fallible-alloc/SPEC.md R6): each case
// prints the string, arms testing.fail_next_alloc(), calls, and prints the
// result and the string again.
module t
import "std/str"
func show(s: view[str.String]) {
    print_str("  "); print_str(s.as_view())
    print_str(" len "); print_u64(u64(s.len()))
    print_str(" cap "); print_u64(u64(s.capacity()))
    println()
}
func res(r: Result[(), AllocErr]) {
    match r {
        Ok(u) => { print_str("  ok"); println() }
        Err(e) => { print_str("  err out of memory"); println() }
    }
}
func from_try(b: view[]u8) -> Result[(), AllocErr] {
    s := str.String.try_from(b)?
    show(s)
    return Ok(())
}
func say(s: view[]u8) { print_str(s); println() }
func main() -> i32 {
    say("try_from")
    testing.fail_next_alloc(); res(from_try("hello"))
    say("try_reserve")
    a := str.String.from("abcd"); show(a)
    testing.fail_next_alloc(); res(a.try_reserve(64usize)); show(a)
    say("try_push on a full string")
    b := str.String.from("abcd"); show(b)
    testing.fail_next_alloc(); res(b.try_push(101u8)); show(b)
    say("try_push_str that must grow")
    c := str.String.from("abcd"); show(c)
    testing.fail_next_alloc(); res(c.try_push_str(", world")); show(c)
    return 0i32
}
