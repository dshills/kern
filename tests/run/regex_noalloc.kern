//! phase: 6
//! expect: output regex_noalloc
//! test-hooks: true
// std/regex, no allocation in a search (specs/std-regex/SPEC.md, T5 and
// R17). For three patterns, one of them with a group, and one Scratch
// reserved for each in turn: testing.fail_next_alloc() is armed, which
// makes the program's next allocation call fail; is_match, find,
// captures, a cursor run to its end with next and another with
// next_captures, and replace_all and split into vectors that have room
// already, go over four texts, one of 4,003 bytes; then try_push on a new
// vector must return Err(OutOfMemory), which shows the failure was still
// armed, so no search made an allocation call. The same is done
// with a second Scratch after a first search in place of reserve, and
// that first search is the least there is: the empty text, from an offset
// past its end. Nothing is printed between the arming and the check; the
// control that the hook reaches a vector's growth is
// tests/trap/regex_noalloc_control.kern. The hook exists at debug only.
module t
import "std/regex"

func say(s: view[]u8) { print_str(s); println() }

func span(s: Option[regex.Span]) {
    match s {
        Some(m) => {
            print_u64(u64(m.start))
            print_str("-")
            print_u64(u64(m.end))
        }
        None => print_str("none")
    }
}

// Seen is what the searches of one pattern returned, for each of the four
// texts: is_match, find from 0, find from 3, captures from 0 with the
// span it wrote for group 1, how many matches a cursor yielded with next
// and with next_captures, and what replace_all and split returned.
struct Seen {
    any: [4]bool
    whole: [4]Option[regex.Span]
    later: [4]Option[regex.Span]
    caps: [4]bool
    group: [4]Option[regex.Span]
    nexts: [4]u64
    withs: [4]u64
    subs: [4]u64
    parts: [4]u64
}

// Room is a byte vector and a span vector with room for what replace_all
// and split append here, made before the failure is armed.
struct Room nocopy { dst: Vec[u8]; fields: Vec[regex.Span] }

func searches_of(re: view[regex.Regex], sc: edit[regex.Scratch], room: edit[Room], text: view[]u8, seen: edit[Seen], i: usize) {
    seen.any[i] = re.is_match(sc, text)
    seen.whole[i] = re.find(sc, text, 0usize)
    seen.later[i] = re.find(sc, text, 3usize)
    var g: [2]Option[regex.Span] = zero()
    seen.caps[i] = re.captures(sc, text, 0usize, g)
    seen.group[i] = g[1usize]
    cur := regex.cursor()
    var going: bool = true
    while going {
        match re.next(sc, text, cur) {
            Some(m) => { seen.nexts[i] = seen.nexts[i] + 1u64 }
            None => { going = false }
        }
    }
    again := regex.cursor()
    while re.next_captures(sc, text, again, g) { seen.withs[i] = seen.withs[i] + 1u64 }
    room.dst.clear()
    seen.subs[i] = u64(re.replace_all(sc, text, "<\\1&>", room.dst))
    room.fields.clear()
    seen.parts[i] = u64(re.split(sc, text, room.fields))
}

func searches(re: view[regex.Regex], sc: edit[regex.Scratch], room: edit[Room], long: view[]u8, seen: edit[Seen]) {
    searches_of(re, sc, room, "abababc 12ab99 xxxx abc xxx", seen, 0usize)
    searches_of(re, sc, room, "", seen, 1usize)
    searches_of(re, sc, room, long, seen, 2usize)
    searches_of(re, sc, room, "y\0zxx", seen, 3usize)
}

// still_armed is whether the next allocation call fails.
func still_armed() -> bool {
    v := Vec[u8].new()
    match v.try_push(1u8) {
        Ok(u) => { return false }
        Err(e) => { return true }
    }
}

func line(label: view[]u8, seen: view[Seen], i: usize) {
    print_str("  ")
    print_str(label)
    print_str(" ")
    print_bool(seen.any[i])
    print_str(" ")
    span(seen.whole[i])
    print_str(" ")
    span(seen.later[i])
    print_str(", captures ")
    print_bool(seen.caps[i])
    if seen.caps[i] {
        print_str(" ")
        span(seen.group[i])
    }
    print_str(", next ")
    print_u64(seen.nexts[i])
    print_str(", next_captures ")
    print_u64(seen.withs[i])
    print_str(", replace_all ")
    print_u64(seen.subs[i])
    print_str(", split ")
    print_u64(seen.parts[i])
    println()
}

// check sizes sc for the pattern, by reserve or by a first search, arms
// the failure, searches, and prints what the searches returned and
// whether the failure was still armed after them.
func check(p: view[]u8, sc: edit[regex.Scratch], room: edit[Room], reserve: bool, long: view[]u8) {
    print_str("/")
    print_str(p)
    if reserve { say("/ after reserve") } else { say("/ after a first search") }
    with r := regex.compile(p) {
        match r {
            Err(e) => { say("  refused") }
            Ok(re) => {
                var seen: Seen = zero()
                if reserve {
                    sc.reserve(re)
                } else {
                    first := re.find(sc, "", 1usize)
                }
                testing.fail_next_alloc()
                searches(re, sc, room, long, seen)
                armed := still_armed()
                line("\"abababc 12ab99 xxxx abc xxx\"", seen, 0usize)
                line("\"\"", seen, 1usize)
                line("ab 2000 times, then c42:", seen, 2usize)
                line("\"y<0>zxx\"", seen, 3usize)
                print_str("  the failure was still armed: ")
                print_bool(armed)
                println()
            }
        }
    }
}

func main() -> i32 {
    long := Vec[u8].new()
    var i: usize = 0usize
    while i < 2000usize {
        long.extend("ab")
        i = i + 1usize
    }
    long.extend("c42")
    room := Room { dst: Vec[u8].with_capacity(8192usize), fields: Vec[regex.Span].with_capacity(16usize) }
    one := regex.Scratch.new()
    check("(a|ab)*c", one, room, true, long.as_view())
    check("[a-z]+[0-9]{2,4}$", one, room, true, long.as_view())
    check("x{3,}|^y.z", one, room, true, long.as_view())
    other := regex.Scratch.new()
    check("(a|ab)*c", other, room, false, long.as_view())
    check("[a-z]+[0-9]{2,4}$", other, room, false, long.as_view())
    check("x{3,}|^y.z", other, room, false, long.as_view())
    return 0i32
}
