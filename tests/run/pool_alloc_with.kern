//! phase: 3
//! expect: output pool_alloc_with
// Pool.alloc_with constructs in the slot (specs/in-place-init/SPEC.md R4):
// on an initializer error the partial field is destroyed, Node's own
// destructor does not run, len() is unchanged and the slot is reused by
// the next allocation; a freed slot is reused by alloc_with.
module t
struct Tok nocopy { id: u64 }
impl Tok {
    destructor(edit self) { print_str("drop tok "); print_u64(self.id); println() }
}
struct Node nocopy { key: u64; tok: Tok }
impl Node {
    destructor(edit self) { print_str("drop node "); print_u64(self.key); println() }
}
union E { Bad }
func init_a(n: out Node) -> Result[(), E] {
    n.key = 1u64
    n.tok = Tok { id: 10u64 }
    return Ok(())
}
func init_b(n: out Node) -> Result[(), E] {
    n.key = 2u64
    n.tok = Tok { id: 20u64 }
    return Ok(())
}
func init_fail(n: out Node) -> Result[(), E] {
    n.tok = Tok { id: 99u64 }
    return Err(Bad)
}
func run() -> Result[u64, AllocOrInit[E]] {
    p := Pool[Node].new()
    a := p.alloc_with(init_a)?
    print_str("len "); print_u64(u64(p.len())); println()
    match p.alloc_with(init_fail) {
        Ok(x) => { print_str("unexpected"); println() }
        Err(e) => {
            match e {
                Alloc(a) => { print_str("alloc error"); println() }
                Init(i) => { print_str("init error, len "); print_u64(u64(p.len())); println() }
            }
        }
    }
    b := p.alloc_with(init_b)?
    print_str("len "); print_u64(u64(p.len())); println()
    p.free(a)
    print_str("freed, len "); print_u64(u64(p.len())); println()
    c := p.alloc_with(init_a)?
    print_str("len "); print_u64(u64(p.len())); println()
    return Ok(p.get(b).key * 10u64 + p.get(c).key)
}
func main() -> i32 {
    match run() {
        Ok(v) => { print_str("ok "); print_u64(v); println() }
        Err(e) => { print_str("unexpected"); println() }
    }
    return 0i32
}
