//! phase: 3
//! expect: output vec_reserved_append
//! test-hooks: true
// An append that fits in reserved capacity makes no allocation call
// (specs/fallible-alloc/SPEC.md R5). Each part reserves, arms the hook once,
// appends with every append form, and then probes once with Box.try_new:
// the probe still fails, so none of the appends consumed the hook. Nothing
// re-arms between a part's appends and its probe. The Vec part fills 16
// elements; the String part reserves the bounds of its appends (1 + 1 +
// 3 + 3 + 20 + 20 + 16 + 4 + 30 bytes) and uses every String append form.
module run
import "std/str"
func res(r: Result[(), AllocErr]) {
    match r {
        Ok(u) => { print_str("  ok"); println() }
        Err(e) => { print_str("  err out of memory"); println() }
    }
}
func probe() -> Result[(), AllocErr] {
    b := Box[u64].try_new(1u64)?
    return Ok(())
}
func show(v: view[Vec[u64]]) {
    h := 0u64
    for x in v.as_view() { h = (h * 31u64 + x) % 1000003u64 }
    print_str("  len "); print_u64(u64(v.len()))
    print_str(" cap "); print_u64(u64(v.capacity()))
    print_str(" sum "); print_u64(h)
    println()
}
func main() -> i32 {
    print_str("vec"); println()
    three := Vec[u64].new()
    three.push(3u64); three.push(4u64); three.push(5u64)
    v := Vec[u64].new()
    res(v.try_reserve(16usize))
    testing.fail_next_alloc()
    v.push(1u64)
    res(v.try_push(2u64))
    v.extend(three.as_view())
    res(v.try_extend(three.as_view()))
    v.resize(12usize, 6u64)
    res(v.try_resize(16usize, 7u64))
    show(v)
    print_str("probe"); println()
    res(probe())
    print_str("string"); println()
    s := str.String.new()
    res(s.try_reserve(98usize))
    testing.fail_next_alloc()
    s.push(65u8)
    res(s.try_push(66u8))
    s.push_str("cde")
    res(s.try_push_str("fgh"))
    s.push_u64(18446744073709551615u64)
    s.push_i64(0i64 - 9223372036854775807i64 - 1i64)
    s.push_hex(18446744073709551615u64)
    if !s.push_rune(128512u32) { print_str("  rune rejected"); println() }
    s.push_padded(7u64, 30usize, 32u8)
    print_str("  "); print_str(s.as_view()); println()
    print_str("  len "); print_u64(u64(s.len())); print_str(" cap "); print_u64(u64(s.capacity())); println()
    print_str("probe"); println()
    res(probe())
    return 0i32
}
