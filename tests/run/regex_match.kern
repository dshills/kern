    row(rs, "(^a|^b)c", opts(false, true), "x\nbc", 0usize)

    say("-- ignore_case, and a pattern of ordinary bytes with and without it")
    row(rs, "abc", opts(true, false), "xABcx", 0usize)
    row(rs, "abc", opts(false, false), "xABcx", 0usize)
    row(rs, "a1b", opts(true, false), "A1B", 0usize)
    row(rs, "123", opts(true, false), "x123", 0usize)
    row(rs, "123", opts(true, false), "x123", 2usize)
