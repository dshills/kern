    row(rs, "a{1,2}{2}", opts(false, false), "aaaaa", 0usize)
    row(rs, "a{3,}", opts(false, false), "aa", 0usize)
    row(rs, "(a{2,}b){2}", opts(false, false), "aabaaab", 0usize)
    row(rs, "a{0,1}b", opts(false, false), "aab", 0usize)

    say("-- any byte")
    row(rs, ".", opts(false, false), "a", 0usize)
    row(rs, ".", opts(false, false), "", 0usize)
    row(rs, ".", opts(false, false), "\n", 0usize)
    row(rs, ".", opts(false, true), "\n", 0usize)
    row(rs, ".", opts(false, true), "\na", 0usize)
    row(rs, "a.c", opts(false, false), "a\nc", 0usize)
    row(rs, "a.c", opts(false, true), "a\nc", 0usize)
    row(rs, ".*", opts(false, false), "ab\ncd", 0usize)
    row(rs, ".*", opts(false, true), "ab\ncd", 0usize)
    row(rs, ".*", opts(false, true), "ab\ncd", 2usize)
    row(rs, ".*", opts(false, true), "ab\ncd", 3usize)
    row(rs, ".+", opts(false, true), "\n\nab", 0usize)
    row(rs, ".", opts(false, false), "\0", 0usize)
    row(rs, "..", opts(false, false), "a\xff", 0usize)

    say("-- bracket expressions")
    row(rs, "[abc]", opts(false, false), "xbz", 0usize)
    row(rs, "[a-c]+", opts(false, false), "xabcd", 0usize)
    row(rs, "[^a]", opts(false, false), "aab", 0usize)
    row(rs, "[^a]", opts(false, false), "aaa", 0usize)
    row(rs, "[^a]", opts(false, false), "a\n", 0usize)
    row(rs, "[^a]", opts(false, true), "a\n", 0usize)
    row(rs, "[\\n]", opts(false, true), "a\n", 0usize)
    row(rs, "[]a]+", opts(false, false), "x]a]", 0usize)
