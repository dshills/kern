    row(rs, "[^a]", opts(true, false), "aAb", 0usize)
    row(rs, "[^a-z]+", opts(true, false), "abXY12z", 0usize)
    row(rs, "\\x41", opts(true, false), "xa", 0usize)
    row(rs, "[[:upper:]]+", opts(true, false), "abC1", 0usize)
