    row(rs, "[^[:space:]]+", opts(false, false), " ab ", 0usize)
    row(rs, "[[:upper:]][[:lower:]]*", opts(false, false), "xHello World", 0usize)
    row(rs, "[\\]]", opts(false, false), "a]", 0usize)
    row(rs, "[\\\\]", opts(false, false), "a\\b", 0usize)
    row(rs, "[\\x41-\\x43]+", opts(false, false), "xABCD", 0usize)
    row(rs, "[\t ]+", opts(false, false), "a \t b", 0usize)
    row(rs, "[*+?.]", opts(false, false), "a.b", 0usize)
    row(rs, "[[]", opts(false, false), "a[", 0usize)
    row(rs, "[^\0-\x7f]+", opts(false, false), "abéc", 0usize)
    row(rs, "[[:alpha:]-]+", opts(false, false), "1a-b2", 0usize)

    say("-- escapes")
    row(rs, "\\.", opts(false, false), "a.b", 0usize)
    row(rs, "\\.", opts(false, false), "ab", 0usize)
    row(rs, "\\\\", opts(false, false), "a\\b", 0usize)
    row(rs, "\\(a\\)", opts(false, false), "(a)", 0usize)
    row(rs, "a\\|b", opts(false, false), "a|b", 0usize)
    row(rs, "\\n", opts(false, false), "a\nb", 0usize)
    row(rs, "\\t\\r", opts(false, false), "x\t\r", 0usize)
    row(rs, "\\x41\\x4a", opts(false, false), "AJ", 0usize)
    row(rs, "\\x4", opts(false, false), "\x04", 0usize)
    row(rs, "\\x414", opts(false, false), "A4", 0usize)
    row(rs, "\\x00", opts(false, false), "a\0b", 0usize)
    row(rs, "a\\*", opts(false, false), "a*", 0usize)
    row(rs, "\\{2\\}", opts(false, false), "{2}", 0usize)
    row(rs, "\\^\\$", opts(false, false), "^$", 0usize)
    row(rs, "\\f\\v\\a", opts(false, false), "\x0c\x0b\x07", 0usize)

    say("-- anchors refer to the whole text")
    row(rs, "^a", opts(false, false), "ab", 0usize)
    row(rs, "^a", opts(false, false), "ba", 0usize)
    row(rs, "^a", opts(false, false), "ba", 1usize)
    row(rs, "^a", opts(false, false), "aa", 1usize)
    row(rs, "a$", opts(false, false), "aa", 0usize)
    row(rs, "a$", opts(false, false), "ab", 0usize)
    row(rs, "^$", opts(false, false), "", 0usize)
    row(rs, "^$", opts(false, false), "", 1usize)
    row(rs, "^$", opts(false, false), "a", 0usize)
    row(rs, "^", opts(false, false), "abc", 0usize)
    row(rs, "^", opts(false, false), "abc", 1usize)
    row(rs, "$", opts(false, false), "abc", 0usize)
    row(rs, "$", opts(false, false), "abc", 3usize)
    row(rs, "$", opts(false, false), "abc", 4usize)
    row(rs, "^abc$", opts(false, false), "abc", 0usize)
    row(rs, "^abc$", opts(false, false), "abcd", 0usize)
    row(rs, "x^a", opts(false, false), "xa", 0usize)
    row(rs, "x^a", opts(false, false), "xa", 1usize)
    row(rs, "a^b", opts(false, false), "ab", 0usize)
    row(rs, "a$b", opts(false, false), "ab", 0usize)
    row(rs, "^*a", opts(false, false), "ba", 0usize)
    row(rs, "^a|b", opts(false, false), "xb", 0usize)
