//! phase: 6
//! expect: output regex_match
// std/regex, searching (specs/std-regex/SPEC.md, T2): the match find
// returns for a pattern, its options, a text and an offset to search
// from, over every operator, the leftmost-longest choice, anchors with
// and without newline, ignore_case, the byte 0 and bytes above 127, the
// empty pattern and the empty text, and offsets at and past the end of
// the text. The rows where a search may take a shorter way (a pattern of
// ordinary bytes, one that can only begin at offset 0, one whose first
// byte is known) are searched from 0 and from above it. Every row is
// searched with a new Scratch, whose span is the one printed, and again
// with one Scratch that serves all the rows in turn, which must give the
// same; is_match on that Scratch must agree with find from 0.
module t
import "std/regex"

func say(s: view[]u8) { print_str(s); println() }

// show prints bytes, one outside 32 to 126 as its value in angle brackets.
func show(p: view[]u8) {
    var i: usize = 0usize
    while i < len(p) {
        if p[i] >= 32u8 && p[i] <= 126u8 {
            print_str(p[i:i + 1usize])
        } else {
            print_str("<")
            print_u64(u64(p[i]))
            print_str(">")
        }
        i = i + 1usize
    }
}

func opts(ignore_case: bool, newline: bool) -> regex.Options {
    o := regex.options()
    o.ignore_case = ignore_case
    o.newline = newline
    return o
}

func span(s: Option[regex.Span]) {
    match s {
        Some(m) => {
            print_u64(u64(m.start))
            print_str("-")
            print_u64(u64(m.end))
        }
        None => print_str("none")
    }
}

func same(a: Option[regex.Span], b: Option[regex.Span]) -> bool {
    match a {
        Some(x) => {
            match b {
                Some(y) => { return x.start == y.start && x.end == y.end }
                None => { return false }
            }
        }
        None => {
            match b {
                Some(y) => { return false }
                None => { return true }
            }
        }
    }
}

func found(s: Option[regex.Span]) -> bool {
    match s {
        Some(m) => { return true }
        None => { return false }
    }
}

// Rows holds the Scratch every row is searched with a second time, and
// how many rows there were and how many gave another answer with it.
struct Rows nocopy { shared: regex.Scratch; count: u64; differ: u64 }

func title(p: view[]u8, o: regex.Options, text: view[]u8) {
    print_str("/")
    show(p)
    print_str("/")
    if o.ignore_case { print_str(" ignore_case") }
    if o.newline { print_str(" newline") }
    print_str(" in \"")
    show(text)
    print_str("\"")
}

func row(rs: edit[Rows], p: view[]u8, o: regex.Options, text: view[]u8, from: usize) {
    rs.count = rs.count + 1u64
    title(p, o, text)
    print_str(" from ")
    print_u64(u64(from))
    print_str(" => ")
    with r := regex.compile_with(p, o) {
        match r {
            Err(e) => { print_str("refused") }
            Ok(re) => {
                fresh := regex.Scratch.new()
                got := re.find(fresh, text, from)
                span(got)
                again := re.find(rs.shared, text, from)
                any := re.is_match(rs.shared, text)
                whole := re.find(rs.shared, text, 0usize)
                if !same(got, again) || any != found(whole) { rs.differ = rs.differ + 1u64 }
            }
        }
    }
    println()
}

func matches(rs: edit[Rows], p: view[]u8, o: regex.Options, text: view[]u8) {
    title(p, o, text)
    print_str(" => ")
    with r := regex.compile_with(p, o) {
        match r {
            Err(e) => { print_str("refused") }
            Ok(re) => {
                fresh := regex.Scratch.new()
                print_bool(re.is_match(fresh, text))
                if re.is_match(rs.shared, text) != re.is_match(fresh, text) { rs.differ = rs.differ + 1u64 }
            }
        }
    }
    println()
}

// kept compiles a pattern held in a vector, overwrites the vector and
// destroys it, and returns what the compilation gave.
func kept() -> Result[regex.Regex, regex.CompileErr] {
    v := Vec[u8].new()
    v.extend("(a)(b(c))")
    r := regex.compile(v.as_view())
    var i: usize = 0usize
    while i < v.len() {
        with b := v.at(i) { b = 41u8 }
        i = i + 1usize
    }
    drop(v)
    return r
}

func main() -> i32 {
    rs := Rows { shared: regex.Scratch.new(), count: 0u64, differ: 0u64 }

    say("-- ordinary bytes")
    row(rs, "abc", opts(false, false), "abc", 0usize)
    row(rs, "abc", opts(false, false), "xabcx", 0usize)
    row(rs, "abc", opts(false, false), "ab", 0usize)
    row(rs, "abc", opts(false, false), "abcabc", 1usize)
    row(rs, "abc", opts(false, false), "abcabc", 3usize)
    row(rs, "abc", opts(false, false), "abcabc", 4usize)
    row(rs, "a", opts(false, false), "", 0usize)
    row(rs, "aa", opts(false, false), "aaa", 1usize)
    row(rs, "ab", opts(false, false), "abab", 1usize)
    row(rs, "b", opts(false, false), "abab", 2usize)

    say("-- the empty pattern")
    row(rs, "", opts(false, false), "", 0usize)
    row(rs, "", opts(false, false), "abc", 0usize)
    row(rs, "", opts(false, false), "abc", 2usize)
    row(rs, "", opts(false, false), "abc", 3usize)
    row(rs, "", opts(false, false), "abc", 4usize)
    row(rs, "", opts(false, false), "", 1usize)

    say("-- alternation: the leftmost match, and of those the longest")
    row(rs, "a|ab", opts(false, false), "ab", 0usize)
    row(rs, "ab|a", opts(false, false), "ab", 0usize)
    row(rs, "a|ab|abc", opts(false, false), "xabcd", 0usize)
    row(rs, "b|ab", opts(false, false), "ab", 0usize)
    row(rs, "a|b", opts(false, false), "cba", 0usize)
    row(rs, "a|", opts(false, false), "ba", 0usize)
    row(rs, "a|", opts(false, false), "ba", 1usize)
    row(rs, "|a", opts(false, false), "a", 0usize)
    row(rs, "a||b", opts(false, false), "b", 0usize)
    row(rs, "x|y|z", opts(false, false), "abc", 0usize)
    row(rs, "ab|cd", opts(false, false), "acd", 0usize)
    row(rs, "abcd|bc", opts(false, false), "abcx", 0usize)
    row(rs, "(a|ab)(c|bcd)", opts(false, false), "abcd", 0usize)
    row(rs, "foo|foobar", opts(false, false), "foobarbaz", 0usize)
    row(rs, "b*|a", opts(false, false), "ab", 0usize)
    row(rs, "a*|b", opts(false, false), "b", 0usize)
    row(rs, "(a|ab)(bc|c)?", opts(false, false), "abc", 0usize)
    row(rs, "xy|y|yz", opts(false, false), "ayz", 0usize)

    say("-- groups")
    row(rs, "(a)", opts(false, false), "ba", 0usize)
    row(rs, "(a)(b)", opts(false, false), "ab", 0usize)
    row(rs, "()", opts(false, false), "x", 0usize)
    row(rs, "(|a)", opts(false, false), "a", 0usize)
    row(rs, "((a|b)c)", opts(false, false), "xbc", 0usize)
    row(rs, "(a(b(c)))d", opts(false, false), "abcd", 0usize)
    row(rs, "(a)|(b)", opts(false, false), "cb", 0usize)

    say("-- star, plus, question mark")
    row(rs, "a*", opts(false, false), "aaa", 0usize)
    row(rs, "a*", opts(false, false), "baaa", 0usize)
    row(rs, "a*", opts(false, false), "baaa", 1usize)
    row(rs, "a*", opts(false, false), "b", 0usize)
    row(rs, "a*", opts(false, false), "b", 1usize)
    row(rs, "a*", opts(false, false), "b", 2usize)
    row(rs, "a+", opts(false, false), "baaa", 0usize)
    row(rs, "a+", opts(false, false), "bbb", 0usize)
