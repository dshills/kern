    row(rs, "abc", opts(false, false), "xxabc", 0usize)
    row(rs, "abc", opts(false, false), "xxabc", 3usize)
    row(rs, "abc", opts(true, false), "xxABC", 0usize)
    row(rs, "abc", opts(true, false), "xxABC", 3usize)
    row(rs, "^a", opts(true, false), "A", 0usize)
    row(rs, "^a.$", opts(true, true), "b\nAx\nc", 0usize)

    say("-- the byte 0 and bytes above 127")
    row(rs, "\xc8", opts(false, false), "a\xc8", 0usize)
    row(rs, "a\0b", opts(false, false), "xa\0b", 0usize)
    row(rs, "\0+", opts(false, false), "a\0\0b", 0usize)
    row(rs, "[\0\xff]+", opts(false, false), "\xff\0a", 0usize)
    row(rs, "a.b", opts(false, false), "a\0b", 0usize)
    row(rs, "\xff\xfe", opts(false, false), "\xff\xff\xfe", 0usize)

    say("-- from at the end of the text and past it")
    row(rs, "a", opts(false, false), "aaa", 3usize)
    row(rs, "a*", opts(false, false), "aaa", 3usize)
    row(rs, "a", opts(false, false), "aaa", 4usize)
    row(rs, "a", opts(false, false), "aaa", 1000000usize)
    row(rs, "a*", opts(false, false), "aaa", 4usize)
    row(rs, "^", opts(false, false), "", 0usize)
    row(rs, "a|$", opts(false, false), "bb", 2usize)
    row(rs, "abc", opts(false, false), "abc", 1000000usize)
    row(rs, "^a", opts(false, false), "a", 5usize)

    say("-- is_match")
    matches(rs, "abc", opts(false, false), "xabcx")
    matches(rs, "abc", opts(false, false), "ab")
    matches(rs, "", opts(false, false), "")
    matches(rs, "a", opts(false, false), "")
    matches(rs, "^a", opts(false, false), "ba")
    matches(rs, "a$", opts(false, false), "ba")
    matches(rs, "^$", opts(false, true), "a\n")
    matches(rs, "^$", opts(false, false), "a\n")
    matches(rs, "abc", opts(true, false), "xxABC")
    matches(rs, "[0-9]+", opts(false, false), "abc")
    matches(rs, "x*", opts(false, false), "")
    matches(rs, "a{3}", opts(false, false), "aa")
    matches(rs, "a{3}", opts(false, false), "aaa")
    matches(rs, ".", opts(false, true), "\n")
    matches(rs, "(a|b)*c", opts(false, false), "abab")
    matches(rs, "(a|b)*c", opts(false, false), "ababc")
    matches(rs, "b", opts(false, false), "aaaaaaaab")

    say("-- the pattern is not kept")
    with r := kept() {
        match r {
            Err(e) => { print_str("refused") }
            Ok(re) => { span(re.find(rs.shared, "xabc", 0usize)) }
        }
    }
    println()

    say("-- every row again with one Scratch for them all, and is_match beside find")
    print_str("rows ")
    print_u64(rs.count)
    print_str(", differences ")
    print_u64(rs.differ)
    println()
    return 0i32
}
