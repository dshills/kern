    row(rs, "ab?c", opts(false, false), "abbc", 0usize)
    row(rs, "(ab)*", opts(false, false), "ababa", 0usize)
    row(rs, "(ab)+", opts(false, false), "xababx", 0usize)
    row(rs, "(a|b)*c", opts(false, false), "abbac", 0usize)
    row(rs, "(a|b)*c", opts(false, false), "xyc", 0usize)
    row(rs, "a*b*", opts(false, false), "aabbb", 0usize)
    row(rs, "a*b*", opts(false, false), "bba", 0usize)
    row(rs, "a+?", opts(false, false), "aa", 0usize)
    row(rs, "a**", opts(false, false), "aaa", 0usize)
    row(rs, "(a*)*", opts(false, false), "aa", 0usize)
    row(rs, "(a*)+", opts(false, false), "b", 0usize)
    row(rs, "x*", opts(false, false), "abc", 1usize)
    row(rs, "a*ab", opts(false, false), "aaab", 0usize)
    row(rs, "[ab]*abb", opts(false, false), "ababb", 0usize)
    row(rs, "[ab]*abb", opts(false, false), "xabab", 0usize)
    row(rs, "(a|b)*abb", opts(false, false), "aabb", 0usize)
    row(rs, "(a+)(a+)", opts(false, false), "aaa", 0usize)

    say("-- intervals")
    row(rs, "a{2}", opts(false, false), "aaaa", 0usize)
    row(rs, "a{2}", opts(false, false), "a", 0usize)
    row(rs, "a{2,}", opts(false, false), "aaaa", 0usize)
    row(rs, "a{2,}", opts(false, false), "a", 0usize)
    row(rs, "a{2,}", opts(false, false), "baab", 0usize)
    row(rs, "a{2,3}", opts(false, false), "aaaa", 0usize)
    row(rs, "a{2,3}", opts(false, false), "aab", 0usize)
    row(rs, "a{0}", opts(false, false), "aaa", 0usize)
    row(rs, "a{0}b", opts(false, false), "ab", 0usize)
    row(rs, "a{0,}", opts(false, false), "aa", 0usize)
    row(rs, "a{0,2}", opts(false, false), "aaa", 0usize)
    row(rs, "a{1,1}", opts(false, false), "a", 0usize)
    row(rs, "(ab){2}", opts(false, false), "ababab", 0usize)
