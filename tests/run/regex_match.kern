    row(rs, "^a|b", opts(false, false), "xb", 2usize)
    row(rs, "(^a|^b)c", opts(false, false), "xbc", 0usize)
    row(rs, "(^a|^b)c", opts(false, false), "xbc", 1usize)
    row(rs, "(^a|^b)c", opts(false, false), "bc", 0usize)
    row(rs, "(^a|^b)c", opts(false, false), "bc", 1usize)
    row(rs, "^a*", opts(false, false), "aab", 0usize)
