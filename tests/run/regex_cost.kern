//! phase: 6
//! expect: output regex_cost
// std/regex, the cost of a search (specs/std-regex/SPEC.md, T5 and R18):
// three patterns on which a search that tries one alternative at a time
// takes time exponential or quadratic in the text, each against 200,000
// bytes of `a`, where none matches, and against the same bytes followed
// by `bc`, by find and by captures. A search takes time proportional to
// the text, so the fixture finishes; the spans are those of R11 and R13.
// The group of `(a*)*b` repeats an operand that matches the empty string,
// so R13 says of its span only that it lies within the match.
module t
import "std/regex"

func span(s: Option[regex.Span]) {
    match s {
        Some(m) => {
            print_u64(u64(m.start))
            print_str("-")
            print_u64(u64(m.end))
        }
        None => print_str("none")
    }
}

// within is whether a group's span is none or lies within the match.
func within(g: Option[regex.Span], whole: Option[regex.Span]) -> bool {
    match g {
        Some(m) => {
            match whole {
                Some(w) => { return w.start <= m.start && m.start <= m.end && m.end <= w.end }
                None => { return false }
            }
        }
        None => { return true }
    }
}

func run(p: view[]u8, sc: edit[regex.Scratch], text: view[]u8, what: view[]u8, exact: bool) {
    print_str("/")
    print_str(p)
    print_str("/ in ")
    print_str(what)
    print_str(" => ")
    with r := regex.compile(p) {
        match r {
            Err(e) => { print_str("refused") }
            Ok(re) => {
                span(re.find(sc, text, 0usize))
                var g: [2]Option[regex.Span] = zero()
                print_str(", captures ")
                if re.captures(sc, text, 0usize, g) {
                    print_str("true ")
                    span(g[0usize])
                    if exact {
                        print_str(", group 1 ")
                        span(g[1usize])
                    } else {
                        print_str(", group 1 within the match or none: ")
                        print_bool(within(g[1usize], g[0usize]))
                    }
                } else {
                    print_str("false")
                }
            }
        }
    }
    println()
}

func main() -> i32 {
    text := Vec[u8].new()
    text.resize(200000usize, 97u8)
    sc := regex.Scratch.new()
    run("(a*)*b", sc, text.as_view(), "200000 bytes of a", false)
    run("(a|aa)*c", sc, text.as_view(), "200000 bytes of a", true)
    run("a*a*a*a*a*b", sc, text.as_view(), "200000 bytes of a", true)
    text.push(98u8)
    text.push(99u8)
    run("(a*)*b", sc, text.as_view(), "200000 bytes of a, then bc", false)
    run("(a|aa)*c", sc, text.as_view(), "200000 bytes of a, then bc", true)
    run("a*a*a*a*a*b", sc, text.as_view(), "200000 bytes of a, then bc", true)
    return 0i32
}
