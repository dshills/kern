//! phase: 3
//! expect: output
// std/str formatting (specs/std-gaps R6): push_i64, push_hex and
// push_padded on boundary values, in both engines.
module t
import "std/str"
func line(s: view[str.String]) {
    print_str(s.as_view())
    println()
}
func main() -> i32 {
    signed := [0i64, 1i64, -1i64, 9i64, -10i64, 9223372036854775807i64, -9223372036854775808i64]
    for v in signed {
        s := str.String.new()
        s.push_i64(v)
        line(s)
    }
    hex := [0u64, 1u64, 9u64, 10u64, 15u64, 16u64, 255u64, 3735928559u64, 18446744073709551615u64]
    for v in hex {
        s := str.String.new()
        s.push_hex(v)
        line(s)
    }
    s := str.String.new()
    s.push_padded(42u64, 6usize, 48u8)
    s.push(124u8)
    s.push_padded(42u64, 6usize, 32u8)
    s.push(124u8)
    s.push_padded(123456u64, 3usize, 48u8)
    s.push(124u8)
    s.push_padded(0u64, 1usize, 48u8)
    s.push(124u8)
    s.push_padded(0u64, 0usize, 48u8)
    s.push(124u8)
    s.push_padded(18446744073709551615u64, 22usize, 46u8)
    line(s)
    return 0i32
}
