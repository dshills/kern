//! phase: 3
//! expect: output mmio
//! env: freestanding
// Volatile stores to the console device address write bytes directly: the
// program's own driver for the PL011 data register.
module fs
contract { requires "0x0900_0000 is the console device of the target machine" }
func putc(c: u8) { unsafe { ptr_store_volatile(ptr_from_addr[u8](150994944usize), c) } }
func main() -> i32 {
    putc(107u8)
    putc(101u8)
    putc(114u8)
    putc(110u8)
    putc(10u8)
    return 0i32
}
