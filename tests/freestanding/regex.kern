//! phase: 6
//! expect: output regex
//! env: freestanding
// std/regex on bare metal (specs/std-regex/SPEC.md, T7 and R20): the
// module calls no runtime entry of its own, so compiling a pattern and
// searching need only the allocator a Vec needs. Three patterns, each
// compiled and searched with find, is_match and captures, and used by
// replace_all; one more splits a text. A hosted run of this file prints
// the same lines.
module fs
import "std/regex"

func seek(re: view[regex.Regex], sc: edit[regex.Scratch], text: view[]u8, from: usize) {
    print_str("  in \"")
    print_str(text)
    print_str("\" from ")
    print_u64(u64(from))
    print_str(" => ")
    match re.find(sc, text, from) {
        Some(m) => {
            print_u64(u64(m.start))
            print_str("-")
            print_u64(u64(m.end))
        }
        None => print_str("none")
    }
    print_str(", is_match ")
    print_bool(re.is_match(sc, text))
    print_str(", captures ")
    var g: [3]Option[regex.Span] = zero()
    if re.captures(sc, text, from, g) {
        print_str("[")
        for i in 0usize..3usize {
            if i > 0usize { print_str(" ") }
            match g[i] {
                Some(m) => {
                    print_u64(u64(m.start))
                    print_str("-")
                    print_u64(u64(m.end))
                }
                None => print_str("none")
            }
        }
        print_str("]")
    } else {
        print_str("false")
    }
    println()
}

func sub(re: view[regex.Regex], sc: edit[regex.Scratch], text: view[]u8, template: view[]u8) {
    print_str("  replace_all in \"")
    print_str(text)
    print_str("\" with \"")
    print_str(template)
    print_str("\" => ")
    dst := Vec[u8].new()
    print_u64(u64(re.replace_all(sc, text, template, dst)))
    print_str(" \"")
    print_str(dst.as_view())
    print_str("\"")
    println()
}

func main() -> i32 {
    sc := regex.Scratch.new()
    print_str("/(ab|c)+d/")
    println()
    with r := regex.compile("(ab|c)+d") {
        match r {
            Err(e) => { print_str("  refused"); println() }
            Ok(re) => {
                seek(re, sc, "xabcabd!", 0usize)
                seek(re, sc, "xabcabd!", 2usize)
                seek(re, sc, "abab", 0usize)
                sub(re, sc, "xabcabd! cd", "[\\1&]")
            }
        }
    }
    print_str("/[[:digit:]]{2,3}$/")
    println()
    with r := regex.compile("[[:digit:]]{2,3}$") {
        match r {
            Err(e) => { print_str("  refused"); println() }
            Ok(re) => {
                seek(re, sc, "a1 22 4567", 0usize)
                seek(re, sc, "12", 0usize)
                seek(re, sc, "1", 0usize)
                sub(re, sc, "a1 22 4567", "#")
            }
        }
    }
    o := regex.options()
    o.ignore_case = true
    print_str("/^k.rn|bare/ ignore_case")
    println()
    with r := regex.compile_with("^k.rn|bare", o) {
        match r {
            Err(e) => { print_str("  refused"); println() }
            Ok(re) => {
                seek(re, sc, "On BARE metal", 0usize)
                seek(re, sc, "Kern", 0usize)
                seek(re, sc, "kern kern", 1usize)
                sub(re, sc, "Kern on BARE metal", "<&>")
            }
        }
    }
    with r := regex.compile(", *") {
        match r {
            Err(e) => {
                print_str("/, */ refused")
                println()
            }
            Ok(re) => {
                fields := Vec[regex.Span].new()
                print_str("/, */ split \"a, b,c\" => ")
                print_u64(u64(re.split(sc, "a, b,c", fields)))
                print_str(":")
                for f in fields.as_view() {
                    print_str(" ")
                    print_u64(u64(f.start))
                    print_str("-")
                    print_u64(u64(f.end))
                }
                println()
            }
        }
    }
    with r := regex.compile("a{2,1}") {
        match r {
            Err(e) => {
                print_str("/a{2,1}/ refused at ")
                print_u64(u64(e.at))
                println()
            }
            Ok(re) => { print_str("/a{2,1}/ accepted"); println() }
        }
    }
    return 0i32
}
