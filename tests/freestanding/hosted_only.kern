//! expect: reject ENV_HOSTED_ONLY rule=6.8
//! twin: hosted_only_ok
//! env: freestanding
// A freestanding image has no wall clock: std/time's wall_nanos reaches the
// hosted runtime's kern_time_wall_ns, so the call is rejected before the
// program is built or run (Rule 6.8, specs/freestanding-availability). The
// monotonic clock is provided (specs/freestanding-clock).
module fs
import "std/time"
func main() -> i32 {
    t := time.wall_nanos()
    print_u64(t)
    println()
    return 0i32
}
