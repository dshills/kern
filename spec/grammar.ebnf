(* kern — Phase 1 subset grammar. ISO-14977-style EBNF.
   Tokens: identifiers, keywords, literals and punctuation are produced by compiler/lexer.
   Newlines are statement terminators inside blocks; ';' is an explicit terminator and is
   also accepted between struct fields and union variants. Comments: '//' to end of line.
   '//!' lines at the top of a file are fixture headers and are ignored by the parser. *)

file          = "module" ident newline , { import } , { decl } ;
import        = "import" string_lit newline ;

decl          = struct_decl | union_decl | interface_decl | impl_decl | func_decl
              | extern_decl | const_decl | tls_decl | assert_decl ;
assert_decl   = "unsafe" "assert" ( "Send" | "Share" | "Interior" ) "for" ident newline ;

type_params   = "[" type_param { "," type_param } "]" ;
type_param    = ident [ ":" constraint { "+" constraint } ] ;
constraint    = "Copy" | "Send" | "Share" | type_name ;

struct_decl   = [ "view" ] "struct" ident [ type_params ] [ "nocopy" ] "{" { field sep } "}" ;
field         = ident ":" type ;
union_decl    = "union" ident [ type_params ] "{" { variant sep } "}" ;
variant       = ident [ "(" variant_fields ")" ] ;
variant_fields= type { "," type } | field { "," field } ;
interface_decl= "interface" ident [ type_params ] "{" { func_sig sep } "}" ;
impl_decl     = "impl" [ type_params ] ( type_name "for" type | type ) "{" { impl_item } "}" ;
impl_item     = func_decl | destructor_decl ;
destructor_decl = "destructor" "(" "edit" "self" ")" block ;
const_decl    = "const" ident ":" type "=" expr newline ;
extern_decl   = "extern" string_lit "func" ident "(" [ params ] ")" [ "->" type ] ( newline | block ) ;
                                                  (* with a block: an exported function under its C symbol *)
tls_decl      = "thread_local" ident ":" type "=" expr newline ;   (* Copy type; literal or zero() *)

func_decl     = [ contract ] "func" ident [ type_params ] "(" [ params ] ")" [ "->" ret_type ]
                [ "release" ident ] block ;
func_sig      = "func" ident [ type_params ] "(" [ params ] ")" [ "->" ret_type ] ;
contract      = "contract" "{" { contract_clause sep } "}" ;
contract_clause = ( "invariant" | "requires" | "ensures" ) string_lit ;
params        = param { "," param } ;
param         = receiver | ident ":" param_type ;
receiver      = ( "view" | "edit" | "own" ) "self" ;
param_type    = type | "own" type | "out" type ;      (* view[T]/edit[T] are ordinary types *)
ret_type      = type | "(" type { "," type } ")" ;    (* tuple: only for multi-access returns *)

type          = prim_type | "RawPtr" "[" type "]"
              | "[" int_lit "]" type                  (* array *)
              | "[" "]" type                          (* slice, only under view/edit *)
              | "view" "[" type "]" | "edit" "[" type "]"
              | "view" "[" "]" type | "edit" "[" "]" type   (* sequence access shorthand *)
              | "func" "(" [ param_type { "," param_type } ] ")" [ "->" ret_type ]
              | "(" ")"                                (* unit *)
              | type_name ;
type_name     = ident [ "." ident ] [ "[" type { "," type } "]" ] ;
prim_type     = "i8" | "i16" | "i32" | "i64" | "isize" | "u8" | "u16" | "u32" | "u64" | "usize"
              | "f32" | "f64" | "bool" ;

block         = "{" { stmt } "}" ;
stmt          = ( var_decl | short_decl | assign | with_stmt | match_stmt | for_stmt
              | while_stmt | if_stmt | return_stmt | "break" | "continue"
              | unsafe_block | block | expr ) stmt_end ;
stmt_end      = newline | ";" ;
var_decl      = "var" ident ":" type [ "=" expr ] ;
short_decl    = ident ":=" expr ;
assign        = place "=" expr ;
with_stmt     = "with" ident { "," ident } ":=" expr block ;
match_stmt    = "match" match_subject "{" { match_arm } "}" ;
match_subject = expr | "move" ident ;
match_arm     = pattern "=>" ( block | stmt ) stmt_end ;
pattern       = [ type_name "." ] ident [ "(" [ ident { "," ident } ] ")" ] | "_" ;
for_stmt      = "for" ident "in" expr block ;        (* expr: place, projection, or range a..b *)
while_stmt    = "while" expr block ;
if_stmt       = "if" expr block [ "else" ( if_stmt | block ) ] ;
return_stmt   = "return" [ expr ] ;
unsafe_block  = "unsafe" block ;

expr          = or_expr ;
or_expr       = and_expr { "||" and_expr } ;
and_expr      = cmp_expr { "&&" cmp_expr } ;
cmp_expr      = range_expr [ ( "==" | "!=" | "<" | "<=" | ">" | ">=" ) range_expr ] ;
range_expr    = add_expr [ ".." add_expr ] ;
add_expr      = mul_expr { ( "+" | "-" | "|" | "^" ) mul_expr } ;
mul_expr      = unary_expr { ( "*" | "/" | "%" | "&" | "<<" | ">>" ) unary_expr } ;
unary_expr    = ( "-" | "!" ) unary_expr | postfix_expr ;
postfix_expr  = primary { postfix } ;
postfix       = "." ident [ "(" [ args ] ")" ]        (* field or method call *)
              | "[" expr "]" | "[" [ expr ] ":" [ expr ] "]"
              | "(" [ args ] ")" | "?" ;
args          = arg { "," arg } ;
arg           = [ "out" ] expr ;                      (* 'out x' passes uninitialized storage *)
primary       = int_lit | float_lit | string_lit | "true" | "false"
              | ident [ "[" type { "," type } "]" ]  (* generic instantiation f[T] *)
              | prim_type "(" expr ")"                (* conversion *)
              | "truncate" "[" prim_type "]" "(" expr ")"
              | "move" ident | "copy" "(" expr ")" | "take" "(" place ")"
              | "replace" "(" place "," expr ")" | "drop" "(" ident ")"
              | "trap" "(" ")"
              | type_name "{" [ field_init { "," field_init } ] "}"   (* struct literal *)
              | "(" expr ")" | "(" ")" ;
field_init    = ident ":" expr ;
place         = ident { "." ident | "[" expr "]" } ;

int_lit       = digit { digit | "_" } [ prim_type ] ;   (* 0u64, 42, 1_000i32 *)
float_lit     = digit { digit } "." digit { digit } [ "f32" | "f64" ] ;
string_lit    = '"' { character } '"' ;
ident         = ( letter | "_" ) { letter | digit | "_" } ;
