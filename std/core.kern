// kern standard-library prelude. Functions without bodies are intrinsics
// implemented by the compiler, the interpreter and the hosted runtime; the
// library containers (Box, Vec, Pool, Arena) are kern code over the
// raw-pointer core and are compiled with every program.
module core

// zero() yields the all-zero value of any Copy type (the only way to
// initialize an array without naming every element).
func zero[T: Copy]() -> T
// wrapping_add, wrapping_sub and wrapping_mul are the §4.1 wrapping forms:
// two's-complement arithmetic modulo 2^width on any integer type.
func wrapping_add[T: Copy](a: T, b: T) -> T
func wrapping_sub[T: Copy](a: T, b: T) -> T
func wrapping_mul[T: Copy](a: T, b: T) -> T
// count_trailing_zeros, count_leading_zeros and count_ones are the bit-count
// operations on integers; the count of a zero operand's trailing or leading
// zeros is the operand width. They never trap.
func count_trailing_zeros[T: Copy](x: T) -> u32
func count_leading_zeros[T: Copy](x: T) -> u32
func count_ones[T: Copy](x: T) -> u32
// load_be and load_le read an integer T from the bytes of a view at offset
// at, big- or little-endian, one bounds check (at + size_of[T] - 1 < len)
// the proof pass can discharge and one wide load natively; T is explicit.
func load_be[T: Copy](p: view[]u8, at: usize) -> T
func load_le[T: Copy](p: view[]u8, at: usize) -> T
// store_be and store_le write an integer T into the bytes of an edit at
// offset at, big- or little-endian: the same one bounds check on the last
// byte, and one wide store natively.
func store_be[T: Copy](p: edit[]u8, at: usize, v: T)
func store_le[T: Copy](p: edit[]u8, at: usize, v: T)
// Raw pointers (spec §6): every operation below is an unsafe operation and
// requires an unsafe block; the pointee's representation is the §4.1 layout.
func ptr_null[T]() -> RawPtr[T]
func ptr_from_addr[T](addr: usize) -> RawPtr[T]
func ptr_addr[T](p: RawPtr[T]) -> usize
func ptr_cast[U, T](p: RawPtr[T]) -> RawPtr[U]
func ptr_offset[T](p: RawPtr[T], n: isize) -> RawPtr[T]
func ptr_load[T: Copy](p: RawPtr[T]) -> T
func ptr_store[T](p: RawPtr[T], v: own T)
func ptr_take[T](p: RawPtr[T]) -> T
func ptr_load_volatile[T: Copy](p: RawPtr[T]) -> T
func ptr_store_volatile[T: Copy](p: RawPtr[T], v: T)
func ptr_copy[T](dst: RawPtr[T], src: RawPtr[T], n: usize)
// ptr_view, ptr_edit and their sequence forms open an access on raw memory:
// the pointee (or the n elements from p) must be a live, initialized value
// for the access's whole lifetime. A function that returns such an access
// must contain unsafe and carry a contract stating that obligation (rule
// 6.4); the containers below are the library's uses. ptr_edit2 opens two
// edits at once (the caller has checked that a and b are disjoint).
func ptr_view[T](p: RawPtr[T]) -> view[T]
func ptr_edit[T](p: RawPtr[T]) -> edit[T]
func ptr_view_seq[T](p: RawPtr[T], n: usize) -> view[]T
func ptr_edit_seq[T](p: RawPtr[T], n: usize) -> edit[]T
func ptr_edit2[T](a: RawPtr[T], b: RawPtr[T]) -> (edit[T], edit[T])
// ptr_store_seq writes the len(src) elements of a sequence view into raw
// memory at p, each in its §4.1 layout (so the elements are duplicated
// bitwise); the destination must not overlap the source. Vec.extend's block
// copy: natively one memcpy, in the interpreter an element-wise encode (a
// view of an array local has no raw address there).
func ptr_store_seq[T](p: RawPtr[T], src: view[]T)
// size_of and align_of are the §4.1 size and alignment of T in bytes.
func size_of[T]() -> usize
func align_of[T]() -> usize
// trap_kind terminates with the given trap kind, written as a literal
// variant (trap_kind(bounds)); the span reported is the call that entered
// the library, as for every trap raised inside std/core.
func trap_kind(kind: TrapKind)
// container_identity issues the next 32-bit identity tag (spec §5.6): a
// process-global counter starting at 1 in debug builds, 0 in release builds.
func container_identity() -> u32
// SIMD (PLAN.md 3.2): T is a fixed-width vector [N]E with N in 2, 4, 8, 16
// and E a number; lanes wrap on overflow. simd_shuffle selects lanes from
// the concatenation of a and b by index (traps bounds when out of range);
// simd_reduce_add sums the lanes (wrapping) and is typed by the checker.
func simd_add[T: Copy](a: T, b: T) -> T
func simd_sub[T: Copy](a: T, b: T) -> T
func simd_mul[T: Copy](a: T, b: T) -> T
func simd_and[T: Copy](a: T, b: T) -> T
func simd_or[T: Copy](a: T, b: T) -> T
func simd_xor[T: Copy](a: T, b: T) -> T
func simd_shuffle[T: Copy, I: Copy](a: T, b: T, idx: I) -> T
// asm executes an inline assembly template (unsafe; no operands, clobbers
// memory); the interpreter traps with kind explicit.
func asm(template: view[]u8)
// yield_now lets another thread run (a scheduling hint; hosted only, a
// no-op in the freestanding mode and the interpreter's scheduler).
func yield_now()
// exit terminates the program with a status (hosted) or halts (freestanding).
func exit(code: i32)

// Hosted output for the Phase 1 interpreter and fixtures.
func print_u64(v: u64)
func print_i64(v: i64)
func print_bool(v: bool)
func print_str(s: view[]u8)
func println()
// now_ns is a monotonic clock in nanoseconds (hosted; benchmarks).
func now_ns() -> u64

// Test hooks (PLAN.md 2.3): available only under --test-hooks.
struct testing { phantom: u8 }
impl testing {
    // require_hooks traps (interpreter) or fails to link (native) unless the
    // program was built with --test-hooks.
    func require_hooks()
    func seed_generation[T](p: edit[Pool[T]], slot: u32, gen: u32) {
        p.seed_generation(slot, gen) // gated by require_hooks inside
    }
    func seed_shared_count[T](s: view[Shared[T]], count: u64)
    // the next allocation by a convenience constructor fails (oom trap)
    func fail_next_alloc()
}

union Option[T] { Some(T); None }
union Result[T, E] { Ok(T); Err(E) }
// The remaining §4.1 alternative forms. wrapping_neg, wrapping_shl and
// wrapping_shr complete the wrapping forms: two's-complement negation, and
// shifts whose count is masked to width - 1; none traps. The saturating
// forms clamp to the type's range. The checked forms yield None exactly
// where the trapping form would trap (overflow, division by zero, the
// minimum signed value divided by -1, a shift count of the width or more,
// a set bit shifted out) and Some(result) otherwise.
func wrapping_neg[T: Copy](a: T) -> T
func wrapping_shl[T: Copy](a: T, n: u32) -> T
func wrapping_shr[T: Copy](a: T, n: u32) -> T
func saturating_add[T: Copy](a: T, b: T) -> T
func saturating_sub[T: Copy](a: T, b: T) -> T
func saturating_mul[T: Copy](a: T, b: T) -> T
func checked_add[T: Copy](a: T, b: T) -> Option[T]
func checked_sub[T: Copy](a: T, b: T) -> Option[T]
func checked_mul[T: Copy](a: T, b: T) -> Option[T]
func checked_div[T: Copy](a: T, b: T) -> Option[T]
func checked_rem[T: Copy](a: T, b: T) -> Option[T]
func checked_shl[T: Copy](a: T, n: u32) -> Option[T]
func checked_shr[T: Copy](a: T, n: u32) -> Option[T]
union AllocErr { OutOfMemory }
union AllocOrInit[E] { Alloc(AllocErr); Init(E) }
union SpawnErr { ResourceExhausted }

interface Allocator {
    func alloc(edit self, size: usize, align: usize) -> Result[RawPtr[u8], AllocErr]
    func free(edit self, ptr: RawPtr[u8], size: usize, align: usize)
}

struct SystemAllocator nocopy { phantom: u8 }
impl Allocator for SystemAllocator {
    func alloc(edit self, size: usize, align: usize) -> Result[RawPtr[u8], AllocErr]
    func free(edit self, ptr: RawPtr[u8], size: usize, align: usize)
}
impl SystemAllocator {
    func new() -> SystemAllocator
    // realloc resizes an allocation of alloc or realloc to new_size bytes
    // at the same alignment, keeping the first min(old_size, new_size)
    // bytes (in place when the allocator can); on failure the old
    // allocation is untouched. An unsafe operation with alloc's obligations.
    func realloc(edit self, ptr: RawPtr[u8], old_size: usize, new_size: usize, align: usize) -> Result[RawPtr[u8], AllocErr]
    // alloc_zeroed is alloc whose bytes are all zero (calloc: a large
    // block comes from fresh zero pages that are not touched until used).
    // An unsafe operation with alloc's obligations; freed by free.
    func alloc_zeroed(edit self, size: usize, align: usize) -> Result[RawPtr[u8], AllocErr]
}

// ---- Library containers (spec §5.6), written in kern over the raw-pointer
// core. Every raw operation sits in a small contracted method; the rest is
// ordinary kern that the backend inlines. Fields of a nocopy core struct are
// private to this module (the unsafe invariants below depend on them). The
// helper methods (reserve, grow, check, release) are visible like every core
// declaration and keep the container valid: release leaves an empty
// container (with a fresh identity where handles exist).
// The storage of every container comes from the system allocator.

// heap_alloc allocates size bytes at align from the system allocator and
// traps oom on failure: the convenience constructors' allocation.
contract { requires "align is a power of two at most 4096 and size is a multiple of it" }
func heap_alloc(size: usize, align: usize) -> RawPtr[u8] {
    p := heap_try_alloc(size, align)
    unsafe { if ptr_addr(p) == 0usize { trap_kind(oom) } }
    return p
}
// heap_try_alloc is heap_alloc that yields a null pointer on failure.
contract { requires "align is a power of two at most 4096 and size is a multiple of it" }
func heap_try_alloc(size: usize, align: usize) -> RawPtr[u8] {
    a := SystemAllocator.new()
    unsafe {
        match a.alloc(size, align) {
            Ok(p) => return p
            Err(e) => return ptr_null[u8]()
        }
    }
}
// heap_alloc_zeroed is heap_alloc whose bytes are all zero.
contract { requires "align is a power of two at most 4096 and size is a multiple of it" }
func heap_alloc_zeroed(size: usize, align: usize) -> RawPtr[u8] {
    a := SystemAllocator.new()
    var p: RawPtr[u8] = zero()
    unsafe {
        match a.alloc_zeroed(size, align) {
            Ok(q) => p = q
            Err(e) => trap_kind(oom)
        }
    }
    return p
}
// heap_realloc resizes an allocation, trapping oom on failure.
contract { requires "p, old_size and align are those of one live allocation; new_size is a multiple of align" }
func heap_realloc(p: RawPtr[u8], old_size: usize, new_size: usize, align: usize) -> RawPtr[u8] {
    q := heap_try_realloc(p, old_size, new_size, align)
    unsafe { if ptr_addr(q) == 0usize { trap_kind(oom) } }
    return q
}
// heap_try_realloc is heap_realloc that yields null on failure (the old
// allocation stays valid).
contract { requires "p, old_size and align are those of one live allocation; new_size is a multiple of align" }
func heap_try_realloc(p: RawPtr[u8], old_size: usize, new_size: usize, align: usize) -> RawPtr[u8] {
    a := SystemAllocator.new()
    unsafe {
        match a.realloc(p, old_size, new_size, align) {
            Ok(q) => return q
            Err(e) => return ptr_null[u8]()
        }
    }
}
// heap_free releases an allocation of heap_alloc or heap_try_alloc.
contract { requires "p, size and align are those of one live allocation" }
func heap_free(p: RawPtr[u8], size: usize, align: usize) {
    a := SystemAllocator.new()
    unsafe { a.free(p, size, align) }
}
// elems_bytes is n * size_of[T], or None when the product is unrepresentable.
func elems_bytes[T](n: usize) -> Option[usize] {
    esize := size_of[T]()
    if esize == 0usize { return Some(0usize) }
    if n > 18446744073709551615usize / esize { return None }
    return Some(n * esize)
}

struct Box[T] nocopy { p: RawPtr[T] }
impl Box[T] {
    contract { requires "the allocation holds one T until into or the destructor takes it" }
    func new(v: own T) -> Box[T] {
        unsafe {
            p := ptr_cast[T, u8](heap_alloc(size_of[T](), align_of[T]()))
            ptr_store(p, v)
            return Box[T] { p: p }
        }
    }
    // get, at and into trap explicit on a Box emptied by release.
    contract { requires "p is null or addresses the live T owned by this Box" }
    func get(view self) -> view[T] {
        unsafe {
            if ptr_addr(self.p) == 0usize { trap_kind(explicit) }
            return ptr_view(self.p)
        }
    }
    contract { requires "p is null or addresses the live T owned by this Box" }
    func at(edit self) -> edit[T] {
        unsafe {
            if ptr_addr(self.p) == 0usize { trap_kind(explicit) }
            return ptr_edit(self.p)
        }
    }
    contract { requires "p is null or addresses the live T owned by this Box; the Box is consumed" }
    func into(own self) -> T {
        unsafe {
            if ptr_addr(self.p) == 0usize { trap_kind(explicit) }
            v := ptr_take(self.p)
            heap_free(ptr_cast[u8, T](self.p), size_of[T](), align_of[T]())
            self.p = zero()
            return v
        }
    }
    // clone deep-copies the boxed value (the clone behind copy(b)).
    func clone(view self) -> Box[T] {
        return Box[T].new(copy(self.get()))
    }
    contract { requires "p is null (after into) or addresses the live T owned by this Box" }
    func release(edit self) {
        unsafe {
            if ptr_addr(self.p) != 0usize {
                v := ptr_take(self.p)
                drop(v)
                heap_free(ptr_cast[u8, T](self.p), size_of[T](), align_of[T]())
                self.p = zero()
            }
        }
    }
    destructor(edit self) { self.release() }
}

struct Vec[T] nocopy { data: RawPtr[T]; size: usize; cap: usize }
impl Vec[T] {
    func new() -> Vec[T] {
        return Vec[T] { data: zero(), size: 0usize, cap: 0usize }
    }
    func with_capacity(n: usize) -> Vec[T] {
        v := Vec[T].new()
        v.reserve(n)
        return v
    }
    func len(view self) -> usize { return self.size }
    // reserve makes room for at least n elements, trapping oom when the
    // allocator fails or the byte size is unrepresentable.
    contract { requires "data addresses cap elements of which the first size are live" }
    func reserve(edit self, n: usize) {
        if n <= self.cap { return }
        var bytes: usize = 0usize
        match elems_bytes[T](n) {
            Some(b) => bytes = b
            None => trap_kind(oom)
        }
        unsafe {
            if self.cap > 0usize {
                var old: usize = 0usize
                match elems_bytes[T](self.cap) {
                    Some(b) => old = b
                    None => trap_kind(unreachable)
                }
                self.data = ptr_cast[T, u8](heap_realloc(ptr_cast[u8, T](self.data), old, bytes, align_of[T]()))
            } else {
                self.data = ptr_cast[T, u8](heap_alloc(bytes, align_of[T]()))
            }
            self.cap = n
        }
    }
    // grow doubles the capacity (4 elements at first).
    func grow(edit self) {
        if self.cap > 9223372036854775807usize { trap_kind(oom) }
        n := 4usize
        if self.cap > 0usize { n = self.cap * 2usize }
        self.reserve(n)
    }
    // push appends v, growing the buffer when it is full. size < cap after
    // grow and cap never exceeds half the address space, so the increment
    // cannot wrap: the wrapping form keeps the hot path free of a check.
    contract { requires "data addresses cap elements of which the first size are live" }
    func push(edit self, v: own T) {
        if self.size == self.cap { self.grow() }
        unsafe { ptr_store(ptr_offset(self.data, truncate[isize](self.size)), v) }
        self.size = wrapping_add(self.size, 1usize)
    }
    contract { requires "data addresses cap elements of which the first size are live" }
    func pop(edit self) -> Option[T] {
        if self.size == 0usize { return None }
        self.size = self.size - 1usize
        unsafe { return Some(ptr_take(ptr_offset(self.data, truncate[isize](self.size)))) }
    }
    // grow_to makes room for at least n elements, doubling the capacity
    // when that is more, so a run of small extends stays amortized like a
    // run of pushes.
    func grow_to(edit self, n: usize) {
        if self.cap > 9223372036854775807usize { trap_kind(oom) }
        want := 4usize
        if self.cap > 0usize { want = self.cap * 2usize }
        if want < n { want = n }
        self.reserve(want)
    }
    // extend appends the elements of src, whose type must be Copy (the
    // where clause; CONSTRAINT_UNSATISFIED at a call otherwise): one
    // reservation for size + len(src) (checked, so the sum cannot wrap),
    // one block copy of the elements, then the size update. This is the
    // memcpy / extend_from_slice form of a loop of pushes.
    contract { requires "data addresses cap elements of which the first size are live; src does not overlap the spare capacity" }
    func extend(edit self, src: view[]T) where T: Copy {
        total := self.size + len(src)
        if total > self.cap { self.grow_to(total) }
        unsafe {
            ptr_store_seq(ptr_offset(self.data, truncate[isize](self.size)), src)
            self.size = total
        }
    }
    // resize sets the length to n: elements past n are destroyed, and the
    // new elements are copies of x (x itself is destroyed on return). The
    // fill runs over a local index so the backend can turn it into a block
    // store. A vector with nothing allocated takes zeroed storage first and
    // writes one copy: when that copy's bytes are all zero the rest of the
    // storage already holds it, so the fill is skipped and the pages stay
    // untouched until used (Rust's vec![0; n]). copy(x) runs no user code:
    // it is a load, a core container's clone or the field-wise clone, so it
    // is deterministic, and its one side effect (Shared.clone's count) comes
    // with a non-null pointer. A copy whose bytes are all zero therefore owns
    // nothing and changed nothing (a Vec copy is then the empty vector), and
    // bitwise duplicates of it are exactly what further copies would be.
    contract { requires "data addresses cap elements of which the first size are live; an all-zero copy of x owns nothing" }
    func resize(edit self, n: usize, x: own T) {
        while self.size > n {
            self.size = self.size - 1usize
            unsafe {
                v := ptr_take(ptr_offset(self.data, truncate[isize](self.size)))
                drop(v)
            }
        }
        if self.cap == 0usize && n > 0usize {
            var bytes: usize = 0usize
            match elems_bytes[T](n) {
                Some(b) => bytes = b
                None => trap_kind(oom)
            }
            unsafe {
                self.data = ptr_cast[T, u8](heap_alloc_zeroed(bytes, align_of[T]()))
                self.cap = n
                ptr_store(self.data, copy(x))
                self.size = 1usize
                b := ptr_cast[u8, T](self.data)
                k := 0usize
                while k < size_of[T]() && ptr_load(ptr_offset(b, truncate[isize](k))) == 0u8 { k = wrapping_add(k, 1usize) }
                if k == size_of[T]() { self.size = n }
            }
        }
        self.reserve(n)
        unsafe {
            d := self.data
            i := self.size
            while i < n {
                ptr_store(ptr_offset(d, truncate[isize](i)), copy(x))
                i = wrapping_add(i, 1usize)
            }
            self.size = n
        }
    }
    contract { requires "data addresses cap elements of which the first size are live" }
    func get(view self, i: usize) -> view[T] {
        if i >= self.size { trap_kind(bounds) }
        unsafe { return ptr_view(ptr_offset(self.data, truncate[isize](i))) }
    }
    contract { requires "data addresses cap elements of which the first size are live" }
    func at(edit self, i: usize) -> edit[T] {
        if i >= self.size { trap_kind(bounds) }
        unsafe { return ptr_edit(ptr_offset(self.data, truncate[isize](i))) }
    }
    contract { requires "data addresses cap elements of which the first size are live" }
    func as_view(view self) -> view[]T {
        unsafe { return ptr_view_seq(self.data, self.size) }
    }
    contract { requires "data addresses cap elements of which the first size are live" }
    func as_edit(edit self) -> edit[]T {
        unsafe { return ptr_edit_seq(self.data, self.size) }
    }
    // clear destroys the elements from the last to the first; the capacity stays.
    contract { requires "data addresses cap elements of which the first size are live" }
    func clear(edit self) {
        while self.size > 0usize {
            self.size = self.size - 1usize
            unsafe {
                v := ptr_take(ptr_offset(self.data, truncate[isize](self.size)))
                drop(v)
            }
        }
    }
    // clone deep-copies every element (the clone behind copy(v)).
    func clone(view self) -> Vec[T] {
        res := Vec[T].with_capacity(self.size)
        for i in 0usize..self.size { res.push(copy(self.get(i))) }
        return res
    }
    contract { requires "data addresses cap elements of which the first size are live" }
    func release(edit self) {
        self.clear()
        unsafe {
            if self.cap > 0usize {
                match elems_bytes[T](self.cap) {
                    Some(b) => heap_free(ptr_cast[u8, T](self.data), b, align_of[T]())
                    None => trap_kind(unreachable)
                }
                self.data = zero()
                self.cap = 0usize
            }
        }
    }
    destructor(edit self) { self.release() }
}

// PoolSlotMeta is the bookkeeping of one Pool slot: its generation, whether
// it holds a live element, and whether it was retired at generation wrap.
struct PoolSlotMeta { gen: u32; live: bool; retired: bool }
// A handle carries its container's identity tag in debug builds only
// (spec §5.6): a release build has no tags, so its handles are narrower.
// The //@debug and //@release lines are the two variants (resolve.Prelude).
struct PoolId[T] { index: u32; gen: u32; phantom_tag: u32 } //@debug
struct PoolId[T] { index: u32; gen: u32 } //@release
// Pool keeps count slots (cap allocated) in one buffer: a slot is the
// slot's PoolSlotMeta followed by its element, so a handle's check and its
// element share a cache line (a B-tree descent touches one line per level,
// not two). It also keeps a stack of nfree vacant slot indices in
// free_list, the number of live elements, and its identity tag.
struct Pool[T] nocopy { data: RawPtr[u8]; free_list: RawPtr[u32]; count: usize; cap: usize; nfree: usize; live: usize; identity: u32 }
impl Pool[T] {
    func new() -> Pool[T] {
        return Pool[T] { data: zero(), free_list: zero(), count: 0usize, cap: 0usize, nfree: 0usize, live: 0usize, identity: container_identity() }
    }
    // slot_align, elem_offset and stride lay out one slot: the metadata at
    // offset 0, the element at the first multiple of its alignment past
    // the metadata, the slot rounded up to the larger of the two
    // alignments.
    func slot_align(view self) -> usize {
        a := align_of[T]()
        if a < align_of[PoolSlotMeta]() { return align_of[PoolSlotMeta]() }
        return a
    }
    func elem_offset(view self) -> usize {
        a := align_of[T]()
        return (size_of[PoolSlotMeta]() + a - 1usize) / a * a
    }
    func stride(view self) -> usize {
        a := self.slot_align()
        return (self.elem_offset() + size_of[T]() + a - 1usize) / a * a
    }
    // buffer_bytes is n slots' bytes, or None when unrepresentable.
    func buffer_bytes(view self, n: usize) -> Option[usize] {
        st := self.stride()
        if n > 18446744073709551615usize / st { return None }
        return Some(n * st)
    }
    // meta_at and elem_at address slot i's metadata and element.
    contract { requires "i < cap" }
    func meta_at(view self, i: usize) -> RawPtr[PoolSlotMeta] {
        unsafe { return ptr_cast[PoolSlotMeta, u8](ptr_offset(self.data, truncate[isize](i * self.stride()))) }
    }
    contract { requires "i < cap" }
    func elem_at(view self, i: usize) -> RawPtr[T] {
        unsafe { return ptr_cast[T, u8](ptr_offset(self.data, truncate[isize](i * self.stride() + self.elem_offset()))) }
    }
    // grow doubles the two buffers transactionally: nothing changes
    // unless both new buffers were obtained. The free list is allocated
    // first and the slot buffer is then resized in place
    // (heap_try_realloc), so a failure leaves the old buffers untouched and
    // a success never holds two copies of the elements: the system
    // allocator extends or remaps a large block instead of allocating a
    // second one, copying and freeing, which kept every outgrown element
    // buffer resident and tripled the peak RSS of the btree workload.
    // Indices must fit a u32.
    contract { requires "the two buffers hold cap entries; the first count slots are initialized" }
    func grow(edit self) -> bool {
        n := 8usize
        if self.cap > 0usize {
            if self.cap > 2147483648usize { return false }
            n = self.cap * 2usize
        }
        var bytes: usize = 0usize
        match self.buffer_bytes(n) {
            Some(b) => bytes = b
            None => return false
        }
        unsafe {
            nf := heap_try_alloc(n * 4usize, 4usize)
            var nd: RawPtr[u8] = zero()
            if ptr_addr(nf) != 0usize {
                if self.cap > 0usize {
                    var old: usize = 0usize
                    match self.buffer_bytes(self.cap) {
                        Some(b) => old = b
                        None => trap_kind(unreachable)
                    }
                    nd = heap_try_realloc(self.data, old, bytes, self.slot_align())
                } else {
                    nd = heap_try_alloc(bytes, self.slot_align())
                }
            }
            if ptr_addr(nd) == 0usize {
                if ptr_addr(nf) != 0usize { heap_free(nf, n * 4usize, 4usize) }
                return false
            }
            ptr_copy(ptr_cast[u32, u8](nf), self.free_list, self.nfree)
            if self.cap > 0usize {
                heap_free(ptr_cast[u8, u32](self.free_list), self.cap * 4usize, 4usize)
            }
            self.data = nd
            self.free_list = ptr_cast[u32, u8](nf)
            self.cap = n
        }
        return true
    }
    contract { requires "the two buffers hold cap entries; the first count slots are initialized" }
    func alloc(edit self, v: own T) -> Result[PoolId[T], AllocErr] {
        var idx: usize = 0usize
        var gen: u32 = 0u32
        unsafe {
            if self.nfree > 0usize {
                self.nfree = self.nfree - 1usize
                idx = usize(ptr_load(ptr_offset(self.free_list, truncate[isize](self.nfree))))
                mp := self.meta_at(idx)
                m := ptr_load(mp)
                m.live = true
                gen = m.gen
                ptr_store(mp, m)
            } else {
                if self.count == self.cap {
                    if !self.grow() { drop(v); return Err(OutOfMemory) }
                }
                idx = self.count
                self.count = self.count + 1usize
                ptr_store(self.meta_at(idx), PoolSlotMeta { gen: 0u32, live: true, retired: false })
            }
            ptr_store(self.elem_at(idx), v)
        }
        self.live = self.live + 1usize
        return Ok(PoolId[T] { index: truncate[u32](idx), gen: gen, phantom_tag: self.identity }) //@debug
        return Ok(PoolId[T] { index: truncate[u32](idx), gen: gen }) //@release
    }
    // check validates a handle in the §5.6 order (bounds, identity, vacant,
    // generation) and returns its slot index.
    contract { requires "the two buffers hold cap entries; the first count slots are initialized" }
    func check(view self, id: PoolId[T]) -> usize {
        idx := usize(id.index)
        if idx >= self.count { trap_kind(bounds) }
        if id.phantom_tag != 0u32 && self.identity != 0u32 && id.phantom_tag != self.identity { trap_kind(identity) } //@debug
        unsafe {
            m := ptr_load(self.meta_at(idx))
            if !m.live { trap_kind(vacant) }
            if m.gen != id.gen { trap_kind(generation) }
        }
        return idx
    }
    contract { requires "data addresses cap slots; slot idx holds a live element after check" }
    func get(view self, id: PoolId[T]) -> view[T] {
        idx := self.check(id)
        unsafe { return ptr_view(self.elem_at(idx)) }
    }
    contract { requires "data addresses cap slots; slot idx holds a live element after check" }
    func at(edit self, id: PoolId[T]) -> edit[T] {
        idx := self.check(id)
        unsafe { return ptr_edit(self.elem_at(idx)) }
    }
    contract { invariant "a != b is checked at runtime; the two accesses are disjoint" }
    func get2(edit self, a: PoolId[T], b: PoolId[T]) -> (edit[T], edit[T]) {
        ia := self.check(a)
        ib := self.check(b)
        if ia == ib { trap_kind(disjoint) }
        unsafe { return ptr_edit2(self.elem_at(ia), self.elem_at(ib)) }
    }
    // free validates the handle, destroys the element and bumps the slot's
    // generation; a slot whose generation would wrap is retired.
    contract { requires "data addresses cap slots; slot idx holds a live element after check" }
    func free(edit self, id: PoolId[T]) {
        idx := self.check(id)
        unsafe {
            sp := self.meta_at(idx)
            m := ptr_load(sp)
            m.live = false
            ptr_store(sp, m)
            v := ptr_take(self.elem_at(idx))
            drop(v)
            if m.gen == 4294967295u32 {
                m.retired = true
            } else {
                m.gen = m.gen + 1u32
                ptr_store(ptr_offset(self.free_list, truncate[isize](self.nfree)), id.index)
                self.nfree = self.nfree + 1usize
            }
            ptr_store(sp, m)
        }
        self.live = self.live - 1usize
    }
    func len(view self) -> usize { return self.live }
    // seed_generation (test hook): makes slot exist as a vacant slot with
    // the given generation, keeping every slot below it allocated.
    contract { requires "the two buffers hold cap entries; the first count slots are initialized" }
    func seed_generation(edit self, slot: u32, gen: u32) {
        testing.require_hooks()
        s := usize(slot)
        while self.cap <= s { if !self.grow() { trap_kind(oom) } }
        unsafe {
            i := self.count
            while i <= s {
                ptr_store(self.meta_at(i), PoolSlotMeta { gen: 0u32, live: false, retired: false })
                ptr_store(ptr_offset(self.free_list, truncate[isize](self.nfree)), truncate[u32](i))
                self.nfree = self.nfree + 1usize
                i = i + 1usize
            }
            if self.count <= s { self.count = s + 1usize }
            sp := self.meta_at(s)
            m := ptr_load(sp)
            m.gen = gen
            ptr_store(sp, m)
        }
    }
    contract { requires "the two buffers hold cap entries; the first count slots are initialized" }
    func release(edit self) {
        unsafe {
            i := self.count
            while i > 0usize {
                i = i - 1usize
                m := ptr_load(self.meta_at(i))
                if m.live {
                    v := ptr_take(self.elem_at(i))
                    drop(v)
                }
            }
            if self.cap > 0usize {
                match self.buffer_bytes(self.cap) {
                    Some(b) => heap_free(self.data, b, self.slot_align())
                    None => trap_kind(unreachable)
                }
                heap_free(ptr_cast[u8, u32](self.free_list), self.cap * 4usize, 4usize)
                self.data = zero()
                self.free_list = zero()
                self.cap = 0usize
            }
            self.count = 0usize
            self.nfree = 0usize
            self.live = 0usize
            // a released pool is an empty one with a new identity: handles
            // issued before cannot name its slots (debug builds check it)
            self.identity = container_identity()
        }
    }
    destructor(edit self) { self.release() }
}

struct ArenaId[T] { index: u32; phantom_tag: u32 } //@debug
struct ArenaId[T] { index: u32 } //@release
struct Arena[T] nocopy { data: RawPtr[T]; size: usize; cap: usize; identity: u32 }
impl Arena[T] {
    func new() -> Arena[T] {
        return Arena[T] { data: zero(), size: 0usize, cap: 0usize, identity: container_identity() }
    }
    contract { requires "data addresses cap elements of which the first size are live" }
    func grow(edit self) -> bool {
        n := 8usize
        if self.cap > 0usize {
            if self.cap > 2147483648usize { return false }
            n = self.cap * 2usize
        }
        var bytes: usize = 0usize
        match elems_bytes[T](n) {
            Some(b) => bytes = b
            None => return false
        }
        unsafe {
            var nd: RawPtr[u8] = zero()
            if self.cap > 0usize {
                var old: usize = 0usize
                match elems_bytes[T](self.cap) {
                    Some(b) => old = b
                    None => return false
                }
                nd = heap_try_realloc(ptr_cast[u8, T](self.data), old, bytes, align_of[T]())
            } else {
                nd = heap_try_alloc(bytes, align_of[T]())
            }
            if ptr_addr(nd) == 0usize { return false }
            self.data = ptr_cast[T, u8](nd)
            self.cap = n
        }
        return true
    }
    contract { requires "data addresses cap elements of which the first size are live" }
    func alloc(edit self, v: own T) -> Result[ArenaId[T], AllocErr] {
        if self.size == self.cap {
            if !self.grow() { drop(v); return Err(OutOfMemory) }
        }
        unsafe { ptr_store(ptr_offset(self.data, truncate[isize](self.size)), v) }
        id := ArenaId[T] { index: truncate[u32](self.size), phantom_tag: self.identity } //@debug
        id := ArenaId[T] { index: truncate[u32](self.size) } //@release
        self.size = self.size + 1usize
        return Ok(id)
    }
    // check validates a handle (bounds, then identity) and returns its index.
    func check(view self, id: ArenaId[T]) -> usize {
        idx := usize(id.index)
        if idx >= self.size { trap_kind(bounds) }
        if id.phantom_tag != 0u32 && self.identity != 0u32 && id.phantom_tag != self.identity { trap_kind(identity) } //@debug
        return idx
    }
    contract { requires "data addresses cap elements of which the first size are live" }
    func get(view self, id: ArenaId[T]) -> view[T] {
        idx := self.check(id)
        unsafe { return ptr_view(ptr_offset(self.data, truncate[isize](idx))) }
    }
    contract { requires "data addresses cap elements of which the first size are live" }
    func at(edit self, id: ArenaId[T]) -> edit[T] {
        idx := self.check(id)
        unsafe { return ptr_edit(ptr_offset(self.data, truncate[isize](idx))) }
    }
    func len(view self) -> usize { return self.size }
    contract { requires "data addresses cap elements of which the first size are live" }
    func release(edit self) {
        unsafe {
            while self.size > 0usize {
                self.size = self.size - 1usize
                v := ptr_take(ptr_offset(self.data, truncate[isize](self.size)))
                drop(v)
            }
            if self.cap > 0usize {
                match elems_bytes[T](self.cap) {
                    Some(b) => heap_free(ptr_cast[u8, T](self.data), b, align_of[T]())
                    None => trap_kind(unreachable)
                }
                self.data = zero()
                self.cap = 0usize
            }
            self.identity = container_identity()
        }
    }
    destructor(edit self) { self.release() }
}

struct Shared[T] nocopy { inner: T }
impl Shared[T] {
    func new(v: own T) -> Shared[T]
    func get(view self) -> view[T]
    func clone(view self) -> Shared[T]
    destructor(edit self) { }
}
unsafe assert Interior for Shared

struct Mutex[T] nocopy { inner: T }
impl Mutex[T] {
    func new(v: own T) -> Mutex[T]
    contract { invariant "the lock guarantees exclusivity of the returned edit while it is live" }
    func lock(view self) -> edit[T] release unlock
    func unlock(view self)
    destructor(edit self) { }
}
unsafe assert Interior for Mutex

// Condvar is a condition variable (spec §5.5). wait takes the edit bound by
// a Mutex lock: it releases that lock, blocks until a notify (spurious
// wakeups are permitted, so callers re-test their condition in a loop),
// reacquires the lock and returns with the binding still live. Every wait on
// one Condvar must use the same Mutex; a wait with a different Mutex traps
// with kind explicit, as does a wait whose guard is not held by the calling
// thread.
struct Condvar nocopy { phantom: u8 }
impl Condvar {
    func new() -> Condvar
    func wait[T](view self, g: edit[T])
    func notify_one(view self)
    func notify_all(view self)
    destructor(edit self) { }
}
unsafe assert Interior for Condvar

struct Atomic[T] { inner: T }
impl Atomic[T] {
    func new(v: T) -> Atomic[T]
    func load(view self, ord: Ordering) -> T
    func store(view self, v: T, ord: Ordering)
    func swap(view self, v: T, ord: Ordering) -> T
    func compare_exchange(view self, expected: T, desired: T, success: Ordering, failure: Ordering) -> Result[T, T]
    func compare_exchange_weak(view self, expected: T, desired: T, success: Ordering, failure: Ordering) -> Result[T, T]
    func fetch_add(view self, v: T, ord: Ordering) -> T
    func fetch_sub(view self, v: T, ord: Ordering) -> T
    func fetch_and(view self, v: T, ord: Ordering) -> T
    func fetch_or(view self, v: T, ord: Ordering) -> T
    func fetch_xor(view self, v: T, ord: Ordering) -> T
}
unsafe assert Interior for Atomic
union Ordering { relaxed; acquire; release; acq_rel; seq_cst }
func fence(ord: Ordering)

struct Thread[R] nocopy { phantom: R }
impl Thread[R] {
    func join(own self) -> R
    destructor(edit self) { }
}
struct Join[R] nocopy { phantom: R }
impl Join[R] {
    func get(own self) -> R
    destructor(edit self) { }
}
struct Scope nocopy { phantom: u8 }
impl Scope {
    // spawn is an intrinsic: spawn(f, args...) with the §5.5 rules; typed by the checker.
    destructor(edit self) { }
}
struct thread { phantom: u8 }
impl thread {
    func scope() -> Scope
    // thread.spawn(f, own args...) -> Result[Thread[R], SpawnErr] is an intrinsic typed by the checker.
}

union TrapKind { bounds; overflow; div_zero; shift; conversion; generation; vacant; identity; disjoint; oom; stack; explicit; unreachable }
struct TrapInfo { kind: TrapKind; file: RawPtr[u8]; start: usize; end: usize; thread_id: u64 }
struct trap { phantom: u8 }
impl trap {
    func set_handler(f: func(view[TrapInfo])) -> func(view[TrapInfo])
}
