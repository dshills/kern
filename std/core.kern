// kern standard-library prelude. Functions without bodies are intrinsics
// implemented by the compiler, the interpreter and the hosted runtime; the
// library containers (Box, Vec, Pool, Arena) are kern code over the
// raw-pointer core and are compiled with every program.
module core

// zero() yields the all-zero value of any Copy type (the only way to
// initialize an array without naming every element).
func zero[T: Copy]() -> T
// wrapping_add, wrapping_sub and wrapping_mul are the §4.1 wrapping forms:
// two's-complement arithmetic modulo 2^width on any integer type.
func wrapping_add[T: Copy](a: T, b: T) -> T
func wrapping_sub[T: Copy](a: T, b: T) -> T
func wrapping_mul[T: Copy](a: T, b: T) -> T
// count_trailing_zeros, count_leading_zeros and count_ones are the bit-count
// operations on integers; the count of a zero operand's trailing or leading
// zeros is the operand width. They never trap.
func count_trailing_zeros[T: Copy](x: T) -> u32
func count_leading_zeros[T: Copy](x: T) -> u32
func count_ones[T: Copy](x: T) -> u32
// load_be and load_le read an integer T from the bytes of a view at offset
// at, big- or little-endian, one bounds check (at + size_of[T] - 1 < len)
// the proof pass can discharge and one wide load natively; T is explicit.
func load_be[T: Copy](p: view[]u8, at: usize) -> T
func load_le[T: Copy](p: view[]u8, at: usize) -> T
// store_be and store_le write an integer T into the bytes of an edit at
// offset at, big- or little-endian: the same one bounds check on the last
// byte, and one wide store natively.
func store_be[T: Copy](p: edit[]u8, at: usize, v: T)
func store_le[T: Copy](p: edit[]u8, at: usize, v: T)
// Raw pointers (spec §6): every operation below is an unsafe operation and
// requires an unsafe block; the pointee's representation is the §4.1 layout.
func ptr_null[T]() -> RawPtr[T]
func ptr_from_addr[T](addr: usize) -> RawPtr[T]
func ptr_addr[T](p: RawPtr[T]) -> usize
func ptr_cast[U, T](p: RawPtr[T]) -> RawPtr[U]
func ptr_offset[T](p: RawPtr[T], n: isize) -> RawPtr[T]
func ptr_load[T: Copy](p: RawPtr[T]) -> T
func ptr_store[T](p: RawPtr[T], v: own T)
func ptr_take[T](p: RawPtr[T]) -> T
func ptr_load_volatile[T: Copy](p: RawPtr[T]) -> T
func ptr_store_volatile[T: Copy](p: RawPtr[T], v: T)
func ptr_copy[T](dst: RawPtr[T], src: RawPtr[T], n: usize)
// ptr_view, ptr_edit and their sequence forms open an access on raw memory:
// the pointee (or the n elements from p) must be a live, initialized value
// for the access's whole lifetime. A function that returns such an access
// must contain unsafe and carry a contract stating that obligation (rule
// 6.4); the containers below are the library's uses. ptr_edit2 opens two
// edits at once (the caller has checked that a and b are disjoint), and
// ptr_view2 and ptr_view_edit two accesses of possibly different types
// (std/map's cursor_entry: a key and a value in distinct vectors).
func ptr_view[T](p: RawPtr[T]) -> view[T]
func ptr_edit[T](p: RawPtr[T]) -> edit[T]
func ptr_view_seq[T](p: RawPtr[T], n: usize) -> view[]T
func ptr_edit_seq[T](p: RawPtr[T], n: usize) -> edit[]T
func ptr_edit2[T](a: RawPtr[T], b: RawPtr[T]) -> (edit[T], edit[T])
func ptr_view2[A, B](a: RawPtr[A], b: RawPtr[B]) -> (view[A], view[B])
func ptr_view_edit[A, B](a: RawPtr[A], b: RawPtr[B]) -> (view[A], edit[B])
// ptr_init calls init with the raw storage at p as its out parameter
// (spec §5.2: out storage may be "a fresh slot provided by a container"),
// and returns its result: on Ok the storage holds an initialized T; on
// Err init's failure rule has destroyed what it had initialized, and the
// storage is uninitialized again. p must address storage for one T that
// holds no live value (specs/in-place-init/SPEC.md).
func ptr_init[T, E](p: RawPtr[T], init: func(out T) -> Result[(), E]) -> Result[(), E]
// ptr_init_ctx is ptr_init with a context: init is called with the raw
// storage at p as its out parameter and ctx, the caller's view access,
// unchanged, as its second argument; everything else is ptr_init's
// (specs/init-context/SPEC.md R1).
func ptr_init_ctx[T, C, E](p: RawPtr[T], init: func(out T, view[C]) -> Result[(), E], ctx: view[C]) -> Result[(), E]
// ptr_store_seq writes the len(src) elements of a sequence view into raw
// memory at p, each in its §4.1 layout (so the elements are duplicated
// bitwise); the destination must not overlap the source. Vec.extend's block
// copy: natively one memcpy, in the interpreter an element-wise encode (a
// view of an array local has no raw address there).
func ptr_store_seq[T](p: RawPtr[T], src: view[]T)
// swap_at exchanges the elements i and j of a sequence, whatever their
// type (a move-only element cannot be copied out and back); it traps
// bounds when either index is not below len(xs).
func swap_at[T](xs: edit[]T, i: usize, j: usize)
// size_of and align_of are the §4.1 size and alignment of T in bytes.
func size_of[T]() -> usize
func align_of[T]() -> usize
// trap_kind terminates with the given trap kind, written as a literal
// variant (trap_kind(bounds)); the span reported is the call that entered
// the library, as for every trap raised inside std/core.
func trap_kind(kind: TrapKind)
// expect returns when cond is true and otherwise traps explicit, the
// assertion of `kern test` (assert is a keyword); as for every trap raised
// in std/core, the record names the expect call's file and span
// (specs/test-command/SPEC.md R5).
func expect(cond: bool) {
    if !cond { trap_kind(explicit) }
}
// expect_msg is expect with a message: when cond is false it writes the
// line {"expect":{"message":"..."}} to standard error, the message
// escaped as a JSON string, and traps explicit as expect does; kern test
// reports the message with the run (specs/test-runs/SPEC.md R1). Only the
// first 4096 bytes are written: escaped, they stay within the 64 KiB of
// standard error kern test keeps.
func expect_msg(cond: bool, msg: view[]u8) {
    if cond { return }
    eprint_str("{\"expect\":{\"message\":\"")
    var d: [2]u8 = [0u8, 0u8]
    var n: usize = len(msg)
    if n > 4096usize { n = 4096usize }
    var from: usize = 0usize
    var i: usize = 0usize
    while i < n {
        b := msg[i]
        if b == 34u8 || b == 92u8 || b < 32u8 {
            eprint_str(msg[from:i])
            if b == 34u8 {
                eprint_str("\\\"")
            } else if b == 92u8 {
                eprint_str("\\\\")
            } else {
                eprint_str("\\u00")
                d[0usize] = 48u8 + (b >> 4u32) // b < 32: the high digit is 0 or 1
                d[1usize] = b & 15u8
                if d[1usize] < 10u8 { d[1usize] = d[1usize] + 48u8 } else { d[1usize] = d[1usize] + 87u8 }
                eprint_str(d[0usize:2usize])
            }
            from = i + 1usize
        }
        i = i + 1usize
    }
    eprint_str(msg[from:n])
    eprint_str("\"}}\n")
    trap_kind(explicit)
}
// container_identity issues the next 32-bit identity tag (spec §5.6): a
// process-global counter starting at 1 in debug builds, 0 in release builds.
func container_identity() -> u32
// SIMD (PLAN.md 3.2): T is a fixed-width vector [N]E with N in 2, 4, 8, 16
// and E a number; lanes wrap on overflow. simd_shuffle selects lanes from
// the concatenation of a and b by index (traps bounds when out of range);
// simd_reduce_add sums the lanes (wrapping) and is typed by the checker.
func simd_add[T: Copy](a: T, b: T) -> T
func simd_sub[T: Copy](a: T, b: T) -> T
func simd_mul[T: Copy](a: T, b: T) -> T
func simd_and[T: Copy](a: T, b: T) -> T
func simd_or[T: Copy](a: T, b: T) -> T
func simd_xor[T: Copy](a: T, b: T) -> T
func simd_shuffle[T: Copy, I: Copy](a: T, b: T, idx: I) -> T
// asm executes an inline assembly template (unsafe; no operands, clobbers
// memory); the interpreter traps with kind explicit.
func asm(template: view[]u8)
// yield_now lets another thread run (a scheduling hint; hosted only, a
// no-op in the freestanding mode and the interpreter's scheduler).
func yield_now()
// exit terminates the program with a status (hosted) or halts (freestanding).
func exit(code: i32)

// Hosted output for the Phase 1 interpreter and fixtures.
func print_u64(v: u64)
func print_i64(v: i64)
func print_bool(v: bool)
func print_str(s: view[]u8)
func println()
// eprint_str writes bytes to standard error at once, unbuffered (hosted;
// the console in the freestanding mode).
func eprint_str(s: view[]u8)
// now_ns is a monotonic clock in nanoseconds (hosted and freestanding).
func now_ns() -> u64

// Test hooks (PLAN.md 2.3): available only under --test-hooks.
struct testing { phantom: u8 }
impl testing {
    // require_hooks traps (interpreter) or fails to link (native) unless the
    // program was built with --test-hooks.
    func require_hooks()
    func seed_generation[T](p: edit[Pool[T]], slot: u32, gen: u32) {
        p.seed_generation(slot, gen) // gated by require_hooks inside
    }
    func seed_shared_count[T](s: view[Shared[T]], count: u64)
    // the next allocation by a convenience constructor fails (oom trap)
    func fail_next_alloc()
    // the next thread.spawn or Scope.spawn fails with ResourceExhausted
    // before any thread exists, so that its own arguments are destroyed
    func fail_next_spawn()
    // the system's source of random bytes serves after more requests of
    // at most 256 bytes and fails the one that follows, once (std/rand)
    func fail_random(after: u32)
}

union Option[T] { Some(T); None }
union Result[T, E] { Ok(T); Err(E) }
// The remaining §4.1 alternative forms. wrapping_neg, wrapping_shl and
// wrapping_shr complete the wrapping forms: two's-complement negation, and
// shifts whose count is masked to width - 1; none traps. The saturating
// forms clamp to the type's range. The checked forms yield None exactly
// where the trapping form would trap (overflow, division by zero, the
// minimum signed value divided by -1, a shift count of the width or more,
// a set bit shifted out) and Some(result) otherwise.
func wrapping_neg[T: Copy](a: T) -> T
func wrapping_shl[T: Copy](a: T, n: u32) -> T
func wrapping_shr[T: Copy](a: T, n: u32) -> T
func saturating_add[T: Copy](a: T, b: T) -> T
func saturating_sub[T: Copy](a: T, b: T) -> T
func saturating_mul[T: Copy](a: T, b: T) -> T
func checked_add[T: Copy](a: T, b: T) -> Option[T]
func checked_sub[T: Copy](a: T, b: T) -> Option[T]
func checked_mul[T: Copy](a: T, b: T) -> Option[T]
func checked_div[T: Copy](a: T, b: T) -> Option[T]
func checked_rem[T: Copy](a: T, b: T) -> Option[T]
func checked_shl[T: Copy](a: T, n: u32) -> Option[T]
func checked_shr[T: Copy](a: T, n: u32) -> Option[T]
union AllocErr { OutOfMemory }
union AllocOrInit[E] { Alloc(AllocErr); Init(E) }
union SpawnErr { ResourceExhausted }

interface Allocator {
    func alloc(edit self, size: usize, align: usize) -> Result[RawPtr[u8], AllocErr]
    func free(edit self, ptr: RawPtr[u8], size: usize, align: usize)
}

struct SystemAllocator nocopy { phantom: u8 }
impl Allocator for SystemAllocator {
    func alloc(edit self, size: usize, align: usize) -> Result[RawPtr[u8], AllocErr]
    func free(edit self, ptr: RawPtr[u8], size: usize, align: usize)
}
impl SystemAllocator {
    func new() -> SystemAllocator
    // realloc resizes an allocation of alloc or realloc to new_size bytes
    // at the same alignment, keeping the first min(old_size, new_size)
    // bytes (in place when the allocator can); on failure the old
    // allocation is untouched. An unsafe operation with alloc's obligations.
    func realloc(edit self, ptr: RawPtr[u8], old_size: usize, new_size: usize, align: usize) -> Result[RawPtr[u8], AllocErr]
    // alloc_zeroed is alloc whose bytes are all zero (calloc: a large
    // block comes from fresh zero pages that are not touched until used).
    // An unsafe operation with alloc's obligations; freed by free.
    func alloc_zeroed(edit self, size: usize, align: usize) -> Result[RawPtr[u8], AllocErr]
}

// ---- Library containers (spec §5.6), written in kern over the raw-pointer
// core. Every raw operation sits in a small contracted method; the rest is
// ordinary kern that the backend inlines. Fields of a nocopy core struct are
// private to this module (the unsafe invariants below depend on them). The
// helper methods (reserve, grow, check, release) are visible like every core
// declaration and keep the container valid: release leaves an empty
// container (with a fresh identity where handles exist).
// The storage of every container comes from the system allocator.

// heap_alloc allocates size bytes at align from the system allocator and
// traps oom on failure: the convenience constructors' allocation.
contract { requires "align is a power of two at most 4096 and size is a multiple of it" }
func heap_alloc(size: usize, align: usize) -> RawPtr[u8] {
    p := heap_try_alloc(size, align)
    unsafe { if ptr_addr(p) == 0usize { trap_kind(oom) } }
    return p
}
// heap_try_alloc is heap_alloc that yields a null pointer on failure.
contract { requires "align is a power of two at most 4096 and size is a multiple of it" }
func heap_try_alloc(size: usize, align: usize) -> RawPtr[u8] {
    a := SystemAllocator.new()
    unsafe {
        match a.alloc(size, align) {
            Ok(p) => return p
            Err(e) => return ptr_null[u8]()
        }
    }
}
// heap_alloc_zeroed is heap_alloc whose bytes are all zero.
contract { requires "align is a power of two at most 4096 and size is a multiple of it" }
func heap_alloc_zeroed(size: usize, align: usize) -> RawPtr[u8] {
    a := SystemAllocator.new()
    var p: RawPtr[u8] = zero()
    unsafe {
        match a.alloc_zeroed(size, align) {
            Ok(q) => p = q
            Err(e) => trap_kind(oom)
        }
    }
    return p
}
// heap_try_alloc_zeroed is heap_alloc_zeroed that yields a null pointer on
// failure.
contract { requires "align is a power of two at most 4096 and size is a multiple of it" }
func heap_try_alloc_zeroed(size: usize, align: usize) -> RawPtr[u8] {
    a := SystemAllocator.new()
    unsafe {
        match a.alloc_zeroed(size, align) {
            Ok(p) => return p
            Err(e) => return ptr_null[u8]()
        }
    }
}
// heap_realloc resizes an allocation, trapping oom on failure.
contract { requires "p, old_size and align are those of one live allocation; new_size is a multiple of align" }
func heap_realloc(p: RawPtr[u8], old_size: usize, new_size: usize, align: usize) -> RawPtr[u8] {
    q := heap_try_realloc(p, old_size, new_size, align)
    unsafe { if ptr_addr(q) == 0usize { trap_kind(oom) } }
    return q
}
// heap_try_realloc is heap_realloc that yields null on failure (the old
// allocation stays valid).
contract { requires "p, old_size and align are those of one live allocation; new_size is a multiple of align" }
func heap_try_realloc(p: RawPtr[u8], old_size: usize, new_size: usize, align: usize) -> RawPtr[u8] {
    a := SystemAllocator.new()
    unsafe {
        match a.realloc(p, old_size, new_size, align) {
            Ok(q) => return q
            Err(e) => return ptr_null[u8]()
        }
    }
}
// heap_free releases an allocation of heap_alloc or heap_try_alloc.
contract { requires "p, size and align are those of one live allocation" }
func heap_free(p: RawPtr[u8], size: usize, align: usize) {
    a := SystemAllocator.new()
    unsafe { a.free(p, size, align) }
}
// elems_bytes is n * size_of[T], or None when the product is unrepresentable.
func elems_bytes[T](n: usize) -> Option[usize] {
    esize := size_of[T]()
    if esize == 0usize { return Some(0usize) }
    if n > 18446744073709551615usize / esize { return None }
    return Some(n * esize)
}

struct Box[T] nocopy { p: RawPtr[T] }
impl Box[T] {
    contract { requires "the allocation holds one T until into or the destructor takes it" }
    func new(v: own T) -> Box[T] {
        unsafe {
            p := ptr_cast[T, u8](heap_alloc(size_of[T](), align_of[T]()))
            ptr_store(p, v)
            return Box[T] { p: p }
        }
    }
    // new_with constructs the boxed value in place (spec §5.2): init
    // initializes the allocation through out, so no T is built elsewhere
    // and copied. On Err(e) init has already destroyed what it had
    // initialized (the out failure rule); the allocation is freed and
    // Err(e) returned. A failed allocation traps oom, as in new.
    contract { requires "init initializes the whole T through out on Ok and leaves the storage uninitialized on Err" }
    func new_with[E](init: func(out T) -> Result[(), E]) -> Result[Box[T], E] {
        unsafe {
            p := ptr_cast[T, u8](heap_alloc(size_of[T](), align_of[T]()))
            match ptr_init(p, init) {
                Ok(u) => return Ok(Box[T] { p: p })
                Err(e) => {
                    heap_free(ptr_cast[u8, T](p), size_of[T](), align_of[T]())
                    return Err(e)
                }
            }
        }
    }
    // new_with_ctx is new_with with a context: init is called with the
    // storage as its out parameter and ctx, unchanged, as its second
    // argument (specs/init-context/SPEC.md R2).
    contract { requires "init initializes the whole T through out on Ok and leaves the storage uninitialized on Err" }
    func new_with_ctx[C, E](init: func(out T, view[C]) -> Result[(), E], ctx: view[C]) -> Result[Box[T], E] {
        unsafe {
            p := ptr_cast[T, u8](heap_alloc(size_of[T](), align_of[T]()))
            match ptr_init_ctx(p, init, ctx) {
                Ok(u) => return Ok(Box[T] { p: p })
                Err(e) => {
                    heap_free(ptr_cast[u8, T](p), size_of[T](), align_of[T]())
                    return Err(e)
                }
            }
        }
    }
    // try_new, try_new_with and try_new_with_ctx are new, new_with and
    // new_with_ctx returning Err where they trap oom
    // (specs/fallible-alloc/SPEC.md §2): on a failed allocation try_new
    // destroys v and the _with forms return Alloc(OutOfMemory) before
    // init is called; an initializer's own failure is Init(e), after which
    // the allocation is freed, as in new_with.
    contract { requires "the allocation holds one T until into or the destructor takes it" }
    func try_new(v: own T) -> Result[Box[T], AllocErr] {
        unsafe {
            q := heap_try_alloc(size_of[T](), align_of[T]())
            if ptr_addr(q) == 0usize { drop(v); return Err(OutOfMemory) }
            p := ptr_cast[T, u8](q)
            ptr_store(p, v)
            return Ok(Box[T] { p: p })
        }
    }
    contract { requires "init initializes the whole T through out on Ok and leaves the storage uninitialized on Err" }
    func try_new_with[E](init: func(out T) -> Result[(), E]) -> Result[Box[T], AllocOrInit[E]] {
        unsafe {
            q := heap_try_alloc(size_of[T](), align_of[T]())
            if ptr_addr(q) == 0usize { return Err(Alloc(OutOfMemory)) }
            p := ptr_cast[T, u8](q)
            match ptr_init(p, init) {
                Ok(u) => return Ok(Box[T] { p: p })
                Err(e) => {
                    heap_free(q, size_of[T](), align_of[T]())
                    return Err(Init(e))
                }
            }
        }
    }
    contract { requires "init initializes the whole T through out on Ok and leaves the storage uninitialized on Err" }
    func try_new_with_ctx[C, E](init: func(out T, view[C]) -> Result[(), E], ctx: view[C]) -> Result[Box[T], AllocOrInit[E]] {
        unsafe {
            q := heap_try_alloc(size_of[T](), align_of[T]())
            if ptr_addr(q) == 0usize { return Err(Alloc(OutOfMemory)) }
            p := ptr_cast[T, u8](q)
            match ptr_init_ctx(p, init, ctx) {
                Ok(u) => return Ok(Box[T] { p: p })
                Err(e) => {
                    heap_free(q, size_of[T](), align_of[T]())
                    return Err(Init(e))
                }
            }
        }
    }
    // get, at and into trap explicit on a Box emptied by release.
    contract { requires "p is null or addresses the live T owned by this Box" }
    func get(view self) -> view[T] {
        unsafe {
            if ptr_addr(self.p) == 0usize { trap_kind(explicit) }
            return ptr_view(self.p)
        }
    }
    contract { requires "p is null or addresses the live T owned by this Box" }
    func at(edit self) -> edit[T] {
        unsafe {
            if ptr_addr(self.p) == 0usize { trap_kind(explicit) }
            return ptr_edit(self.p)
        }
    }
    contract { requires "p is null or addresses the live T owned by this Box; the Box is consumed" }
    func into(own self) -> T {
        unsafe {
            if ptr_addr(self.p) == 0usize { trap_kind(explicit) }
            v := ptr_take(self.p)
            heap_free(ptr_cast[u8, T](self.p), size_of[T](), align_of[T]())
            self.p = zero()
            return v
        }
    }
    // clone deep-copies the boxed value (the clone behind copy(b)).
    func clone(view self) -> Box[T] {
        return Box[T].new(copy(self.get()))
    }
    contract { requires "p is null (after into) or addresses the live T owned by this Box" }
    func release(edit self) {
        unsafe {
            if ptr_addr(self.p) != 0usize {
                v := ptr_take(self.p)
                drop(v)
                heap_free(ptr_cast[u8, T](self.p), size_of[T](), align_of[T]())
                self.p = zero()
            }
        }
    }
    destructor(edit self) { self.release() }
}

struct Vec[T] nocopy { data: RawPtr[T]; size: usize; cap: usize }
impl Vec[T] {
    func new() -> Vec[T] {
        return Vec[T] { data: zero(), size: 0usize, cap: 0usize }
    }
    func with_capacity(n: usize) -> Vec[T] {
        v := Vec[T].new()
        v.reserve(n)
        return v
    }
    func len(view self) -> usize { return self.size }
    // reserve makes room for at least n elements, trapping oom when the
    // allocator fails or the byte size is unrepresentable.
    contract { requires "data addresses cap elements of which the first size are live" }
    func reserve(edit self, n: usize) {
        if n <= self.cap { return }
        var bytes: usize = 0usize
        match elems_bytes[T](n) {
            Some(b) => bytes = b
            None => trap_kind(oom)
        }
        unsafe {
            if self.cap > 0usize {
                var old: usize = 0usize
                match elems_bytes[T](self.cap) {
                    Some(b) => old = b
                    None => trap_kind(unreachable)
                }
                self.data = ptr_cast[T, u8](heap_realloc(ptr_cast[u8, T](self.data), old, bytes, align_of[T]()))
            } else {
                self.data = ptr_cast[T, u8](heap_alloc(bytes, align_of[T]()))
            }
            self.cap = n
        }
    }
    // grow doubles the capacity (4 elements at first).
    func grow(edit self) {
        if self.cap > 9223372036854775807usize { trap_kind(oom) }
        n := 4usize
        if self.cap > 0usize { n = self.cap * 2usize }
        self.reserve(n)
    }
    // push appends v, growing the buffer when it is full. size < cap after
    // grow and cap never exceeds half the address space, so the increment
    // cannot wrap: the wrapping form keeps the hot path free of a check.
    contract { requires "data addresses cap elements of which the first size are live" }
    func push(edit self, v: own T) {
        if self.size == self.cap { self.grow() }
        unsafe { ptr_store(ptr_offset(self.data, truncate[isize](self.size)), v) }
        self.size = wrapping_add(self.size, 1usize)
    }
    contract { requires "data addresses cap elements of which the first size are live" }
    func pop(edit self) -> Option[T] {
        if self.size == 0usize { return None }
        self.size = self.size - 1usize
        unsafe { return Some(ptr_take(ptr_offset(self.data, truncate[isize](self.size)))) }
    }
    // grow_to makes room for at least n elements, doubling the capacity
    // when that is more, so a run of small extends stays amortized like a
    // run of pushes.
    func grow_to(edit self, n: usize) {
        if self.cap > 9223372036854775807usize { trap_kind(oom) }
        want := 4usize
        if self.cap > 0usize { want = self.cap * 2usize }
        if want < n { want = n }
        self.reserve(want)
    }
    // extend appends the elements of src, whose type must be Copy (the
    // where clause; CONSTRAINT_UNSATISFIED at a call otherwise): one
    // reservation for size + len(src) (checked, so the sum cannot wrap),
    // one block copy of the elements, then the size update. This is the
    // memcpy / extend_from_slice form of a loop of pushes.
    contract { requires "data addresses cap elements of which the first size are live; src does not overlap the spare capacity" }
    func extend(edit self, src: view[]T) where T: Copy {
        total := self.size + len(src)
        if total > self.cap { self.grow_to(total) }
        unsafe {
            ptr_store_seq(ptr_offset(self.data, truncate[isize](self.size)), src)
            self.size = total
        }
    }
    // resize sets the length to n: elements past n are destroyed, and the
    // new elements are copies of x (x itself is destroyed on return). The
    // fill runs over a local index so the backend can turn it into a block
    // store. A vector with nothing allocated takes zeroed storage first and
    // writes one copy: when that copy's bytes are all zero the rest of the
    // storage already holds it, so the fill is skipped and the pages stay
    // untouched until used (Rust's vec![0; n]). copy(x) runs no user code:
    // it is a load, a core container's clone or the field-wise clone, so it
    // is deterministic, and its one side effect (Shared.clone's count) comes
    // with a non-null pointer. A copy whose bytes are all zero therefore owns
    // nothing and changed nothing (a Vec copy is then the empty vector), and
    // bitwise duplicates of it are exactly what further copies would be.
    contract { requires "data addresses cap elements of which the first size are live; an all-zero copy of x owns nothing" }
    func resize(edit self, n: usize, x: own T) {
        while self.size > n {
            self.size = self.size - 1usize
            unsafe {
                v := ptr_take(ptr_offset(self.data, truncate[isize](self.size)))
                drop(v)
            }
        }
        if self.cap == 0usize && n > 0usize {
            var bytes: usize = 0usize
            match elems_bytes[T](n) {
                Some(b) => bytes = b
                None => trap_kind(oom)
            }
            unsafe {
                self.data = ptr_cast[T, u8](heap_alloc_zeroed(bytes, align_of[T]()))
                self.cap = n
                ptr_store(self.data, copy(x))
                self.size = 1usize
                b := ptr_cast[u8, T](self.data)
                k := 0usize
                while k < size_of[T]() && ptr_load(ptr_offset(b, truncate[isize](k))) == 0u8 { k = wrapping_add(k, 1usize) }
                if k == size_of[T]() { self.size = n }
            }
        }
        self.reserve(n)
        unsafe {
            d := self.data
            i := self.size
            while i < n {
                ptr_store(ptr_offset(d, truncate[isize](i)), copy(x))
                i = wrapping_add(i, 1usize)
            }
            self.size = n
        }
    }
    // ---- The fallible forms (specs/fallible-alloc/SPEC.md §2): each
    // returns Err(OutOfMemory) where its mirrored operation traps oom, and
    // on Err the vector is unchanged. They repeat their mirrors' bodies
    // rather than sharing them, so the existing operations' code stays as
    // it was; tests/run/vec_try.kern compares each pair.

    // capacity is the number of elements the buffer holds without growing.
    func capacity(view self) -> usize { return self.cap }
    func try_with_capacity(n: usize) -> Result[Vec[T], AllocErr] {
        v := Vec[T].new()
        v.try_reserve(n)?
        return Ok(v)
    }
    // try_reserve is reserve: a failed reallocation leaves the old buffer
    // in place (SystemAllocator.realloc), so nothing is written on Err.
    contract { requires "data addresses cap elements of which the first size are live" }
    func try_reserve(edit self, n: usize) -> Result[(), AllocErr] {
        if n <= self.cap { return Ok(()) }
        var bytes: usize = 0usize
        match elems_bytes[T](n) {
            Some(b) => bytes = b
            None => return Err(OutOfMemory)
        }
        unsafe {
            var q: RawPtr[u8] = zero()
            if self.cap > 0usize {
                var old: usize = 0usize
                match elems_bytes[T](self.cap) {
                    Some(b) => old = b
                    None => trap_kind(unreachable)
                }
                q = heap_try_realloc(ptr_cast[u8, T](self.data), old, bytes, align_of[T]())
            } else {
                q = heap_try_alloc(bytes, align_of[T]())
            }
            if ptr_addr(q) == 0usize { return Err(OutOfMemory) }
            self.data = ptr_cast[T, u8](q)
            self.cap = n
        }
        return Ok(())
    }
    // try_grow and try_grow_to are grow and grow_to.
    func try_grow(edit self) -> Result[(), AllocErr] {
        if self.cap > 9223372036854775807usize { return Err(OutOfMemory) }
        n := 4usize
        if self.cap > 0usize { n = self.cap * 2usize }
        return self.try_reserve(n)
    }
    func try_grow_to(edit self, n: usize) -> Result[(), AllocErr] {
        if self.cap > 9223372036854775807usize { return Err(OutOfMemory) }
        want := 4usize
        if self.cap > 0usize { want = self.cap * 2usize }
        if want < n { want = n }
        return self.try_reserve(want)
    }
    // try_push is push; on Err v is destroyed, as Pool.alloc destroys it.
    contract { requires "data addresses cap elements of which the first size are live" }
    func try_push(edit self, v: own T) -> Result[(), AllocErr] {
        if self.size == self.cap {
            match self.try_grow() {
                Ok(u) => { }
                Err(e) => { drop(v); return Err(e) }
            }
        }
        unsafe { ptr_store(ptr_offset(self.data, truncate[isize](self.size)), v) }
        self.size = wrapping_add(self.size, 1usize)
        return Ok(())
    }
    // try_extend is extend; a sum past usize is Err, not an overflow trap.
    contract { requires "data addresses cap elements of which the first size are live; src does not overlap the spare capacity" }
    func try_extend(edit self, src: view[]T) -> Result[(), AllocErr] where T: Copy {
        var total: usize = 0usize
        match checked_add(self.size, len(src)) {
            Some(t) => total = t
            None => return Err(OutOfMemory)
        }
        if total > self.cap { self.try_grow_to(total)? }
        unsafe {
            ptr_store_seq(ptr_offset(self.data, truncate[isize](self.size)), src)
            self.size = total
        }
        return Ok(())
    }
    // try_resize is resize for a Copy element, so the copies of x are
    // loads that run no element code. Shrinking never allocates; when
    // growing, every fallible step runs before the vector is written.
    contract { requires "data addresses cap elements of which the first size are live; an all-zero copy of x owns nothing" }
    func try_resize(edit self, n: usize, x: own T) -> Result[(), AllocErr] where T: Copy {
        while self.size > n {
            self.size = self.size - 1usize
            unsafe {
                v := ptr_take(ptr_offset(self.data, truncate[isize](self.size)))
                drop(v)
            }
        }
        if self.cap == 0usize && n > 0usize {
            var bytes: usize = 0usize
            match elems_bytes[T](n) {
                Some(b) => bytes = b
                None => return Err(OutOfMemory)
            }
            unsafe {
                q := heap_try_alloc_zeroed(bytes, align_of[T]())
                if ptr_addr(q) == 0usize { return Err(OutOfMemory) }
                self.data = ptr_cast[T, u8](q)
                self.cap = n
                ptr_store(self.data, copy(x))
                self.size = 1usize
                b := ptr_cast[u8, T](self.data)
                k := 0usize
                while k < size_of[T]() && ptr_load(ptr_offset(b, truncate[isize](k))) == 0u8 { k = wrapping_add(k, 1usize) }
                if k == size_of[T]() { self.size = n }
            }
        }
        self.try_reserve(n)?
        unsafe {
            d := self.data
            i := self.size
            while i < n {
                ptr_store(ptr_offset(d, truncate[isize](i)), copy(x))
                i = wrapping_add(i, 1usize)
            }
            self.size = n
        }
        return Ok(())
    }
    contract { requires "data addresses cap elements of which the first size are live" }
    func get(view self, i: usize) -> view[T] {
        if i >= self.size { trap_kind(bounds) }
        unsafe { return ptr_view(ptr_offset(self.data, truncate[isize](i))) }
    }
    // ptr_at is the address of element i (bounds-checked); reading or
    // writing through it is unsafe, as for every raw pointer.
    contract { requires "data addresses cap elements of which the first size are live" }
    func ptr_at(view self, i: usize) -> RawPtr[T] {
        if i >= self.size { trap_kind(bounds) }
        unsafe { return ptr_offset(self.data, truncate[isize](i)) }
    }
    contract { requires "data addresses cap elements of which the first size are live" }
    func at(edit self, i: usize) -> edit[T] {
        if i >= self.size { trap_kind(bounds) }
        unsafe { return ptr_edit(ptr_offset(self.data, truncate[isize](i))) }
    }
    contract { requires "data addresses cap elements of which the first size are live" }
    func as_view(view self) -> view[]T {
        unsafe { return ptr_view_seq(self.data, self.size) }
    }
    contract { requires "data addresses cap elements of which the first size are live" }
    func as_edit(edit self) -> edit[]T {
        unsafe { return ptr_edit_seq(self.data, self.size) }
    }
    // clear destroys the elements from the last to the first; the capacity stays.
    contract { requires "data addresses cap elements of which the first size are live" }
    func clear(edit self) {
        while self.size > 0usize {
            self.size = self.size - 1usize
            unsafe {
                v := ptr_take(ptr_offset(self.data, truncate[isize](self.size)))
                drop(v)
            }
        }
    }
    // clone deep-copies every element (the clone behind copy(v)).
    func clone(view self) -> Vec[T] {
        res := Vec[T].with_capacity(self.size)
        for i in 0usize..self.size { res.push(copy(self.get(i))) }
        return res
    }
    contract { requires "data addresses cap elements of which the first size are live" }
    func release(edit self) {
        self.clear()
        unsafe {
            if self.cap > 0usize {
                match elems_bytes[T](self.cap) {
                    Some(b) => heap_free(ptr_cast[u8, T](self.data), b, align_of[T]())
                    None => trap_kind(unreachable)
                }
                self.data = zero()
                self.cap = 0usize
            }
        }
    }
    destructor(edit self) { self.release() }
}

// ---- Containers over a caller's allocator (specs/alloc-containers): each
// holds its allocator inline and owns it, allocates its storage only
// through it, and is fallible throughout (a user allocator running out is
// expected, not a bug). The Allocator interface has no realloc, so a
// vector grows by allocating the new buffer, moving the live elements into
// it and freeing the old one. Their markers are their element's and their
// allocator's (resolve.markerOf).

struct BoxIn[T, A: Allocator] nocopy { p: RawPtr[T]; a: A }
impl[T, A: Allocator] BoxIn[T, A] {
    // try_new_in allocates one T from a; on Err v is destroyed, then a.
    contract { requires "the allocation from a holds one T until release takes it" }
    func try_new_in(v: own T, a: own A) -> Result[BoxIn[T, A], AllocErr] {
        unsafe {
            match a.alloc(size_of[T](), align_of[T]()) {
                Ok(q) => {
                    p := ptr_cast[T, u8](q)
                    ptr_store(p, v)
                    return Ok(BoxIn[T, A] { p: p, a: a })
                }
                Err(e) => {
                    drop(v)
                    drop(a)
                    return Err(e)
                }
            }
        }
    }
    // get and at trap explicit on a BoxIn emptied by release.
    contract { requires "p is null or addresses the live T allocated from a" }
    func get(view self) -> view[T] {
        unsafe {
            if ptr_addr(self.p) == 0usize { trap_kind(explicit) }
            return ptr_view(self.p)
        }
    }
    contract { requires "p is null or addresses the live T allocated from a" }
    func at(edit self) -> edit[T] {
        unsafe {
            if ptr_addr(self.p) == 0usize { trap_kind(explicit) }
            return ptr_edit(self.p)
        }
    }
    func allocator(view self) -> view[A] { return self.a }
    contract { requires "p is null or addresses the live T allocated from a" }
    func release(edit self) {
        unsafe {
            if ptr_addr(self.p) != 0usize {
                v := ptr_take(self.p)
                drop(v)
                self.a.free(ptr_cast[u8, T](self.p), size_of[T](), align_of[T]())
                self.p = zero()
            }
        }
    }
    destructor(edit self) { self.release() }
}

struct VecIn[T, A: Allocator] nocopy { data: RawPtr[T]; size: usize; cap: usize; a: A }
impl[T, A: Allocator] VecIn[T, A] {
    func new_in(a: own A) -> VecIn[T, A] {
        return VecIn[T, A] { data: zero(), size: 0usize, cap: 0usize, a: a }
    }
    func len(view self) -> usize { return self.size }
    func capacity(view self) -> usize { return self.cap }
    func allocator(view self) -> view[A] { return self.a }
    // try_reserve is Vec.try_reserve over a: the new buffer is allocated,
    // the live elements moved into it, and the old buffer freed; nothing is
    // written when the allocation fails.
    contract { requires "data addresses cap elements allocated from a, of which the first size are live" }
    func try_reserve(edit self, n: usize) -> Result[(), AllocErr] {
        if n <= self.cap { return Ok(()) }
        var bytes: usize = 0usize
        match elems_bytes[T](n) {
            Some(b) => bytes = b
            None => return Err(OutOfMemory)
        }
        unsafe {
            var q: RawPtr[u8] = zero()
            match self.a.alloc(bytes, align_of[T]()) {
                Ok(r) => q = r
                Err(e) => return Err(e)
            }
            p := ptr_cast[T, u8](q)
            if self.cap > 0usize {
                var old: usize = 0usize
                match elems_bytes[T](self.cap) {
                    Some(b) => old = b
                    None => trap_kind(unreachable)
                }
                ptr_copy(p, self.data, self.size)
                self.a.free(ptr_cast[u8, T](self.data), old, align_of[T]())
            }
            self.data = p
            self.cap = n
        }
        return Ok(())
    }
    // try_grow and try_grow_to are Vec's growth steps, with its guard.
    func try_grow(edit self) -> Result[(), AllocErr] {
        if self.cap > 9223372036854775807usize { return Err(OutOfMemory) }
        n := 4usize
        if self.cap > 0usize { n = self.cap * 2usize }
        return self.try_reserve(n)
    }
    func try_grow_to(edit self, n: usize) -> Result[(), AllocErr] {
        if self.cap > 9223372036854775807usize { return Err(OutOfMemory) }
        want := 4usize
        if self.cap > 0usize { want = self.cap * 2usize }
        if want < n { want = n }
        return self.try_reserve(want)
    }
    // try_push destroys v on Err.
    contract { requires "data addresses cap elements allocated from a, of which the first size are live" }
    func try_push(edit self, v: own T) -> Result[(), AllocErr] {
        if self.size == self.cap {
            match self.try_grow() {
                Ok(u) => { }
                Err(e) => { drop(v); return Err(e) }
            }
        }
        unsafe { ptr_store(ptr_offset(self.data, truncate[isize](self.size)), v) }
        self.size = wrapping_add(self.size, 1usize)
        return Ok(())
    }
    contract { requires "data addresses cap elements allocated from a, of which the first size are live; src does not overlap the spare capacity" }
    func try_extend(edit self, src: view[]T) -> Result[(), AllocErr] where T: Copy {
        var total: usize = 0usize
        match checked_add(self.size, len(src)) {
            Some(t) => total = t
            None => return Err(OutOfMemory)
        }
        if total > self.cap { self.try_grow_to(total)? }
        unsafe {
            ptr_store_seq(ptr_offset(self.data, truncate[isize](self.size)), src)
            self.size = total
        }
        return Ok(())
    }
    contract { requires "data addresses cap elements allocated from a, of which the first size are live" }
    func pop(edit self) -> Option[T] {
        if self.size == 0usize { return None }
        self.size = self.size - 1usize
        unsafe { return Some(ptr_take(ptr_offset(self.data, truncate[isize](self.size)))) }
    }
    contract { requires "data addresses cap elements allocated from a, of which the first size are live" }
    func get(view self, i: usize) -> view[T] {
        if i >= self.size { trap_kind(bounds) }
        unsafe { return ptr_view(ptr_offset(self.data, truncate[isize](i))) }
    }
    contract { requires "data addresses cap elements allocated from a, of which the first size are live" }
    func at(edit self, i: usize) -> edit[T] {
        if i >= self.size { trap_kind(bounds) }
        unsafe { return ptr_edit(ptr_offset(self.data, truncate[isize](i))) }
    }
    contract { requires "data addresses cap elements allocated from a, of which the first size are live" }
    func as_view(view self) -> view[]T {
        unsafe { return ptr_view_seq(self.data, self.size) }
    }
    contract { requires "data addresses cap elements allocated from a, of which the first size are live" }
    func as_edit(edit self) -> edit[]T {
        unsafe { return ptr_edit_seq(self.data, self.size) }
    }
    // clear destroys the elements from the last to the first; the capacity stays.
    contract { requires "data addresses cap elements allocated from a, of which the first size are live" }
    func clear(edit self) {
        while self.size > 0usize {
            self.size = self.size - 1usize
            unsafe {
                v := ptr_take(ptr_offset(self.data, truncate[isize](self.size)))
                drop(v)
            }
        }
    }
    // release destroys the elements and frees the storage through a,
    // leaving an empty vector that still holds a.
    contract { requires "data addresses cap elements allocated from a, of which the first size are live" }
    func release(edit self) {
        self.clear()
        unsafe {
            if self.cap > 0usize {
                match elems_bytes[T](self.cap) {
                    Some(b) => self.a.free(ptr_cast[u8, T](self.data), b, align_of[T]())
                    None => trap_kind(unreachable)
                }
                self.data = zero()
                self.cap = 0usize
            }
        }
    }
    destructor(edit self) { self.release() }
    // seed_len (test hook) sets the length of a vector of a zero-size Copy
    // element, so a fixture can reach the growth guard without 2^63 pushes.
    func seed_len(edit self, n: usize) where T: Copy {
        testing.require_hooks()
        if size_of[T]() != 0usize || n > self.cap { trap_kind(explicit) }
        self.size = n
    }
}

// PoolSlotMeta is the bookkeeping of one Pool slot: its generation, whether
// it holds a live element, and whether it was retired at generation wrap.
struct PoolSlotMeta { gen: u32; live: bool; retired: bool }
// A handle carries its container's identity tag in debug builds only
// (spec §5.6): a release build has no tags, so its handles are narrower.
// The //@debug and //@release lines are the two variants (resolve.Prelude).
struct PoolId[T] { index: u32; gen: u32; phantom_tag: u32 } //@debug
struct PoolId[T] { index: u32; gen: u32 } //@release
// Pool keeps count slots (cap allocated) in one buffer: a slot is the
// slot's PoolSlotMeta followed by its element, so a handle's check and its
// element share a cache line (a B-tree descent touches one line per level,
// not two). It also keeps a stack of nfree vacant slot indices in
// free_list, the number of live elements, and its identity tag.
struct Pool[T] nocopy { data: RawPtr[u8]; free_list: RawPtr[u32]; count: usize; cap: usize; nfree: usize; live: usize; identity: u32 }
impl Pool[T] {
    func new() -> Pool[T] {
        return Pool[T] { data: zero(), free_list: zero(), count: 0usize, cap: 0usize, nfree: 0usize, live: 0usize, identity: container_identity() }
    }
    // slot_align, elem_offset and stride lay out one slot: the metadata at
    // offset 0, the element at the first multiple of its alignment past
    // the metadata, the slot rounded up to the larger of the two
    // alignments.
    func slot_align(view self) -> usize {
        a := align_of[T]()
        if a < align_of[PoolSlotMeta]() { return align_of[PoolSlotMeta]() }
        return a
    }
    func elem_offset(view self) -> usize {
        a := align_of[T]()
        return (size_of[PoolSlotMeta]() + a - 1usize) / a * a
    }
    func stride(view self) -> usize {
        a := self.slot_align()
        return (self.elem_offset() + size_of[T]() + a - 1usize) / a * a
    }
    // buffer_bytes is n slots' bytes, or None when unrepresentable.
    func buffer_bytes(view self, n: usize) -> Option[usize] {
        st := self.stride()
        if n > 18446744073709551615usize / st { return None }
        return Some(n * st)
    }
    // meta_at and elem_at address slot i's metadata and element.
    contract { requires "i < cap" }
    func meta_at(view self, i: usize) -> RawPtr[PoolSlotMeta] {
        unsafe { return ptr_cast[PoolSlotMeta, u8](ptr_offset(self.data, truncate[isize](i * self.stride()))) }
    }
    contract { requires "i < cap" }
    func elem_at(view self, i: usize) -> RawPtr[T] {
        unsafe { return ptr_cast[T, u8](ptr_offset(self.data, truncate[isize](i * self.stride() + self.elem_offset()))) }
    }
    // grow doubles the two buffers transactionally: nothing changes
    // unless both new buffers were obtained. The free list is allocated
    // first and the slot buffer is then resized in place
    // (heap_try_realloc), so a failure leaves the old buffers untouched and
    // a success never holds two copies of the elements: the system
    // allocator extends or remaps a large block instead of allocating a
    // second one, copying and freeing, which kept every outgrown element
    // buffer resident and tripled the peak RSS of the btree workload.
    // Indices must fit a u32.
    contract { requires "the two buffers hold cap entries; the first count slots are initialized" }
    func grow(edit self) -> bool {
        n := 8usize
        if self.cap > 0usize {
            if self.cap > 2147483648usize { return false }
            n = self.cap * 2usize
        }
        var bytes: usize = 0usize
        match self.buffer_bytes(n) {
            Some(b) => bytes = b
            None => return false
        }
        unsafe {
            nf := heap_try_alloc(n * 4usize, 4usize)
            var nd: RawPtr[u8] = zero()
            if ptr_addr(nf) != 0usize {
                if self.cap > 0usize {
                    var old: usize = 0usize
                    match self.buffer_bytes(self.cap) {
                        Some(b) => old = b
                        None => trap_kind(unreachable)
                    }
                    nd = heap_try_realloc(self.data, old, bytes, self.slot_align())
                } else {
                    nd = heap_try_alloc(bytes, self.slot_align())
                }
            }
            if ptr_addr(nd) == 0usize {
                if ptr_addr(nf) != 0usize { heap_free(nf, n * 4usize, 4usize) }
                return false
            }
            ptr_copy(ptr_cast[u32, u8](nf), self.free_list, self.nfree)
            if self.cap > 0usize {
                heap_free(ptr_cast[u8, u32](self.free_list), self.cap * 4usize, 4usize)
            }
            self.data = nd
            self.free_list = ptr_cast[u32, u8](nf)
            self.cap = n
        }
        return true
    }
    contract { requires "the two buffers hold cap entries; the first count slots are initialized" }
    func alloc(edit self, v: own T) -> Result[PoolId[T], AllocErr] {
        var idx: usize = 0usize
        var gen: u32 = 0u32
        unsafe {
            if self.nfree > 0usize {
                self.nfree = self.nfree - 1usize
                idx = usize(ptr_load(ptr_offset(self.free_list, truncate[isize](self.nfree))))
                mp := self.meta_at(idx)
                m := ptr_load(mp)
                m.live = true
                gen = m.gen
                ptr_store(mp, m)
            } else {
                if self.count == self.cap {
                    if !self.grow() { drop(v); return Err(OutOfMemory) }
                }
                idx = self.count
                self.count = self.count + 1usize
                ptr_store(self.meta_at(idx), PoolSlotMeta { gen: 0u32, live: true, retired: false })
            }
            ptr_store(self.elem_at(idx), v)
        }
        self.live = self.live + 1usize
        return Ok(PoolId[T] { index: truncate[u32](idx), gen: gen, phantom_tag: self.identity }) //@debug
        return Ok(PoolId[T] { index: truncate[u32](idx), gen: gen }) //@release
    }
    // alloc_with constructs the value in its slot (spec §5.2, PLAN.md
    // Phase 1): the slot is obtained as alloc obtains it, and init
    // initializes it through out. Err(Alloc(OutOfMemory)) when the buffers
    // cannot grow, before init runs; Err(Init(e)) when init fails, after
    // which init has destroyed what it had initialized (the out failure
    // rule) and the slot is back on the free list, vacant, its generation
    // unchanged.
    contract { requires "the two buffers hold cap entries; the first count slots are initialized; init initializes the whole T through out on Ok and leaves the storage uninitialized on Err" }
    func alloc_with[E](edit self, init: func(out T) -> Result[(), E]) -> Result[PoolId[T], AllocOrInit[E]] {
        var idx: usize = 0usize
        var gen: u32 = 0u32
        unsafe {
            if self.nfree > 0usize {
                self.nfree = self.nfree - 1usize
                idx = usize(ptr_load(ptr_offset(self.free_list, truncate[isize](self.nfree))))
                gen = ptr_load(self.meta_at(idx)).gen
            } else {
                if self.count == self.cap {
                    if !self.grow() { return Err(Alloc(OutOfMemory)) }
                }
                idx = self.count
                self.count = self.count + 1usize
                ptr_store(self.meta_at(idx), PoolSlotMeta { gen: 0u32, live: false, retired: false })
            }
            match ptr_init(self.elem_at(idx), init) {
                Ok(u) => {
                    mp := self.meta_at(idx)
                    m := ptr_load(mp)
                    m.live = true
                    ptr_store(mp, m)
                }
                Err(e) => {
                    ptr_store(ptr_offset(self.free_list, truncate[isize](self.nfree)), truncate[u32](idx))
                    self.nfree = self.nfree + 1usize
                    return Err(Init(e))
                }
            }
        }
        self.live = self.live + 1usize
        return Ok(PoolId[T] { index: truncate[u32](idx), gen: gen, phantom_tag: self.identity }) //@debug
        return Ok(PoolId[T] { index: truncate[u32](idx), gen: gen }) //@release
    }
    // alloc_with_ctx is alloc_with with a context: init is called with the
    // storage as its out parameter and ctx, unchanged, as its second
    // argument (specs/init-context/SPEC.md R3).
    contract { requires "the two buffers hold cap entries; the first count slots are initialized; init initializes the whole T through out on Ok and leaves the storage uninitialized on Err" }
    func alloc_with_ctx[C, E](edit self, init: func(out T, view[C]) -> Result[(), E], ctx: view[C]) -> Result[PoolId[T], AllocOrInit[E]] {
        var idx: usize = 0usize
        var gen: u32 = 0u32
        unsafe {
            if self.nfree > 0usize {
                self.nfree = self.nfree - 1usize
                idx = usize(ptr_load(ptr_offset(self.free_list, truncate[isize](self.nfree))))
                gen = ptr_load(self.meta_at(idx)).gen
            } else {
                if self.count == self.cap {
                    if !self.grow() { return Err(Alloc(OutOfMemory)) }
                }
                idx = self.count
                self.count = self.count + 1usize
                ptr_store(self.meta_at(idx), PoolSlotMeta { gen: 0u32, live: false, retired: false })
            }
            match ptr_init_ctx(self.elem_at(idx), init, ctx) {
                Ok(u) => {
                    mp := self.meta_at(idx)
                    m := ptr_load(mp)
                    m.live = true
                    ptr_store(mp, m)
                }
                Err(e) => {
                    ptr_store(ptr_offset(self.free_list, truncate[isize](self.nfree)), truncate[u32](idx))
                    self.nfree = self.nfree + 1usize
                    return Err(Init(e))
                }
            }
        }
        self.live = self.live + 1usize
        return Ok(PoolId[T] { index: truncate[u32](idx), gen: gen, phantom_tag: self.identity }) //@debug
        return Ok(PoolId[T] { index: truncate[u32](idx), gen: gen }) //@release
    }
    // check validates a handle in the §5.6 order (bounds, identity, vacant,
    // generation) and returns its slot index.
    contract { requires "the two buffers hold cap entries; the first count slots are initialized" }
    func check(view self, id: PoolId[T]) -> usize {
        idx := usize(id.index)
        if idx >= self.count { trap_kind(bounds) }
        if id.phantom_tag != 0u32 && self.identity != 0u32 && id.phantom_tag != self.identity { trap_kind(identity) } //@debug
        unsafe {
            m := ptr_load(self.meta_at(idx))
            if !m.live { trap_kind(vacant) }
            if m.gen != id.gen { trap_kind(generation) }
        }
        return idx
    }
    contract { requires "data addresses cap slots; slot idx holds a live element after check" }
    func get(view self, id: PoolId[T]) -> view[T] {
        idx := self.check(id)
        unsafe { return ptr_view(self.elem_at(idx)) }
    }
    contract { requires "data addresses cap slots; slot idx holds a live element after check" }
    func at(edit self, id: PoolId[T]) -> edit[T] {
        idx := self.check(id)
        unsafe { return ptr_edit(self.elem_at(idx)) }
    }
    contract { invariant "a != b is checked at runtime; the two accesses are disjoint" }
    func get2(edit self, a: PoolId[T], b: PoolId[T]) -> (edit[T], edit[T]) {
        ia := self.check(a)
        ib := self.check(b)
        if ia == ib { trap_kind(disjoint) }
        unsafe { return ptr_edit2(self.elem_at(ia), self.elem_at(ib)) }
    }
    // free validates the handle, destroys the element and bumps the slot's
    // generation; a slot whose generation would wrap is retired.
    contract { requires "data addresses cap slots; slot idx holds a live element after check" }
    func free(edit self, id: PoolId[T]) {
        idx := self.check(id)
        unsafe {
            sp := self.meta_at(idx)
            m := ptr_load(sp)
            m.live = false
            ptr_store(sp, m)
            v := ptr_take(self.elem_at(idx))
            drop(v)
            if m.gen == 4294967295u32 {
                m.retired = true
            } else {
                m.gen = m.gen + 1u32
                ptr_store(ptr_offset(self.free_list, truncate[isize](self.nfree)), id.index)
                self.nfree = self.nfree + 1usize
            }
            ptr_store(sp, m)
        }
        self.live = self.live - 1usize
    }
    func len(view self) -> usize { return self.live }
    // seed_generation (test hook): makes slot exist as a vacant slot with
    // the given generation, keeping every slot below it allocated.
    contract { requires "the two buffers hold cap entries; the first count slots are initialized" }
    func seed_generation(edit self, slot: u32, gen: u32) {
        testing.require_hooks()
        s := usize(slot)
        while self.cap <= s { if !self.grow() { trap_kind(oom) } }
        unsafe {
            i := self.count
            while i <= s {
                ptr_store(self.meta_at(i), PoolSlotMeta { gen: 0u32, live: false, retired: false })
                ptr_store(ptr_offset(self.free_list, truncate[isize](self.nfree)), truncate[u32](i))
                self.nfree = self.nfree + 1usize
                i = i + 1usize
            }
            if self.count <= s { self.count = s + 1usize }
            sp := self.meta_at(s)
            m := ptr_load(sp)
            m.gen = gen
            ptr_store(sp, m)
        }
    }
    contract { requires "the two buffers hold cap entries; the first count slots are initialized" }
    func release(edit self) {
        unsafe {
            i := self.count
            while i > 0usize {
                i = i - 1usize
                m := ptr_load(self.meta_at(i))
                if m.live {
                    v := ptr_take(self.elem_at(i))
                    drop(v)
                }
            }
            if self.cap > 0usize {
                match self.buffer_bytes(self.cap) {
                    Some(b) => heap_free(self.data, b, self.slot_align())
                    None => trap_kind(unreachable)
                }
                heap_free(ptr_cast[u8, u32](self.free_list), self.cap * 4usize, 4usize)
                self.data = zero()
                self.free_list = zero()
                self.cap = 0usize
            }
            self.count = 0usize
            self.nfree = 0usize
            self.live = 0usize
            // a released pool is an empty one with a new identity: handles
            // issued before cannot name its slots (debug builds check it)
            self.identity = container_identity()
        }
    }
    destructor(edit self) { self.release() }
}

struct ArenaId[T] { index: u32; phantom_tag: u32 } //@debug
struct ArenaId[T] { index: u32 } //@release
struct Arena[T] nocopy { data: RawPtr[T]; size: usize; cap: usize; identity: u32 }
impl Arena[T] {
    func new() -> Arena[T] {
        return Arena[T] { data: zero(), size: 0usize, cap: 0usize, identity: container_identity() }
    }
    contract { requires "data addresses cap elements of which the first size are live" }
    func grow(edit self) -> bool {
        n := 8usize
        if self.cap > 0usize {
            if self.cap > 2147483648usize { return false }
            n = self.cap * 2usize
        }
        var bytes: usize = 0usize
        match elems_bytes[T](n) {
            Some(b) => bytes = b
            None => return false
        }
        unsafe {
            var nd: RawPtr[u8] = zero()
            if self.cap > 0usize {
                var old: usize = 0usize
                match elems_bytes[T](self.cap) {
                    Some(b) => old = b
                    None => return false
                }
                nd = heap_try_realloc(ptr_cast[u8, T](self.data), old, bytes, align_of[T]())
            } else {
                nd = heap_try_alloc(bytes, align_of[T]())
            }
            if ptr_addr(nd) == 0usize { return false }
            self.data = ptr_cast[T, u8](nd)
            self.cap = n
        }
        return true
    }
    contract { requires "data addresses cap elements of which the first size are live" }
    func alloc(edit self, v: own T) -> Result[ArenaId[T], AllocErr] {
        if self.size == self.cap {
            if !self.grow() { drop(v); return Err(OutOfMemory) }
        }
        unsafe { ptr_store(ptr_offset(self.data, truncate[isize](self.size)), v) }
        id := ArenaId[T] { index: truncate[u32](self.size), phantom_tag: self.identity } //@debug
        id := ArenaId[T] { index: truncate[u32](self.size) } //@release
        self.size = self.size + 1usize
        return Ok(id)
    }
    // alloc_with constructs the value in the arena's next slot (spec §5.2,
    // PLAN.md Phase 1): Err(Alloc(OutOfMemory)) when the arena cannot
    // grow, before init runs; Err(Init(e)) when init fails, after which
    // init has destroyed what it had initialized and the arena is as it
    // was.
    contract { requires "data addresses cap elements of which the first size are live; init initializes the whole T through out on Ok and leaves the storage uninitialized on Err" }
    func alloc_with[E](edit self, init: func(out T) -> Result[(), E]) -> Result[ArenaId[T], AllocOrInit[E]] {
        if self.size == self.cap {
            if !self.grow() { return Err(Alloc(OutOfMemory)) }
        }
        unsafe {
            match ptr_init(ptr_offset(self.data, truncate[isize](self.size)), init) {
                Ok(u) => {}
                Err(e) => return Err(Init(e))
            }
        }
        id := ArenaId[T] { index: truncate[u32](self.size), phantom_tag: self.identity } //@debug
        id := ArenaId[T] { index: truncate[u32](self.size) } //@release
        self.size = self.size + 1usize
        return Ok(id)
    }
    // alloc_with_ctx is alloc_with with a context: init is called with the
    // storage as its out parameter and ctx, unchanged, as its second
    // argument (specs/init-context/SPEC.md R4).
    contract { requires "data addresses cap elements of which the first size are live; init initializes the whole T through out on Ok and leaves the storage uninitialized on Err" }
    func alloc_with_ctx[C, E](edit self, init: func(out T, view[C]) -> Result[(), E], ctx: view[C]) -> Result[ArenaId[T], AllocOrInit[E]] {
        if self.size == self.cap {
            if !self.grow() { return Err(Alloc(OutOfMemory)) }
        }
        unsafe {
            match ptr_init_ctx(ptr_offset(self.data, truncate[isize](self.size)), init, ctx) {
                Ok(u) => {}
                Err(e) => return Err(Init(e))
            }
        }
        id := ArenaId[T] { index: truncate[u32](self.size), phantom_tag: self.identity } //@debug
        id := ArenaId[T] { index: truncate[u32](self.size) } //@release
        self.size = self.size + 1usize
        return Ok(id)
    }
    // check validates a handle (bounds, then identity) and returns its index.
    func check(view self, id: ArenaId[T]) -> usize {
        idx := usize(id.index)
        if idx >= self.size { trap_kind(bounds) }
        if id.phantom_tag != 0u32 && self.identity != 0u32 && id.phantom_tag != self.identity { trap_kind(identity) } //@debug
        return idx
    }
    contract { requires "data addresses cap elements of which the first size are live" }
    func get(view self, id: ArenaId[T]) -> view[T] {
        idx := self.check(id)
        unsafe { return ptr_view(ptr_offset(self.data, truncate[isize](idx))) }
    }
    contract { requires "data addresses cap elements of which the first size are live" }
    func at(edit self, id: ArenaId[T]) -> edit[T] {
        idx := self.check(id)
        unsafe { return ptr_edit(ptr_offset(self.data, truncate[isize](idx))) }
    }
    func len(view self) -> usize { return self.size }
    contract { requires "data addresses cap elements of which the first size are live" }
    func release(edit self) {
        unsafe {
            while self.size > 0usize {
                self.size = self.size - 1usize
                v := ptr_take(ptr_offset(self.data, truncate[isize](self.size)))
                drop(v)
            }
            if self.cap > 0usize {
                match elems_bytes[T](self.cap) {
                    Some(b) => heap_free(ptr_cast[u8, T](self.data), b, align_of[T]())
                    None => trap_kind(unreachable)
                }
                self.data = zero()
                self.cap = 0usize
            }
            self.identity = container_identity()
        }
    }
    destructor(edit self) { self.release() }
}

// ArenaIn and PoolIn are Arena and Pool over a caller's allocator
// (specs/alloc-containers-more), as VecIn is Vec over one: each holds its
// allocator inline and owns it, allocates its buffers only through it, and
// is fallible throughout. Growth allocates the new buffers, moves the live
// slots into them and frees the old ones, since Allocator has no realloc.
// Their handles are Arena's and Pool's, with the same checks.
struct ArenaIn[T, A: Allocator] nocopy { data: RawPtr[T]; size: usize; cap: usize; identity: u32; a: A }
impl[T, A: Allocator] ArenaIn[T, A] {
    func new_in(a: own A) -> ArenaIn[T, A] {
        return ArenaIn[T, A] { data: zero(), size: 0usize, cap: 0usize, identity: container_identity(), a: a }
    }
    func len(view self) -> usize { return self.size }
    func allocator(view self) -> view[A] { return self.a }
    // try_grow doubles the buffer through a; nothing changes on Err.
    contract { requires "data addresses cap elements allocated from a, of which the first size are live" }
    func try_grow(edit self) -> Result[(), AllocErr] {
        n := 8usize
        if self.cap > 0usize {
            if self.cap > 2147483648usize { return Err(OutOfMemory) }
            n = self.cap * 2usize
        }
        var bytes: usize = 0usize
        match elems_bytes[T](n) {
            Some(b) => bytes = b
            None => return Err(OutOfMemory)
        }
        unsafe {
            var q: RawPtr[u8] = zero()
            match self.a.alloc(bytes, align_of[T]()) {
                Ok(r) => q = r
                Err(e) => return Err(e)
            }
            p := ptr_cast[T, u8](q)
            if self.cap > 0usize {
                var old: usize = 0usize
                match elems_bytes[T](self.cap) {
                    Some(b) => old = b
                    None => trap_kind(unreachable)
                }
                ptr_copy(p, self.data, self.size)
                self.a.free(ptr_cast[u8, T](self.data), old, align_of[T]())
            }
            self.data = p
            self.cap = n
        }
        return Ok(())
    }
    // try_alloc stores v and returns its handle; on Err v is destroyed and
    // the arena is as it was.
    contract { requires "data addresses cap elements allocated from a, of which the first size are live" }
    func try_alloc(edit self, v: own T) -> Result[ArenaId[T], AllocErr] {
        if self.size == self.cap {
            match self.try_grow() {
                Ok(u) => { }
                Err(e) => {
                    drop(v)
                    return Err(e)
                }
            }
        }
        unsafe { ptr_store(ptr_offset(self.data, truncate[isize](self.size)), v) }
        id := ArenaId[T] { index: truncate[u32](self.size), phantom_tag: self.identity } //@debug
        id := ArenaId[T] { index: truncate[u32](self.size) } //@release
        self.size = self.size + 1usize
        return Ok(id)
    }
    // try_alloc_with constructs the value in the next slot
    // (specs/in-forms §1.1): Err(Alloc(e)) with the allocator's error when
    // the arena cannot grow, before init runs; Err(Init(e)) when init
    // fails, after which init has destroyed what it had initialized and
    // the arena holds what it held (a growth already made is kept).
    contract { requires "data addresses cap elements allocated from a, of which the first size are live; init initializes the whole T through out on Ok and leaves the storage uninitialized on Err" }
    func try_alloc_with[E](edit self, init: func(out T) -> Result[(), E]) -> Result[ArenaId[T], AllocOrInit[E]] {
        if self.size == self.cap {
            match self.try_grow() {
                Ok(u) => { }
                Err(e) => return Err(Alloc(e))
            }
        }
        unsafe {
            match ptr_init(ptr_offset(self.data, truncate[isize](self.size)), init) {
                Ok(u) => { }
                Err(e) => return Err(Init(e))
            }
        }
        id := ArenaId[T] { index: truncate[u32](self.size), phantom_tag: self.identity } //@debug
        id := ArenaId[T] { index: truncate[u32](self.size) } //@release
        self.size = self.size + 1usize
        return Ok(id)
    }
    // try_alloc_with_ctx is try_alloc_with with a context: init is called
    // with the storage as its out parameter and ctx, unchanged, as its
    // second argument.
    contract { requires "data addresses cap elements allocated from a, of which the first size are live; init initializes the whole T through out on Ok and leaves the storage uninitialized on Err" }
    func try_alloc_with_ctx[C, E](edit self, init: func(out T, view[C]) -> Result[(), E], ctx: view[C]) -> Result[ArenaId[T], AllocOrInit[E]] {
        if self.size == self.cap {
            match self.try_grow() {
                Ok(u) => { }
                Err(e) => return Err(Alloc(e))
            }
        }
        unsafe {
            match ptr_init_ctx(ptr_offset(self.data, truncate[isize](self.size)), init, ctx) {
                Ok(u) => { }
                Err(e) => return Err(Init(e))
            }
        }
        id := ArenaId[T] { index: truncate[u32](self.size), phantom_tag: self.identity } //@debug
        id := ArenaId[T] { index: truncate[u32](self.size) } //@release
        self.size = self.size + 1usize
        return Ok(id)
    }
    // check validates a handle (bounds, then identity) and returns its index.
    func check(view self, id: ArenaId[T]) -> usize {
        idx := usize(id.index)
        if idx >= self.size { trap_kind(bounds) }
        if id.phantom_tag != 0u32 && self.identity != 0u32 && id.phantom_tag != self.identity { trap_kind(identity) } //@debug
        return idx
    }
    contract { requires "data addresses cap elements of which the first size are live" }
    func get(view self, id: ArenaId[T]) -> view[T] {
        idx := self.check(id)
        unsafe { return ptr_view(ptr_offset(self.data, truncate[isize](idx))) }
    }
    contract { requires "data addresses cap elements of which the first size are live" }
    func at(edit self, id: ArenaId[T]) -> edit[T] {
        idx := self.check(id)
        unsafe { return ptr_edit(ptr_offset(self.data, truncate[isize](idx))) }
    }
    contract { requires "data addresses cap elements allocated from a, of which the first size are live" }
    func release(edit self) {
        unsafe {
            while self.size > 0usize {
                self.size = self.size - 1usize
                v := ptr_take(ptr_offset(self.data, truncate[isize](self.size)))
                drop(v)
            }
            if self.cap > 0usize {
                match elems_bytes[T](self.cap) {
                    Some(b) => self.a.free(ptr_cast[u8, T](self.data), b, align_of[T]())
                    None => trap_kind(unreachable)
                }
                self.data = zero()
                self.cap = 0usize
            }
            self.identity = container_identity()
        }
    }
    destructor(edit self) { self.release() }
}

struct PoolIn[T, A: Allocator] nocopy { data: RawPtr[u8]; free_list: RawPtr[u32]; count: usize; cap: usize; nfree: usize; live: usize; identity: u32; a: A }
impl[T, A: Allocator] PoolIn[T, A] {
    func new_in(a: own A) -> PoolIn[T, A] {
        return PoolIn[T, A] { data: zero(), free_list: zero(), count: 0usize, cap: 0usize, nfree: 0usize, live: 0usize, identity: container_identity(), a: a }
    }
    func len(view self) -> usize { return self.live }
    func allocator(view self) -> view[A] { return self.a }
    // the slot layout is Pool's: the metadata at offset 0, the element at
    // the first multiple of its alignment past it, the slot rounded up to
    // the larger alignment
    func slot_align(view self) -> usize {
        a := align_of[T]()
        if a < align_of[PoolSlotMeta]() { return align_of[PoolSlotMeta]() }
        return a
    }
    func elem_offset(view self) -> usize {
        a := align_of[T]()
        return (size_of[PoolSlotMeta]() + a - 1usize) / a * a
    }
    func stride(view self) -> usize {
        a := self.slot_align()
        return (self.elem_offset() + size_of[T]() + a - 1usize) / a * a
    }
    func buffer_bytes(view self, n: usize) -> Option[usize] {
        st := self.stride()
        if n > 18446744073709551615usize / st { return None }
        return Some(n * st)
    }
    contract { requires "i < cap" }
    func meta_at(view self, i: usize) -> RawPtr[PoolSlotMeta] {
        unsafe { return ptr_cast[PoolSlotMeta, u8](ptr_offset(self.data, truncate[isize](i * self.stride()))) }
    }
    contract { requires "i < cap" }
    func elem_at(view self, i: usize) -> RawPtr[T] {
        unsafe { return ptr_cast[T, u8](ptr_offset(self.data, truncate[isize](i * self.stride() + self.elem_offset()))) }
    }
    // try_grow doubles both buffers through a, transactionally: nothing
    // changes unless both new buffers were obtained; the initialized slots
    // and the free list are moved into them and the old ones freed.
    contract { requires "the two buffers hold cap entries allocated from a; the first count slots are initialized" }
    func try_grow(edit self) -> Result[(), AllocErr] {
        n := 8usize
        if self.cap > 0usize {
            if self.cap > 2147483648usize { return Err(OutOfMemory) }
            n = self.cap * 2usize
        }
        var bytes: usize = 0usize
        match self.buffer_bytes(n) {
            Some(b) => bytes = b
            None => return Err(OutOfMemory)
        }
        unsafe {
            var nf: RawPtr[u8] = zero()
            match self.a.alloc(n * 4usize, 4usize) {
                Ok(r) => nf = r
                Err(e) => return Err(e)
            }
            var nd: RawPtr[u8] = zero()
            match self.a.alloc(bytes, self.slot_align()) {
                Ok(r) => nd = r
                Err(e) => {
                    self.a.free(nf, n * 4usize, 4usize)
                    return Err(e)
                }
            }
            ptr_copy(ptr_cast[u32, u8](nf), self.free_list, self.nfree)
            if self.cap > 0usize {
                var old: usize = 0usize
                match self.buffer_bytes(self.cap) {
                    Some(b) => old = b
                    None => trap_kind(unreachable)
                }
                ptr_copy(nd, self.data, self.count * self.stride())
                self.a.free(self.data, old, self.slot_align())
                self.a.free(ptr_cast[u8, u32](self.free_list), self.cap * 4usize, 4usize)
            }
            self.data = nd
            self.free_list = ptr_cast[u32, u8](nf)
            self.cap = n
        }
        return Ok(())
    }
    // try_alloc stores v in a vacant slot (the most recently freed first)
    // or a new one and returns its handle; on Err v is destroyed and the
    // pool is as it was.
    contract { requires "the two buffers hold cap entries allocated from a; the first count slots are initialized" }
    func try_alloc(edit self, v: own T) -> Result[PoolId[T], AllocErr] {
        var idx: usize = 0usize
        var gen: u32 = 0u32
        if self.nfree == 0usize && self.count == self.cap {
            match self.try_grow() {
                Ok(u) => { }
                Err(e) => {
                    drop(v)
                    return Err(e)
                }
            }
        }
        unsafe {
            if self.nfree > 0usize {
                self.nfree = self.nfree - 1usize
                idx = usize(ptr_load(ptr_offset(self.free_list, truncate[isize](self.nfree))))
                mp := self.meta_at(idx)
                m := ptr_load(mp)
                m.live = true
                gen = m.gen
                ptr_store(mp, m)
            } else {
                idx = self.count
                self.count = self.count + 1usize
                ptr_store(self.meta_at(idx), PoolSlotMeta { gen: 0u32, live: true, retired: false })
            }
            ptr_store(self.elem_at(idx), v)
        }
        self.live = self.live + 1usize
        return Ok(PoolId[T] { index: truncate[u32](idx), gen: gen, phantom_tag: self.identity }) //@debug
        return Ok(PoolId[T] { index: truncate[u32](idx), gen: gen }) //@release
    }
    // try_alloc_with constructs the value in its slot (specs/in-forms
    // §1.2), the slot chosen as try_alloc chooses it: Err(Alloc(e)) with
    // the allocator's error when the pool cannot grow, before init runs;
    // Err(Init(e)) when init fails, after which init has destroyed what it
    // had initialized and the slot is back on top of the free list,
    // vacant, its generation unchanged (a growth already made is kept).
    contract { requires "the two buffers hold cap entries allocated from a; the first count slots are initialized; init initializes the whole T through out on Ok and leaves the storage uninitialized on Err" }
    func try_alloc_with[E](edit self, init: func(out T) -> Result[(), E]) -> Result[PoolId[T], AllocOrInit[E]] {
        if self.nfree == 0usize && self.count == self.cap {
            match self.try_grow() {
                Ok(u) => { }
                Err(e) => return Err(Alloc(e))
            }
        }
        var idx: usize = 0usize
        var gen: u32 = 0u32
        unsafe {
            if self.nfree > 0usize {
                self.nfree = self.nfree - 1usize
                idx = usize(ptr_load(ptr_offset(self.free_list, truncate[isize](self.nfree))))
                gen = ptr_load(self.meta_at(idx)).gen
            } else {
                idx = self.count
                self.count = self.count + 1usize
                ptr_store(self.meta_at(idx), PoolSlotMeta { gen: 0u32, live: false, retired: false })
            }
            match ptr_init(self.elem_at(idx), init) {
                Ok(u) => {
                    mp := self.meta_at(idx)
                    m := ptr_load(mp)
                    m.live = true
                    ptr_store(mp, m)
                }
                Err(e) => {
                    ptr_store(ptr_offset(self.free_list, truncate[isize](self.nfree)), truncate[u32](idx))
                    self.nfree = self.nfree + 1usize
                    return Err(Init(e))
                }
            }
        }
        self.live = self.live + 1usize
        return Ok(PoolId[T] { index: truncate[u32](idx), gen: gen, phantom_tag: self.identity }) //@debug
        return Ok(PoolId[T] { index: truncate[u32](idx), gen: gen }) //@release
    }
    // try_alloc_with_ctx is try_alloc_with with a context: init is called
    // with the storage as its out parameter and ctx, unchanged, as its
    // second argument.
    contract { requires "the two buffers hold cap entries allocated from a; the first count slots are initialized; init initializes the whole T through out on Ok and leaves the storage uninitialized on Err" }
    func try_alloc_with_ctx[C, E](edit self, init: func(out T, view[C]) -> Result[(), E], ctx: view[C]) -> Result[PoolId[T], AllocOrInit[E]] {
        if self.nfree == 0usize && self.count == self.cap {
            match self.try_grow() {
                Ok(u) => { }
                Err(e) => return Err(Alloc(e))
            }
        }
        var idx: usize = 0usize
        var gen: u32 = 0u32
        unsafe {
            if self.nfree > 0usize {
                self.nfree = self.nfree - 1usize
                idx = usize(ptr_load(ptr_offset(self.free_list, truncate[isize](self.nfree))))
                gen = ptr_load(self.meta_at(idx)).gen
            } else {
                idx = self.count
                self.count = self.count + 1usize
                ptr_store(self.meta_at(idx), PoolSlotMeta { gen: 0u32, live: false, retired: false })
            }
            match ptr_init_ctx(self.elem_at(idx), init, ctx) {
                Ok(u) => {
                    mp := self.meta_at(idx)
                    m := ptr_load(mp)
                    m.live = true
                    ptr_store(mp, m)
                }
                Err(e) => {
                    ptr_store(ptr_offset(self.free_list, truncate[isize](self.nfree)), truncate[u32](idx))
                    self.nfree = self.nfree + 1usize
                    return Err(Init(e))
                }
            }
        }
        self.live = self.live + 1usize
        return Ok(PoolId[T] { index: truncate[u32](idx), gen: gen, phantom_tag: self.identity }) //@debug
        return Ok(PoolId[T] { index: truncate[u32](idx), gen: gen }) //@release
    }
    contract { requires "the two buffers hold cap entries; the first count slots are initialized" }
    func check(view self, id: PoolId[T]) -> usize {
        idx := usize(id.index)
        if idx >= self.count { trap_kind(bounds) }
        if id.phantom_tag != 0u32 && self.identity != 0u32 && id.phantom_tag != self.identity { trap_kind(identity) } //@debug
        unsafe {
            m := ptr_load(self.meta_at(idx))
            if !m.live { trap_kind(vacant) }
            if m.gen != id.gen { trap_kind(generation) }
        }
        return idx
    }
    contract { requires "data addresses cap slots; slot idx holds a live element after check" }
    func get(view self, id: PoolId[T]) -> view[T] {
        idx := self.check(id)
        unsafe { return ptr_view(self.elem_at(idx)) }
    }
    contract { requires "data addresses cap slots; slot idx holds a live element after check" }
    func at(edit self, id: PoolId[T]) -> edit[T] {
        idx := self.check(id)
        unsafe { return ptr_edit(self.elem_at(idx)) }
    }
    // get2 lends two distinct live elements at once (specs/in-forms §1.3):
    // a is checked, then b, each as get checks it; one slot named twice
    // traps disjoint.
    contract { invariant "a != b is checked at runtime; the two accesses are disjoint" }
    func get2(edit self, a: PoolId[T], b: PoolId[T]) -> (edit[T], edit[T]) {
        ia := self.check(a)
        ib := self.check(b)
        if ia == ib { trap_kind(disjoint) }
        unsafe { return ptr_edit2(self.elem_at(ia), self.elem_at(ib)) }
    }
    // free validates the handle, destroys the element and bumps the slot's
    // generation; a slot whose generation would wrap is retired.
    contract { requires "data addresses cap slots; slot idx holds a live element after check" }
    func free(edit self, id: PoolId[T]) {
        idx := self.check(id)
        unsafe {
            sp := self.meta_at(idx)
            m := ptr_load(sp)
            m.live = false
            ptr_store(sp, m)
            v := ptr_take(self.elem_at(idx))
            drop(v)
            if m.gen == 4294967295u32 {
                m.retired = true
            } else {
                m.gen = m.gen + 1u32
                ptr_store(ptr_offset(self.free_list, truncate[isize](self.nfree)), id.index)
                self.nfree = self.nfree + 1usize
            }
            ptr_store(sp, m)
        }
        self.live = self.live - 1usize
    }
    contract { requires "the two buffers hold cap entries allocated from a; the first count slots are initialized" }
    func release(edit self) {
        unsafe {
            i := self.count
            while i > 0usize {
                i = i - 1usize
                m := ptr_load(self.meta_at(i))
                if m.live {
                    v := ptr_take(self.elem_at(i))
                    drop(v)
                }
            }
            if self.cap > 0usize {
                match self.buffer_bytes(self.cap) {
                    Some(b) => self.a.free(self.data, b, self.slot_align())
                    None => trap_kind(unreachable)
                }
                self.a.free(ptr_cast[u8, u32](self.free_list), self.cap * 4usize, 4usize)
                self.data = zero()
                self.free_list = zero()
                self.cap = 0usize
            }
            self.count = 0usize
            self.nfree = 0usize
            self.live = 0usize
            self.identity = container_identity()
        }
    }
    destructor(edit self) { self.release() }
}

struct Shared[T] nocopy { inner: T }
impl Shared[T] {
    func new(v: own T) -> Shared[T]
    // try_new is new returning Err(OutOfMemory) when the runtime cannot
    // allocate the object, after destroying v (specs/fallible-runtime-objects).
    func try_new(v: own T) -> Result[Shared[T], AllocErr]
    func get(view self) -> view[T]
    func clone(view self) -> Shared[T]
    destructor(edit self) { }
}
unsafe assert Interior for Shared

struct Mutex[T] nocopy { inner: T }
impl Mutex[T] {
    func new(v: own T) -> Mutex[T]
    // try_new is new returning Err(OutOfMemory) when the runtime cannot
    // allocate the lock, after destroying v.
    func try_new(v: own T) -> Result[Mutex[T], AllocErr]
    contract { invariant "the lock guarantees exclusivity of the returned edit while it is live" }
    func lock(view self) -> edit[T] release unlock
    func unlock(view self)
    // try_acquire takes the lock only if it is free and reports whether it
    // did; held is the guarded value for a caller that holds the lock.
    // Both are unsafe operations: nothing releases a lock taken this way
    // but the caller's own unlock. try_with is their safe form.
    func try_acquire(view self) -> bool
    func held(view self) -> edit[T]
    // try_with calls f with the guarded value if the lock is free, and
    // reports whether it did: it acquires the lock, calls f, releases the
    // lock and returns true; when the lock is held, by any thread, the
    // caller included, it returns false without calling f and without
    // trapping (specs/runtime RD3).
    contract { invariant "the lock is held from try_acquire to unlock, so the edit passed to f is exclusive for the call" }
    func try_with(view self, f: closure(edit[T])) -> bool {
        unsafe {
            if !self.try_acquire() { return false }
            f(self.held())
        }
        self.unlock()
        return true
    }
    destructor(edit self) { }
}
unsafe assert Interior for Mutex

// Condvar is a condition variable (spec §5.5). wait takes the edit bound by
// a Mutex lock: it releases that lock, blocks until a notify (spurious
// wakeups are permitted, so callers re-test their condition in a loop),
// reacquires the lock and returns with the binding still live. Every wait on
// one Condvar must use the same Mutex; a wait with a different Mutex traps
// with kind explicit, as does a wait whose guard is not held by the calling
// thread.
struct Condvar nocopy { phantom: u8 }
impl Condvar {
    func new() -> Condvar
    // try_new is new returning Err(OutOfMemory) when the runtime cannot
    // allocate the condition variable.
    func try_new() -> Result[Condvar, AllocErr]
    func wait[T](view self, g: edit[T])
    // wait_ns is wait that also returns when ns nanoseconds have passed:
    // false only when the time elapsed with no wake. The lock is held
    // again when it returns either way, so the caller re-tests its
    // condition as after wait. wait's traps apply (specs/runtime RD2).
    func wait_ns[T](view self, g: edit[T], ns: u64) -> bool
    func notify_one(view self)
    func notify_all(view self)
    destructor(edit self) { }
}
unsafe assert Interior for Condvar

struct Atomic[T] { inner: T }
impl Atomic[T] {
    func new(v: T) -> Atomic[T]
    func load(view self, ord: Ordering) -> T
    func store(view self, v: T, ord: Ordering)
    func swap(view self, v: T, ord: Ordering) -> T
    func compare_exchange(view self, expected: T, desired: T, success: Ordering, failure: Ordering) -> Result[T, T]
    func compare_exchange_weak(view self, expected: T, desired: T, success: Ordering, failure: Ordering) -> Result[T, T]
    func fetch_add(view self, v: T, ord: Ordering) -> T
    func fetch_sub(view self, v: T, ord: Ordering) -> T
    func fetch_and(view self, v: T, ord: Ordering) -> T
    func fetch_or(view self, v: T, ord: Ordering) -> T
    func fetch_xor(view self, v: T, ord: Ordering) -> T
}
unsafe assert Interior for Atomic
union Ordering { relaxed; acquire; release; acq_rel; seq_cst }
func fence(ord: Ordering)

// Parking: the one blocking primitive under the synchronization types
// (specs/runtime RD1; hosted only). park blocks the calling thread while
// the atomic's value equals expect; it may return at any time, so a caller
// re-checks its condition in a loop. A wake that comes between the
// caller's last check and its sleep is not lost: the sleep begins only if
// the value still equals expect. park_ns also returns after ns
// nanoseconds, and returns false only when the time elapsed. unpark_one
// and unpark_all wake one or every thread parked on the atomic. std/sync
// is built on these four and Atomic.
func park(a: view[Atomic[u32]], expect: u32)
func park_ns(a: view[Atomic[u32]], expect: u32, ns: u64) -> bool
func unpark_one(a: view[Atomic[u32]])
func unpark_all(a: view[Atomic[u32]])

struct Thread[R] nocopy { phantom: R }
impl Thread[R] {
    func join(own self) -> R
    destructor(edit self) { }
}
struct Join[R] nocopy { phantom: R }
impl Join[R] {
    func get(own self) -> R
    destructor(edit self) { }
}
struct Scope nocopy { phantom: u8 }
impl Scope {
    // spawn is an intrinsic: spawn(f, args...) with the §5.5 rules; typed by the checker.
    destructor(edit self) { }
}
struct thread { phantom: u8 }
impl thread {
    func scope() -> Scope
    // set_stack_bytes sets the stack size of every thread spawned from now
    // on, by any thread; it returns false and changes nothing when n is
    // below 65,536 or above 1,073,741,824. The size is rounded up to a
    // whole page. Without it a spawned thread's stack is KERN_STACK_BYTES,
    // else the build's --stack-bytes, else 8 MiB (specs/runtime RC2).
    func set_stack_bytes(n: usize) -> bool
    // stack_bytes is the stack size the next spawned thread gets.
    func stack_bytes() -> usize
    // available_parallelism is the number of processors the process may
    // run on, at least 1.
    func available_parallelism() -> usize
    // current_id is the calling thread's identifier, the one a trap record
    // carries: 0 for the thread that runs main.
    func current_id() -> u64
    // thread.spawn(f, own args...) -> Result[Thread[R], SpawnErr] is an intrinsic typed by the checker.
}

union TrapKind { bounds; overflow; div_zero; shift; conversion; generation; vacant; identity; disjoint; oom; stack; explicit; unreachable }
struct TrapInfo { kind: TrapKind; file: RawPtr[u8]; start: usize; end: usize; thread_id: u64 }
struct trap { phantom: u8 }
impl trap {
    func set_handler(f: func(view[TrapInfo])) -> func(view[TrapInfo])
}
