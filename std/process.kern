// std/process: child processes and the program's environment, for hosted
// programs (a freestanding image has no runtime behind these). Imported
// with `import "std/process"`; errors are std/io's IoErr, so a program
// matching them also imports "std/io". The runtime calls below are raw
// entries (specs/std-process/PLAN.md); the functions after them are the
// library's interface.
module process
import "std/io"
import "std/time"

// Stdio is what a child's standard stream is connected to.
union Stdio { Inherit; Null; Piped }

// ExitStatus is how a child ended: its exit code (0 to 255), or the
// signal that ended it.
union ExitStatus { Exited(code: i32); Signaled(signal: i32) }

impl ExitStatus {
    // success is true exactly for Exited(0).
    func success(view self) -> bool {
        match self {
            Exited(c) => return c == 0i32
            Signaled(s) => return false
        }
        return false
    }
}

// Output is a finished child's status and captured output.
struct Output { status: ExitStatus; stdout: Vec[u8]; stderr: Vec[u8] }

// Runtime intrinsics (hosted). The environment is a snapshot taken when
// the program started, keeping only the first entry of a name that
// occurs more than once.
func proc_env_count() -> usize
func proc_env_at(i: usize, buf: edit[]u8) -> usize

// env_entry returns entry i of the start-time environment, `name=value`.
func env_entry(i: usize) -> Vec[u8] {
    buf := Vec[u8].new()
    buf.resize(256usize, 0u8)
    while true {
        var n: usize = 0usize
        with e := buf.as_edit() { n = proc_env_at(i, e) }
        if n <= buf.len() {
            entry := Vec[u8].new()
            with b := buf.as_view() { entry.extend(b[0usize : n]) }
            return entry
        }
        buf.resize(n, 0u8)
    }
    return buf
}

// valid_name: an environment name is non-empty and holds no '=' and no NUL.
func valid_name(name: view[]u8) -> bool {
    if len(name) == 0usize { return false }
    var i: usize = 0usize
    while i < len(name) {
        if name[i] == 61u8 || name[i] == 0u8 { return false }
        i = i + 1usize
    }
    return true
}

// env returns the value of the variable name in the environment the
// program started with, or None when it is unset or name is not a valid
// name.
func env(name: view[]u8) -> Option[Vec[u8]] {
    if !valid_name(name) { return None }
    n := proc_env_count()
    var i: usize = 0usize
    while i < n {
        e := env_entry(i)
        k := len(name)
        if e.len() > k && e.get(k) == 61u8 {
            var same: bool = true
            var j: usize = 0usize
            while j < k {
                if e.get(j) != name[j] { same = false; break }
                j = j + 1usize
            }
            if same {
                v := Vec[u8].new()
                m := e.len()
                with b := e.as_view() { v.extend(b[k + 1usize : m]) }
                return Some(v)
            }
        }
        i = i + 1usize
    }
    return None
}

// More runtime intrinsics (hosted): starting, waiting for and signalling
// a child. They are raw entries, as std/io's io_* are: they check what
// memory safety needs (packing, lengths) but not who owns a handle.
func proc_spawn(prog: view[]u8, argv: view[]u8, argc: usize, envp: view[]u8, envc: usize, dir: view[]u8, has_dir: bool, search: view[]u8, modes: view[]u8, fds: edit[]i32) -> i64
func proc_pid(h: i64) -> u32
func proc_wait(h: i64, block: bool, st: edit[]i32) -> i32
func proc_signal(h: i64, sig: i32) -> i32
func proc_release(h: i64)
func proc_flush_inherited(h: i64)
func proc_close(fd: i32) -> i32
func proc_read(fd: i32, buf: edit[]u8) -> i64
func proc_write(fd: i32, data: view[]u8) -> i64
func proc_errno(which: u8) -> i32
// The fault hook (tests only): proc_fault_arm sets slot kind (a Pipe's
// kind) to an errno, which the next pipe operation of that kind takes
// with proc_fault_take and returns instead of making its call. Arming
// exists only under --test-hooks (the interpreter traps, a native build
// fails to link); taking is always there and costs one atomic exchange.
func proc_fault_arm(kind: u8, code: i32)
func proc_fault_take(kind: u8) -> i32

// fail_next_io makes the next pipe operation of kind (0 a write to a
// child's stdin, 1 a read of its stdout, 2 of its stderr), on any pipe,
// fail with errno code; for tests, under --test-hooks.
func fail_next_io(kind: u8, code: i32) { proc_fault_arm(kind, code) }

// errno_err is the IoErr of the host's errno number which (0 EINVAL, 1
// ENAMETOOLONG; proc_errno), so that no errno number is written here.
func errno_err(which: u8) -> io.IoErr { return io.err_of(proc_errno(which)) }

// neg_err is the IoErr of a runtime entry's negative result.
func neg_err(r: i64) -> io.IoErr { return io.err_of(truncate[i32](0i64 - r)) }

// has_nul reports whether bytes holds a NUL.
func has_nul(bytes: view[]u8) -> bool {
    var i: usize = 0usize
    while i < len(bytes) {
        if bytes[i] == 0u8 { return true }
        i = i + 1usize
    }
    return false
}

// Packed is a list of byte strings each followed by a NUL, as the
// runtime takes an argument vector or an environment, and their number.
struct Packed { bytes: Vec[u8]; count: usize }

// EnvEdit is one recorded change to a child's environment.
union EnvEdit { Set(name: Vec[u8], value: Vec[u8]); Remove(name: Vec[u8]) }

// names_entry reports whether an environment entry `name=value` is named
// name; an entry without '=' names nothing.
func names_entry(entry: view[]u8, name: view[]u8) -> bool {
    k := len(name)
    if len(entry) <= k || entry[k] != 61u8 { return false }
    var i: usize = 0usize
    while i < k {
        if entry[i] != name[i] { return false }
        i = i + 1usize
    }
    return true
}

// bytes_of copies a view into a new Vec.
func bytes_of(b: view[]u8) -> Vec[u8] {
    v := Vec[u8].new()
    v.extend(b)
    return v
}

// stdio_mode is the runtime's number for a stream setting.
func stdio_mode(s: view[Stdio]) -> u8 {
    match s {
        Inherit => return 0u8
        Null => return 1u8
        Piped => return 2u8
    }
    return 0u8
}

// Command describes a child to start: the program, its arguments, changes
// to the environment, the working directory and the three streams. Its
// methods only record; spawn checks and starts. A Command is not consumed
// by spawn, status or output.
struct Command { program: Vec[u8]; args: Vec[Vec[u8]]; edits: Vec[EnvEdit]; cleared: bool; dir: Option[Vec[u8]]; modes: [3]u8 }

impl Command {
    // new describes program with no arguments, the environment the
    // program started with, its working directory and inherited streams.
    func new(program: view[]u8) -> Command {
        return Command { program: bytes_of(program), args: Vec[Vec[u8]].new(), edits: Vec[EnvEdit].new(), cleared: false, dir: None, modes: [0u8, 0u8, 0u8] }
    }
    // arg appends one argument.
    func arg(edit self, a: view[]u8) { self.args.push(bytes_of(a)) }
    // env_set gives the child name=value, replacing every entry named name.
    func env_set(edit self, name: view[]u8, value: view[]u8) { self.edits.push(Set(bytes_of(name), bytes_of(value))) }
    // env_remove leaves every entry named name out of the child's environment.
    func env_remove(edit self, name: view[]u8) { self.edits.push(Remove(bytes_of(name))) }
    // env_clear starts the child's environment empty, discarding the
    // env_set and env_remove calls recorded before it.
    func env_clear(edit self) {
        self.edits.clear()
        self.cleared = true
    }
    // dir sets the child's working directory.
    func dir(edit self, path: view[]u8) { self.dir = Some(bytes_of(path)) }
    func stdin(edit self, s: Stdio) { self.modes[0usize] = stdio_mode(s) }
    func stdout(edit self, s: Stdio) { self.modes[1usize] = stdio_mode(s) }
    func stderr(edit self, s: Stdio) { self.modes[2usize] = stdio_mode(s) }

    // check runs spawn's validation (specs/std-process R4), in order, and
    // returns the first failure.
    func check(view self) -> Option[io.IoErr] {
        n := self.program.len()
        with p := self.program.as_view() {
            if n == 0usize || has_nul(p) { return Some(errno_err(0u8)) }
        }
        if n >= 4096usize { return Some(errno_err(1u8)) }
        var i: usize = 0usize
        while i < self.args.len() {
            with a := self.args.get(i).as_view() {
                if has_nul(a) { return Some(errno_err(0u8)) }
            }
            i = i + 1usize
        }
        i = 0usize
        while i < self.edits.len() {
            var bad: bool = false
            match self.edits.get(i) {
                Set(name, value) => {
                    with nv := name.as_view() { bad = !valid_name(nv) }
                    with vv := value.as_view() { bad = bad || has_nul(vv) }
                }
                Remove(name) => {
                    with nv := name.as_view() { bad = !valid_name(nv) }
                }
            }
            if bad { return Some(errno_err(0u8)) }
            i = i + 1usize
        }
        match self.dir {
            Some(d) => {
                m := d.len()
                with dv := d.as_view() {
                    if has_nul(dv) { return Some(errno_err(0u8)) }
                }
                if m >= 4096usize { return Some(errno_err(1u8)) }
            }
            None => { }
        }
        return None
    }

    // child_env computes the child's environment (R3), packed.
    func child_env(view self) -> Packed {
        list := Vec[Vec[u8]].new()
        if !self.cleared {
            n := proc_env_count()
            var i: usize = 0usize
            while i < n {
                list.push(env_entry(i))
                i = i + 1usize
            }
        }
        var k: usize = 0usize
        while k < self.edits.len() {
            next := Vec[Vec[u8]].new()
            match self.edits.get(k) {
                Set(name, value) => {
                    entry := name.clone()
                    entry.push(61u8)
                    with vv := value.as_view() { entry.extend(vv) }
                    var placed: bool = false
                    var j: usize = 0usize
                    while j < list.len() {
                        var named: bool = false
                        with e := list.get(j).as_view() {
                            with nv := name.as_view() { named = names_entry(e, nv) }
                        }
                        if !named {
                            next.push(list.get(j).clone())
                        } else if !placed {
                            next.push(entry.clone())
                            placed = true
                        }
                        j = j + 1usize
                    }
                    if !placed { next.push(entry.clone()) }
                }
                Remove(name) => {
                    var j: usize = 0usize
                    while j < list.len() {
                        var named: bool = false
                        with e := list.get(j).as_view() {
                            with nv := name.as_view() { named = names_entry(e, nv) }
                        }
                        if !named { next.push(list.get(j).clone()) }
                        j = j + 1usize
                    }
                }
            }
            list = next
            k = k + 1usize
        }
        packed := Vec[u8].new()
        var i: usize = 0usize
        while i < list.len() {
            with e := list.get(i).as_view() { packed.extend(e) }
            packed.push(0u8)
            i = i + 1usize
        }
        return Packed { bytes: packed, count: list.len() }
    }

    // spawn starts the child, or returns why it could not.
    func spawn(view self) -> Result[Child, io.IoErr] { return self.spawn_modes(self.modes) }

    // spawn_modes is spawn with the three stream settings given.
    func spawn_modes(view self, modes: [3]u8) -> Result[Child, io.IoErr] {
        match self.check() {
            Some(e) => return Err(e)
            None => { }
        }
        argv := self.program.clone()
        argv.push(0u8)
        var i: usize = 0usize
        while i < self.args.len() {
            with a := self.args.get(i).as_view() { argv.extend(a) }
            argv.push(0u8)
            i = i + 1usize
        }
        argc := self.args.len() + 1usize
        envp := self.child_env()
        search := Vec[u8].new()
        with p := env("PATH") {
            match p {
                Some(v) => { with b := v.as_view() { search.extend(b) } }
                None => search.extend("/usr/bin:/bin")
            }
        }
        var dir: Vec[u8] = Vec[u8].new()
        var has_dir: bool = false
        match self.dir {
            Some(d) => {
                with dv := d.as_view() { dir.extend(dv) }
                has_dir = true
            }
            None => { }
        }
        var fds: [3]i32 = [-1i32, -1i32, -1i32]
        var h: i64 = 0i64
        with pv := self.program.as_view() {
            with av := argv.as_view() {
                with ev := envp.bytes.as_view() {
                    with dv := dir.as_view() {
                        with sv := search.as_view() {
                            h = proc_spawn(pv, av, argc, ev, envp.count, dv, has_dir, sv, modes, fds)
                        }
                    }
                }
            }
        }
        if h < 0i64 { return Err(neg_err(h)) }
        return Ok(Child { h: h, fds: fds, reaped: false, st: [0i32, 0i32] })
    }

    // output runs the child with all three streams piped, whatever the
    // settings: it writes input to the child's stdin and closes it, and
    // reads stdout and stderr to their ends, all at once (the readers on
    // scoped threads), so that no size of either can deadlock it; then it
    // waits. An EPIPE while writing input (the child stopped reading) is
    // not an error. A failure stops nothing else: each operation runs to
    // its end and closes its own pipe end. When any failed, the error is
    // the first failed one of writing, reading stdout, reading stderr and
    // waiting (first_err), whatever order they failed in (R7).
    func output(view self, input: view[]u8) -> Result[Output, io.IoErr] {
        c := self.spawn_modes([2u8, 2u8, 2u8])?
        w := c.take_stdin()?
        o := c.take_stdout()?
        e := c.take_stderr()?
        with g := gather(w, o, e, input) {
            match g {
                Ok(got) => {
                    st := c.wait()
                    var waited: Option[io.IoErr] = None
                    match st {
                        Ok(s) => { }
                        Err(x) => waited = Some(x)
                    }
                    first := first_err(got.wrote, err_in(got.read_out), err_in(got.read_err), waited)
                    match first {
                        Some(x) => return Err(x)
                        None => { }
                    }
                    so := replace(got.read_out, Ok(Vec[u8].new()))
                    se := replace(got.read_err, Ok(Vec[u8].new()))
                    return Ok(Output { status: st?, stdout: so?, stderr: se? })
                }
                Err(x) => {
                    // a reader thread could not start: gather closed stdin
                    // before the scope joined, so the child can end
                    st := c.wait()
                    return Err(errno_err(5u8))
                }
            }
        }
        return Err(errno_err(5u8))
    }

    // output_timeout is output with a deadline (specs/std-timeouts): Some
    // of what output returns when the child ends within d; None when it
    // does not, after killing (SIGKILL) and reaping it, with what it wrote
    // discarded. The writer and both readers run on scoped threads while
    // the calling thread waits. A failure of the timed wait, the kill or
    // the reap is returned, after the child was stopped and the threads
    // joined. A descendant holding one of the child's pipes open keeps
    // the threads, and so the call, waiting past d.
    func output_timeout(view self, input: view[]u8, d: time.Duration) -> Result[Option[Output], io.IoErr] {
        end := deadline_of(d)
        c := self.spawn_modes([2u8, 2u8, 2u8])?
        w := c.take_stdin()?
        o := c.take_stdout()?
        e := c.take_stderr()?
        with g := gather_timed(c, w, o, e, input, end) {
            match g {
                Ok(got) => {
                    match got.failed {
                        Some(x) => return Err(x)
                        None => { }
                    }
                    match got.status {
                        None => return Ok(None)
                        Some(st) => {
                            first := first_err(got.wrote, err_in(got.read_out), err_in(got.read_err), None)
                            match first {
                                Some(x) => return Err(x)
                                None => { }
                            }
                            so := replace(got.read_out, Ok(Vec[u8].new()))
                            se := replace(got.read_err, Ok(Vec[u8].new()))
                            return Ok(Some(Output { status: st, stdout: so?, stderr: se? }))
                        }
                    }
                }
                Err(x) => return Err(errno_err(5u8))
            }
        }
        return Err(errno_err(5u8))
    }

    // status runs the child to its end with the stream settings, a Piped
    // stream treated as Null, and returns how it ended.
    func status(view self) -> Result[ExitStatus, io.IoErr] {
        var m: [3]u8 = self.modes
        var i: usize = 0usize
        while i < 3usize {
            if m[i] == 2u8 { m[i] = 1u8 }
            i = i + 1usize
        }
        c := self.spawn_modes(m)?
        return c.wait()
    }
}

// status_from is the ExitStatus of a runtime status pair.
func status_from(st: view[[2]i32]) -> ExitStatus {
    if st[0usize] == 0i32 { return Exited(st[1usize]) }
    return Signaled(st[1usize])
}

// Child is a started child process. Its destructor closes the pipe ends
// it still holds; it neither waits for nor kills the child.
struct Child nocopy { h: i64; fds: [3]i32; reaped: bool; st: [2]i32 }

impl Child {
    // id is the child's process ID.
    func id(view self) -> u32 { return proc_pid(self.h) }

    // take_stdin, take_stdout and take_stderr hand over the pipe end of a
    // Piped stream the first time, and EBADF afterwards and for a stream
    // that is not Piped. They return a Result, not an Option, because a
    // Pipe comes out of either only by ?: an Option[Pipe] cannot be
    // destructured (its payload has a destructor, OWN_DESTRUCTURE_DESTRUCTOR).
    func take_stdin(edit self) -> Result[Pipe, io.IoErr] { return self.take_fd(0usize) }
    func take_stdout(edit self) -> Result[Pipe, io.IoErr] { return self.take_fd(1usize) }
    func take_stderr(edit self) -> Result[Pipe, io.IoErr] { return self.take_fd(2usize) }
    func take_fd(edit self, i: usize) -> Result[Pipe, io.IoErr] {
        fd := self.fds[i]
        if fd < 0i32 { return Err(errno_err(2u8)) }
        self.fds[i] = -1i32
        return Ok(Pipe { fd: fd, kind: truncate[u8](i) })
    }

    // try_wait returns the child's status once it has ended (reaping it),
    // None while it runs, without blocking.
    func try_wait(edit self) -> Result[Option[ExitStatus], io.IoErr] {
        if self.reaped { return Ok(Some(status_from(self.st))) }
        var st: [2]i32 = [0i32, 0i32]
        r := proc_wait(self.h, false, st)
        if r < 0i32 { return Err(neg_err(i64(r))) }
        if r == 0i32 { return Ok(None) }
        self.st = st
        self.reaped = true
        return Ok(Some(status_from(self.st)))
    }

    // wait_timeout waits at most d for the child to end (specs/std-timeouts):
    // Some of its status once it has ended (reaping it, as try_wait does),
    // None when d passes first; the child keeps running after None. It
    // closes the stdin pipe it still holds first, as wait does. It checks
    // with try_wait, sleeping 1 ms between checks and doubling up to 10 ms,
    // never past the deadline; a d of zero checks once.
    func wait_timeout(edit self, d: time.Duration) -> Result[Option[ExitStatus], io.IoErr] {
        if self.fds[0usize] >= 0i32 {
            c := proc_close(self.fds[0usize])
            self.fds[0usize] = -1i32
        }
        end := deadline_of(d)
        var pause: u64 = 1000000u64
        while true {
            r := self.try_wait()?
            match r {
                Some(st) => {
                    proc_flush_inherited(self.h)
                    return Ok(Some(st))
                }
                None => { }
            }
            t := now_ns()
            if t >= end { return Ok(None) }
            var p: u64 = pause
            if p > end - t { p = end - t }
            time.sleep(time.nanos(p))
            pause = pause * 2u64
            if pause > 10000000u64 { pause = 10000000u64 }
        }
        return Ok(None)
    }

    // wait blocks until the child ends and returns its status. It closes
    // the stdin pipe it still holds first, so that a child reading to end
    // of file can end (R5); the other pipes are closed by the destructor.
    func wait(own self) -> Result[ExitStatus, io.IoErr] {
        if self.fds[0usize] >= 0i32 {
            c := proc_close(self.fds[0usize])
            self.fds[0usize] = -1i32
        }
        if !self.reaped {
            var st: [2]i32 = [0i32, 0i32]
            r := proc_wait(self.h, true, st)
            if r < 0i32 { return Err(neg_err(i64(r))) }
            self.st = st
            self.reaped = true
        }
        proc_flush_inherited(self.h)
        return Ok(status_from(self.st))
    }

    // terminate sends SIGTERM, kill SIGKILL; after a reap they send nothing.
    func terminate(edit self) -> Result[(), io.IoErr] { return self.signal(15i32) }
    func kill(edit self) -> Result[(), io.IoErr] { return self.signal(9i32) }
    func signal(edit self, sig: i32) -> Result[(), io.IoErr] {
        if self.reaped { return Ok(()) }
        r := proc_signal(self.h, sig)
        if r < 0i32 { return Err(neg_err(i64(r))) }
        return Ok(())
    }

    destructor(edit self) {
        var i: usize = 0usize
        while i < 3usize {
            if self.fds[i] >= 0i32 {
                c := proc_close(self.fds[i])
                self.fds[i] = -1i32
            }
            i = i + 1usize
        }
        proc_release(self.h)
    }
}

// Pipe is an owned end of a pipe to a child's stdin (kind 0, written) or
// from its stdout (1) or stderr (2, both read). Its destructor closes it.
struct Pipe nocopy { fd: i32; kind: u8 }

impl Pipe {
    // read reads at most len(buf) bytes and returns how many: 0 at end of
    // file (the child closed its end) or for an empty buf.
    func read(edit self, buf: edit[]u8) -> Result[usize, io.IoErr] {
        if self.kind == 0u8 { return Err(errno_err(2u8)) }
        f := proc_fault_take(self.kind)
        if f != 0i32 { return Err(io.err_of(f)) }
        n := proc_read(self.fd, buf)
        if n < 0i64 { return Err(neg_err(n)) }
        return Ok(usize(n))
    }

    // read_timeout is read waiting at most d for data (specs/std-timeouts):
    // Some(n) for n bytes (0 at end of file or for an empty buf), None
    // when none arrived in time, with nothing read.
    func read_timeout(edit self, buf: edit[]u8, d: time.Duration) -> Result[Option[usize], io.IoErr] {
        if self.kind == 0u8 { return Err(errno_err(2u8)) }
        f := proc_fault_take(self.kind)
        if f != 0i32 { return Err(io.err_of(f)) }
        n := io.io_read_timeout(self.fd, buf, d.ns)
        if n == io.timed_out() { return Ok(None) }
        if n < 0i64 { return Err(neg_err(n)) }
        return Ok(Some(usize(n)))
    }

    // read_all reads to end of file.
    func read_all(edit self) -> Result[Vec[u8], io.IoErr] {
        if self.kind == 0u8 { return Err(errno_err(2u8)) }
        data := Vec[u8].new()
        var buf: [4096]u8 = zero()
        while true {
            f := proc_fault_take(self.kind)
            if f != 0i32 { return Err(io.err_of(f)) }
            n := proc_read(self.fd, buf)
            if n < 0i64 { return Err(neg_err(n)) }
            if n == 0i64 { break }
            data.extend(buf[0usize : usize(n)])
        }
        return Ok(data)
    }

    // write_all writes all of data, retrying short writes. Writing to a
    // child that closed its stdin is EPIPE; it never ends the program.
    func write_all(edit self, data: view[]u8) -> Result[(), io.IoErr] {
        if self.kind != 0u8 { return Err(errno_err(2u8)) }
        var off: usize = 0usize
        while off < len(data) {
            f := proc_fault_take(self.kind)
            if f != 0i32 { return Err(io.err_of(f)) }
            n := proc_write(self.fd, data[off : len(data)])
            if n < 0i64 { return Err(neg_err(n)) }
            off = off + usize(n)
        }
        return Ok(())
    }

    destructor(edit self) {
        if self.fd >= 0i32 {
            c := proc_close(self.fd)
            self.fd = -1i32
        }
    }
}

// Gathered is what output's three pipe operations produced: the write's
// failure, if any, and each stream's bytes or failure.
struct Gathered { wrote: Option[io.IoErr]; read_out: Result[Vec[u8], io.IoErr]; read_err: Result[Vec[u8], io.IoErr] }

// gather runs output's three pipe operations at once: the two readers on
// scoped threads, the write on the calling thread. Each operation owns its
// pipe end and closes it when it ends. A reader that cannot start is
// seen before anything waits for it: gather then closes stdin itself, so
// that the scope's join of a reader that did start cannot wait for a
// child that waits for end of file (R7).
func gather(w: own Pipe, o: own Pipe, e: own Pipe, input: view[]u8) -> Result[Gathered, SpawnErr] {
    with s := thread.scope() {
        r1 := s.spawn(read_end, o)
        var failed: bool = false
        match r1 {
            Ok(t) => { }
            Err(x) => failed = true
        }
        if failed {
            drop(w)
            return Err(ResourceExhausted)
        }
        r2 := s.spawn(read_end, e)
        match r2 {
            Ok(t) => { }
            Err(x) => failed = true
        }
        if failed {
            drop(w)
            return Err(ResourceExhausted)
        }
        wrote := write_end(w, input)
        jo := r1?
        je := r2?
        return Ok(Gathered { wrote: wrote, read_out: jo.get(), read_err: je.get() })
    }
}

// deadline_of is now_ns() plus d, saturating at the largest u64 (a
// deadline that never passes).
func deadline_of(d: time.Duration) -> u64 {
    t := now_ns()
    if d.ns > 18446744073709551615u64 - t { return 18446744073709551615u64 }
    return t + d.ns
}

// Timed is what gather_timed produced: the threads' results, as in
// Gathered; the child's status when it ended within the deadline (None
// when it was killed); and a failure of the timed wait, the kill or the
// reap.
struct Timed { wrote: Option[io.IoErr]; read_out: Result[Vec[u8], io.IoErr]; read_err: Result[Vec[u8], io.IoErr]; status: Option[ExitStatus]; failed: Option[io.IoErr] }

// gather_timed runs output_timeout's operations: the two readers and the
// writer on scoped threads, and the wait for c on the calling thread
// until end, the deadline output_timeout took at its call (spawning and
// starting the threads count against it). When the deadline passes or
// the wait fails, c is stopped, which closes its pipe ends, so the
// threads end and the scope can join them. A thread that cannot start
// stops c too.
func gather_timed(c: edit[Child], w: own Pipe, o: own Pipe, e: own Pipe, input: view[]u8, end: u64) -> Result[Timed, SpawnErr] {
    with s := thread.scope() {
        r1 := s.spawn(read_end, o)
        r2 := s.spawn(read_end, e)
        r3 := s.spawn(write_end, w, input)
        var failed: bool = false
        match r1 {
            Ok(t) => { }
            Err(x) => failed = true
        }
        match r2 {
            Ok(t) => { }
            Err(x) => failed = true
        }
        match r3 {
            Ok(t) => { }
            Err(x) => failed = true
        }
        if failed {
            // a pipe end whose thread did not start was dropped with it;
            // stopping the child ends the threads that did start
            f := stop(c)
            return Err(ResourceExhausted)
        }
        var status: Option[ExitStatus] = None
        var bad: Option[io.IoErr] = None
        t := now_ns()
        var left: u64 = 0u64
        if end > t { left = end - t }
        match c.wait_timeout(time.nanos(left)) {
            Ok(st) => status = st
            Err(x) => bad = Some(x)
        }
        var ended: bool = false
        match status {
            Some(st) => ended = true
            None => { }
        }
        if !ended {
            f := stop(c)
            var none: bool = false
            match bad {
                Some(x) => { }
                None => none = true
            }
            if none { bad = f }
        }
        jo := r1?
        je := r2?
        jw := r3?
        return Ok(Timed { wrote: jw.get(), read_out: jo.get(), read_err: je.get(), status: status, failed: bad })
    }
}

// stop kills a child that has not ended (SIGKILL) and reaps it: None, or
// the kill's failure (after waiting for the child to end anyway) or else
// the reap's.
func stop(c: edit[Child]) -> Option[io.IoErr] {
    k := c.kill()
    r := c.wait_timeout(time.nanos(18446744073709551615u64))
    match k {
        Err(x) => return Some(x)
        Ok(u) => { }
    }
    match r {
        Err(x) => return Some(x)
        Ok(st) => { }
    }
    return None
}

// read_end reads a pipe end to its end of file, then closes it.
func read_end(p: own Pipe) -> Result[Vec[u8], io.IoErr] { return p.read_all() }

// write_end writes data to a stdin pipe end, then closes it. An EPIPE
// (the child stopped reading) is not a failure.
func write_end(p: own Pipe, data: view[]u8) -> Option[io.IoErr] {
    r := p.write_all(data)
    match r {
        Ok(u) => return None
        Err(e) => {
            if is_epipe(e) { return None }
            return Some(e)
        }
    }
    return None
}

// is_epipe reports whether e is the host's EPIPE.
func is_epipe(e: view[io.IoErr]) -> bool {
    match e {
        Other(c) => return c == proc_errno(3u8)
        NotFound => return false
        Permission => return false
        Exists => return false
    }
    return false
}

// err_in is the failure a stream's result holds, if any.
func err_in(r: view[Result[Vec[u8], io.IoErr]]) -> Option[io.IoErr] {
    match r {
        Ok(v) => return None
        Err(e) => return Some(e)
    }
    return None
}

// first_err is the first failure in R7's order: writing input, reading
// stdout, reading stderr, waiting.
func first_err(wrote: Option[io.IoErr], on_out: Option[io.IoErr], on_err: Option[io.IoErr], waited: Option[io.IoErr]) -> Option[io.IoErr] {
    match wrote {
        Some(e) => return Some(e)
        None => { }
    }
    match on_out {
        Some(e) => return Some(e)
        None => { }
    }
    match on_err {
        Some(e) => return Some(e)
        None => { }
    }
    return waited
}
