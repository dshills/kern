// std/map: an open-addressing hash map with linear probing (the
// bench/kern/hash_table design), keyed by any Hashable type. Imported with
// `import "std/map"`. A Map[K, V] keeps its slots in three vectors (state,
// key, value); removal leaves a tombstone, and the table doubles when
// three quarters of its slots are in use.
module map
import "std/str"

// Hashable is the constraint on a Map's key type: a hash and an equality.
interface Hashable {
    func hash(view self) -> u64
    func eq(view self, other: view[Self]) -> bool
}

// mix scrambles an integer key (Fibonacci hashing of its folded halves).
func mix(x: u64) -> u64 { return wrapping_mul(x ^ (x >> 32u32), 11400714819323198485u64) }

impl Hashable for u64 {
    func hash(view self) -> u64 { return mix(self) }
    func eq(view self, other: view[u64]) -> bool { return self == other }
}
impl Hashable for u32 {
    func hash(view self) -> u64 { return mix(u64(self)) }
    func eq(view self, other: view[u32]) -> bool { return self == other }
}
impl Hashable for usize {
    func hash(view self) -> u64 { return mix(u64(self)) }
    func eq(view self, other: view[usize]) -> bool { return self == other }
}
impl Hashable for i64 {
    func hash(view self) -> u64 { return mix(truncate[u64](self)) }
    func eq(view self, other: view[i64]) -> bool { return self == other }
}
impl Hashable for u8 {
    func hash(view self) -> u64 { return mix(u64(self)) }
    func eq(view self, other: view[u8]) -> bool { return self == other }
}
impl Hashable for str.String {
    func hash(view self) -> u64 { return str.hash(self.as_view()) }
    func eq(view self, other: view[str.String]) -> bool { return self.equals(other.as_view()) }
}

// Map is the table: states (0 empty, 1 deleted, 2 full), keys and values
// by slot; count is the number of live entries, used the number of slots
// that are not empty.
struct Map[K, V] nocopy { states: Vec[u8]; keys: Vec[Option[K]]; vals: Vec[Option[V]]; cap: usize; count: usize; used: usize; bits: u32 }

// with_bits builds an empty map of 2^bits slots, 1 <= bits <= 58 (the hash
// is shifted by 64 - bits to pick a slot; a map traps explicitly outside
// that range).
func with_bits[K, V](bits: u32) -> Map[K, V] {
    if bits == 0u32 || bits > 58u32 { trap() }
    cap := 1usize << bits
    m := Map[K, V] { states: Vec[u8].new(), keys: Vec[Option[K]].new(), vals: Vec[Option[V]].new(), cap: cap, count: 0usize, used: 0usize, bits: bits }
    m.states.resize(cap, 0u8)
    i := 0usize
    while i < cap {
        m.keys.push(None)
        m.vals.push(None)
        i = i + 1usize
    }
    return m
}

// try_with_bits is with_bits returning Err(OutOfMemory) where with_bits
// traps oom (specs/effect-trap-kinds §2). The key and value vectors are
// reserved to the table size first, so filling them with None makes no
// allocation call; on Err the partly built map is destroyed on return.
func try_with_bits[K, V](bits: u32) -> Result[Map[K, V], AllocErr] {
    if bits == 0u32 || bits > 58u32 { trap() }
    cap := 1usize << bits
    m := Map[K, V] { states: Vec[u8].new(), keys: Vec[Option[K]].new(), vals: Vec[Option[V]].new(), cap: cap, count: 0usize, used: 0usize, bits: bits }
    m.states.try_resize(cap, 0u8)?
    m.keys.try_reserve(cap)?
    m.vals.try_reserve(cap)?
    i := 0usize
    while i < cap {
        m.keys.try_push(None)?
        m.vals.try_push(None)?
        i = i + 1usize
    }
    return Ok(m)
}

// The methods that hash or compare keys bound K with a where clause
// (spec/types.md): a Map exists for every K, and is usable for Hashable ones.
impl Map[K, V] {
    func new() -> Map[K, V] { return with_bits[K, V](4u32) }
    func try_new() -> Result[Map[K, V], AllocErr] { return try_with_bits[K, V](4u32) }
    func len(view self) -> usize { return self.count }

    // slot finds the slot holding key, or, when key is absent, the first
    // slot (deleted or empty) an insert of it would use.
    func slot(view self, key: view[K]) -> usize where K: Hashable {
        mask := self.cap - 1usize
        i := usize(key.hash() >> (64u32 - self.bits))
        free := self.cap
        while true {
            st := self.states.get(i)
            if st == 0u8 {
                if free == self.cap { return i }
                return free
            }
            if st == 1u8 {
                if free == self.cap { free = i }
            } else {
                match self.keys.get(i) {
                    Some(k) => { if k.eq(key) { return i } }
                    None => { }
                }
            }
            i = (i + 1usize) & mask
        }
        return self.cap
    }

    // Lookups take the key by value (a Copy key is copied, an owned key such
    // as a String is given up and destroyed after the lookup), so a literal
    // or a temporary may be passed.
    func contains(view self, key: own K) -> bool where K: Hashable {
        i := self.slot(key)
        return self.states.get(i) == 2u8
    }

    // get views the value stored under key; it traps (explicit) when the
    // key is absent, so callers test with contains first when unsure.
    func get(view self, key: own K) -> view[V] where K: Hashable {
        i := self.slot(key)
        if self.states.get(i) != 2u8 { trap() }
        match self.vals.get(i) {
            Some(v) => return v
            None => trap()
        }
    }

    // at edits the value stored under key; it traps when the key is absent.
    func at(edit self, key: own K) -> edit[V] where K: Hashable {
        i := self.slot(key)
        if self.states.get(i) != 2u8 { trap() }
        match self.vals.at(i) {
            Some(v) => return v
            None => trap()
        }
    }

    // find is a lookup that borrows its key: the slot holding key, or
    // None. The caller keeps an owned key such as a String. A slot stays
    // valid until the next insert, remove, reserve or try_reserve: each may
    // rebuild the table and move every entry to another slot.
    func find(view self, key: view[K]) -> Option[usize] where K: Hashable {
        i := self.slot(key)
        if self.states.get(i) == 2u8 { return Some(i) }
        return None
    }

    // key_at, value_at and value_at_mut view or edit the entry in a live
    // slot (one find returned); a slot past the table traps bounds, a slot
    // that holds no entry traps explicit.
    func key_at(view self, slot: usize) -> view[K] {
        if self.states.get(slot) != 2u8 { trap() }
        match self.keys.get(slot) {
            Some(k) => return k
            None => trap()
        }
    }
    func value_at(view self, slot: usize) -> view[V] {
        if self.states.get(slot) != 2u8 { trap() }
        match self.vals.get(slot) {
            Some(v) => return v
            None => trap()
        }
    }
    func value_at_mut(edit self, slot: usize) -> edit[V] {
        if self.states.get(slot) != 2u8 { trap() }
        match self.vals.at(slot) {
            Some(v) => return v
            None => trap()
        }
    }

    // The cursor protocol (spec/types.md §7): `for k, v in m` visits every
    // entry in slot order, the order of each; a position is a slot.
    func cursor_first(view self) -> usize { return self.live_from(0usize) }
    func cursor_next(view self, at: usize) -> usize { return self.live_from(at + 1usize) }
    func cursor_end(view self) -> usize { return self.cap }
    // cursor_entry and cursor_entry_mut open the key and the value of the
    // entry at a live position at once: elements of two distinct vectors,
    // so disjoint, at the payload offset of their Some (some_offset).
    contract { invariant "the position is checked live, so both slots hold Some; keys and vals are distinct vectors, so the accesses are disjoint" }
    func cursor_entry(view self, at: usize) -> (view[K], view[V]) {
        if self.states.get(at) != 2u8 { trap() }
        unsafe {
            k := ptr_cast[K, u8](ptr_offset(ptr_cast[u8, Option[K]](self.keys.ptr_at(at)), truncate[isize](self.some_offset(align_of[K]()))))
            v := ptr_cast[V, u8](ptr_offset(ptr_cast[u8, Option[V]](self.vals.ptr_at(at)), truncate[isize](self.some_offset(align_of[V]()))))
            return ptr_view2(k, v)
        }
    }
    contract { invariant "the position is checked live, so both slots hold Some; keys and vals are distinct vectors, so the accesses are disjoint" }
    func cursor_entry_mut(edit self, at: usize) -> (view[K], edit[V]) {
        if self.states.get(at) != 2u8 { trap() }
        unsafe {
            k := ptr_cast[K, u8](ptr_offset(ptr_cast[u8, Option[K]](self.keys.ptr_at(at)), truncate[isize](self.some_offset(align_of[K]()))))
            v := ptr_cast[V, u8](ptr_offset(ptr_cast[u8, Option[V]](self.vals.ptr_at(at)), truncate[isize](self.some_offset(align_of[V]()))))
            return ptr_view_edit(k, v)
        }
    }
    // some_offset is where Some's payload sits in an Option whose payload
    // has alignment a (spec §4.1): after the one-byte tag (two variants),
    // rounded up to a.
    func some_offset(view self, a: usize) -> usize { return (1usize + a - 1usize) / a * a }
    // live_from is the first live slot at or after from, or the capacity.
    func live_from(view self, from: usize) -> usize {
        i := from
        while i < self.cap && self.states.get(i) != 2u8 { i = i + 1usize }
        return i
    }

    // each calls f with every entry's key and value, in slot order: the
    // same for two maps built by the same inserts and removals. f cannot
    // reach the map itself (its access would conflict with this call's).
    func each(view self, f: closure(view[K], view[V])) {
        i := 0usize
        while i < self.cap {
            if self.states.get(i) == 2u8 {
                match self.keys.get(i) {
                    Some(k) => {
                        match self.vals.get(i) {
                            Some(v) => f(k, v)
                            None => { }
                        }
                    }
                    None => { }
                }
            }
            i = i + 1usize
        }
    }

    // each_mut is each with an edit of every value.
    func each_mut(edit self, f: closure(view[K], edit[V])) {
        i := 0usize
        while i < self.cap {
            if self.states.get(i) == 2u8 {
                with k := self.keys.get(i) {
                    with v := self.vals.at(i) {
                        match k {
                            Some(kk) => {
                                match v {
                                    Some(vv) => f(kk, vv)
                                    None => { }
                                }
                            }
                            None => { }
                        }
                    }
                }
            }
            i = i + 1usize
        }
    }

    // insert stores val under key and returns the value it replaced, if any.
    func insert(edit self, key: own K, val: own V) -> Option[V] where K: Hashable {
        if (self.used + 1usize) * 4usize >= self.cap * 3usize {
            // slots are running out: double when the live entries need it,
            // otherwise rebuild at the same size to drop the tombstones
            bits := self.bits
            if (self.count + 1usize) * 2usize > self.cap { self.rebuild(bits + 1u32) } else { self.rebuild(bits) }
        }
        i := self.slot(key)
        if self.states.get(i) == 2u8 {
            with slot := self.vals.at(i) { return replace(slot, Some(val)) }
        }
        fresh := self.states.get(i) == 0u8
        if fresh { self.used = self.used + 1usize }
        with st := self.states.at(i) { st = 2u8 }
        with ks := self.keys.at(i) { ks = Some(key) }
        with vs := self.vals.at(i) { vs = Some(val) }
        self.count = self.count + 1usize
        return None
    }

    // try_insert is insert returning Err(OutOfMemory) where insert traps
    // oom: when the table must grow and the larger table cannot be
    // allocated, key and then val are destroyed and the map is unchanged.
    // Once the larger table exists, moving the entries into it makes no
    // allocation call (try_rebuild).
    func try_insert(edit self, key: own K, val: own V) -> Result[Option[V], AllocErr] where K: Hashable {
        if (self.used + 1usize) * 4usize >= self.cap * 3usize {
            bits := self.bits
            if (self.count + 1usize) * 2usize > self.cap { bits = bits + 1u32 }
            match self.try_rebuild(bits) {
                Ok(u) => { }
                Err(e) => {
                    drop(key)
                    drop(val)
                    return Err(e)
                }
            }
        }
        return Ok(self.place(key, val))
    }

    // reserve makes room for n absent inserts (specs/map-in §1): when the
    // table lacks it, the table is rebuilt at the smallest size that has
    // it, at least the present one, so the next n absent inserts make no
    // allocation call and never rebuild. A request past usize or past 2^58
    // slots, or a failed allocation, traps oom and leaves the map as it was.
    func reserve(edit self, n: usize) where K: Hashable {
        if reserve_room(self.cap, self.used, n) { return }
        match reserve_bits(self.bits, self.count, n) {
            Some(b) => self.rebuild(b)
            None => trap_kind(oom)
        }
    }

    // try_reserve is reserve returning Err(OutOfMemory) where reserve
    // traps oom; on Err the map is unchanged.
    func try_reserve(edit self, n: usize) -> Result[(), AllocErr] where K: Hashable {
        if reserve_room(self.cap, self.used, n) { return Ok(()) }
        match reserve_bits(self.bits, self.count, n) {
            Some(b) => return self.try_rebuild(b)
            None => return Err(OutOfMemory)
        }
    }

    // place is insert's slot write without its growth check: the table
    // must have room (a free slot within its 3/4 load), which try_insert
    // and try_rebuild ensure.
    func place(edit self, key: own K, val: own V) -> Option[V] where K: Hashable {
        i := self.slot(key)
        if self.states.get(i) == 2u8 {
            with slot := self.vals.at(i) { return replace(slot, Some(val)) }
        }
        fresh := self.states.get(i) == 0u8
        if fresh { self.used = self.used + 1usize }
        with st := self.states.at(i) { st = 2u8 }
        with ks := self.keys.at(i) { ks = Some(key) }
        with vs := self.vals.at(i) { vs = Some(val) }
        self.count = self.count + 1usize
        return None
    }

    // try_rebuild is rebuild over try_with_bits; the new table always has
    // room for the live entries (a same-size rebuild happens only when
    // count + 1 <= cap / 2, and a doubled table holds fewer than 3/8 of its
    // slots), so they are moved with place. On Err nothing has changed.
    func try_rebuild(edit self, bits: u32) -> Result[(), AllocErr] where K: Hashable {
        bigger := try_with_bits[K, V](bits)?
        i := 0usize
        while i < self.cap {
            if self.states.get(i) == 2u8 {
                var k: Option[K] = None
                var v: Option[V] = None
                with ks := self.keys.at(i) { k = replace(ks, None) }
                with vs := self.vals.at(i) { v = replace(vs, None) }
                match move k {
                    Some(kk) => { place_opt(bigger, kk, v) }
                    None => { drop(v) }
                }
            }
            i = i + 1usize
        }
        self = bigger
        return Ok(())
    }

    // remove takes the value stored under key out of the map, if any.
    func remove(edit self, key: own K) -> Option[V] where K: Hashable {
        i := self.slot(key)
        if self.states.get(i) != 2u8 { return None }
        with st := self.states.at(i) { st = 1u8 }
        with ks := self.keys.at(i) { ks = None }
        self.count = self.count - 1usize
        with vs := self.vals.at(i) { return replace(vs, None) }
    }

    // rebuild makes a table of 2^bits slots, dropping tombstones: each live
    // entry is taken out of its slots and inserted into the new map, which
    // then replaces this one.
    func rebuild(edit self, bits: u32) where K: Hashable {
        bigger := with_bits[K, V](bits)
        i := 0usize
        while i < self.cap {
            if self.states.get(i) == 2u8 {
                var k: Option[K] = None
                var v: Option[V] = None
                with ks := self.keys.at(i) { k = replace(ks, None) }
                with vs := self.vals.at(i) { v = replace(vs, None) }
                match move k {
                    Some(kk) => { insert_opt(bigger, kk, v) }
                    None => { drop(v) }
                }
            }
            i = i + 1usize
        }
        self = bigger
    }
}

// reserve_room reports whether a table of cap slots, used of them not
// empty, has room for n absent inserts with no rebuild: the growth rule
// rebuilds before an insert once (used + 1) * 4 >= cap * 3. A sum or a
// product past usize is no room.
func reserve_room(cap: usize, used: usize, n: usize) -> bool {
    match checked_add(used, n) {
        Some(t) => {
            match checked_mul(t, 4usize) {
                Some(x) => return x < cap * 3usize
                None => return false
            }
        }
        None => return false
    }
}

// reserve_bits is the smallest b >= from, at most 58, with
// (count + n) * 4 < 3 * 2^b: the table a rebuild for n absent inserts
// needs. None when there is none, or the sum or product passes usize.
func reserve_bits(from: u32, count: usize, n: usize) -> Option[u32] {
    var need: usize = 0usize
    match checked_add(count, n) {
        Some(t) => need = t
        None => return None
    }
    match checked_mul(need, 4usize) {
        Some(x) => need = x
        None => return None
    }
    b := from
    while b <= 58u32 {
        if need < 3usize * (1usize << b) { return Some(b) }
        b = b + 1u32
    }
    return None
}

// MapIn is Map over a caller's allocator (specs/map-in §2): the same
// probe, growth rule and slot order, with its table in three allocations
// from a (the states, cap bytes at alignment 1; the keys; the values),
// a slot's key and value initialized exactly when its state is full
// (2). It is fallible throughout: no method traps oom. A new map has no
// table; the first insert or reserve makes one of 2^4 slots or more.
struct MapIn[K, V, A: Allocator] nocopy { states: RawPtr[u8]; keys: RawPtr[K]; vals: RawPtr[V]; cap: usize; count: usize; used: usize; bits: u32; a: A }

// probe_in is Map.slot over raw buffers: in a table of 2^bits slots, the
// slot holding key, or the first slot (deleted or empty) an insert of it
// would use.
contract { requires "states and keys address 2^bits slots; a full slot holds an initialized key; some slot is empty" }
func probe_in[K: Hashable](states: RawPtr[u8], keys: RawPtr[K], bits: u32, key: view[K]) -> usize {
    cap := 1usize << bits
    mask := cap - 1usize
    i := usize(key.hash() >> (64u32 - bits))
    free := cap
    unsafe {
        while true {
            st := ptr_load(ptr_offset(states, truncate[isize](i)))
            if st == 0u8 {
                if free == cap { return i }
                return free
            }
            if st == 1u8 {
                if free == cap { free = i }
            } else {
                if ptr_view(ptr_offset(keys, truncate[isize](i))).eq(key) { return i }
            }
            i = (i + 1usize) & mask
        }
    }
    return cap
}

impl[K, V, A: Allocator] MapIn[K, V, A] {
    func new_in(a: own A) -> MapIn[K, V, A] {
        return MapIn[K, V, A] { states: zero(), keys: zero(), vals: zero(), cap: 0usize, count: 0usize, used: 0usize, bits: 0u32, a: a }
    }
    func len(view self) -> usize { return self.count }
    func allocator(view self) -> view[A] { return self.a }

    // state, key_ptr and val_ptr address slot i of the table.
    contract { requires "i < cap; states addresses cap bytes" }
    func state(view self, i: usize) -> u8 {
        unsafe { return ptr_load(ptr_offset(self.states, truncate[isize](i))) }
    }
    contract { requires "i < cap; keys addresses cap keys" }
    func key_ptr(view self, i: usize) -> RawPtr[K] {
        unsafe { return ptr_offset(self.keys, truncate[isize](i)) }
    }
    contract { requires "i < cap; vals addresses cap values" }
    func val_ptr(view self, i: usize) -> RawPtr[V] {
        unsafe { return ptr_offset(self.vals, truncate[isize](i)) }
    }

    // slot is Map.slot; the table must exist.
    contract { requires "cap > 0: the three buffers address cap slots and some slot is empty" }
    func slot(view self, key: view[K]) -> usize where K: Hashable {
        unsafe { return probe_in(self.states, self.keys, self.bits, key) }
    }

    // try_rebuild makes a table of 2^bits slots through a and moves the
    // live entries into it in slot order, dropping tombstones. The three
    // allocations are requested states, keys, values; when one is refused
    // the granted ones are freed in reverse order and the map is unchanged.
    // Moving makes no allocation call; the old table is then freed.
    contract { requires "the three buffers address cap slots allocated from a; full slots hold initialized entries" }
    func try_rebuild(edit self, bits: u32) -> Result[(), AllocErr] where K: Hashable {
        if bits > 58u32 { return Err(OutOfMemory) }
        n := 1usize << bits
        var kb: usize = 0usize
        var vb: usize = 0usize
        match elems_bytes[K](n) {
            Some(b) => kb = b
            None => return Err(OutOfMemory)
        }
        match elems_bytes[V](n) {
            Some(b) => vb = b
            None => return Err(OutOfMemory)
        }
        unsafe {
            var ns: RawPtr[u8] = zero()
            match self.a.alloc(n, 1usize) {
                Ok(r) => ns = r
                Err(e) => return Err(e)
            }
            var nk: RawPtr[u8] = zero()
            match self.a.alloc(kb, align_of[K]()) {
                Ok(r) => nk = r
                Err(e) => {
                    self.a.free(ns, n, 1usize)
                    return Err(e)
                }
            }
            var nv: RawPtr[u8] = zero()
            match self.a.alloc(vb, align_of[V]()) {
                Ok(r) => nv = r
                Err(e) => {
                    self.a.free(nk, kb, align_of[K]())
                    self.a.free(ns, n, 1usize)
                    return Err(e)
                }
            }
            i := 0usize
            while i < n {
                ptr_store(ptr_offset(ns, truncate[isize](i)), 0u8)
                i = i + 1usize
            }
            keys := ptr_cast[K, u8](nk)
            vals := ptr_cast[V, u8](nv)
            j := 0usize
            while j < self.cap {
                if self.state(j) == 2u8 {
                    k := ptr_take(self.key_ptr(j))
                    v := ptr_take(self.val_ptr(j))
                    at := probe_in(ns, keys, bits, k)
                    ptr_store(ptr_offset(ns, truncate[isize](at)), 2u8)
                    ptr_store(ptr_offset(keys, truncate[isize](at)), k)
                    ptr_store(ptr_offset(vals, truncate[isize](at)), v)
                }
                j = j + 1usize
            }
            self.free_table()
            self.states = ns
            self.keys = keys
            self.vals = vals
            self.cap = n
            self.bits = bits
            self.used = self.count
        }
        return Ok(())
    }

    // free_table frees the three allocations of the table, if any, with
    // their own sizes and alignments; the entries must already be gone.
    contract { requires "the three buffers address cap slots allocated from a; no slot holds a live entry the caller still needs" }
    func free_table(edit self) {
        if self.cap == 0usize { return }
        var kb: usize = 0usize
        var vb: usize = 0usize
        match elems_bytes[K](self.cap) {
            Some(b) => kb = b
            None => trap_kind(unreachable)
        }
        match elems_bytes[V](self.cap) {
            Some(b) => vb = b
            None => trap_kind(unreachable)
        }
        unsafe {
            self.a.free(ptr_cast[u8, V](self.vals), vb, align_of[V]())
            self.a.free(ptr_cast[u8, K](self.keys), kb, align_of[K]())
            self.a.free(self.states, self.cap, 1usize)
        }
    }

    // try_reserve is Map.try_reserve (specs/map-in §1); a map with no
    // table gets the smallest table of 2^4 slots or more with room, and
    // reserving nothing makes no table.
    func try_reserve(edit self, n: usize) -> Result[(), AllocErr] where K: Hashable {
        if n == 0usize { return Ok(()) }
        if self.cap > 0usize && reserve_room(self.cap, self.used, n) { return Ok(()) }
        var from: u32 = 4u32
        if self.cap > 0usize { from = self.bits }
        match reserve_bits(from, self.count, n) {
            Some(b) => return self.try_rebuild(b)
            None => return Err(OutOfMemory)
        }
    }

    // try_insert is Map.try_insert: when the table must grow (or does not
    // exist yet) and the larger one cannot be allocated, key and then val
    // are destroyed and the map is unchanged.
    func try_insert(edit self, key: own K, val: own V) -> Result[Option[V], AllocErr] where K: Hashable {
        if self.cap == 0usize || (self.used + 1usize) * 4usize >= self.cap * 3usize {
            var bits: u32 = 4u32
            if self.cap > 0usize {
                bits = self.bits
                if (self.count + 1usize) * 2usize > self.cap { bits = bits + 1u32 }
            }
            match self.try_rebuild(bits) {
                Ok(u) => { }
                Err(e) => {
                    drop(key)
                    drop(val)
                    return Err(e)
                }
            }
        }
        return Ok(self.place(key, val))
    }

    // place is Map.place: the table must have room.
    contract { requires "cap > 0 and the table has a free slot within its 3/4 load" }
    func place(edit self, key: own K, val: own V) -> Option[V] where K: Hashable {
        i := self.slot(key)
        unsafe {
            if self.state(i) == 2u8 {
                old := ptr_take(self.val_ptr(i))
                ptr_store(self.val_ptr(i), val)
                return Some(old)
            }
            if self.state(i) == 0u8 { self.used = self.used + 1usize }
            ptr_store(ptr_offset(self.states, truncate[isize](i)), 2u8)
            ptr_store(self.key_ptr(i), key)
            ptr_store(self.val_ptr(i), val)
        }
        self.count = self.count + 1usize
        return None
    }

    // The lookups are Map's: by value (the key is destroyed after the
    // lookup), get and at trapping on an absent key.
    func contains(view self, key: own K) -> bool where K: Hashable {
        if self.cap == 0usize { return false }
        return self.state(self.slot(key)) == 2u8
    }
    contract { requires "a full slot holds an initialized value" }
    func get(view self, key: own K) -> view[V] where K: Hashable {
        if self.cap == 0usize { trap() }
        i := self.slot(key)
        if self.state(i) != 2u8 { trap() }
        unsafe { return ptr_view(self.val_ptr(i)) }
    }
    contract { requires "a full slot holds an initialized value" }
    func at(edit self, key: own K) -> edit[V] where K: Hashable {
        if self.cap == 0usize { trap() }
        i := self.slot(key)
        if self.state(i) != 2u8 { trap() }
        unsafe { return ptr_edit(self.val_ptr(i)) }
    }
    // find is Map.find: a slot stays valid until the next try_insert,
    // remove, try_reserve or release.
    func find(view self, key: view[K]) -> Option[usize] where K: Hashable {
        if self.cap == 0usize { return None }
        i := self.slot(key)
        if self.state(i) == 2u8 { return Some(i) }
        return None
    }
    // key_at, value_at and value_at_mut are Map's: a slot past the table
    // traps bounds, a slot that holds no entry traps explicit.
    func check_slot(view self, slot: usize) {
        if slot >= self.cap { trap_kind(bounds) }
        if self.state(slot) != 2u8 { trap() }
    }
    contract { requires "a full slot holds an initialized key" }
    func key_at(view self, slot: usize) -> view[K] {
        self.check_slot(slot)
        unsafe { return ptr_view(self.key_ptr(slot)) }
    }
    contract { requires "a full slot holds an initialized value" }
    func value_at(view self, slot: usize) -> view[V] {
        self.check_slot(slot)
        unsafe { return ptr_view(self.val_ptr(slot)) }
    }
    contract { requires "a full slot holds an initialized value" }
    func value_at_mut(edit self, slot: usize) -> edit[V] {
        self.check_slot(slot)
        unsafe { return ptr_edit(self.val_ptr(slot)) }
    }

    // remove is Map.remove: the key is destroyed, the value returned.
    contract { requires "a full slot holds an initialized entry" }
    func remove(edit self, key: own K) -> Option[V] where K: Hashable {
        if self.cap == 0usize { return None }
        i := self.slot(key)
        if self.state(i) != 2u8 { return None }
        unsafe {
            ptr_store(ptr_offset(self.states, truncate[isize](i)), 1u8)
            k := ptr_take(self.key_ptr(i))
            drop(k)
            self.count = self.count - 1usize
            return Some(ptr_take(self.val_ptr(i)))
        }
    }

    // The cursor protocol and each/each_mut are Map's, in slot order.
    func live_from(view self, from: usize) -> usize {
        i := from
        while i < self.cap && self.state(i) != 2u8 { i = i + 1usize }
        return i
    }
    func cursor_first(view self) -> usize { return self.live_from(0usize) }
    func cursor_next(view self, at: usize) -> usize { return self.live_from(at + 1usize) }
    func cursor_end(view self) -> usize { return self.cap }
    contract { invariant "the position is checked live, so the key and the value are initialized; they are in distinct buffers, so the accesses are disjoint" }
    func cursor_entry(view self, at: usize) -> (view[K], view[V]) {
        self.check_slot(at)
        unsafe { return ptr_view2(self.key_ptr(at), self.val_ptr(at)) }
    }
    contract { invariant "the position is checked live, so the key and the value are initialized; they are in distinct buffers, so the accesses are disjoint" }
    func cursor_entry_mut(edit self, at: usize) -> (view[K], edit[V]) {
        self.check_slot(at)
        unsafe { return ptr_view_edit(self.key_ptr(at), self.val_ptr(at)) }
    }
    contract { requires "full slots hold initialized entries" }
    func each(view self, f: closure(view[K], view[V])) {
        i := 0usize
        while i < self.cap {
            if self.state(i) == 2u8 {
                unsafe {
                    with k, v := ptr_view2(self.key_ptr(i), self.val_ptr(i)) { f(k, v) }
                }
            }
            i = i + 1usize
        }
    }
    contract { requires "full slots hold initialized entries" }
    func each_mut(edit self, f: closure(view[K], edit[V])) {
        i := 0usize
        while i < self.cap {
            if self.state(i) == 2u8 {
                // one call opens both: the key and the value are in
                // distinct buffers, so the two accesses are disjoint
                unsafe {
                    with k, v := ptr_view_edit(self.key_ptr(i), self.val_ptr(i)) { f(k, v) }
                }
            }
            i = i + 1usize
        }
    }

    // release destroys every live entry, key then value, in slot order,
    // and frees the table, leaving an empty map with no table that still
    // holds a.
    contract { requires "the three buffers address cap slots allocated from a; full slots hold initialized entries" }
    func release(edit self) {
        i := 0usize
        while i < self.cap {
            if self.state(i) == 2u8 {
                unsafe {
                    k := ptr_take(self.key_ptr(i))
                    drop(k)
                    v := ptr_take(self.val_ptr(i))
                    drop(v)
                }
            }
            i = i + 1usize
        }
        self.free_table()
        self.states = zero()
        self.keys = zero()
        self.vals = zero()
        self.cap = 0usize
        self.count = 0usize
        self.used = 0usize
        self.bits = 0u32
    }
    destructor(edit self) { self.release() }
}

// find_text finds the slot of a String key by its bytes, without building
// a String: the hash and the equality String's Hashable uses.
func find_text[V](m: view[Map[str.String, V]], key: view[]u8) -> Option[usize] {
    mask := m.cap - 1usize
    i := usize(str.hash(key) >> (64u32 - m.bits))
    probes := 0usize
    while probes < m.cap {
        st := m.states.get(i)
        if st == 0u8 { return None }
        if st == 2u8 {
            match m.keys.get(i) {
                Some(k) => { if k.equals(key) { return Some(i) } }
                None => { }
            }
        }
        i = (i + 1usize) & mask
        probes = probes + 1usize
    }
    return None
}

// place_opt places kk with the value in v, if any (try_rebuild's helper).
func place_opt[K: Hashable, V](m: edit[Map[K, V]], kk: own K, v: own Option[V]) {
    match move v {
        Some(vv) => { m.place(kk, vv) }
        None => { drop(kk) }
    }
}

// insert_opt inserts kk with the value in v, if any (grow's helper).
func insert_opt[K: Hashable, V](m: edit[Map[K, V]], kk: own K, v: own Option[V]) {
    match move v {
        Some(vv) => { m.insert(kk, vv) }
        None => { drop(kk) }
    }
}
